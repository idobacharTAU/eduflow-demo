{"slug": "bgm412_ln_rules_not_invented", "duration": 34.42, "cues": [{"start": 0, "end": 1.48, "text": "יש חוק לוגריתמים", "words": [{"t": "יש", "s": 0, "e": 0.32}, {"t": "חוק", "s": 0.32, "e": 0.8}, {"t": "לוגריתמים", "s": 0.8, "e": 1.36}]}, {"start": 1.36, "end": 2.6, "text": "שקל להמציא.", "words": [{"t": "שקל", "s": 1.36, "e": 2.06}, {"t": "להמציא.", "s": 2.06, "e": 2.48}]}, {"start": 2.58, "end": 3.94, "text": "מפרקים לן של", "words": [{"t": "מפרקים", "s": 2.58, "e": 3.4}, {"t": "לן", "s": 3.4, "e": 3.64}, {"t": "של", "s": 3.64, "e": 3.82}]}, {"start": 3.82, "end": 5.5, "text": "סכום לשני לוגריתמים.", "words": [{"t": "סכום", "s": 3.82, "e": 4.26}, {"t": "לשני", "s": 4.26, "e": 4.84}, {"t": "לוגריתמים.", "s": 4.84, "e": 5.38}]}, {"start": 5.58, "end": 7, "text": "חוק כזה פשוט", "words": [{"t": "חוק", "s": 5.58, "e": 6.16}, {"t": "כזה", "s": 6.16, "e": 6.36}, {"t": "פשוט", "s": 6.36, "e": 6.88}]}, {"start": 6.88, "end": 7.9, "text": "לא קיים.", "words": [{"t": "לא", "s": 6.88, "e": 7.3}, {"t": "קיים.", "s": 7.3, "e": 7.78}]}, {"start": 8, "end": 9.56, "text": "נציב אחד ועוד אחד.", "words": [{"t": "נציב", "s": 8, "e": 8.58}, {"t": "אחד", "s": 8.58, "e": 8.94}, {"t": "ועוד", "s": 8.94, "e": 9.28}, {"t": "אחד.", "s": 9.28, "e": 9.44}]}, {"start": 9.74, "end": 10.82, "text": "לן של שתיים", "words": [{"t": "לן", "s": 9.74, "e": 10.1}, {"t": "של", "s": 10.1, "e": 10.26}, {"t": "שתיים", "s": 10.26, "e": 10.7}]}, {"start": 10.7, "end": 11.82, "text": "אינו אפס.", "words": [{"t": "אינו", "s": 10.7, "e": 11.2}, {"t": "אפס.", "s": 11.2, "e": 11.7}]}, {"start": 11.74, "end": 12.7, "text": "לן של אחד", "words": [{"t": "לן", "s": 11.74, "e": 12.22}, {"t": "של", "s": 12.22, "e": 12.32}, {"t": "אחד", "s": 12.32, "e": 12.58}]}, {"start": 12.58, "end": 13.52, "text": "הוא אפס.", "words": [{"t": "הוא", "s": 12.58, "e": 12.94}, {"t": "אפס.", "s": 12.94, "e": 13.4}]}, {"start": 13.44, "end": 14.72, "text": "אפס ועוד אפס", "words": [{"t": "אפס", "s": 13.44, "e": 14.02}, {"t": "ועוד", 