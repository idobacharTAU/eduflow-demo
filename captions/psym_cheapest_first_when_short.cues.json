{"slug": "psym_cheapest_first_when_short", "duration": 41.7, "cues": [{"start": 0, "end": 1.92, "text": "מאיזו שאלה מתחילים", "words": [{"t": "מאיזו", "s": 0, "e": 0.86}, {"t": "שאלה", "s": 0.86, "e": 1.24}, {"t": "מתחילים", "s": 1.24, "e": 1.8}]}, {"start": 1.8, "end": 3.14, "text": "כשהזמן קצר?", "words": [{"t": "כשהזמן", "s": 1.8, "e": 2.42}, {"t": "קצר?", "s": 2.42, "e": 3.02}]}, {"start": 3.08, "end": 5.4, "text": "בפרק הדגמה נשארו שלוש", "words": [{"t": "בפרק", "s": 3.08, "e": 3.84}, {"t": "הדגמה", "s": 3.84, "e": 4.22}, {"t": "נשארו", "s": 4.22, "e": 4.74}, {"t": "שלוש", "s": 4.74, "e": 5.28}]}, {"start": 5.28, "end": 7.24, "text": "דקות ושלוש שאלות.", "words": [{"t": "דקות", "s": 5.28, "e": 5.68}, {"t": "ושלוש", "s": 5.68, "e": 6.58}, {"t": "שאלות.", "s": 6.58, "e": 7.12}]}, {"start": 7.22, "end": 9.8, "text": "בסדר הדף, קודם בינונית,", "words": [{"t": "בסדר", "s": 7.22, "e": 8.02}, {"t": "הדף,", "s": 8.02, "e": 8.38}, {"t": "קודם", "s": 8.48, "e": 9.12}, {"t": "בינונית,", "s": 9.12, "e": 9.68}]}, {"start": 9.92, "end": 12.98, "text": "אחריה ארוכה וכבדה, ואחרונה", "words": [{"t": "אחריה", "s": 9.92, "e": 10.46}, {"t": "ארוכה", "s": 10.46, "e": 11.24}, {"t": "וכבדה,", "s": 11.24, "e": 11.86}, {"t": "ואחרונה", "s": 11.96, "e": 12.86}]}, {"start": 12.86, "end": 14.82, "text": "קצרה שאתה מזהה מיד.", "words": [{"t": "קצרה", "s": 12.86, "e": 13.48}, {"t": "שאתה", "s": 13.48, "e": 14.02}, {"t": "מזהה", "s": 14.02, "e": 14.36}, {"t": "מיד.", "s": 14.36, "e": 14.7}]}, {"start": 15.44, "end": 16.82, "text": "כולן שוות אותו ניקוד,", "words": [{"t": "כולן", "s": 15.44, "e": 15.84}, {"t": "שוות", "s": 15.84, "e": 16.14}, {"t": "אותו", "s": 16.14, "e": 16.28}, {"t": "ניקוד,", "s": 16.28, "e": 16.7}]}, {"start": 16.78, "end": 18.4, "text": "רק הזמן נגמר.", "words": [{"t": "רק", "s": 16.78, "e": 17.18}, {"t": "הזמן", "s": 17.18, "e": 17.8}, {"t": "נגמר.", "s": 17.8, "e": 18.28}]}, {"start": 18.9, "end": 20.44, "text": "לא לפי סדר הדף.", "words": [{"t": "לא", "s": 18.9, "e": 19.3}, {"t": "לפי", "s": 19.3, "e": 19.68}, {"t": "סדר", "s": 19.68, "e": 19.94}, {"t": "הדף.", "s": 19.94, "e": 20.32}]}, {"start": 20.5, "end": 22.28, "text": "לא הארוכה קודם", "words": [{"t": "לא", "s": 20.5, "e": 20.88}, {"t": "הארוכה", "s": 20.88, "e": 21.7}, {"t": "קודם", "s": 21.7, "e": 22.16}]}, {"start": 22.16, "end": 23.5, "text": "כדי להיפטר ממנה.", "words": [{"t": "כדי", "s": 22.16, "e": 22.4}, {"t": "להיפטר", "s": 22.4, "e": 22.98}, {"t": "ממנה.", "s": 22.98, "e": 23.38}]}, {"start": 23.4, "end": 24.82, "text": "היא עלולה לבלוע", "words": [{"t": "היא", "s": 23.4, "e": 23.76}, {"t": "עלולה", "s": 23.76, "e": 24.26}, {"t": "לבלוע", "s": 24.26, "e": 24.7}]}, {"start": 24.7, "end": 26.04, "text": "את כל הדקות.", "words": [{"t": "את", "s": 24.7, "e": 24.96}, {"t": "כל", "s": 24.96, "e": 25.38}, {"t": "הדקות.", "s": 25.38, "e": 25.92}]}, {"start": 26.1, "end": 28.04, "text": "לא דקה לכל אחת.", "words": [{"t": "לא", "s": 26.1, "e": 26.9}, {"t": "דקה", "s": 26.9, "e": 27.28}, {"t": "לכל", "s": 27.28, "e": 27.52}, {"t": "אחת.", "s": 27.52, "e": 27.92}]}, {"start": 27.96, "end": 29.34, "text": "שאלות לא עולות", "words": [{"t": "שאלות", "s": 27.96, "e": 28.64}, {"t": "לא", "s": 28.64, "e": 28.9}, {"t": "עולות", "s": 28.9, "e": 29.22}]}, {"start": 29.22, "end": 29.74, "text": "אותו זמן.", "words": [{"t": "אותו", "s": 29.22, "e": 29.34}, {"t": "זמן.", "s": 29.34, "e": 29.62}]}, {"start": 30, "end": 32.62, "text": "הקצרה ראשונה, הבינונית", "words": [{"t": "הקצרה", "s": 30, "e": 30.94}, {"t": "ראשונה,", "s": 30.94, "e": 31.52}, {"t": "הבינונית", "s": 31.54, "e": 32.5}]}, {"start": 32.5, "end": 34.78, "text": "אחריה, הארוכה אחרונה.", "words": [{"t": "אחריה,", "s": 32.5, "e": 32.98}, {"t": "הארוכה", "s": 33.06, "e": 34.14}, {"t": "אחרונה.", "s": 34.14, "e": 34.66}]}, {"start": 35.44, "end": 38.86, "text": "כלל, כשהדקות אוזלות, מהזולה", "words": [{"t": "כלל,", "s": 35.44, "e": 35.92}, {"t": "כשהדקות", "s": 35.94, "e": 37.1}, {"t": "אוזלות,", "s": 37.1, "e": 37.6}, {"t": "מהזולה", "s": 37.66, "e": 38.74}]}, {"start": 38.74, "end": 40.22, "text": "בזמן אל היקרה.", "words": [{"t": "בזמן", "s": 38.74, "e": 39.22}, {"t": "אל", "s": 39.22, "e": 39.62}, {"t": "היקרה.", "s": 39.62, "e": 40.1}]}]}
