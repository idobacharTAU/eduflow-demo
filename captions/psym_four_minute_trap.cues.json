{"slug": "psym_four_minute_trap", "duration": 34.48, "cues": [{"start": 0.0, "end": 1.6, "text": "השאלה הקשה הזאת", "words": [{"t": "השאלה", "s": 0.0, "e": 0.74}, {"t": "הקשה", "s": 0.74, "e": 1.16}, {"t": "הזאת", "s": 1.16, "e": 1.6}]}, {"start": 1.6, "end": 3.36, "text": "עלתה שלוש נקודות.", "words": [{"t": "עלתה", "s": 1.6, "e": 2.02}, {"t": "שלוש", "s": 2.02, "e": 2.8}, {"t": "נקודות.", "s": 2.8, "e": 3.36}]}, {"start": 3.8, "end": 5.02, "text": "נניח פרק של עשרים", "words": [{"t": "נניח", "s": 3.8, "e": 4.18}, {"t": "פרק", "s": 4.18, "e": 4.52}, {"t": "של", "s": 4.52, "e": 4.64}, {"t": "עשרים", "s": 4.64, "e": 5.02}]}, {"start": 5.02, "end": 6.66, "text": "שאלות בעשרים דקות.", "words": [{"t": "שאלות", "s": 5.02, "e": 5.68}, {"t": "בעשרים", "s": 5.68, "e": 6.22}, {"t": "דקות.", "s": 6.22, "e": 6.66}]}, {"start": 6.8, "end": 8.18, "text": "תקציב של דקה", "words": [{"t": "תקציב", "s": 6.8, "e": 7.56}, {"t": "של", "s": 7.56, "e": 7.66}, {"t": "דקה", "s": 7.66, "e": 8.18}]}, {"start": 8.18, "end": 9.561, "text": "אחת בממוצע לשאלה.", "words": [{"t": "אחת", "s": 8.18, "e": 8.52}, {"t": "בממוצע", "s": 8.52, "e": 9.04}, {"t": "לשאלה.", "s": 9.04, "e": 9.561}]}, {"start": 9.7, "end": 11.939, "text": "נתקעים עליה ארבע דקות.", "words": [{"t": "נתקעים", "s": 9.7, "e": 10.46}, {"t": "עליה", "s": 10.46, "e": 10.68}, {"t": "ארבע", "s": 10.68, "e": 11.36}, {"t": "דקות.", "s": 11.36, "e": 11.939}]}, {"start": 12.08, "end": 14.103, "text": "שלוש מהן כבר לא שלה.", "words": [{"t": "שלוש", "s": 12.08, "e": 12.84}, {"t": "מהן", "s": 12.84, "e": 13.16}, {"t": "כבר", "s": 13.16, "e": 13.52}, {"t": "לא", "s": 13.52, "e": 13.72}, {"t": "שלה.", "s": 13.72, "e": 14.103}]}, {"start": 14.38, "end": 15.96, "text": "ובדקה לשאלה זה", "words": [{"t": "ובדקה", "s": 14.38, "e": 15.14}, {"t": "לשאלה", "s": 15.14, "e": 15.7}, {"t": "זה", "s": 15.7, "e": 15.96}]}, {"start": 15.96, "end": 17.309, "text": "עוד שלוש שאלות.", "words": [{"t": "עוד", "s": 15.96, "e": 16.2}, {"t": "שלוש", "s": 16.2, "e": 16