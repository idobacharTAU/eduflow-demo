{"slug": "psym_four_minute_trap", "duration": 34.12, "cues": [{"start": 0, "end": 2.3, "text": "השאלה הקשה הזאת עלתה", "words": [{"t": "השאלה", "s": 0, "e": 0.78}, {"t": "הקשה", "s": 0.78, "e": 1.16}, {"t": "הזאת", "s": 1.16, "e": 1.64}, {"t": "עלתה", "s": 1.64, "e": 2.18}]}, {"start": 2.18, "end": 3.84, "text": "לך שלוש נקודות.", "words": [{"t": "לך", "s": 2.18, "e": 2.46}, {"t": "שלוש", "s": 2.46, "e": 3.12}, {"t": "נקודות.", "s": 3.12, "e": 3.72}]}, {"start": 3.86, "end": 5.86, "text": "פרק של עשרים שאלות", "words": [{"t": "פרק", "s": 3.86, "e": 4.62}, {"t": "של", "s": 4.62, "e": 4.76}, {"t": "עשרים", "s": 4.76, "e": 5.04}, {"t": "שאלות", "s": 5.04, "e": 5.74}]}, {"start": 5.74, "end": 6.82, "text": "ב -20 דקות.", "words": [{"t": "ב", "s": 5.74, "e": 5.9}, {"t": "-20", "s": 5.9, "e": 6.28}, {"t": "דקות.", "s": 6.28, "e": 6.7}]}, {"start": 6.84, "end": 8.26, "text": "תקציב של דקה", "words": [{"t": "תקציב", "s": 6.84, "e": 7.6}, {"t": "של", "s": 7.6, "e": 7.72}, {"t": "דקה", "s": 7.72, "e": 8.14}]}, {"start": 8.14, "end": 9.64, "text": "אחת בממוצע לשאלה.", "words": [{"t": "אחת", "s": 8.14, "e": 8.5}, {"t": "בממוצע", "s": 8.5, "e": 9}, {"t": "לשאלה.", "s": 9, "e": 9.52}]}, {"start": 9.7, "end": 12.1, "text": "נתקעת עליה ארבע דקות.", "words": [{"t": "נתקעת", "s": 9.7, "e": 10.46}, {"t": "עליה", "s": 10.46, "e": 10.8}, {"t": "ארבע", "s": 10.8, "e": 11.5}, {"t": "דקות.", "s": 11.5, "e": 11.98}]}, {"start": 12.1, "end": 13.44, "text": "שלוש מהן כבר לא", "words": [{"t": "שלוש", "s": 12.1, "e": 12.78}, {"t": "מהן", "s": 12.78, "e": 13}, {"t": "כבר", "s": 13, "e": 13.22}, {"t": "לא", "s": 13.22, "e": 13.32}]}, {"start": 13.32, "end": 15.38, "text": "שלה, ובדקה לשאלה זה", "words": [{"t": "שלה,", "s": 13.32, "e": 13.64}, {"t": "ובדקה", "s": 13.66, "e": 14.48}, {"t": "לשאלה", "s": 14.48, "e": 15.02}, {"t": "זה", "s": 15.02, "e": 15.26}]}, {"start": 15.26, "end": 16.64, "text": "עוד שלוש שאלות.", "words": [{"t": "עוד", "s": 15.26, "e": 15.48}, {"t": "שלוש", "s": 15.48, "e": 15.92}, {"t": "שאלות.", "s": 15.92, "e": 16.52}]}, {"start": 16.58, "end": 18.14, "text": "וכל אחת שווה", "words": [{"t": "וכל", "s": 16.58, "e": 17.24}, {"t": "אחת", "s": 17.24, "e": 17.66}, {"t": "שווה", "s": 17.66, "e": 18.02}]}, {"start": 18.02, "end": 18.88, "text": "אותו ניקוד.", "words": [{"t": "אותו", "s": 18.02, "e": 18.26}, {"t": "ניקוד.", "s": 18.26, "e": 18.76}]}, {"start": 19, "end": 20.18, "text": "אין בונוס על", "words": [{"t": "אין", "s": 19, "e": 19.62}, {"t": "בונוס", "s": 19.62, "e": 19.98}, {"t": "על", "s": 19.98, "e": 20.06}]}, {"start": 20.06, "end": 20.76, "text": "שאלה קשה.", "words": [{"t": "שאלה", "s": 20.06, "e": 20.4}, {"t": "קשה.", "s": 20.4, "e": 20.64}]}, {"start": 20.78, "end": 22.42, "text": "לכן סמן את", "words": [{"t": "לכן", "s": 20.78, "e": 21.54}, {"t": "סמן", "s": 21.54, "e": 22.12}, {"t": "את", "s": 22.12, "e": 22.3}]}, {"start": 22.3, "end": 23.94, "text": "הקשה ודלג הלאה.", "words": [{"t": "הקשה", "s": 22.3, "e": 22.68}, {"t": "ודלג", "s": 22.68, "e": 23.44}, {"t": "הלאה.", "s": 23.44, "e": 23.82}]}, {"start": 23.92, "end": 25.58, "text": "אסוף קודם את הקלות.", "words": [{"t": "אסוף", "s": 23.92, "e": 24.54}, {"t": "קודם", "s": 24.54, "e": 24.94}, {"t": "את", "s": 24.94, "e": 25.06}, {"t": "הקלות.", "s": 25.06, "e": 25.46}]}, {"start": 25.56, "end": 26.98, "text": "חזור אליה רק", "words": [{"t": "חזור", "s": 25.56, "e": 26.22}, {"t": "אליה", "s": 26.22, "e": 26.44}, {"t": "רק", "s": 26.44, "e": 26.86}]}, {"start": 26.86, "end": 28.06, "text": "אם נשאר זמן.", "words": [{"t": "אם", "s": 26.86, "e": 27.16}, {"t": "נשאר", "s": 27.16, "e": 27.54}, {"t": "זמן.", "s": 27.54, "e": 27.94}]}, {"start": 28.06, "end": 29.5, "text": "כלל אצבע פשוט.", "words": [{"t": "כלל", "s": 28.06, "e": 28.7}, {"t": "אצבע", "s": 28.7, "e": 28.98}, {"t": "פשוט.", "s": 28.98, "e": 29.38}]}, {"start": 29.38, "end": 31.08, "text": "שאלה שלא נפתחת", "words": [{"t": "שאלה", "s": 29.38, "e": 30.16}, {"t": "שלא", "s": 30.16, "e": 30.5}, {"t": "נפתחת", "s": 30.5