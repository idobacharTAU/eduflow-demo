{"slug": "psym_leave_early_not_arrive_early", "duration": 39.8, "cues": [{"start": 0.0, "end": 1.282, "text": "יצאת מוקדם.", "words": [{"t": "יצאת", "s": 0.0, "e": 0.631}, {"t": "מוקדם.", "s": 0.631, "e": 1.282}]}, {"start": 1.282, "end": 3.787, "text": "ועדיין הגעת בדופק לחץ.", "words": [{"t": "ועדיין", "s": 1.282, "e": 2.307}, {"t": "הגעת", "s": 2.307, "e": 2.643}, {"t": "בדופק", "s": 2.643, "e": 3.274}, {"t": "לחץ.", "s": 3.274, "e": 3.787}]}, {"start": 3.885, "end": 6.489, "text": "נבחן ישן היטב, ארז", "words": [{"t": "נבחן", "s": 3.885, "e": 4.792}, {"t": "ישן", "s": 4.792, "e": 5.345}, {"t": "היטב,", "s": 5.345, "e": 5.798}, {"t": "ארז", "s": 5.956, "e": 6.489}]}, {"start": 6.489, "end": 8.244, "text": "תעודה, ויצא מוקדם.", "words": [{"t": "תעודה,", "s": 6.489, "e": 6.844}, {"t": "ויצא", "s": 7.021, "e": 7.751}, {"t": "מוקדם.", "s": 7.751, "e": 8.244}]}, {"start": 8.283, "end": 10.709, "text": "אבל לא ידע איפה המתחם.", "words": [{"t": "אבל", "s": 8.283, "e": 8.914}, {"t": "לא", "s": 8.914, "e": 9.427}, {"t": "ידע", "s": 9.427, "e": 9.802}, {"t": "איפה", "s": 9.802, "e": 10.196}, {"t": "המתחם.", "s": 10.196, "e": 10.709}]}, {"start": 10.847, "end": 13.135, "text": "וחיפש אותו עד הרגע האחרון.", "words": [{"t": "וחיפש", "s": 10.847, "e": 11.675}, {"t": "אותו", "s": 11.675, "e": 11.873}, {"t": "עד", "s": 11.873, "e": 12.326}, {"t": "הרגע", "s": 12.326, "e": 12.583}, {"t": "האחרון.", "s": 12.583, "e": 13.135}]}, {"start": 13.707, "end": 16.093, "text": "שינה, הגעה, נשימה.", "words": [{"t": "שינה,", "s": 13.707, "e": 14.16}, {"t": "הגעה,", "s": 14.377, "e": 15.225}, {"t": "נשימה.", "s": 15.304, "e": 16.093}]}, {"start": 16.527, "end": 17.631, "text": "איזה מהם נכשל?", "words": [{"t": "איזה", "s": 16.527, "e": 16.981}, {"t": "מהם", "s": 16.981, "e": 17.217}, {"t": "נכשל?", "s": 17.217, "e": 17.631}]}, {"start": 18.341, "end": 19.367, "text": "השינה בוצעה.", "words": [{"t": "השינה", "s": 18.341, "e": 18.795}, {"t": "בוצעה.", "s": 18.795, "e": 19.367}]}, {"start": 19.505, "end": 21.398, "text": "לנשימה עוד לא הגיע התור.", "words": [{"t": "לנשימה", "s": 19.505, "e": 20.412}, {"t": "עוד", "s": 20.412, "e": 20.649}, {"t": "לא", "s": 20.649, "e": 20.728}, {"t": "הגיע", "s": 20.728, "e": 21.142}, {"t": "התור.", "s": 21.142, "e": 21.398}]}, {"start": 21.635, "end": 24.337, "text": "הכשל הוא בהגעה המוקדמת.", "words": [{"t": "הכשל", "s": 21.635, "e": 22.542}, {"t": "הוא", "s": 22.542, "e": 22.799}, {"t": "בהגעה", "s": 22.799, "e": 23.568}, {"t": "המוקדמת.", "s": 23.568, "e": 24.337}]}, {"start": 24.574, "end": 26.782, "text": "העוגן הוא להגיע מוקדם,", "words": [{"t": "העוגן", "s": 24.574, "e": 25.461}, {"t": "הוא", "s": 25.461, "e": 25.599}, {"t": "להגיע", "s": 25.599, "e": 26.23}, {"t": "מוקדם,", "s": 26.23, "e": 26.782}]}, {"start": 26.782, "end": 28.123, "text": "לא לצאת מוקדם.", "words": [{"t": "לא", "s": 26.782, "e": 27.137}, {"t": "לצאת", "s": 27.137, "e": 27.591}, {"t": "מוקדם.", "s": 27.591, "e": 28.123}]}, {"start": 28.123, "end": 30.391, "text": "המרווח לפני הפרק הוא", "words": [{"t": "המרווח", "s": 28.123, "e": 29.169}, {"t": "לפני", "s": 29.169, "e": 29.642}, {"t": "הפרק", "s": 29.642, "e": 30.155}, {"t": "הוא", "s": 30.155, "e": 30.391}]}, {"start": 30.391, "end": 31.673, "text": "כל התכלית שלו.", "words": [{"t": "כל", "s": 30.391, "e": 30.766}, {"t": "התכלית", "s": 30.766, "e": 31.358}, {"t": "שלו.", "s": 31.358, "e": 31.673}]}, {"start": 32.147, "end": 34.218, "text": "יעד שלא נבדק מוחק", "words": [{"t": "יעד", "s": 32.147, "e": 32.62}, {"t": "שלא", "s": 32.62, "e": 33.014}, {"t": "נבדק", "s": 33.014, "e": 33.547}, {"t": "מוחק", "s": 33.547, "e": 34.218}]}, {"start": 34.218, "end": 34.987, "text": "את המרווח הזה.", "words": [{"t": "את", "s": 34.218, "e": 34.336}, {"t": "המרווח", "s": 34.336, "e": 34.849}, {"t": "הזה.", "s": 34.849, "e": 34.987}]}, {"start": 35.519, "end": 37.649, "text": "לכן בודקים כתובת ודרך", "words": [{"t": "לכן", "s": 35.519, "e": 35.993}, {"t": "בודקים", "s": 35.993, "e": 36.545}, {"t": "כתובת", "s": 36.545, "e": 37.018}, {"t": "ודרך", "s": 37.018, "e": 37.649}]}, {"start": 37.649, "end": 39.404, "text": "הגעה לפני היום עצמו.", "words": [{"t": "הגעה", "s": 37.649, "e": 38.024}, {"t": "לפני", "s": 38.024, "e": 38.714}, {"t": "היום", "s": 38.714, "e": 39.089}, {"t": "עצמו.", "s": 39.089, "e": 39.404}]}], "captions_default": "on", "text_load": {"mean_visible_words": 18.9, "threshold": 20.0}}
