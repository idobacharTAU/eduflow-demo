{"slug": "psym_pack_the_bag_the_night_before", "duration": 36.94, "cues": [{"start": 0, "end": 2.06, "text": "התיק נארז בערב,", "words": [{"t": "התיק", "s": 0, "e": 0.68}, {"t": "נארז", "s": 0.68, "e": 1.26}, {"t": "בערב,", "s": 1.26, "e": 1.94}]}, {"start": 2, "end": 3.08, "text": "לא בבוקר.", "words": [{"t": "לא", "s": 2, "e": 2.44}, {"t": "בבוקר.", "s": 2.44, "e": 2.96}]}, {"start": 2.98, "end": 4.9, "text": "בבוקר המבחן אין", "words": [{"t": "בבוקר", "s": 2.98, "e": 3.74}, {"t": "המבחן", "s": 3.74, "e": 4.22}, {"t": "אין", "s": 4.22, "e": 4.78}]}, {"start": 4.78, "end": 5.78, "text": "מרווח לחזור.", "words": [{"t": "מרווח", "s": 4.78, "e": 5.2}, {"t": "לחזור.", "s": 5.2, "e": 5.66}]}, {"start": 5.8, "end": 7.46, "text": "פריט שנשכח בבוקר", "words": [{"t": "פריט", "s": 5.8, "e": 6.32}, {"t": "שנשכח", "s": 6.32, "e": 6.84}, {"t": "בבוקר", "s": 6.84, "e": 7.34}]}, {"start": 7.34, "end": 8.62, "text": "עולה ביוקר.", "words": [{"t": "עולה", "s": 7.34, "e": 7.86}, {"t": "ביוקר.", "s": 7.86, "e": 8.5}]}, {"start": 8.54, "end": 10.46, "text": "בערב עוד אפשר לתקן.", "words": [{"t": "בערב", "s": 8.54, "e": 9.34}, {"t": "עוד", "s": 9.34, "e": 9.74}, {"t": "אפשר", "s": 9.74, "e": 9.94}, {"t": "לתקן.", "s": 9.94, "e": 10.34}]}, {"start": 10.44, "end": 12.18, "text": "ופריט אחד הוא", "words": [{"t": "ופריט", "s": 10.44, "e": 11.3}, {"t": "אחד", "s": 11.3, "e": 11.54}, {"t": "הוא", "s": 11.54, "e": 12.06}]}, {"start": 12.06, "end": 13.2, "text": "לא עוד פריט.", "words": [{"t": "לא", "s": 12.06, "e": 12.34}, {"t": "עוד", "s": 12.34, "e": 12.76}, {"t": "פריט.", "s": 12.76, "e": 13.08}]}, {"start": 13.59, "end": 15, "text": "תעודה מזהה היא", "words": [{"t": "תעודה", "s": 13.59, "e": 14.04}, {"t": "מזהה", "s": 14.04, "e": 14.62}, {"t": "היא", "s": 14.62, "e": 14.88}]}, {"start": 14.88, "end": 15.96, "text": "תנאי כניסה.", "words": [{"t": "תנאי", "s": 14.88, "e": 15.36}, {"t": "כניסה.", "s": 15.36, "e": 15.84}]}, {"start": 15.94, "end": 17.34, "text": "בלי תעודה בתוקף", "words": [{"t": "בלי", "s": 15.94, "e": 16.5}, {"t": "תעודה", "s": 16.5, "e": 16.78}, {"t": "בתוקף", "s": 16.78, "e": 17.22}]}, {"start": 17.22, "end": 18.3, "text": "אין כניסה.", "words": [{"t": "אין", "s": 17.22, "e": 17.78}, {"t": "כניסה.", "s": 17.78, "e": 18.18}]}, {"start": 18.3, "end": 19.9, "text": "זה הפריט היחיד", "words": [{"t": "זה", "s": 18.3, "e": 18.82}, {"t": "הפריט", "s": 18.82, "e": 19.2}, {"t": "היחיד", "s": 19.2, "e": 19.78}]}, {"start": 19.78, "end": 21.38, "text": "ברשימה שמסיים את", "words": [{"t": "ברשימה", "s": 19.78, "e": 20.26}, {"t": "שמסיים", "s": 20.26, "e": 21.08}, {"t": "את", "s": 21.08, "e": 21.26}]}, {"start": 21.26, "end": 22.88, "text": "היום לפני שהתחיל.", "words": [{"t": "היום", "s": 21.26, "e": 21.62}, {"t": "לפני", "s": 21.62, "e": 22.26}, {"t": "שהתחיל.", "s": 22.26, "e": 22.76}]}, {"start": 23.06, "end": 24.84, "text": "והבוקר כבר מוקצה.", "words": [{"t": "והבוקר", "s": 23.06, "e": 23.96}, {"t": "כבר", "s": 23.96, "e": 24.26}, {"t": "מוקצה.", "s": 24.26, "e": 24.72}]}, {"start": 24.88, "end": 26.32, "text": "הוא הולך להגעה,", "words": [{"t": "הוא", "s": 24.88, "e": 25.26}, {"t": "הולך", "s": 25.26, "e": 25.58}, {"t": "להגעה,", "s": 25.58, "e": 26.2}]}, {"start": 26.26, "end": 28.18, "text": "להזדהות ולנשימה.", "words": [{"t": "להזדהות", "s": 26.26, "e": 27.16}, {"t": "ולנשימה.", "s": 27.16, "e": 28.06}]}, {"start": 28.12, "end": 29.28, "text": "אז שואלים על", "words": [{"t": "אז", "s": 28.12, "e": 28.66}, {"t": "שואלים", "s": 28.66, "e": 29.06}, {"t": "על", "s": 29.06, "e": 29.16}]}, {"start": 29.16, "end": 30, "text": "כל פריט.", "words": [{"t": "כל", "s": 29.16, "e": 29.38}, {"t": "פריט.", "s": 29.38, "e": 29.88}]}, {"start": 30, "end": 31.48, "text": "אם חסר, יש", "words": [{"t": "אם", "s": 30, "e": 30.4}, {"t": "חסר,", "s": 30.4, "e": 30.88}, {"t": "יש", "s": 30.9, "e": 31.36}]}, {"start": 31.36, "end": 32.22, "text": "זמן לתקן?", "words": [{"t": "זמן", "s": 31.36, "e": 31.68}, {"t": "לתקן?", "s": 31.68, "e": 32.1}]}, {"start": 32.38, "end": 33.68, "text": "בערב, כן.", "words": [{"t": "בערב,", "s": 32.38, "e": 33.14}, {"t": "כן.", "s": 33.18, "e": 33.56}]}, {"start": 33.96, "end": 35.46, "text": "בבוקר, לא.", "words": [{"t": "בבוקר,", "s": 33.96, "e": 34.72}, {"t": "לא.", "s": 34.76, "e": 35.34}]}]}
