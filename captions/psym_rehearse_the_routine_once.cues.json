{"slug": "psym_rehearse_the_routine_once", "duration": 33.94, "cues": [{"start": 0.0, "end": 2.18, "text": "שגרה שמורצת לראשונה ביום", "words": [{"t": "שגרה", "s": 0.0, "e": 0.64}, {"t": "שמורצת", "s": 0.64, "e": 1.28}, {"t": "לראשונה", "s": 1.28, "e": 1.86}, {"t": "ביום", "s": 1.86, "e": 2.18}]}, {"start": 2.18, "end": 4.12, "text": "המבחן היא נוהל חדש.", "words": [{"t": "המבחן", "s": 2.18, "e": 2.64}, {"t": "היא", "s": 2.64, "e": 2.96}, {"t": "נוהל", "s": 2.96, "e": 3.48}, {"t": "חדש.", "s": 3.48, "e": 4.12}]}, {"start": 4.16, "end": 6.74, "text": "ונוהל כזה נלמד תחת לחץ.", "words": [{"t": "ונוהל", "s": 4.16, "e": 4.92}, {"t": "כזה", "s": 4.92, "e": 5.2}, {"t": "נלמד", "s": 5.2, "e": 5.8}, {"t": "תחת", "s": 5.8, "e": 6.16}, {"t": "לחץ.", "s": 6.16, "e": 6.74}]}, {"start": 6.78, "end": 9.36, "text": "לכן השגרה מורצת פעם אחת", "words": [{"t": "לכן", "s": 6.78, "e": 7.54}, {"t": "השגרה", "s": 7.54, "e": 8.08}, {"t": "מורצת", "s": 8.08, "e": 8.54}, {"t": "פעם", "s": 8.54, "e": 8.96}, {"t": "אחת", "s": 8.96, "e": 9.36}]}, {"start": 9.36, "end": 11.224, "text": "לפחות לפני היום עצמו.", "words": [{"t": "לפחות", "s": 9.36, "e": 9.98}, {"t": "לפני", "s": 9.98, "e": 10.62}, {"t": "היום", "s": 10.62, "e": 10.86}, {"t": "עצמו.", "s": 10.86, "e": 11.224}]}, {"start": 11.62, "end": 13.1, "text": "אחרי חזרה כזאת, היא", "words": [{"t": "אחרי", "s": 11.62, "e": 12.08}, {"t": "חזרה", "s": 12.08, "e": 12.36}, {"t": "כזאת,", "s": 12.36, "e": 12.74}, {"t": "היא", "s": 12.74, "e": 13.1}]}, {"start": 13.1, "end": 13.78, "text": "כבר לא חדשה.", "words": [{"t": "כבר", "s": 13.1, "e": 13.28}, {"t": "לא", "s": 13.28, "e": 13.36}, {"t": "חדשה.", "s": 13.36, "e": 13.78}]}, {"start": 13.82, "end": 16.736, "text": "והחזרה כוללת את שלושת הזמנים.", "words": [{"t": "והחזרה", "s": 13.82, "e": 14.84}, {"t": "כוללת", "s": 14.84, "e": 15.56}, {"t": "את", "s": 15.56, "e": 15.66}, {"t": "שלושת", "s": 15.66, "e": 16.22}, {"t": "הזמנים.", "s": 16.22, "e": 16.736}]}, {"start": 16.9, "end": 19.42, "text": "לילה שלפני, בוקר המבחן,", "words": [{"t": "לילה", "s": 16.9, "e": 17.62}, {"t": "שלפני,", "s": 17.62, "e": 18.08}, {"t": "בוקר", "s": 18.16, "e": 18.94}, {"t": "המבחן,", "s": 18.94, "e": 19.42}]}, {"start": 19.42, "end": 21.76, "text": "ורגע לפני כל פרק.", "words": [{"t": "ורגע", "s": 19.42, "e": 20.28}, {"t": "לפני", "s": 20.28, "e": 20.78}, {"t": "כל", "s": 20.78, "e": 21.1}, {"t": "פרק.", "s": 21.1, "e": 21.76}]}, {"start": 21.82, "end": 22.78, "text": "היא לא דורשת", "words": [{"t": "היא", "s": 21.82, "e": 22.28}, {"t": "לא", "s": 22.28, "e": 22.42}, {"t": "דורשת", "s": 22.42, "e": 22.78}]}, {"start": 22.78, "end": 23.88, "text": "שום נתון רשמי.", "words": [{"t": "שום", "s": 22.78, "e": 23.18}, {"t": "נתון", "s": 23.18, "e": 23.46}, {"t": "רשמי.", "s": 23.46, "e": 23.88}]}, {"start": 23.88, "end": 25.9, "text": "לא שעה מדויקת, ולא", "words": [{"t": "לא", "s": 23.88, "e": 24.42}, {"t": "שעה", "s": 24.42, "e": 24.76}, {"t": "מדויקת,", "s": 24.76, "e": 25.38}, {"t": "ולא", "s": 25.38, "e": 25.9}]}, {"start": 25.9, "end": 26.9, "text": "אורך של פרק.", "words": [{"t": "אורך", "s": 25.9, "e": 26.32}, {"t": "של", "s": 26.32, "e": 26.44}, {"t": "פרק.", "s": 26.44, "e": 26.9}]}, {"start": 26.9, "end": 28.74, "text": "וגם גבול ברור.", "words": [{"t": "וגם", "s": 26.9, "e": 27.74}, {"t": "גבול", "s": 27.74, "e": 28.26}, {"t": "ברור.", "s": 28.26, "e": 28.74}]}, {"start": 28.74, "end": 31.12, "text": "השגרה לא מוסיפה ידע.", "words": [{"t": "השגרה", "s": 28.74, "e": 29.8}, {"t": "לא", "s": 29.8, "e": 30.2}, {"t": "מוסיפה", "s": 30.2, "e": 30.76}, {"t": "ידע.", "s": 30.76, "e": 31.12}]}, {"start": 31.12, "end": 33.564, "text": "היא מגינה על היכולת הקיימת.", "words": [{"t": "היא", "s": 31.12, "e": 31.5}, {"t": "מגינה", "s": 31.5, "e": 32.08}, {"t": "על", "s": 32.08, "e": 32.42}, {"t": "היכולת", "s": 32.42, "e": 33.04}, {"t": "הקיימת.", "s": 33.04, "e": 33.564}]}], "captions_default": "on", "text_load": {"mean_visible_words": 17.0, "threshold": 20.0}}
