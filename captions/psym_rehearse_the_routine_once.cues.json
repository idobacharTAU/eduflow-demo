{"slug": "psym_rehearse_the_routine_once", "duration": 37.64, "cues": [{"start": 0, "end": 2.5, "text": "שגרה שמורצת לראשונה ביום", "words": [{"t": "שגרה", "s": 0, "e": 0.68}, {"t": "שמורצת", "s": 0.68, "e": 1.3}, {"t": "לראשונה", "s": 1.3, "e": 1.94}, {"t": "ביום", "s": 1.94, "e": 2.38}]}, {"start": 2.38, "end": 3.76, "text": "המבחן היא נוהל", "words": [{"t": "המבחן", "s": 2.38, "e": 2.88}, {"t": "היא", "s": 2.88, "e": 3.26}, {"t": "נוהל", "s": 3.26, "e": 3.64}]}, {"start": 3.64, "end": 5.58, "text": "חדש, ונוהל כזה", "words": [{"t": "חדש,", "s": 3.64, "e": 4.22}, {"t": "ונוהל", "s": 4.32, "e": 5.16}, {"t": "כזה", "s": 5.16, "e": 5.46}]}, {"start": 5.46, "end": 7.32, "text": "נלמד תחת לחץ.", "words": [{"t": "נלמד", "s": 5.46, "e": 6.18}, {"t": "תחת", "s": 6.18, "e": 6.58}, {"t": "לחץ.", "s": 6.58, "e": 7.2}]}, {"start": 7.3, "end": 9.42, "text": "לכן השגרה מורצת", "words": [{"t": "לכן", "s": 7.3, "e": 8.14}, {"t": "השגרה", "s": 8.14, "e": 8.84}, {"t": "מורצת", "s": 8.84, "e": 9.3}]}, {"start": 9.3, "end": 10.8, "text": "פעם אחת לפחות", "words": [{"t": "פעם", "s": 9.3, "e": 9.64}, {"t": "אחת", "s": 9.64, "e": 10.02}, {"t": "לפחות", "s": 10.02, "e": 10.68}]}, {"start": 10.68, "end": 12.18, "text": "לפני היום עצמו.", "words": [{"t": "לפני", "s": 10.68, "e": 11.4}, {"t": "היום", "s": 11.4, "e": 11.7}, {"t": "עצמו.", "s": 11.7, "e": 12.06}]}, {"start": 12.6, "end": 14.28, "text": "אחרי חזרה כזאת היא", "words": [{"t": "אחרי", "s": 12.6, "e": 13.02}, {"t": "חזרה", "s": 13.02, "e": 13.34}, {"t": "כזאת", "s": 13.34, "e": 13.74}, {"t": "היא", "s": 13.74, "e": 14.16}]}, {"start": 14.16, "end": 16.38, "text": "כבר לא חדשה, והחזרה", "words": [{"t": "כבר", "s": 14.16, "e": 14.48}, {"t": "לא", "s": 14.48, "e": 14.66}, {"t": "חדשה,", "s": 14.66, "e": 14.98}, {"t": "והחזרה", "s": 15.2, "e": 16.26}]}, {"start": 16.26, "end": 18.34, "text": "כוללת את שלושת הזמנים.", "words": [{"t": "כוללת", "s": 16.26, "e": 16.88}, {"t": "את", "s": 16.88, "e": 17}, {"t": "שלושת", "s": 17, "e": 17.66}, {"t": "הזמנים.", "s": 17.66, "e": 18.22}]}, {"start": 18.68, "end": 21.16, "text": "לילה שלפני, בוקר המבחן,", "words": [{"t": "לילה", "s": 18.68, "e": 19.1}, {"t": "שלפני,", "s": 19.1, "e": 19.58}, {"t": "בוקר", "s": 19.68, "e": 20.5}, {"t": "המבחן,", "s": 20.5, "e": 21.04}]}, {"start": 21.06, "end": 23.48, "text": "ורגע לפני כל פרק.", "words": [{"t": "ורגע", "s": 21.06, "e": 22.02}, {"t": "לפני", "s": 22.02, "e": 22.42}, {"t": "כל", "s": 22.42, "e": 22.7}, {"t": "פרק.", "s": 22.7, "e": 23.36}]}, {"start": 23.46, "end": 25.14, "text": "היא לא דורשת שום", "words": [{"t": "היא", "s": 23.46, "e": 24.04}, {"t": "לא", "s": 24.04, "e": 24.22}, {"t": "דורשת", "s": 24.22, "e": 24.6}, {"t": "שום", "s": 24.6, "e": 25.02}]}, {"start": 25.02, "end": 26.46, "text": "נתון רשמי, לא", "words": [{"t": "נתון", "s": 25.02, "e": 25.32}, {"t": "רשמי,", "s": 25.32, "e": 25.72}, {"t": "לא", "s": 25.8, "e": 26.34}]}, {"start": 26.34, "end": 27.96, "text": "שעה מדויקת ולא", "words": [{"t": "שעה", "s": 26.34, "e": 26.76}, {"t": "מדויקת", "s": 26.76, "e": 27.42}, {"t": "ולא", "s": 27.42, "e": 27.84}]}, {"start": 27.84, "end": 28.98, "text": "אורך של פרק.", "words": [{"t": "אורך", "s": 27.84, "e": 28.26}, {"t": "של", "s": 28.26, "e": 28.38}, {"t": "פרק.", "s": 28.38, "e": 28.86}]}, {"start": 28.86, "end": 30.72, "text": "וגם גבול ברור.", "words": [{"t": "וגם", "s": 28.86, "e": 29.66}, {"t": "גבול", "s": 29.66, "e": 30.16}, {"t": "ברור.", "s": 30.16, "e": 30.6}]}, {"start": 30.8, "end": 33.22, "text": "השגרה לא מוסיפה ידע.", "words": [{"t": "השגרה", "s": 30.8, "e": 31.66}, {"t": "לא", "s": 31.66, "e": 32.06}, {"t": "מוסיפה", "s": 32.06, "e": 32.68}, {"t": "ידע.", "s": 32.68, "e": 33.1}]}, {"start": 33.1, "end": 35.2, "text": "היא מגינה על היכולת", "words": [{"t": "היא", "s": 33.1, "e": 33.54}, {"t": "מגינה", "s": 33.54, "e": 34.12}, {"t": "על", "s": 34.12, "e": 34.46}, {"t": "היכולת", "s": 34.46, "e": 35.08}]}, {"start": 35.08, "end": 36.16, "text": "שכבר יש לך.", "words": [{"t": "שכבר", "s": 35.08, "e": 35.5}, {"t": "יש", "s": 35.5, "e": 35.74}, {"t": "לך.", "s": 35.74, "e": 36.04}]}]}
