{"slug": "psym_tim2_breaks_a_stage", "duration": 35.66, "cues": [{"start": 0, "end": 1.56, "text": "דילגת בלי לסמן.", "words": [{"t": "דילגת", "s": 0, "e": 0.7}, {"t": "בלי", "s": 0.7, "e": 1.06}, {"t": "לסמן.", "s": 1.06, "e": 1.44}]}, {"start": 1.6, "end": 3.18, "text": "מה בדיוק נשבר?", "words": [{"t": "מה", "s": 1.6, "e": 2.3}, {"t": "בדיוק", "s": 2.3, "e": 2.74}, {"t": "נשבר?", "s": 2.74, "e": 3.06}]}, {"start": 3.24, "end": 4.84, "text": "הדקה שכבר עברה", "words": [{"t": "הדקה", "s": 3.24, "e": 3.98}, {"t": "שכבר", "s": 3.98, "e": 4.36}, {"t": "עברה", "s": 4.36, "e": 4.72}]}, {"start": 4.72, "end": 5.98, "text": "היא אבודה גם", "words": [{"t": "היא", "s": 4.72, "e": 5.24}, {"t": "אבודה", "s": 5.24, "e": 5.56}, {"t": "גם", "s": 5.56, "e": 5.86}]}, {"start": 5.86, "end": 6.84, "text": "אם היית מסמן.", "words": [{"t": "אם", "s": 5.86, "e": 6.08}, {"t": "היית", "s": 6.08, "e": 6.28}, {"t": "מסמן.", "s": 6.28, "e": 6.72}]}, {"start": 7.02, "end": 9.58, "text": "שכחת אילו מסיחים פסלת?", "words": [{"t": "שכחת", "s": 7.02, "e": 7.84}, {"t": "אילו", "s": 7.84, "e": 8.28}, {"t": "מסיחים", "s": 8.28, "e": 8.84}, {"t": "פסלת?", "s": 8.84, "e": 9.46}]}, {"start": 9.76, "end": 11.56, "text": "זו אבידה אמיתית.", "words": [{"t": "זו", "s": 9.76, "e": 10.58}, {"t": "אבידה", "s": 10.58, "e": 10.98}, {"t": "אמיתית.", "s": 10.98, "e": 11.44}]}, {"start": 11.54, "end": 12.94, "text": "אבל היא נשארת", "words": [{"t": "אבל", "s": 11.54, "e": 12.14}, {"t": "היא", "s": 12.14, "e": 12.3}, {"t": "נשארת", "s": 12.3, "e": 12.82}]}, {"start": 12.82, "end": 13.98, "text": "בתוך שאלה אחת.", "words": [{"t": "בתוך", "s": 12.82, "e": 13.14}, {"t": "שאלה", "s": 13.14, "e": 13.5}, {"t": "אחת.", "s": 13.5, "e": 13.86}]}, {"start": 14.18, "end": 16.48, "text": "השיטה בנויה מסבב איסוף", "words": [{"t": "השיטה", "s": 14.18, "e": 15}, {"t": "בנויה", "s": 15, "e": 15.32}, {"t": "מסבב", "s": 15.32, "e": 15.94}, {"t": "איסוף", "s": 15.94, "e": 16.36}]}, {"start": 16.36, "end": 18.5, "text": "ואחריו סבב חזרה.", "words": [{"t": "ואחריו", "s": 16.36, "e": 17.38}, {"t": "סבב", "s": 17.38, "e": 18.06}, {"t": "חזרה.", "s": 18.06, "e": 18.38}]}, {"start": 19.05, "end": 21.36, "text": "בלי רשימה סבב החזרה", "words": [{"t": "בלי", "s": 19.05, "e": 19.46}, {"t": "רשימה", "s": 19.46, "e": 19.94}, {"t": "סבב", "s": 19.94, "e": 20.82}, {"t": "החזרה", "s": 20.82, "e": 21.24}]}, {"start": 21.24, "end": 22.5, "text": "פשוט לא קיים.", "words": [{"t": "פשוט", "s": 21.24, "e": 21.6}, {"t": "לא", "s": 21.6, "e": 21.88}, {"t": "קיים.", "s": 21.88, "e": 22.38}]}, {"start": 23.05, "end": 24.4, "text": "הזמן שנשאר הולך", "words": [{"t": "הזמן", "s": 23.05, "e": 23.46}, {"t": "שנשאר", "s": 23.46, "e": 23.96}, {"t": "הולך", "s": 23.96, "e": 24.28}]}, {"start": 24.28, "end": 26.3, "text": "לחיפוש, לא לפתרון.", "words": [{"t": "לחיפוש,", "s": 24.28, "e": 24.96}, {"t": "לא", "s": 25.06, "e": 25.5}, {"t": "לפתרון.", "s": 25.5, "e": 26.18}]}, {"start": 26.18, "end": 28.12, "text": "אז שואלים, זה", "words": [{"t": "אז", "s": 26.18, "e": 26.98}, {"t": "שואלים,", "s": 26.98, "e": 27.4}, {"t": "זה", "s": 27.48, "e": 28}]}, {"start": 28, "end": 29.7, "text": "מייקר שאלה אחת", "words": [{"t": "מייקר", "s": 28, "e": 28.72}, {"t": "שאלה", "s": 28.72, "e": 29.1}, {"t": "אחת", "s": 29.1, "e": 29.58}]}, {"start": 29.58, "end": 31.3, "text": "או מבטל שלב?", "words": [{"t": "או", "s": 29.58, "e": 29.96}, {"t": "מבטל", "s": 29.96, "e": 30.76}, {"t": "שלב?", "s": 30.76, "e": 31.18}]}, {"start": 31.68, "end": 33.42, "text": "רק ביטול שלב", "words": [{"t": "רק", "s": 31.68, "e": 32.12}, {"t": "ביטול", "s": 32.12, "e": 32.76}, {"t": "שלב", "s": 32.76, "e": 33.3}]}, {"start": 33.3, "end": 34.18, "text": "הוא שבירה.", "words": [{"t": "הוא", "s": 33.3, "e": 33.62}, {"t": "שבירה.", "s": 33.62, "e": 34.06}]}]}
