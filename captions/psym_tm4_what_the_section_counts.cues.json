{"slug": "psym_tm4_what_the_section_counts", "duration": 37.74, "cues": [{"start": 0, "end": 1.52, "text": "מה הפרק סופר?", "words": [{"t": "מה", "s": 0, "e": 0.42}, {"t": "הפרק", "s": 0.42, "e": 0.86}, {"t": "סופר?", "s": 0.86, "e": 1.4}]}, {"start": 1.44, "end": 4.06, "text": "לא כמה התאמצת, ולא", "words": [{"t": "לא", "s": 1.44, "e": 2.12}, {"t": "כמה", "s": 2.12, "e": 2.56}, {"t": "התאמצת,", "s": 2.56, "e": 3.26}, {"t": "ולא", "s": 3.38, "e": 3.94}]}, {"start": 3.94, "end": 5.78, "text": "כמה קשות היו השאלות.", "words": [{"t": "כמה", "s": 3.94, "e": 4.3}, {"t": "קשות", "s": 4.3, "e": 4.72}, {"t": "היו", "s": 4.72, "e": 5.04}, {"t": "השאלות.", "s": 5.04, "e": 5.66}]}, {"start": 5.86, "end": 8.12, "text": "הפרק בעל זמן קצוב,", "words": [{"t": "הפרק", "s": 5.86, "e": 6.78}, {"t": "בעל", "s": 6.78, "e": 7.02}, {"t": "זמן", "s": 7.02, "e": 7.46}, {"t": "קצוב,", "s": 7.46, "e": 8}]}, {"start": 8.12, "end": 9.52, "text": "וכל שאלה בו", "words": [{"t": "וכל", "s": 8.12, "e": 8.8}, {"t": "שאלה", "s": 8.8, "e": 9.26}, {"t": "בו", "s": 9.26, "e": 9.4}]}, {"start": 9.4, "end": 10.88, "text": "שווה אותו ניקוד.", "words": [{"t": "שווה", "s": 9.4, "e": 9.86}, {"t": "אותו", "s": 9.86, "e": 10.1}, {"t": "ניקוד.", "s": 10.1, "e": 10.76}]}, {"start": 10.8, "end": 12.16, "text": "אין בונוס על", "words": [{"t": "אין", "s": 10.8, "e": 11.44}, {"t": "בונוס", "s": 11.44, "e": 11.92}, {"t": "על", "s": 11.92, "e": 12.04}]}, {"start": 12.04, "end": 12.82, "text": "שאלה קשה.", "words": [{"t": "שאלה", "s": 12.04, "e": 12.4}, {"t": "קשה.", "s": 12.4, "e": 12.7}]}, {"start": 13.32, "end": 16.12, "text": "ודלג וחזור אינה שאלה", "words": [{"t": "ודלג", "s": 13.32, "e": 14.24}, {"t": "וחזור", "s": 14.24, "e": 14.9}, {"t": "אינה", "s": 14.9, "e": 15.52}, {"t": "שאלה", "s": 15.52, "e": 16}]}, {"start": 16, "end": 17.26, "text": "עם תשובה אחת.", "words": [{"t": "עם", "s": 16, "e": 16.12}, {"t": "תשובה", "s": 16.12, "e": 16.58}, {"t": "אחת.", "s": 16.58, "e": 17.14}]}, {"start": 17.18, "end": 19.8, 