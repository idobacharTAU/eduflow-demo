{"slug": "psym_tm4_what_the_section_counts", "duration": 33.82, "cues": [{"start": 0.0, "end": 1.46, "text": "מה הפרק סופר?", "words": [{"t": "מה", "s": 0.0, "e": 0.42}, {"t": "הפרק", "s": 0.42, "e": 0.88}, {"t": "סופר?", "s": 0.88, "e": 1.46}]}, {"start": 1.5, "end": 3.16, "text": "לא כמה התאמצנו.", "words": [{"t": "לא", "s": 1.5, "e": 2.12}, {"t": "כמה", "s": 2.12, "e": 2.52}, {"t": "התאמצנו.", "s": 2.52, "e": 3.16}]}, {"start": 3.22, "end": 5.44, "text": "ולא כמה קשות היו השאלות.", "words": [{"t": "ולא", "s": 3.22, "e": 3.84}, {"t": "כמה", "s": 3.84, "e": 4.16}, {"t": "קשות", "s": 4.16, "e": 4.54}, {"t": "היו", "s": 4.54, "e": 4.86}, {"t": "השאלות.", "s": 4.86, "e": 5.44}]}, {"start": 5.74, "end": 7.76, "text": "הפרק בעל זמן קצוב.", "words": [{"t": "הפרק", "s": 5.74, "e": 6.58}, {"t": "בעל", "s": 6.58, "e": 6.84}, {"t": "זמן", "s": 6.84, "e": 7.26}, {"t": "קצוב.", "s": 7.26, "e": 7.76}]}, {"start": 7.88, "end": 9.1, "text": "וכל שאלה בו", "words": [{"t": "וכל", "s": 7.88, "e": 8.52}, {"t": "שאלה", "s": 8.52, "e": 9.0}, {"t": "בו", "s": 9.0, "e": 9.1}]}, {"start": 9.1, "end": 10.34, "text": "שווה אותו ניקוד.", "words": [{"t": "שווה", "s": 9.1, "e": 9.48}, {"t": "אותו", "s": 9.48, "e": 9.78}, {"t": "ניקוד.", "s": 9.78, "e": 10.34}]}, {"start": 10.42, "end": 12.1, "text": "אין בונוס על שאלה קשה.", "words": [{"t": "אין", "s": 10.42, "e": 11.08}, {"t": "בונוס", "s": 11.08, "e": 11.42}, {"t": "על", "s": 11.42, "e": 11.52}, {"t": "שאלה", "s": 11.52, "e": 11.86}, {"t": "קשה.", "s": 11.86, "e": 12.1}]}, {"start": 12.48, "end": 14.86, "text": "ודלג וחזור אינה שאלה", "words": [{"t": "ודלג", "s": 12.48, "e": 13.32}, {"t": "וחזור", "s": 13.32, "e": 13.86}, {"t": "אינה", "s": 13.86, "e": 14.4}, {"t": "שאלה", "s": 14.4, "e": 14.86}]}, {"start": 14.86, "end": 15.72, "text": "עם תשובה אחת.", "words": [{"t": "עם", "s": 14.86, "e": 14.94}, {"t": "תשובה", "s": 14.94, "e": 15.3}, {"t": "אחת.", "s": 15.3, "e": 15.72}]}, {"start": 15.76, "end": 18.06, "text": "זו אסטרטגיה לניהול זמן.", "words": [{"t": "זו", "s": 15.76, "e": 16.32}, {"t": "אסטרטגיה", "s": 16.32, "e": 17.14}, {"t": "לניהול", "s": 17.14, "e": 17.62}, {"t": "זמן.", "s": 17.62, "e": 18.06}]}, {"start": 18.12, "end": 19.94, "text": "והיא נמדדת בדבר אחד.", "words": [{"t": "והיא", "s": 18.12, "e": 18.76}, {"t": "נמדדת", "s": 18.76, "e": 19.24}, {"t": "בדבר", "s": 19.24, "e": 19.66}, {"t": "אחד.", "s": 19.66, "e": 19.94}]}, {"start": 20.16, "end": 22.76, "text": "כמה נקודות נאספו בזמן הנתון.", "words": [{"t": "כמה", "s": 20.16, "e": 20.9}, {"t": "נקודות", "s": 20.9, "e": 21.44}, {"t": "נאספו", "s": 21.44, "e": 21.94}, {"t": "בזמן", "s": 21.94, "e": 22.4}, {"t": "הנתון.", "s": 22.4, "e": 22.76}]}, {"start": 23.3, "end": 24.76, "text": "שאלה שנתקעים עליה", "words": [{"t": "שאלה", "s": 23.3, "e": 23.94}, {"t": "שנתקעים", "s": 23.94, "e": 24.48}, {"t": "עליה", "s": 24.48, "e": 24.76}]}, {"start": 24.76, "end": 26.2, "text": "היא מלכודת זמן.", "words": [{"t": "היא", "s": 24.76, "e": 25.12}, {"t": "מלכודת", "s": 25.12, "e": 25.76}, {"t": "זמן.", "s": 25.76, "e": 26.2}]}, {"start": 26.2, "end": 27.94, "text": "היא יכולה לעלות בשאלות", "words": [{"t": "היא", "s": 26.2, "e": 26.74}, {"t": "יכולה", "s": 26.74, "e": 27.12}, {"t": "לעלות", "s": 27.12, "e": 27.48}, {"t": "בשאלות", "s": 27.48, "e": 27.94}]}, {"start": 27.94, "end": 29.38, "text": "קלות שלא הגענו אליהן.", "words": [{"t": "קלות", "s": 27.94, "e": 28.3}, {"t": "שלא", "s": 28.3, "e": 28.64}, {"t": "הגענו", "s": 28.64, "e": 29.02}, {"t": "אליהן.", "s": 29.02, "e": 29.38}]}, {"start": 29.4, "end": 32.1, "text": "אז מסמנים, מדלגים, וחוזרים", "words": [{"t": "אז", "s": 29.4, "e": 29.9}, {"t": "מסמנים,", "s": 29.9, "e": 30.46}, {"t": "מדלגים,", "s": 30.48, "e": 31.22}, {"t": "וחוזרים", "s": 31.22, "e": 32.1}]}, {"start": 32.1, "end": 33.42, "text": "רק אם נשאר זמן.", "words": [{"t": "רק", "s": 32.1, "e": 32.52}, {"t": "אם", "s": 32.52, "e": 32.76}, {"t": "נשאר", "s": 32.76, "e": 33.16}, {"t": "זמן.", "s": 33.16, "e": 33.42}]}]}
