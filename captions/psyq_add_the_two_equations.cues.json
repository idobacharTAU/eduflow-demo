{"slug": "psyq_add_the_two_equations", "duration": 37.36, "cues": [{"start": 0.0, "end": 2.2, "text": "איקס ועוד איגרק שווים עשר.", "words": [{"t": "איקס", "s": 0.0, "e": 0.42}, {"t": "ועוד", "s": 0.42, "e": 0.88}, {"t": "איגרק", "s": 0.88, "e": 1.02}, {"t": "שווים", "s": 1.02, "e": 1.82}, {"t": "עשר.", "s": 1.82, "e": 2.2}]}, {"start": 2.52, "end": 4.64, "text": "איקס פחות איגרק שווים ארבע.", "words": [{"t": "איקס", "s": 2.52, "e": 3.04}, {"t": "פחות", "s": 3.04, "e": 3.56}, {"t": "איגרק", "s": 3.56, "e": 3.7}, {"t": "שווים", "s": 3.7, "e": 4.48}, {"t": "ארבע.", "s": 4.48, "e": 4.64}]}, {"start": 4.98, "end": 6.08, "text": "מהי המכפלה?", "words": [{"t": "מהי", "s": 4.98, "e": 5.54}, {"t": "המכפלה?", "s": 5.54, "e": 6.08}]}, {"start": 6.22, "end": 8.3, "text": "איך מגיעים לשם בלי להסתבך?", "words": [{"t": "איך", "s": 6.22, "e": 6.76}, {"t": "מגיעים", "s": 6.76, "e": 7.1}, {"t": "לשם", "s": 7.1, "e": 7.44}, {"t": "בלי", "s": 7.44, "e": 7.76}, {"t": "להסתבך?", "s": 7.76, "e": 8.3}]}, {"start": 8.7, "end": 10.68, "text": "מקדמי איגרק כאן נגדיים.", "words": [{"t": "מקדמי", "s": 8.7, "e": 9.48}, {"t": "איגרק", "s": 9.48, "e": 9.72}, {"t": "כאן", "s": 9.72, "e": 10.1}, {"t": "נגדיים.", "s": 10.1, "e": 10.68}]}, {"start": 10.92, "end": 12.88, "text": "אז מחברים את שתי המשוואות.", "words": [{"t": "אז", "s": 10.92, "e": 11.36}, {"t": "מחברים", "s": 11.36, "e": 11.8}, {"t": "את", "s": 11.8, "e": 11.98}, {"t": "שתי", "s": 11.98, "e": 12.28}, {"t": "המשוואות.", "s": 12.28, "e": 12.88}]}, {"start": 12.94, "end": 15.24, "text": "איגרק מתבטל בשורה אחת.", "words": [{"t": "איגרק", "s": 12.94, "e": 13.4}, {"t": "מתבטל", "s": 13.4, "e": 14.2}, {"t": "בשורה", "s": 14.2, "e": 14.64}, {"t": "אחת.", "s": 14.64, "e": 15.24}]}, {"start": 15.28, "end": 16.84, "text": "נשאר פעמיים איקס,", "words": [{"t": "נשאר", "s": 15.28, "e": 15.98}, {"t": "פעמיים", "s": 15.98, "e": 16.46}, {"t": "איקס,", "s": 16.46, "e": 16.84}]}, {"start": 16.84, "end": 17.86, "text": "שהם ארבע עשרה.", "words": [{"t": "שהם", "s": 16.84, "e": 17.52}, {"t": "ארבע", "s": 17.52, "e": 17.69}, {"t": "עשרה.", "s": 17.69, "e": 17.86}]}, {"start": 18.2, "end": 20.32, "text": "כלומר איקס שווה שבע.", "words": [{"t": "כלומר", "s": 18.2, "e": 18.88}, {"t": "איקס", "s": 18.94, "e": 19.18}, {"t": "שווה", "s": 19.18, "e": 19.94}, {"t": "שבע.", "s": 19.94, "e": 20.32}]}, {"start": 20.8, "end": 22.86, "text": "ומהראשונה איגרק שווה שלוש.", "words": [{"t": "ומהראשונה", "s": 20.8, "e": 21.6}, {"t": "איגרק", "s": 21.64, "e": 21.98}, {"t": "שווה", "s": 21.98, "e": 22.66}, {"t": "שלוש.", "s": 22.66, "e": 22.86}]}, {"start": 23.32, "end": 25.2, "text": "פעמיים איקס הוא שלב", "words": [{"t": "פעמיים", "s": 23.32, "e": 24.12}, {"t": "איקס", "s": 24.12, "e": 24.48}, {"t": "הוא", "s": 24.48, "e": 24.74}, {"t": "שלב", "s": 24.74, "e": 25.2}]}, {"start": 25.2, "end": 26.64, "text": "ביניים, לא תשובה.", "words": [{"t": "ביניים,", "s": 25.2, "e": 25.84}, {"t": "לא", "s": 25.84, "e": 26.2}, {"t": "תשובה.", "s": 26.2, "e": 26.64}]}, {"start": 26.76, "end": 29.62, "text": "הצב בשתי המשוואות, לא באחת.", "words": [{"t": "הצב", "s": 26.76, "e": 27.48}, {"t": "בשתי", "s": 27.48, "e": 27.98}, {"t": "המשוואות,", "s": 27.98, "e": 28.68}, {"t": "לא", "s": 28.68, "e": 29.02}, {"t": "באחת.", "s": 29.02, "e": 29.62}]}, {"start": 29.62, "end": 31.0, "text": "שתיהן מתקיימות.", "words": [{"t": "שתיהן", "s": 29.62, "e": 30.42}, {"t": "מתקיימות.", "s": 30.42, "e": 31.0}]}, {"start": 31.02, "end": 32.72, "text": "המכפלה היא עשרים ואחת.", "words": [{"t": "המכפלה", "s": 31.02, "e": 31.98}, {"t": "היא", "s": 31.98, "e": 32.28}, {"t": "עשרים", "s": 32.28, "e": 32.5}, {"t": "ואחת.", "s": 32.5, "e": 32.72}]}, {"start": 33.38, "end": 34.56, "text": "מקדמים נגדיים?", "words": [{"t": "מקדמים", "s": 33.38, "e": 34.2}, {"t": "נגדיים?", "s": 34.2, "e": 34.56}]}, {"start": 34.74, "end": 36.96, "text": "חבר, ואז בדוק בשתיים.", "words": [{"t": "חבר,", "s": 34.74, "e": 35.48}, {"t": "ואז", "s": 35.48, "e": 36.22}, {"t": "בדוק", "s": 36.22, "e": 36.74}, {"t": "בשתיים.", "s": 36.74, "e": 36.96}]}], "captions_default": "on", "text_load": {"mean_visible_words": 1.5, "threshold": 20.0}}
