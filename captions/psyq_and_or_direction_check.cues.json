{"slug": "psyq_and_or_direction_check", "duration": 43.68, "cues": [{"start": 0, "end": 1.84, "text": "יש מסיחים שנפסלים", "words": [{"t": "יש", "s": 0, "e": 0.46}, {"t": "מסיחים", "s": 0.46, "e": 1.04}, {"t": "שנפסלים", "s": 1.04, "e": 1.72}]}, {"start": 1.72, "end": 2.86, "text": "בלי חישוב.", "words": [{"t": "בלי", "s": 1.72, "e": 2.24}, {"t": "חישוב.", "s": 2.24, "e": 2.74}]}, {"start": 2.8, "end": 5.72, "text": "הסתברות של וגם לעולם", "words": [{"t": "הסתברות", "s": 2.8, "e": 3.68}, {"t": "של", "s": 3.68, "e": 3.86}, {"t": "וגם", "s": 3.86, "e": 4.54}, {"t": "לעולם", "s": 4.54, "e": 5.6}]}, {"start": 5.6, "end": 7.3, "text": "אינה גדולה מאף רכיב,", "words": [{"t": "אינה", "s": 5.6, "e": 5.86}, {"t": "גדולה", "s": 5.86, "e": 6.26}, {"t": "מאף", "s": 6.26, "e": 6.76}, {"t": "רכיב,", "s": 6.76, "e": 7.18}]}, {"start": 7.3, "end": 9.58, "text": "ושל או לעולם אינה", "words": [{"t": "ושל", "s": 7.3, "e": 8.02}, {"t": "או", "s": 8.02, "e": 8.36}, {"t": "לעולם", "s": 8.36, "e": 9.26}, {"t": "אינה", "s": 9.26, "e": 9.46}]}, {"start": 9.46, "end": 11, "text": "קטנה מאף רכיב.", "words": [{"t": "קטנה", "s": 9.46, "e": 9.98}, {"t": "מאף", "s": 9.98, "e": 10.42}, {"t": "רכיב.", "s": 10.42, "e": 10.88}]}, {"start": 11.43, "end": 12.42, "text": "קובייה אחת.", "words": [{"t": "קובייה", "s": 11.43, "e": 11.88}, {"t": "אחת.", "s": 11.88, "e": 12.3}]}, {"start": 12.36, "end": 14.68, "text": "זוגי או גדול מארבע?", "words": [{"t": "זוגי", "s": 12.36, "e": 13.26}, {"t": "או", "s": 13.26, "e": 13.62}, {"t": "גדול", "s": 13.62, "e": 14.18}, {"t": "מארבע?", "s": 14.18, "e": 14.56}]}, {"start": 14.8, "end": 17.42, "text": "הרכיבים הם חצי ושליש.", "words": [{"t": "הרכיבים", "s": 14.8, "e": 15.7}, {"t": "הם", "s": 15.7, "e": 15.86}, {"t": "חצי", "s": 15.86, "e": 16.6}, {"t": "ושליש.", "s": 16.6, "e": 17.3}]}, {"start": 17.83, "end": 19.68, "text": "המסיח שישית קטן", "words": [{"t": "המסיח", "s": 17.83, "e": 18.28}, {"t": "שישית", "s": 18.28, "e": 18.94}, {"t": "קטן", "s": 18.94, "e": 19.56}]}, {"start": 19.56, "end": 21.84, "text": "משניהם, ולכן נפסל.", "words": [{"t": "משניהם,", "s": 19.56, "e": 20.24}, {"t": "ולכן", "s": 20.24, "e": 20.98}, {"t": "נפסל.", "s": 20.98, "e": 21.72}]}, {"start": 21.97, "end": 23.34, "text": "זו התשובה של וגם.", "words": [{"t": "זו", "s": 21.97, "e": 22.42}, {"t": "התשובה", "s": 22.42, "e": 22.78}, {"t": "של", "s": 22.78, "e": 22.88}, {"t": "וגם.", "s": 22.88, "e": 23.22}]}, {"start": 23.87, "end": 24.44, "text": "כד:", "words": [{"t": "כד:", "s": 23.87, "e": 24.32}]}, {"start": 24.81, "end": 26.92, "text": "שלושה אדומים ושניים כחולים.", "words": [{"t": "שלושה", "s": 24.81, "e": 25.26}, {"t": "אדומים", "s": 25.26, "e": 25.7}, {"t": "ושניים", "s": 25.7, "e": 26.36}, {"t": "כחולים.", "s": 26.36, "e": 26.8}]}, {"start": 27.27, "end": 29.04, "text": "שני אדומים בלי החזרה?", "words": [{"t": "שני", "s": 27.27, "e": 27.72}, {"t": "אדומים", "s": 27.72, "e": 28.16}, {"t": "בלי", "s": 28.16, "e": 28.58}, {"t": "החזרה?", "s": 28.58, "e": 28.92}]}, {"start": 28.92, "end": 32.14, "text": "השליפה הפותחת שלוש חמישיות.", "words": [{"t": "השליפה", "s": 28.92, "e": 30.12}, {"t": "הפותחת", "s": 30.12, "e": 30.72}, {"t": "שלוש", "s": 30.72, "e": 31.5}, {"t": "חמישיות.", "s": 31.5, "e": 32.02}]}, {"start": 32.22, "end": 34.68, "text": "השנייה אינה ודאית, אז", "words": [{"t": "השנייה", "s": 32.22, "e": 33.22}, {"t": "אינה", "s": 33.22, "e": 33.74}, {"t": "ודאית,", "s": 33.74, "e": 34.18}, {"t": "אז", "s": 34.26, "e": 34.56}]}, {"start": 34.56, "end": 36.34, "text": "התוצאה קטנה ממנה.", "words": [{"t": "התוצאה", "s": 34.56, "e": 35.14}, {"t": "קטנה", "s": 35.14, "e": 35.74}, {"t": "ממנה.", "s": 35.74, "e": 36.22}]}, {"start": 36.68, "end": 38.3, "text": "לכן שלוש חמישיות", "words": [{"t": "לכן", "s": 36.68, "e": 37.18}, {"t": "שלוש", "s": 37.18, "e": 37.66}, {"t": "חמישיות", "s": 37.66, "e": 38.18}]}, {"start": 38.18, "end": 39.32, "text": "נפסל מיד.", "words": [{"t": "נפסל", "s": 38.18, "e": 38.94}, {"t": "מיד.", "s": 38.94, "e": 39.2}]}, {"