{"slug": "psyq_at_least_never_below_exactly", "duration": 42.5, "cues": [{"start": 0, "end": 1.88, "text": "מטבע הוגן, שתי", "words": [{"t": "מטבע", "s": 0, "e": 0.58}, {"t": "הוגן,", "s": 0.58, "e": 1.04}, {"t": "שתי", "s": 1.2, "e": 1.76}]}, {"start": 1.76, "end": 3.74, "text": "הטלות, ושתי שאלות.", "words": [{"t": "הטלות,", "s": 1.76, "e": 2.18}, {"t": "ושתי", "s": 2.18, "e": 3.06}, {"t": "שאלות.", "s": 3.06, "e": 3.62}]}, {"start": 3.98, "end": 5.92, "text": "בדיוק פעם אחת עץ.", "words": [{"t": "בדיוק", "s": 3.98, "e": 4.74}, {"t": "פעם", "s": 4.74, "e": 5.14}, {"t": "אחת", "s": 5.14, "e": 5.52}, {"t": "עץ.", "s": 5.52, "e": 5.8}]}, {"start": 5.88, "end": 8.12, "text": "עץ-פלי או פלי-עץ.", "words": [{"t": "עץ-פלי", "s": 5.88, "e": 6.84}, {"t": "או", "s": 6.84, "e": 7.38}, {"t": "פלי-עץ.", "s": 7.38, "e": 8}]}, {"start": 8.1, "end": 9.48, "text": "כל אחד ברבע", "words": [{"t": "כל", "s": 8.1, "e": 8.76}, {"t": "אחד", "s": 8.76, "e": 8.96}, {"t": "ברבע", "s": 8.96, "e": 9.36}]}, {"start": 9.36, "end": 11.24, "text": "ויחד חצי.", "words": [{"t": "ויחד", "s": 9.36, "e": 10.46}, {"t": "חצי.", "s": 10.46, "e": 11.12}]}, {"start": 11.86, "end": 13.64, "text": "לפחות פעם אחת עץ.", "words": [{"t": "לפחות", "s": 11.86, "e": 12.62}, {"t": "פעם", "s": 12.62, "e": 12.92}, {"t": "אחת", "s": 12.92, "e": 13.24}, {"t": "עץ.", "s": 13.24, "e": 13.52}]}, {"start": 13.64, "end": 15.82, "text": "אחד פחות פלי-פלי.", "words": [{"t": "אחד", "s": 13.64, "e": 14.4}, {"t": "פחות", "s": 14.4, "e": 15.02}, {"t": "פלי-פלי.", "s": 15.02, "e": 15.7}]}, {"start": 15.74, "end": 17.36, "text": "כלומר, אחד פחות", "words": [{"t": "כלומר,", "s": 15.74, "e": 16.46}, {"t": "אחד", "s": 16.56, "e": 16.86}, {"t": "פחות", "s": 16.86, "e": 17.24}]}, {"start": 17.24, "end": 18.8, "text": "רבע, שלושה רבעים.", "words": [{"t": "רבע,", "s": 17.24, "e": 17.54}, {"t": "שלושה", "s": 17.62, "e": 18.36}, {"t": "רבעים.", "s": 18.36, "e": 18.68}]}, {"start": 18.68, "end": 21.96, "text": "לפחות אחד לעולם אינו", "words"