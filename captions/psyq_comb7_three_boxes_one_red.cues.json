{"slug": "psyq_comb7_three_boxes_one_red", "duration": 38.84, "cues": [{"start": 0, "end": 1.34, "text": "שלושה ארגזים.", "words": [{"t": "שלושה", "s": 0, "e": 0.78}, {"t": "ארגזים.", "s": 0.78, "e": 1.22}]}, {"start": 1.32, "end": 3.42, "text": "בכל אחד ארבעה כדורים.", "words": [{"t": "בכל", "s": 1.32, "e": 1.88}, {"t": "אחד", "s": 1.88, "e": 2.14}, {"t": "ארבעה", "s": 2.14, "e": 2.82}, {"t": "כדורים.", "s": 2.82, "e": 3.3}]}, {"start": 3.34, "end": 4.28, "text": "אחד אדום.", "words": [{"t": "אחד", "s": 3.34, "e": 3.78}, {"t": "אדום.", "s": 3.78, "e": 4.16}]}, {"start": 4.28, "end": 6.48, "text": "שולפים כדור מכל ארגז,", "words": [{"t": "שולפים", "s": 4.28, "e": 5.12}, {"t": "כדור", "s": 5.12, "e": 5.5}, {"t": "מכל", "s": 5.5, "e": 5.88}, {"t": "ארגז,", "s": 5.88, "e": 6.36}]}, {"start": 6.38, "end": 7.8, "text": "בלי קשר בין הארגזים.", "words": [{"t": "בלי", "s": 6.38, "e": 6.72}, {"t": "קשר", "s": 6.72, "e": 7.06}, {"t": "בין", "s": 7.06, "e": 7.24}, {"t": "הארגזים.", "s": 7.24, "e": 7.68}]}, {"start": 7.88, "end": 9.9, "text": "מה ההסתברות לאדום", "words": [{"t": "מה", "s": 7.88, "e": 8.44}, {"t": "ההסתברות", "s": 8.44, "e": 9.06}, {"t": "לאדום", "s": 9.06, "e": 9.78}]}, {"start": 9.78, "end": 10.82, "text": "אחד לפחות?", "words": [{"t": "אחד", "s": 9.78, "e": 10.02}, {"t": "לפחות?", "s": 10.02, "e": 10.7}]}, {"start": 11.22, "end": 13, "text": "ישירות היינו סופרים", "words": [{"t": "ישירות", "s": 11.22, "e": 12.1}, {"t": "היינו", "s": 12.1, "e": 12.52}, {"t": "סופרים", "s": 12.52, "e": 12.88}]}, {"start": 12.88, "end": 14, "text": "שבעה מקרים.", "words": [{"t": "שבעה", "s": 12.88, "e": 13.5}, {"t": "מקרים.", "s": 13.5, "e": 13.88}]}, {"start": 14, "end": 16.08, "text": "במקום זה עוברים למשלים.", "words": [{"t": "במקום", "s": 14, "e": 14.84}, {"t": "זה", "s": 14.84, "e": 15.02}, {"t": "עוברים", "s": 15.02, "e": 15.56}, {"t": "למשלים.", "s": 15.56, "e": 15.96}]}, {"start": 16.42, "end": 17.76, "text": "אין אדום בארגז", "words": [{"t": "אין", "s": 16.42, "e": 16.8