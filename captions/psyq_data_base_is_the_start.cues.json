{"slug": "psyq_data_base_is_the_start", "duration": 39.96, "cues": [{"start": 0.0, "end": 2.44, "text": "המכירות עלו בעשר יחידות.", "words": [{"t": "המכירות", "s": 0.0, "e": 0.9}, {"t": "עלו", "s": 0.9, "e": 1.24}, {"t": "בעשר", "s": 1.24, "e": 1.78}, {"t": "יחידות.", "s": 1.78, "e": 2.44}]}, {"start": 2.48, "end": 4.8, "text": "זה לא אומר עשרה אחוז.", "words": [{"t": "זה", "s": 2.48, "e": 3.04}, {"t": "לא", "s": 3.04, "e": 3.3}, {"t": "אומר", "s": 3.3, "e": 3.54}, {"t": "עשרה", "s": 3.54, "e": 4.24}, {"t": "אחוז.", "s": 4.24, "e": 4.8}]}, {"start": 4.84, "end": 6.48, "text": "בתרשים, הן עלו", "words": [{"t": "בתרשים,", "s": 4.84, "e": 5.72}, {"t": "הן", "s": 5.88, "e": 6.26}, {"t": "עלו", "s": 6.26, "e": 6.48}]}, {"start": 6.48, "end": 8.623, "text": "מארבעים יחידות לחמישים.", "words": [{"t": "מארבעים", "s": 6.48, "e": 7.08}, {"t": "יחידות", "s": 7.08, "e": 7.78}, {"t": "לחמישים.", "s": 7.78, "e": 8.623}]}, {"start": 8.7, "end": 10.193, "text": "בכמה אחוז גדלו?", "words": [{"t": "בכמה", "s": 8.7, "e": 9.52}, {"t": "אחוז", "s": 9.52, "e": 9.78}, {"t": "גדלו?", "s": 9.78, "e": 10.193}]}, {"start": 10.36, "end": 11.4, "text": "מסיח:", "words": [{"t": "מסיח:", "s": 10.36, "e": 11.4}]}, {"start": 11.44, "end": 12.58, "text": "עשרה אחוז.", "words": [{"t": "עשרה", "s": 11.44, "e": 12.18}, {"t": "אחוז.", "s": 12.18, "e": 12.58}]}, {"start": 12.62, "end": 14.1, "text": "זו בדיוק המלכודת.", "words": [{"t": "זו", "s": 12.62, "e": 13.08}, {"t": "בדיוק", "s": 13.08, "e": 13.54}, {"t": "המלכודת.", "s": 13.54, "e": 14.1}]}, {"start": 14.32, "end": 17.2, "text": "עשר הוא השינוי המוחלט, ביחידות.", "words": [{"t": "עשר", "s": 14.32, "e": 15.0}, {"t": "הוא", "s": 15.0, "e": 15.22}, {"t": "השינוי", "s": 15.22, "e": 15.68}, {"t": "המוחלט,", "s": 15.68, "e": 16.42}, {"t": "ביחידות.", "s": 16.42, "e": 17.2}]}, {"start": 17.24, "end": 19.2, "text": "אבל השאלה שואלת אחוז.", "words": [{"t": "אבל", "s": 17.24, "e": 17.74}, {"t": "השאלה", "s": 17.74, "e": 18.22}, {"t": "שואלת", "s": 18.22, "e