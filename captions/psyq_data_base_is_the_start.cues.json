{"slug": "psyq_data_base_is_the_start", "duration": 42.12, "cues": [{"start": 0, "end": 2.36, "text": "המכירות עלו בעשר יחידות.", "words": [{"t": "המכירות", "s": 0, "e": 0.78}, {"t": "עלו", "s": 0.78, "e": 1}, {"t": "בעשר", "s": 1, "e": 1.6}, {"t": "יחידות.", "s": 1.6, "e": 2.24}]}, {"start": 2.28, "end": 3.18, "text": "זה לא אומר", "words": [{"t": "זה", "s": 2.28, "e": 2.68}, {"t": "לא", "s": 2.68, "e": 2.84}, {"t": "אומר", "s": 2.84, "e": 3.06}]}, {"start": 3.06, "end": 4.28, "text": "עשרה אחוז.", "words": [{"t": "עשרה", "s": 3.06, "e": 3.78}, {"t": "אחוז.", "s": 3.78, "e": 4.16}]}, {"start": 4.34, "end": 6.08, "text": "בתרשים, הן עלו", "words": [{"t": "בתרשים,", "s": 4.34, "e": 5.2}, {"t": "הן", "s": 5.2, "e": 5.74}, {"t": "עלו", "s": 5.74, "e": 5.96}]}, {"start": 5.96, "end": 7.96, "text": "מארבעים יחידות לחמישים.", "words": [{"t": "מארבעים", "s": 5.96, "e": 6.54}, {"t": "יחידות", "s": 6.54, "e": 7.12}, {"t": "לחמישים.", "s": 7.12, "e": 7.84}]}, {"start": 7.96, "end": 9.54, "text": "בכמה אחוז גדלו?", "words": [{"t": "בכמה", "s": 7.96, "e": 8.82}, {"t": "אחוז", "s": 8.82, "e": 9.08}, {"t": "גדלו?", "s": 9.08, "e": 9.42}]}, {"start": 9.58, "end": 10.74, "text": "מסיח:", "words": [{"t": "מסיח:", "s": 9.58, "e": 10.62}]}, {"start": 10.8, "end": 12.02, "text": "עשרה אחוז.", "words": [{"t": "עשרה", "s": 10.8, "e": 11.6}, {"t": "אחוז.", "s": 11.6, "e": 11.9}]}, {"start": 12.02, "end": 14, "text": "זו בדיוק המלכודת.", "words": [{"t": "זו", "s": 12.02, "e": 12.72}, {"t": "בדיוק", "s": 12.72, "e": 13.32}, {"t": "המלכודת.", "s": 13.32, "e": 13.88}]}, {"start": 14.08, "end": 15.42, "text": "עשר הוא השינוי", "words": [{"t": "עשר", "s": 14.08, "e": 14.68}, {"t": "הוא", "s": 14.68, "e": 14.84}, {"t": "השינוי", "s": 14.84, "e": 15.3}]}, {"start": 15.3, "end": 16.84, "text": "המוחלט, ביחידות.", "words": [{"t": "המוחלט,", "s": 15.3, "e": 15.92}, {"t": "ביחידות.", "s": 15.92, "e": 16.72}]}, {"start": 16.76, "end": 19.16, "text": "אבל השאלה שואלת אחוז.", "words": [{"t": "אבל", "s": 16.76, "e": 17.34}, {"t": "השאלה", "s": 17.34, "e": 17.9}, {"t": "שואלת", "s": 17.9, "e": 18.46}, {"t": "אחוז.", "s": 18.46, "e": 19.04}]}, {"start": 19.12, "end": 21.66, "text": "ואחוז נמדד מהבסיס,", "words": [{"t": "ואחוז", "s": 19.12, "e": 20.2}, {"t": "נמדד", "s": 20.2, "e": 20.8}, {"t": "מהבסיס,", "s": 20.8, "e": 21.54}]}, {"start": 21.66, "end": 23.1, "text": "מהערך ההתחלתי.", "words": [{"t": "מהערך", "s": 21.66, "e": 22.34}, {"t": "ההתחלתי.", "s": 22.34, "e": 22.98}]}, {"start": 22.98, "end": 25.14, "text": "האחוז תלוי בבסיס", "words": [{"t": "האחוז", "s": 22.98, "e": 24.18}, {"t": "תלוי", "s": 24.18, "e": 24.54}, {"t": "בבסיס", "s": 24.54, "e": 25.02}]}, {"start": 25.02, "end": 26.12, "text": "שממנו מודדים.", "words": [{"t": "שממנו", "s": 25.02, "e": 25.54}, {"t": "מודדים.", "s": 25.54, "e": 26}]}, {"start": 26.3, "end": 27.86, "text": "הבסיס הוא ארבעים,", "words": [{"t": "הבסיס", "s": 26.3, "e": 27.16}, {"t": "הוא", "s": 27.16, "e": 27.24}, {"t": "ארבעים,", "s": 27.24, "e": 27.74}]}, {"start": 27.84, "end": 28.86, "text": "לא חמישים.", "words": [{"t": "לא", "s": 27.84, "e": 28.28}, {"t": "חמישים.", "s": 28.28, "e": 28.74}]}, {"start": 29.02, "end": 30.94, "text": "עשר חלקי ארבעים", "words": [{"t": "עשר", "s": 29.02, "e": 29.76}, {"t": "חלקי", "s": 29.76, "e": 30.24}, {"t": "ארבעים", "s": 30.24, "e": 30.82}]}, {"start": 30.82, "end": 31.7, "text": "זה רבע.", "words": [{"t": "זה", "s": 30.82, "e": 31.24}, {"t": "רבע.", "s": 31.24, "e": 31.58}]}, {"start": 31.68, "end": 34.52, "text": "כלומר, עשרים וחמישה אחוז.", "words": [{"t": "כלומר,", "s": 31.68, "e": 32.54}, {"t": "עשרים", "s": 32.66, "e": 33.34}, {"t": "וחמישה", "s": 33.34, "e": 34}, {"t": "אחוז.", "s": 34, "e": 34.4}]}, {"start": 34.9, "end": 36.8, "text": "אחוז או ערך מוחלט?", "words": [{"t": "אחוז", "s": 34.9, "e": 35.76}, {"t": "או", "s": 35.76, "e": 35.94}, {"t": "ערך", "s": 35.94, "e": 36.26}, {"t": "מוחלט?", "s": 36.26, "e": 36.68}]}, {"start": 36.86, "end": 38.68, "text": "קרא את הצירים ואת", "words": [{"t": "קרא", "s": 36.86, "e": 37.72}, {"t": "את", "s": 37.72, "e": 37.84}, {"t": "הצירים", "s": 37.84, "e": 38.32}, {"t": "ואת", "s": 38.32, "e": 38.56}]}, {"start": 38.56, "end": 40.64, "text": "היחידות, ורק אז חשב.", "words": [{"t": "היחידות,", "s": 38.56, "e": 39.16}, {"t": "ורק", "s": 39.22, "e": 39.92}, {"t": "אז", "s": 39.92, "e": 40.08}, {"t": "חשב.", "s": 40.08, "e": 40.52}]}]}
