{"slug": "psyq_data_base_is_the_start", "duration": 39.8, "cues": [{"start": 0.0, "end": 2.425, "text": "המכירות עלו בעשר יחידות.", "words": [{"t": "המכירות", "s": 0.0, "e": 0.894}, {"t": "עלו", "s": 0.894, "e": 1.232}, {"t": "בעשר", "s": 1.232, "e": 1.769}, {"t": "יחידות.", "s": 1.769, "e": 2.425}]}, {"start": 2.465, "end": 4.77, "text": "זה לא אומר עשרה אחוז.", "words": [{"t": "זה", "s": 2.465, "e": 3.021}, {"t": "לא", "s": 3.021, "e": 3.28}, {"t": "אומר", "s": 3.28, "e": 3.518}, {"t": "עשרה", "s": 3.518, "e": 4.214}, {"t": "אחוז.", "s": 4.214, "e": 4.77}]}, {"start": 4.81, "end": 6.44, "text": "בתרשים, הן עלו", "words": [{"t": "בתרשים,", "s": 4.81, "e": 5.685}, {"t": "הן", "s": 5.844, "e": 6.221}, {"t": "עלו", "s": 6.221, "e": 6.44}]}, {"start": 6.44, "end": 8.57, "text": "מארבעים יחידות לחמישים.", "words": [{"t": "מארבעים", "s": 6.44, "e": 7.036}, {"t": "יחידות", "s": 7.036, "e": 7.732}, {"t": "לחמישים.", "s": 7.732, "e": 8.57}]}, {"start": 8.646, "end": 10.13, "text": "בכמה אחוז גדלו?", "words": [{"t": "בכמה", "s": 8.646, "e": 9.461}, {"t": "אחוז", "s": 9.461, "e": 9.72}, {"t": "גדלו?", "s": 9.72, "e": 10.13}]}, {"start": 10.296, "end": 11.33, "text": "מסיח:", "words": [{"t": "מסיח:", "s": 10.296, "e": 11.33}]}, {"start": 11.37, "end": 12.502, "text": "עשרה אחוז.", "words": [{"t": "עשרה", "s": 11.37, "e": 12.105}, {"t": "אחוז.", "s": 12.105, "e": 12.502}]}, {"start": 12.542, "end": 14.013, "text": "זו בדיוק המלכודת.", "words": [{"t": "זו", "s": 12.542, "e": 12.999}, {"t": "בדיוק", "s": 12.999, "e": 13.457}, {"t": "המלכודת.", "s": 13.457, "e": 14.013}]}, {"start": 14.232, "end": 17.094, "text": "עשר הוא השינוי המוחלט, ביחידות.", "words": [{"t": "עשר", "s": 14.232, "e": 14.908}, {"t": "הוא", "s": 14.908, "e": 15.126}, {"t": "השינוי", "s": 15.126, "e": 15.583}, {"t": "המוחלט,", "s": 15.583, "e": 16.319}, {"t": "ביחידות.", "s": 16.319, "e": 17.094}]}, {"start": 17.134, "end": 19.082, "text": "אבל השאלה שואלת אחוז.", "words": [{"t": "אבל", "s": 17.134, "e": 17.631}, {"t": "השאלה", "s": 17.631, "e": 18.108}, {"t": "שואלת", "s": 18.108, "e": 18.545}, {"t": "אחוז.", "s": 18.545, "e": 19.082}]}, {"start": 19.121, "end": 22.611, "text": "ואחוז נמדד מהבסיס, מהערך ההתחלתי.", "words": [{"t": "ואחוז", "s": 19.121, "e": 20.036}, {"t": "נמדד", "s": 20.036, "e": 20.493}, {"t": "מהבסיס,", "s": 20.493, "e": 21.209}, {"t": "מהערך", "s": 21.248, "e": 21.864}, {"t": "ההתחלתי.", "s": 21.864, "e": 22.611}]}, {"start": 22.739, "end": 25.45, "text": "האחוז תלוי בבסיס שממנו מודדים.", "words": [{"t": "האחוז", "s": 22.739, "e": 23.614}, {"t": "תלוי", "s": 23.614, "e": 23.932}, {"t": "בבסיס", "s": 23.932, "e": 24.448}, {"t": "שממנו", "s": 24.448, "e": 24.945}, {"t": "מודדים.", "s": 24.945, "e": 25.45}]}, {"start": 25.601, "end": 27.847, "text": "הבסיס הוא ארבעים, לא חמישים.", "words": [{"t": "הבסיס", "s": 25.601, "e": 26.476}, {"t": "הוא", "s": 26.476, "e": 26.555}, {"t": "ארבעים,", "s": 26.555, "e": 26.913}, {"t": "לא", "s": 27.211, "e": 27.609}, {"t": "חמישים.", "s": 27.609, "e": 27.847}]}, {"start": 27.847, "end": 30.829, "text": "עשר חלקי ארבעים זה רבע.", "words": [{"t": "עשר", "s": 27.847, "e": 28.941}, {"t": "חלקי", "s": 28.941, "e": 29.597}, {"t": "ארבעים", "s": 29.597, "e": 29.736}, {"t": "זה", "s": 29.736, "e": 30.372}, {"t": "רבע.", "s": 30.372, "e": 30.829}]}, {"start": 30.869, "end": 33.251, "text": "כלומר, 25 אחוז.", "words": [{"t": "כלומר,", "s": 30.869, "e": 31.624}, {"t": "25", "s": 31.624, "e": 32.2}, {"t": "אחוז.", "s": 32.2, "e": 33.251}]}, {"start": 33.751, "end": 35.261, "text": "אחוז או ערך מוחלט?", "words": [{"t": "אחוז", "s": 33.751, "e": 34.268}, {"t": "או", "s": 34.268, "e": 34.446}, {"t": "ערך", "s": 34.446, "e": 34.745}, {"t": "מוחלט?", "s": 34.745, "e": 35.261}]}, {"start": 35.301, "end": 37.11, "text": "קוראים את הצירים ואת", "words": [{"t": "קוראים", "s": 35.301, "e": 36.136}, {"t": "את", "s": 36.136, "e": 36.235}, {"t": "הצירים", "s": 36.235, "e": 36.752}, {"t": "ואת", "s": 36.752, "e": 37.11}]}, {"start": 37.11, "end": 39.36, "text": "היחידות, ורק אז מחשבים.", "words": [{"t": "היחידות,", "s": 37.11, "e": 37.806}, {"t": "ורק", "s": 37.845, "e": 38.442}, {"t": "אז", "s": 38.442, "e": 38.68}, {"t": "מחשבים.", "s": 38.68, "e": 39.36}]}], "captions_default": "on", "text_load": {"mean_visible_words": 11.2, "threshold": 20.0}}
