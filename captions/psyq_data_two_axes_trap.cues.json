{"slug": "psyq_data_two_axes_trap", "duration": 54.26, "cues": [{"start": 0, "end": 1.96, "text": "שתי עמודות באותו גובה", "words": [{"t": "שתי", "s": 0, "e": 0.4}, {"t": "עמודות", "s": 0.4, "e": 0.88}, {"t": "באותו", "s": 0.88, "e": 1.5}, {"t": "גובה", "s": 1.5, "e": 1.84}]}, {"start": 1.84, "end": 3.3, "text": "בדיוק בגרף אחד.", "words": [{"t": "בדיוק", "s": 1.84, "e": 2.42}, {"t": "בגרף", "s": 2.42, "e": 2.94}, {"t": "אחד.", "s": 2.94, "e": 3.18}]}, {"start": 3.52, "end": 5.24, "text": "אחת מצטרפים חדשים,", "words": [{"t": "אחת", "s": 3.52, "e": 4.14}, {"t": "מצטרפים", "s": 4.14, "e": 4.64}, {"t": "חדשים,", "s": 4.64, "e": 5.12}]}, {"start": 5.28, "end": 6.68, "text": "השנייה מבטלים.", "words": [{"t": "השנייה", "s": 5.28, "e": 5.9}, {"t": "מבטלים.", "s": 5.9, "e": 6.56}]}, {"start": 6.74, "end": 8.86, "text": "אז החברה מאבדת בדיוק", "words": [{"t": "אז", "s": 6.74, "e": 7.32}, {"t": "החברה", "s": 7.32, "e": 7.76}, {"t": "מאבדת", "s": 7.76, "e": 8.22}, {"t": "בדיוק", "s": 8.22, "e": 8.74}]}, {"start": 8.74, "end": 9.86, "text": "כמה שהיא מגייסת?", "words": [{"t": "כמה", "s": 8.74, "e": 9}, {"t": "שהיא", "s": 9, "e": 9.2}, {"t": "מגייסת?", "s": 9.2, "e": 9.74}]}, {"start": 9.94, "end": 12.18, "text": "לא, ואפילו לא קרוב.", "words": [{"t": "לא,", "s": 9.94, "e": 10.54}, {"t": "ואפילו", "s": 10.64, "e": 11.3}, {"t": "לא", "s": 11.3, "e": 11.5}, {"t": "קרוב.", "s": 11.5, "e": 12.06}]}, {"start": 12.18, "end": 14.08, "text": "העין השוותה גבהים,", "words": [{"t": "העין", "s": 12.18, "e": 12.9}, {"t": "השוותה", "s": 12.9, "e": 13.42}, {"t": "גבהים,", "s": 13.42, "e": 13.96}]}, {"start": 14.02, "end": 14.86, "text": "לא מספרים.", "words": [{"t": "לא", "s": 14.02, "e": 14.3}, {"t": "מספרים.", "s": 14.3, "e": 14.74}]}, {"start": 15.16, "end": 16.3, "text": "תסתכל על שני", "words": [{"t": "תסתכל", "s": 15.16, "e": 15.78}, {"t": "על", "s": 15.78, "e": 15.92}, {"t": "שני", "s": 15.92, "e": 16.18}]}, {"start": 16.18, "end": 17.28, "text": "הצדדים של הגרף.", "words": [{"t": "הצדדים", "s": 16.18, "e": 16.62}, {"t": "של", "s": 16.62, "e": 16.78}, {"t": "הגרף.", "s": 16.78, "e": 17.16}]}, {"start": 17.36, "end": 19.3, "text": "הציר השמאלי נע מאפס", "words": [{"t": "הציר", "s": 17.36, "e": 17.94}, {"t": "השמאלי", "s": 17.94, "e": 18.36}, {"t": "נע", "s": 18.36, "e": 18.62}, {"t": "מאפס", "s": 18.62, "e": 19.18}]}, {"start": 19.18, "end": 20.94, "text": "עד אלף, והימני", "words": [{"t": "עד", "s": 19.18, "e": 19.6}, {"t": "אלף,", "s": 19.6, "e": 19.86}, {"t": "והימני", "s": 20.1, "e": 20.82}]}, {"start": 20.82, "end": 22.24, "text": "מאפס עד מאה.", "words": [{"t": "מאפס", "s": 20.82, "e": 21.5}, {"t": "עד", "s": 21.5, "e": 21.96}, {"t": "מאה.", "s": 21.96, "e": 22.12}]}, {"start": 22.5, "end": 24.56, "text": "עמודת המצטרפים נמדדת על", "words": [{"t": "עמודת", "s": 22.5, "e": 23.12}, {"t": "המצטרפים", "s": 23.12, "e": 23.8}, {"t": "נמדדת", "s": 23.8, "e": 24.36}, {"t": "על", "s": 24.36, "e": 24.44}]}, {"start": 24.44, "end": 26.18, "text": "הציר השמאלי, ועמודת", "words": [{"t": "הציר", "s": 24.44, "e": 24.76}, {"t": "השמאלי,", "s": 24.76, "e": 25.28}, {"t": "ועמודת", "s": 25.28, "e": 26.06}]}, {"start": 26.06, "end": 27.38, "text": "המבטלים על הימני.", "words": [{"t": "המבטלים", "s": 26.06, "e": 26.58}, {"t": "על", "s": 26.58, "e": 26.9}, {"t": "הימני.", "s": 26.9, "e": 27.26}]}, {"start": 27.38, "end": 29.8, "text": "שתיהן מגיעות לשמונים אחוז", "words": [{"t": "שתיהן", "s": 27.38, "e": 28.34}, {"t": "מגיעות", "s": 28.34, "e": 28.7}, {"t": "לשמונים אחוז", "s": 28.7, "e": 29.68}]}, {"start": 29.68, "end": 31.22, "text": "מגובה הציר שלהן.", "words": [{"t": "מגובה", "s": 29.68, "e": 30.32}, {"t": "הציר", "s": 30.32, "e": 30.64}, {"t": "שלהן.", "s": 30.64, "e": 31.1}]}, {"start": 31.12, "end": 33.26, "text": "אז עמודת המצטרפים היא", "words": [{"t": "אז", "s": 31.12, "e": 31.74}, {"t": "עמודת", "s": 31.74, "e": 32.22}, {"t": "המצטרפים", "s": 32.22, "e": 32.88}, {"t": "היא", "s": 32.88, "e": 33.14}]}, {"start": 33.14, "end": 35.96, "text": "שמונה מאות, ואילו עמודת המבטלים", "words": [{"t": "שמונה מאות,", "s": 33.14, "e": 33.74}, {"t": "ואילו", "s": 34.14, "e": 34.9}, {"t": "עמודת", "s": 34.9, "e": 35.3}, {"t": "המבטלים", "s": 35.3, "e": 35.84}]}, {"start": 35.84, "end": 37.56, "text": "היא שמונים בלבד.", "words": [{"t": "היא", "s": 35.84, "e": 36.16}, {"t": "שמונים", "s": 36.16, "e": 36.72}, {"t": "בלבד.", "s": 36.72, "e": 37.44}]}, {"start": 37.66, "end": 39.92, "text": "התשובה הנכונה, החברה", "words": [{"t": "התשובה", "s": 37.66, "e": 38.46}, {"t": "הנכונה,", "s": 38.46, "e": 38.94}, {"t": "החברה", "s": 39.12, "e": 39.8}]}, {"start": 39.8, "end": 41.32, "text": "מגייסת פי עשרה", "words": [{"t": "מגייסת", "s": 39.8, "e": 40.28}, {"t": "פי", "s": 40.28, "e": 40.58}, {"t": "עשרה", "s": 40.58, "e": 41.2}]}, {"start": 41.2, "end": 42.42, "text": "ממה שהיא מאבדת.", "words": [{"t": "ממה", "s": 41.2, "e": 41.62}, {"t": "שהיא", "s": 41.62, "e": 41.82}, {"t": "מאבדת.", "s": 41.82, "e": 42.3}]}, {"start": 42.78, "end": 43.7, "text": "הטכניקה?", "words": [{"t": "הטכניקה?", "s": 42.78, "e": 43.58}]}, {"start": 43.68, "end": 45.4, "text": "לפני שאתה משווה שתי", "words": [{"t": "לפני", "s": 43.68, "e": 44.48}, {"t": "שאתה", "s": 44.48, "e": 44.72}, {"t": "משווה", "s": 44.72, "e": 45.04}, {"t": "שתי", "s": 45.04, "e": 45.28}]}, {"start": 45.28, "end": 46.92, "text": "עמודות, שייך כל", "words": [{"t": "עמודות,", "s": 45.28, "e": 45.78}, {"t": "שייך", "s": 45.82, "e": 46.5}, {"t": "כל", "s": 46.5, "e": 46.8}]}, {"start": 46.8, "end": 48.2, "text": "עמודה לציר שלה.", "words": [{"t": "עמודה", "s": 46.8, "e": 47.32}, {"t": "לציר", "s": 47.32, "e": 47.78}, {"t": "שלה.", "s": 47.78, "e": 48.08}]}, {"start": 48.68, "end": 49.94, "text": "בגרף עם שני צירים,", "words": [{"t": "בגרף", "s": 48.68, "e": 49.08}, {"t": "עם", "s": 49.08, "e": 49.2}, {"t": "שני", "s": 49.2, "e": 49.44}, {"t": "צירים,", "s": 49.44, "e": 49.82}]}, {"start": 50.02, "end": 51.52, "text": "גובה שווה לא", "words": [{"t": "גובה", "s": 50.02, "e": 50.6}, {"t": "שווה", "s": 50.6, "e": 50.94}, {"t": "לא", "s": 50.94, "e": 51.4}]}, {"start": 51.4, "end": 52.78, "text": "אומר ערך שווה.", "words": [{"t": "אומר", "s": 51.4, "e": 51.72}, {"t": "ערך", "s": 51.72, "e": 52.26}, {"t": "שווה.", "s": 52.26, "e": 52.66}]}]}
