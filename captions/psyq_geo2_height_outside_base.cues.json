{"slug": "psyq_geo2_height_outside_base", "duration": 35.6, "cues": [{"start": 0.0, "end": 1.72, "text": "משולש קהה־זווית.", "words": [{"t": "משולש", "s": 0.0, "e": 0.84}, {"t": "קהה־זווית.", "s": 0.84, "e": 1.72}]}, {"start": 1.74, "end": 5.1, "text": "הבסיס עשר, והגובה אליו שלוש.", "words": [{"t": "הבסיס", "s": 1.74, "e": 2.52}, {"t": "עשר,", "s": 2.52, "e": 3.18}, {"t": "והגובה", "s": 3.38, "e": 4.18}, {"t": "אליו", "s": 4.18, "e": 4.44}, {"t": "שלוש.", "s": 4.44, "e": 5.1}]}, {"start": 5.2, "end": 6.9, "text": "הגובה יורד מקדקוד", "words": [{"t": "הגובה", "s": 5.2, "e": 6.0}, {"t": "יורד", "s": 6.0, "e": 6.3}, {"t": "מקדקוד", "s": 6.3, "e": 6.9}]}, {"start": 6.9, "end": 7.92, "text": "של זווית חדה.", "words": [{"t": "של", "s": 6.9, "e": 7.04}, {"t": "זווית", "s": 7.04, "e": 7.48}, {"t": "חדה.", "s": 7.48, "e": 7.92}]}, {"start": 7.94, "end": 9.8, "text": "והוא נופל מחוץ לבסיס.", "words": [{"t": "והוא", "s": 7.94, "e": 8.5}, {"t": "נופל", "s": 8.5, "e": 8.86}, {"t": "מחוץ", "s": 8.86, "e": 9.3}, {"t": "לבסיס.", "s": 9.3, "e": 9.8}]}, {"start": 10.02, "end": 11.96, "text": "האם הנוסחה עדיין עובדת?", "words": [{"t": "האם", "s": 10.02, "e": 10.84}, {"t": "הנוסחה", "s": 10.84, "e": 11.24}, {"t": "עדיין", "s": 11.24, "e": 11.56}, {"t": "עובדת?", "s": 11.56, "e": 11.96}]}, {"start": 12.5, "end": 12.92, "text": "כן.", "words": [{"t": "כן.", "s": 12.5, "e": 12.92}]}, {"start": 13.18, "end": 14.52, "text": "הגובה הוא האנך", "words": [{"t": "הגובה", "s": 13.18, "e": 14.02}, {"t": "הוא", "s": 14.02, "e": 14.12}, {"t": "האנך", "s": 14.12, "e": 14.52}]}, {"start": 14.52, "end": 16.12, "text": "מהקדקוד אל הבסיס.", "words": [{"t": "מהקדקוד", "s": 14.52, "e": 15.38}, {"t": "אל", "s": 15.38, "e": 15.62}, {"t": "הבסיס.", "s": 15.62, "e": 16.12}]}, {"start": 16.58, "end": 17.36, "text": "כאן הוא פוגע", "words": [{"t": "כאן", "s": 16.58, "e": 17.0}, {"t": "הוא", "s": 17.0, "e": 17.1}, {"t": "פוגע", "s": 17.1, "e": 17.36}]}, {"start": 17.36, "end": 18.54, "text": "בהמשך של הבסיס.", "words": [{"t": "בהמשך", "s": 17.36, "e": 17.92}, {"t": "של", "s": 17.92, "e": 18.1}, {"t": "הבסיס.", "s": 18.1, "e": 18.54}]}, {"start": 18.68, "end": 20.04, "text": "ממשיכים את הקו,", "words": [{"t": "ממשיכים", "s": 18.68, "e": 19.52}, {"t": "את", "s": 19.52, "e": 19.6}, {"t": "הקו,", "s": 19.6, "e": 20.04}]}, {"start": 20.04, "end": 21.18, "text": "ומורידים אליו אנך.", "words": [{"t": "ומורידים", "s": 20.04, "e": 20.76}, {"t": "אליו", "s": 20.76, "e": 20.96}, {"t": "אנך.", "s": 20.96, "e": 21.18}]}, {"start": 21.66, "end": 23.44, "text": "הנוסחה לא משתנה.", "words": [{"t": "הנוסחה", "s": 21.66, "e": 22.5}, {"t": "לא", "s": 22.5, "e": 22.96}, {"t": "משתנה.", "s": 22.96, "e": 23.44}]}, {"start": 23.64, "end": 26.46, "text": "בסיס כפול גובה, חלקי שתיים.", "words": [{"t": "בסיס", "s": 23.64, "e": 24.48}, {"t": "כפול", "s": 24.48, "e": 24.86}, {"t": "גובה,", "s": 24.86, "e": 25.26}, {"t": "חלקי", "s": 25.26, "e": 25.98}, {"t": "שתיים.", "s": 25.98, "e": 26.46}]}, {"start": 26.46, "end": 29.14, "text": "עשר כפול שלוש, שלושים.", "words": [{"t": "עשר", "s": 26.46, "e": 27.34}, {"t": "כפול", "s": 27.34, "e": 27.72}, {"t": "שלוש,", "s": 27.72, "e": 28.2}, {"t": "שלושים.", "s": 28.24, "e": 29.14}]}, {"start": 29.16, "end": 32.34, "text": "חלקי שתיים, והשטח חמש עשרה.", "words": [{"t": "חלקי", "s": 29.16, "e": 29.94}, {"t": "שתיים,", "s": 29.94, "e": 30.4}, {"t": "והשטח", "s": 30.4, "e": 31.32}, {"t": "חמש", "s": 31.32, "e": 31.9}, {"t": "עשרה.", "s": 31.9, "e": 32.34}]}, {"start": 32.42, "end": 34.04, "text": "הגובה לא חייב", "words": [{"t": "הגובה", "s": 32.42, "e": 33.34}, {"t": "לא", "s": 33.34, "e": 33.44}, {"t": "חייב", "s": 33.44, "e": 34.04}]}, {"start": 34.04, "end": 35.2, "text": "לשבת בתוך המשולש.", "words": [{"t": "לשבת", "s": 34.04, "e": 34.36}, {"t": "בתוך", "s": 34.36, "e": 34.7}, {"t": "המשולש.", "s": 34.7, "e": 35.2}]}]}
