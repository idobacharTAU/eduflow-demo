{"slug": "psyq_geo4_cylinder_unrolls", "duration": 40.88, "cues": [{"start": 0, "end": 3.1, "text": "לגליל יש מעטפת, בסיס", "words": [{"t": "לגליל", "s": 0, "e": 0.86}, {"t": "יש", "s": 0.86, "e": 1.18}, {"t": "מעטפת,", "s": 1.18, "e": 2.2}, {"t": "בסיס", "s": 2.26, "e": 2.98}]}, {"start": 2.98, "end": 4.92, "text": "למעלה ובסיס למטה.", "words": [{"t": "למעלה", "s": 2.98, "e": 3.54}, {"t": "ובסיס", "s": 3.54, "e": 4.24}, {"t": "למטה.", "s": 4.24, "e": 4.8}]}, {"start": 4.86, "end": 6.26, "text": "איך מחשבים את", "words": [{"t": "איך", "s": 4.86, "e": 5.66}, {"t": "מחשבים", "s": 5.66, "e": 6.04}, {"t": "את", "s": 6.04, "e": 6.14}]}, {"start": 6.14, "end": 7.14, "text": "שטח המעטפת?", "words": [{"t": "שטח", "s": 6.14, "e": 6.44}, {"t": "המעטפת?", "s": 6.44, "e": 7.02}]}, {"start": 7.46, "end": 9.94, "text": "המעטפת נפרשת למלבן.", "words": [{"t": "המעטפת", "s": 7.46, "e": 8.44}, {"t": "נפרשת", "s": 8.44, "e": 9.18}, {"t": "למלבן.", "s": 9.18, "e": 9.82}]}, {"start": 10.33, "end": 11.86, "text": "צלע אחת של המלבן", "words": [{"t": "צלע", "s": 10.33, "e": 10.82}, {"t": "אחת", "s": 10.82, "e": 11.2}, {"t": "של", "s": 11.2, "e": 11.3}, {"t": "המלבן", "s": 11.3, "e": 11.74}]}, {"start": 11.74, "end": 13.86, "text": "היא גובה הגליל, הצלע", "words": [{"t": "היא", "s": 11.74, "e": 12.08}, {"t": "גובה", "s": 12.08, "e": 12.58}, {"t": "הגליל,", "s": 12.58, "e": 13.06}, {"t": "הצלע", "s": 13.08, "e": 13.74}]}, {"start": 13.74, "end": 15.72, "text": "השנייה היא היקף הבסיס,", "words": [{"t": "השנייה", "s": 13.74, "e": 14.32}, {"t": "היא", "s": 14.32, "e": 14.66}, {"t": "היקף", "s": 14.66, "e": 15.06}, {"t": "הבסיס,", "s": 15.06, "e": 15.6}]}, {"start": 15.68, "end": 18, "text": "והיקף הבסיס הוא פעמיים", "words": [{"t": "והיקף", "s": 15.68, "e": 16.48}, {"t": "הבסיס", "s": 16.48, "e": 16.96}, {"t": "הוא", "s": 16.96, "e": 17.2}, {"t": "פעמיים", "s": 17.2, "e": 17.88}]}, {"start": 17.88, "end": 19.64, "text": "פאי כפול הרדיוס.", "words": [{"t": "פאי", "s": 17.88, "e": 18.32}, {"t": "