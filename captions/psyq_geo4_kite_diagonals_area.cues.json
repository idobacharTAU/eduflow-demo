{"slug": "psyq_geo4_kite_diagonals_area", "duration": 36.52, "cues": [{"start": 0.0, "end": 2.0, "text": "איך מחשבים שטח של דלתון?", "words": [{"t": "איך", "s": 0.0, "e": 0.42}, {"t": "מחשבים", "s": 0.42, "e": 0.9}, {"t": "שטח", "s": 0.9, "e": 1.48}, {"t": "של", "s": 1.48, "e": 1.6}, {"t": "דלתון?", "s": 1.6, "e": 2.0}]}, {"start": 2.16, "end": 4.46, "text": "לא צריך לחפש בסיס וגובה.", "words": [{"t": "לא", "s": 2.16, "e": 2.68}, {"t": "צריך", "s": 2.68, "e": 3.06}, {"t": "לחפש", "s": 3.06, "e": 3.46}, {"t": "בסיס", "s": 3.46, "e": 3.96}, {"t": "וגובה.", "s": 3.96, "e": 4.46}]}, {"start": 4.72, "end": 7.12, "text": "האלכסונים שלו ניצבים זה לזה.", "words": [{"t": "האלכסונים", "s": 4.72, "e": 5.52}, {"t": "שלו", "s": 5.52, "e": 5.9}, {"t": "ניצבים", "s": 5.9, "e": 6.66}, {"t": "זה", "s": 6.66, "e": 6.84}, {"t": "לזה.", "s": 6.84, "e": 7.12}]}, {"start": 7.57, "end": 9.24, "text": "כופלים את שני האלכסונים.", "words": [{"t": "כופלים", "s": 7.57, "e": 8.04}, {"t": "את", "s": 8.04, "e": 8.24}, {"t": "שני", "s": 8.24, "e": 8.6}, {"t": "האלכסונים.", "s": 8.6, "e": 9.24}]}, {"start": 9.24, "end": 11.52, "text": "ולוקחים מחצית מהמכפלה.", "words": [{"t": "ולוקחים", "s": 9.24, "e": 10.22}, {"t": "מחצית", "s": 10.22, "e": 10.9}, {"t": "מהמכפלה.", "s": 10.9, "e": 11.52}]}, {"start": 11.75, "end": 13.32, "text": "זה כל השטח.", "words": [{"t": "זה", "s": 11.75, "e": 12.22}, {"t": "כל", "s": 12.22, "e": 12.7}, {"t": "השטח.", "s": 12.7, "e": 13.32}]}, {"start": 13.61, "end": 16.66, "text": "בלי החלוקה, התשובה כפולה מהשטח.", "words": [{"t": "בלי", "s": 13.61, "e": 14.08}, {"t": "החלוקה,", "s": 14.08, "e": 14.6}, {"t": "התשובה", "s": 14.62, "e": 15.32}, {"t": "כפולה", "s": 15.32, "e": 16.0}, {"t": "מהשטח.", "s": 16.0, "e": 16.66}]}, {"start": 17.03, "end": 17.96, "text": "ומה עם מעוין?", "words": [{"t": "ומה", "s": 17.03, "e": 17.265}, {"t": "עם", "s": 17.265, "e": 17.5}, {"t": "מעוין?", "s": 17.5, "e": 17.96}]}, {"start": 18.16, "end": 20.68, "text": "דלתון קמור שכל צלעותיו", "words": [{"t": "דלתון", "s": 18.16, "e": 19.02}, {"t": "קמור", "s": 19.02, "e": 19.52}, {"t": "שכל", "s": 19.52, "e": 20.1}, {"t": "צלעותיו", "s": 20.1, "e": 20.68}]}, {"start": 20.68, "end": 21.88, "text": "שוות הוא מעוין.", "words": [{"t": "שוות", "s": 20.68, "e": 21.14}, {"t": "הוא", "s": 21.14, "e": 21.38}, {"t": "מעוין.", "s": 21.38, "e": 21.88}]}, {"start": 21.98, "end": 23.68, "text": "לכן אותה נוסחה", "words": [{"t": "לכן", "s": 21.98, "e": 22.74}, {"t": "אותה", "s": 22.74, "e": 23.26}, {"t": "נוסחה", "s": 23.26, "e": 23.68}]}, {"start": 23.68, "end": 24.62, "text": "עובדת גם עליו.", "words": [{"t": "עובדת", "s": 23.68, "e": 24.14}, {"t": "גם", "s": 24.14, "e": 24.3}, {"t": "עליו.", "s": 24.3, "e": 24.62}]}, {"start": 24.92, "end": 26.78, "text": "ובמעוין, כל שתי", "words": [{"t": "ובמעוין,", "s": 24.92, "e": 25.86}, {"t": "כל", "s": 25.86, "e": 26.32}, {"t": "שתי", "s": 26.32, "e": 26.78}]}, {"start": 26.78, "end": 28.48, "text": "זוויות נגדיות שוות.", "words": [{"t": "זוויות", "s": 26.78, "e": 27.18}, {"t": "נגדיות", "s": 27.18, "e": 27.66}, {"t": "שוות.", "s": 27.66, "e": 28.48}]}, {"start": 28.48, "end": 30.92, "text": "ובריבוע, שני האלכסונים", "words": [{"t": "ובריבוע,", "s": 28.48, "e": 29.6}, {"t": "שני", "s": 29.7, "e": 30.32}, {"t": "האלכסונים", "s": 30.32, "e": 30.92}]}, {"start": 30.92, "end": 32.12, "text": "שווים זה לזה.", "words": [{"t": "שווים", "s": 30.92, "e": 31.72}, {"t": "זה", "s": 31.72, "e": 31.84}, {"t": "לזה.", "s": 31.84, "e": 32.12}]}, {"start": 32.18, "end": 34.18, "text": "אז מול דלתון או מעוין,", "words": [{"t": "אז", "s": 32.18, "e": 32.76}, {"t": "מול", "s": 32.76, "e": 33.08}, {"t": "דלתון", "s": 33.08, "e": 33.54}, {"t": "או", "s": 33.54, "e": 33.76}, {"t": "מעוין,", "s": 33.76, "e": 34.18}]}, {"start": 34.32, "end": 36.12, "text": "קודם מחפשים את האלכסונים.", "words": [{"t": "קודם", "s": 34.32, "e": 35.0}, {"t": "מחפשים", "s": 35.0, "e": 35.48}, {"t": "את", "s": 35.48, "e": 35.6}, {"t": "האלכסונים.", "s": 35.6, "e": 36.12}]}], "cap