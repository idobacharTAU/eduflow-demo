{"slug": "psyq_geo4_leg_half_hypotenuse", "duration": 39, "cues": [{"start": 0, "end": 2.5, "text": "משולש ישר זווית ואף", "words": [{"t": "משולש", "s": 0, "e": 0.86}, {"t": "ישר", "s": 0.86, "e": 1.32}, {"t": "זווית", "s": 1.32, "e": 1.74}, {"t": "ואף", "s": 1.74, "e": 2.38}]}, {"start": 2.38, "end": 4.18, "text": "זווית חדה לא נתונה.", "words": [{"t": "זווית", "s": 2.38, "e": 2.82}, {"t": "חדה", "s": 2.82, "e": 3.2}, {"t": "לא", "s": 3.2, "e": 3.6}, {"t": "נתונה.", "s": 3.6, "e": 4.06}]}, {"start": 4.18, "end": 6.16, "text": "נתון רק שניצב אחד", "words": [{"t": "נתון", "s": 4.18, "e": 4.94}, {"t": "רק", "s": 4.94, "e": 5.16}, {"t": "שניצב", "s": 5.16, "e": 5.82}, {"t": "אחד", "s": 5.82, "e": 6.04}]}, {"start": 6.04, "end": 8.16, "text": "שווה למחצית היתר.", "words": [{"t": "שווה", "s": 6.04, "e": 6.72}, {"t": "למחצית", "s": 6.72, "e": 7.46}, {"t": "היתר.", "s": 7.46, "e": 8.04}]}, {"start": 8.06, "end": 10.34, "text": "זה מספיק כדי לדעת", "words": [{"t": "זה", "s": 8.06, "e": 8.7}, {"t": "מספיק", "s": 8.7, "e": 9.42}, {"t": "כדי", "s": 9.42, "e": 9.76}, {"t": "לדעת", "s": 9.76, "e": 10.22}]}, {"start": 10.22, "end": 11.28, "text": "את כל הזוויות.", "words": [{"t": "את", "s": 10.22, "e": 10.34}, {"t": "כל", "s": 10.34, "e": 10.62}, {"t": "הזוויות.", "s": 10.62, "e": 11.16}]}, {"start": 11.4, "end": 13.32, "text": "הזווית שמול הניצב הזה", "words": [{"t": "הזווית", "s": 11.4, "e": 12.22}, {"t": "שמול", "s": 12.22, "e": 12.68}, {"t": "הניצב", "s": 12.68, "e": 13.08}, {"t": "הזה", "s": 13.08, "e": 13.2}]}, {"start": 13.2, "end": 14.84, "text": "היא שלושים מעלות.", "words": [{"t": "היא", "s": 13.2, "e": 13.64}, {"t": "שלושים", "s": 13.64, "e": 14.06}, {"t": "מעלות.", "s": 14.06, "e": 14.72}]}, {"start": 14.8, "end": 16.54, "text": "הזווית החדה השנייה", "words": [{"t": "הזווית", "s": 14.8, "e": 15.6}, {"t": "החדה", "s": 15.6, "e": 15.9}, {"t": "השנייה", "s": 15.9, "e": 16.42}]}, {"start": 16.42, "end": 17.86, "text": "היא שישים מעלות.", "words": [{"t": "היא", "s": 16.42,