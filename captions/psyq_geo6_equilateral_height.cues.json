{"slug": "psyq_geo6_equilateral_height", "duration": 34.32, "cues": [{"start": 0.0, "end": 1.84, "text": "משולש שווה צלעות,", "words": [{"t": "משולש", "s": 0.0, "e": 0.94}, {"t": "שווה", "s": 0.94, "e": 1.39}, {"t": "צלעות,", "s": 1.39, "e": 1.84}]}, {"start": 1.9, "end": 3.28, "text": "וצריך את הגובה.", "words": [{"t": "וצריך", "s": 1.9, "e": 2.66}, {"t": "את", "s": 2.66, "e": 2.78}, {"t": "הגובה.", "s": 2.78, "e": 3.28}]}, {"start": 3.7, "end": 5.16, "text": "מורידים גובה מקדקוד", "words": [{"t": "מורידים", "s": 3.7, "e": 4.16}, {"t": "גובה", "s": 4.16, "e": 4.48}, {"t": "מקדקוד", "s": 4.48, "e": 5.16}]}, {"start": 5.16, "end": 6.32, "text": "אל הצלע שמולו.", "words": [{"t": "אל", "s": 5.16, "e": 5.46}, {"t": "הצלע", "s": 5.46, "e": 5.92}, {"t": "שמולו.", "s": 5.92, "e": 6.32}]}, {"start": 6.46, "end": 8.54, "text": "הגובה חוצה את המשולש", "words": [{"t": "הגובה", "s": 6.46, "e": 7.38}, {"t": "חוצה", "s": 7.38, "e": 7.86}, {"t": "את", "s": 7.86, "e": 7.94}, {"t": "המשולש", "s": 7.94, "e": 8.54}]}, {"start": 8.54, "end": 9.84, "text": "לשני חצאים זהים.", "words": [{"t": "לשני", "s": 8.54, "e": 8.94}, {"t": "חצאים", "s": 8.94, "e": 9.48}, {"t": "זהים.", "s": 9.48, "e": 9.84}]}, {"start": 10.22, "end": 12.16, "text": "כל חצי הוא משולש", "words": [{"t": "כל", "s": 10.22, "e": 10.68}, {"t": "חצי", "s": 10.68, "e": 11.3}, {"t": "הוא", "s": 11.3, "e": 11.48}, {"t": "משולש", "s": 11.48, "e": 12.16}]}, {"start": 12.16, "end": 13.9, "text": "שלושים, שישים, תשעים.", "words": [{"t": "שלושים,", "s": 12.16, "e": 12.62}, {"t": "שישים,", "s": 12.62, "e": 13.22}, {"t": "תשעים.", "s": 13.22, "e": 13.9}]}, {"start": 14.38, "end": 15.88, "text": "היתר שלו הוא", "words": [{"t": "היתר", "s": 14.38, "e": 15.28}, {"t": "שלו", "s": 15.28, "e": 15.6}, {"t": "הוא", "s": 15.6, "e": 15.88}]}, {"start": 15.88, "end": 17.24, "text": "צלע המשולש המקורי.", "words": [{"t": "צלע", "s": 15.88, "e": 16.22}, {"t": "המשולש", "s": 16.22, "e": 16.76}, {"t": "המקורי.", "s": 16.76, "e": 17.24}]}, {"start": 17.5, "end": 20.1, "text": "הניצב הקצר הוא מחצית הצלע.", "words": [{"t": "הניצב", "s": 17.5, "e": 18.1}, {"t": "הקצר", "s": 18.1, "e": 18.78}, {"t": "הוא", "s": 18.78, "e": 18.98}, {"t": "מחצית", "s": 18.98, "e": 19.62}, {"t": "הצלע.", "s": 19.62, "e": 20.1}]}, {"start": 20.1, "end": 22.2, "text": "והגובה הוא הניצב", "words": [{"t": "והגובה", "s": 20.1, "e": 21.36}, {"t": "הוא", "s": 21.36, "e": 21.64}, {"t": "הניצב", "s": 21.64, "e": 22.2}]}, {"start": 22.2, "end": 23.38, "text": "שמול זווית השישים.", "words": [{"t": "שמול", "s": 22.2, "e": 22.78}, {"t": "זווית", "s": 22.78, "e": 23.1}, {"t": "השישים.", "s": 23.1, "e": 23.38}]}, {"start": 23.64, "end": 25.54, "text": "הוא גדול מהניצב הקצר", "words": [{"t": "הוא", "s": 23.64, "e": 24.1}, {"t": "גדול", "s": 24.1, "e": 24.62}, {"t": "מהניצב", "s": 24.62, "e": 25.1}, {"t": "הקצר", "s": 25.1, "e": 25.54}]}, {"start": 25.54, "end": 26.62, "text": "פי שורש שלוש.", "words": [{"t": "פי", "s": 25.54, "e": 25.74}, {"t": "שורש", "s": 25.74, "e": 26.18}, {"t": "שלוש.", "s": 26.18, "e": 26.62}]}, {"start": 26.62, "end": 29.04, "text": "לכן הגובה הוא מחצית", "words": [{"t": "לכן", "s": 26.62, "e": 27.62}, {"t": "הגובה", "s": 27.62, "e": 28.32}, {"t": "הוא", "s": 28.32, "e": 28.44}, {"t": "מחצית", "s": 28.44, "e": 29.04}]}, {"start": 29.04, "end": 31.0, "text": "הצלע כפול שורש שלוש.", "words": [{"t": "הצלע", "s": 29.04, "e": 29.52}, {"t": "כפול", "s": 29.52, "e": 30.3}, {"t": "שורש", "s": 30.3, "e": 30.66}, {"t": "שלוש.", "s": 30.66, "e": 31.0}]}, {"start": 31.52, "end": 33.92, "text": "בפעם הבאה, לא צריך פיתגורס.", "words": [{"t": "בפעם", "s": 31.52, "e": 31.96}, {"t": "הבאה,", "s": 31.96, "e": 32.38}, {"t": "לא", "s": 32.38, "e": 32.92}, {"t": "צריך", "s": 32.92, "e": 33.38}, {"t": "פיתגורס.", "s": 33.38, "e": 33.92}]}]}
