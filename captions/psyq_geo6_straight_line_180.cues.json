{"slug": "psyq_geo6_straight_line_180", "duration": 32.98, "cues": [{"start": 0.0, "end": 2.24, "text": "שתי זוויות יושבות זו ליד", "words": [{"t": "שתי", "s": 0.0, "e": 0.56}, {"t": "זוויות", "s": 0.56, "e": 1.04}, {"t": "יושבות", "s": 1.04, "e": 1.62}, {"t": "זו", "s": 1.62, "e": 1.9}, {"t": "ליד", "s": 1.9, "e": 2.24}]}, {"start": 2.24, "end": 3.54, "text": "זו על קו ישר.", "words": [{"t": "זו", "s": 2.24, "e": 2.54}, {"t": "על", "s": 2.54, "e": 2.7}, {"t": "קו", "s": 2.7, "e": 3.0}, {"t": "ישר.", "s": 3.0, "e": 3.54}]}, {"start": 3.6, "end": 4.84, "text": "את הראשונה נותנים,", "words": [{"t": "את", "s": 3.6, "e": 4.0}, {"t": "הראשונה", "s": 4.0, "e": 4.46}, {"t": "נותנים,", "s": 4.46, "e": 4.84}]}, {"start": 4.98, "end": 6.44, "text": "על השנייה שואלים.", "words": [{"t": "על", "s": 4.98, "e": 5.24}, {"t": "השנייה", "s": 5.24, "e": 5.72}, {"t": "שואלים.", "s": 5.72, "e": 6.44}]}, {"start": 6.88, "end": 8.04, "text": "אל תמדדו אותה בעין,", "words": [{"t": "אל", "s": 6.88, "e": 7.16}, {"t": "תמדדו", "s": 7.16, "e": 7.58}, {"t": "אותה", "s": 7.58, "e": 7.66}, {"t": "בעין,", "s": 7.66, "e": 8.04}]}, {"start": 8.16, "end": 9.44, "text": "השרטוט לא בקנה מידה.", "words": [{"t": "השרטוט", "s": 8.16, "e": 8.62}, {"t": "לא", "s": 8.62, "e": 8.82}, {"t": "בקנה", "s": 8.82, "e": 9.13}, {"t": "מידה.", "s": 9.13, "e": 9.44}]}, {"start": 10.08, "end": 11.9, "text": "זוויות סמוכות על קו ישר", "words": [{"t": "זוויות", "s": 10.08, "e": 10.5}, {"t": "סמוכות", "s": 10.5, "e": 11.02}, {"t": "על", "s": 11.02, "e": 11.16}, {"t": "קו", "s": 11.16, "e": 11.44}, {"t": "ישר", "s": 11.44, "e": 11.9}]}, {"start": 11.9, "end": 13.18, "text": "משלימות זו את זו.", "words": [{"t": "משלימות", "s": 11.9, "e": 12.58}, {"t": "זו", "s": 12.58, "e": 12.82}, {"t": "את", "s": 12.82, "e": 12.94}, {"t": "זו.", "s": 12.94, "e": 13.18}]}, {"start": 13.18, "end": 15.5, "text": "יחד הן 180 מעלות.", "words": [{"t": "יחד", "s": 13.18, "e": 14.0}, {"t": "הן", "s": 14.0, "e": 14.28}, {"t": "180", "s": 14.28, "e"