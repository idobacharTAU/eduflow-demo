{"slug": "psyq_geo7_parallel_cut_top_ninth", "duration": 42.82, "cues": [{"start": 0, "end": 2.02, "text": "קו מקביל לבסיס חותך", "words": [{"t": "קו", "s": 0, "e": 0.36}, {"t": "מקביל", "s": 0.36, "e": 0.74}, {"t": "לבסיס", "s": 0.74, "e": 1.16}, {"t": "חותך", "s": 1.16, "e": 1.9}]}, {"start": 1.9, "end": 4.7, "text": "משולש ומחלק צלע, שתיים", "words": [{"t": "משולש", "s": 1.9, "e": 2.46}, {"t": "ומחלק", "s": 2.46, "e": 3.36}, {"t": "צלע,", "s": 3.36, "e": 3.82}, {"t": "שתיים", "s": 3.84, "e": 4.58}]}, {"start": 4.58, "end": 7, "text": "מהקדקוד וארבע עד הבסיס.", "words": [{"t": "מהקדקוד", "s": 4.58, "e": 5.12}, {"t": "וארבע", "s": 5.12, "e": 5.98}, {"t": "עד", "s": 5.98, "e": 6.42}, {"t": "הבסיס.", "s": 6.42, "e": 6.88}]}, {"start": 7.5, "end": 8.9, "text": "איזה חלק מהשטח", "words": [{"t": "איזה", "s": 7.5, "e": 7.94}, {"t": "חלק", "s": 7.94, "e": 8.22}, {"t": "מהשטח", "s": 8.22, "e": 8.78}]}, {"start": 8.78, "end": 9.7, "text": "נחתך למעלה?", "words": [{"t": "נחתך", "s": 8.78, "e": 9.16}, {"t": "למעלה?", "s": 9.16, "e": 9.58}]}, {"start": 10.2, "end": 11.48, "text": "שליש נשמע הגיוני", "words": [{"t": "שליש", "s": 10.2, "e": 10.64}, {"t": "נשמע", "s": 10.64, "e": 10.96}, {"t": "הגיוני", "s": 10.96, "e": 11.36}]}, {"start": 11.36, "end": 12.38, "text": "וגם רבע.", "words": [{"t": "וגם", "s": 11.36, "e": 11.94}, {"t": "רבע.", "s": 11.94, "e": 12.26}]}, {"start": 12.72, "end": 14.2, "text": "שניהם טעות.", "words": [{"t": "שניהם", "s": 12.72, "e": 13.6}, {"t": "טעות.", "s": 13.6, "e": 14.08}]}, {"start": 14.72, "end": 16.3, "text": "הקו המקביל יוצר", "words": [{"t": "הקו", "s": 14.72, "e": 15.16}, {"t": "המקביל", "s": 15.16, "e": 15.64}, {"t": "יוצר", "s": 15.64, "e": 16.18}]}, {"start": 16.18, "end": 17.24, "text": "משולש דומה.", "words": [{"t": "משולש", "s": 16.18, "e": 16.72}, {"t": "דומה.", "s": 16.72, "e": 17.12}]}, {"start": 17.48, "end": 19.48, "text": "בדמיון משווים לצלע", "words": [{"t": "בדמיון", "s": 17.48, "e": 18.36}, {"t": "משווים", "s": 18.36, "e": 18.96}, {"t": "לצלע", "s": 18.96, "e": 19.36}]}, {"start": 19.36, "end": 20.9, "text": "כולה, לא לקטע.", "words": [{"t": "כולה,", "s": 19.36, "e": 19.9}, {"t": "לא", "s": 19.92, "e": 20.34}, {"t": "לקטע.", "s": 20.34, "e": 20.78}]}, {"start": 21.4, "end": 22.68, "text": "הצלע כולה היא", "words": [{"t": "הצלע", "s": 21.4, "e": 21.84}, {"t": "כולה", "s": 21.84, "e": 22.3}, {"t": "היא", "s": 22.3, "e": 22.56}]}, {"start": 22.56, "end": 23.92, "text": "סכום שני הקטעים.", "words": [{"t": "סכום", "s": 22.56, "e": 23.04}, {"t": "שני", "s": 23.04, "e": 23.38}, {"t": "הקטעים.", "s": 23.38, "e": 23.8}]}, {"start": 24, "end": 26.56, "text": "יחס הדמיון שתיים חלקי", "words": [{"t": "יחס", "s": 24, "e": 24.78}, {"t": "הדמיון", "s": 24.78, "e": 25.28}, {"t": "שתיים", "s": 25.28, "e": 26.06}, {"t": "חלקי", "s": 26.06, "e": 26.44}]}, {"start": 26.44, "end": 28.16, "text": "שש, כלומר שליש.", "words": [{"t": "שש,", "s": 26.44, "e": 26.78}, {"t": "כלומר", "s": 26.82, "e": 27.4}, {"t": "שליש.", "s": 27.4, "e": 28.04}]}, {"start": 28.04, "end": 30.34, "text": "אבל שליש הוא יחס", "words": [{"t": "אבל", "s": 28.04, "e": 28.98}, {"t": "שליש", "s": 28.98, "e": 29.6}, {"t": "הוא", "s": 29.6, "e": 29.76}, {"t": "יחס", "s": 29.76, "e": 30.22}]}, {"start": 30.22, "end": 32.06, "text": "הצלעות, לא השטח.", "words": [{"t": "הצלעות,", "s": 30.22, "e": 30.94}, {"t": "לא", "s": 30.98, "e": 31.38}, {"t": "השטח.", "s": 31.38, "e": 31.94}]}, {"start": 32.33, "end": 35.16, "text": "מעלים בריבוע והשטח תשיעית.", "words": [{"t": "מעלים", "s": 32.33, "e": 32.78}, {"t": "בריבוע", "s": 32.78, "e": 33.22}, {"t": "והשטח", "s": 33.22, "e": 34.3}, {"t": "תשיעית.", "s": 34.3, "e": 35.04}]}, {"start": 35.18, "end": 38.06, "text": "והטרפז שמתחת שמונה תשיעיות.", "words": [{"t": "והטרפז", "s": 35.18, "e": 36.08}, {"t": "שמתחת", "s": 36.08, "e": 36.66}, {"t": "שמונה", "s": 36.66, "e": 37.5}, {"t": "תשיעיות.", "s": 37.5, "e": 37.94}]}, {"start": 38.53, "end": 39.8, "text": "קודם מחלקים בצלע", "words": [{"t": "קודם", "s": 38.53, "e": 38.98}, {"t": "מחלקים", "s": 38.98, "e": 39.36}, {"t": "בצלע", "s": 39.36, "e": 39.68}]}, {"start": 39.68, "end": 41.34, "text": "כולה ואז מרבעים.", "words": [{"t": "כולה", "s": 39.68, "e": 40.1}, {"t": "ואז", "s": 40.1, "e": 40.8}, {"t": "מרבעים.", "s": 40.8, "e": 41.22}]}]}
