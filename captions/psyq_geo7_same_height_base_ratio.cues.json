{"slug": "psyq_geo7_same_height_base_ratio", "duration": 41.78, "cues": [{"start": 0, "end": 3.08, "text": "משולש בשטח שישים, והבסיס", "words": [{"t": "משולש", "s": 0, "e": 0.76}, {"t": "בשטח", "s": 0.76, "e": 1.4}, {"t": "שישים,", "s": 1.4, "e": 1.66}, {"t": "והבסיס", "s": 2.04, "e": 2.96}]}, {"start": 2.96, "end": 5.02, "text": "נחתך ביחס אחד לשניים.", "words": [{"t": "נחתך", "s": 2.96, "e": 3.46}, {"t": "ביחס", "s": 3.46, "e": 3.98}, {"t": "אחד", "s": 3.98, "e": 4.26}, {"t": "לשניים.", "s": 4.26, "e": 4.9}]}, {"start": 5.12, "end": 7.26, "text": "קו מהקדקוד העליון", "words": [{"t": "קו", "s": 5.12, "e": 5.94}, {"t": "מהקדקוד", "s": 5.94, "e": 6.62}, {"t": "העליון", "s": 6.62, "e": 7.14}]}, {"start": 7.14, "end": 8.48, "text": "אל נקודת החיתוך.", "words": [{"t": "אל", "s": 7.14, "e": 7.42}, {"t": "נקודת", "s": 7.42, "e": 7.92}, {"t": "החיתוך.", "s": 7.92, "e": 8.36}]}, {"start": 8.7, "end": 10.28, "text": "מה שטח המשולש", "words": [{"t": "מה", "s": 8.7, "e": 9.18}, {"t": "שטח", "s": 9.18, "e": 9.62}, {"t": "המשולש", "s": 9.62, "e": 10.16}]}, {"start": 10.16, "end": 11.44, "text": "הקטן מביניהם?", "words": [{"t": "הקטן", "s": 10.16, "e": 10.76}, {"t": "מביניהם?", "s": 10.76, "e": 11.32}]}, {"start": 11.6, "end": 13.7, "text": "מפתה לרבע את היחס,", "words": [{"t": "מפתה", "s": 11.6, "e": 12.38}, {"t": "לרבע", "s": 12.38, "e": 12.86}, {"t": "את", "s": 12.86, "e": 13.02}, {"t": "היחס,", "s": 13.02, "e": 13.58}]}, {"start": 13.62, "end": 15.08, "text": "אבל המשולשים האלה", "words": [{"t": "אבל", "s": 13.62, "e": 14.06}, {"t": "המשולשים", "s": 14.06, "e": 14.54}, {"t": "האלה", "s": 14.54, "e": 14.96}]}, {"start": 14.96, "end": 16.36, "text": "לא בהכרח דומים.", "words": [{"t": "לא", "s": 14.96, "e": 15.36}, {"t": "בהכרח", "s": 15.36, "e": 15.88}, {"t": "דומים.", "s": 15.88, "e": 16.24}]}, {"start": 16.46, "end": 18.68, "text": "לפני שמרבעים, שאלו", "words": [{"t": "לפני", "s": 16.46, "e": 17.24}, {"t": "שמרבעים,", "s": 17.24, "e": 17.84}, {"t": "שאלו", "s": 17.92, "e": 18.56}]}, {"start": 18.56, "end": 20.24, "text": "מה משותף לשניהם.", "words": [{"t": "מה", "s": 18.56, "e": 18.92}, {"t": "משותף", "s": 18.92, "e": 19.64}, {"t": "לשניהם.", "s": 19.64, "e": 20.12}]}, {"start": 20.38, "end": 22.48, "text": "הם חולקים אותו גובה.", "words": [{"t": "הם", "s": 20.38, "e": 20.82}, {"t": "חולקים", "s": 20.82, "e": 21.3}, {"t": "אותו", "s": 21.3, "e": 21.56}, {"t": "גובה.", "s": 21.56, "e": 22.36}]}, {"start": 22.94, "end": 24.32, "text": "שטח הוא בסיס כפול", "words": [{"t": "שטח", "s": 22.94, "e": 23.38}, {"t": "הוא", "s": 23.38, "e": 23.56}, {"t": "בסיס", "s": 23.56, "e": 23.94}, {"t": "כפול", "s": 23.94, "e": 24.2}]}, {"start": 24.2, "end": 24.98, "text": "גובה חלקי שתיים.", "words": [{"t": "גובה", "s": 24.2, "e": 24.5}, {"t": "חלקי", "s": 24.5, "e": 24.74}, {"t": "שתיים.", "s": 24.74, "e": 24.86}]}, {"start": 25.46, "end": 26.9, "text": "גובה זהה, אז", "words": [{"t": "גובה", "s": 25.46, "e": 25.9}, {"t": "זהה,", "s": 25.9, "e": 26.22}, {"t": "אז", "s": 26.32, "e": 26.78}]}, {"start": 26.78, "end": 28.54, "text": "השטחים ביחס הבסיסים.", "words": [{"t": "השטחים", "s": 26.78, "e": 27.28}, {"t": "ביחס", "s": 27.28, "e": 27.96}, {"t": "הבסיסים.", "s": 27.96, "e": 28.42}]}, {"start": 28.42, "end": 30.96, "text": "שלושה חלקים, עשרים בכל", "words": [{"t": "שלושה", "s": 28.42, "e": 29.38}, {"t": "חלקים,", "s": 29.38, "e": 29.84}, {"t": "עשרים", "s": 29.88, "e": 30.42}, {"t": "בכל", "s": 30.42, "e": 30.84}]}, {"start": 30.84, "end": 32.88, "text": "חלק, הקטן יוצא עשרים.", "words": [{"t": "חלק,", "s": 30.84, "e": 31.18}, {"t": "הקטן", "s": 31.24, "e": 32}, {"t": "יוצא", "s": 32, "e": 32.34}, {"t": "עשרים.", "s": 32.34, "e": 32.76}]}, {"start": 33.02, "end": 34.5, "text": "והגדול ארבעים.", "words": [{"t": "והגדול", "s": 33.02, "e": 33.94}, {"t": "ארבעים.", "s": 33.94, "e": 34.38}]}, {"start": 35.34, "end": 37.68, "text": "גובה משותף, יחס הבסיסים.", "words": [{"t": "גובה", "s": 35.34, "e": 35.78}, {"t": "משותף,", "s": 35.78, "e": 36.32}, {"t": "יחס", "s": 36.34, "e": 37.1}, {"t": "הבסיסים.", "s": 37.1, "e": 37.56}]}, {"start": 37.88, "end": 40.3, "text": "צורה דומה, ריבוע היחס.", "words": [{"t": "צורה", "s": 37.88, "e": 38.32}, {"t": "דומה,", "s": 38.32, "e": 38.76}, {"t": "ריבוע", "s": 38.76, "e": 39.66}, {"t": "היחס.", "s": 39.66, "e": 40.18}]}]}
