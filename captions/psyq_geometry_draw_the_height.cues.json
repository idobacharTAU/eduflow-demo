{"slug": "psyq_geometry_draw_the_height", "duration": 60.3, "cues": [{"start": 0, "end": 1.76, "text": "משולש נטוי על הדף,", "words": [{"t": "משולש", "s": 0, "e": 0.8}, {"t": "נטוי", "s": 0.8, "e": 1.16}, {"t": "על", "s": 1.16, "e": 1.3}, {"t": "הדף,", "s": 1.3, "e": 1.64}]}, {"start": 1.78, "end": 3.58, "text": "בלי אף זווית ישרה.", "words": [{"t": "בלי", "s": 1.78, "e": 2.28}, {"t": "אף", "s": 2.28, "e": 2.68}, {"t": "זווית", "s": 2.68, "e": 3.06}, {"t": "ישרה.", "s": 3.06, "e": 3.46}]}, {"start": 3.84, "end": 5.92, "text": "נתון, בסיס שש,", "words": [{"t": "נתון,", "s": 3.84, "e": 4.62}, {"t": "בסיס", "s": 4.74, "e": 5.52}, {"t": "שש,", "s": 5.52, "e": 5.8}]}, {"start": 6.08, "end": 7.26, "text": "גובה ארבע.", "words": [{"t": "גובה", "s": 6.08, "e": 6.82}, {"t": "ארבע.", "s": 6.82, "e": 7.14}]}, {"start": 7.52, "end": 9.08, "text": "מבקשים את השטח.", "words": [{"t": "מבקשים", "s": 7.52, "e": 8.3}, {"t": "את", "s": 8.3, "e": 8.44}, {"t": "השטח.", "s": 8.44, "e": 8.96}]}, {"start": 9.32, "end": 11.12, "text": "אין בשרטוט שום", "words": [{"t": "אין", "s": 9.32, "e": 9.88}, {"t": "בשרטוט", "s": 9.88, "e": 10.4}, {"t": "שום", "s": 10.4, "e": 11}]}, {"start": 11, "end": 12.18, "text": "צלע באורך ארבע.", "words": [{"t": "צלע", "s": 11, "e": 11.42}, {"t": "באורך", "s": 11.42, "e": 11.86}, {"t": "ארבע.", "s": 11.86, "e": 12.06}]}, {"start": 12.26, "end": 14, "text": "והיד כבר מחפשת", "words": [{"t": "והיד", "s": 12.26, "e": 13.04}, {"t": "כבר", "s": 13.04, "e": 13.32}, {"t": "מחפשת", "s": 13.32, "e": 13.88}]}, {"start": 13.88, "end": 15.24, "text": "שתי צלעות להכפיל.", "words": [{"t": "שתי", "s": 13.88, "e": 14.18}, {"t": "צלעות", "s": 14.18, "e": 14.6}, {"t": "להכפיל.", "s": 14.6, "e": 15.12}]}, {"start": 15.12, "end": 16.36, "text": "עצור.", "words": [{"t": "עצור.", "s": 15.12, "e": 16.24}]}, {"start": 16.3, "end": 18.1, "text": "פה הגובה הוא", "words": [{"t": "פה", "s": 16.3, "e": 16.98}, {"t": "הגובה", "s": 16.98, "e": 17.78}, {"t": "הוא", "s": 17.78, "e": 17.98}]}, {"start": 17.98, "end": 18.96, "text": "בכלל לא צלע.", "words": [{"t": "בכלל", "s": 17.98, "e": 18.38}, {"t": "לא", "s": 18.38, "e": 18.48}, {"t": "צלע.", "s": 18.48, "e": 18.84}]}, {"start": 18.92, "end": 21, "text": "הוא קו ניצב לבסיס", "words": [{"t": "הוא", "s": 18.92, "e": 19.4}, {"t": "קו", "s": 19.4, "e": 19.78}, {"t": "ניצב", "s": 19.78, "e": 20.34}, {"t": "לבסיס", "s": 20.34, "e": 20.88}]}, {"start": 20.88, "end": 22.9, "text": "שיורד מהקדקוד שממול.", "words": [{"t": "שיורד", "s": 20.88, "e": 21.72}, {"t": "מהקדקוד", "s": 21.72, "e": 22.3}, {"t": "שממול.", "s": 22.3, "e": 22.78}]}, {"start": 22.86, "end": 25.08, "text": "אז תצייר אותו לבד,", "words": [{"t": "אז", "s": 22.86, "e": 23.64}, {"t": "תצייר", "s": 23.64, "e": 24.38}, {"t": "אותו", "s": 24.38, "e": 24.5}, {"t": "לבד,", "s": 24.5, "e": 24.96}]}, {"start": 25, "end": 26.64, "text": "בזווית ישרה לבסיס.", "words": [{"t": "בזווית", "s": 25, "e": 25.62}, {"t": "ישרה", "s": 25.62, "e": 26.02}, {"t": "לבסיס.", "s": 26.02, "e": 26.52}]}, {"start": 26.64, "end": 27.9, "text": "זה הארבע.", "words": [{"t": "זה", "s": 26.64, "e": 27.24}, {"t": "הארבע.", "s": 27.24, "e": 27.78}]}, {"start": 28.02, "end": 29.9, "text": "עכשיו הנוסחה עובדת.", "words": [{"t": "עכשיו", "s": 28.02, "e": 28.88}, {"t": "הנוסחה", "s": 28.88, "e": 29.34}, {"t": "עובדת.", "s": 29.34, "e": 29.78}]}, {"start": 30.04, "end": 31.78, "text": "שש כפול ארבע זה", "words": [{"t": "שש", "s": 30.04, "e": 30.5}, {"t": "כפול", "s": 30.5, "e": 30.92}, {"t": "ארבע", "s": 30.92, "e": 31.14}, {"t": "זה", "s": 31.14, "e": 31.66}]}, {"start": 31.66, "end": 33.91, "text": "עשרים וארבע, וחלקי שתיים", "words": [{"t": "עשרים", "s": 31.66, "e": 31.88}, {"t": "וארבע,", "s": 31.88, "e": 32.1}, {"t": "וחלקי", "s": 32.5, "e": 33.48}, {"t": "שתיים", "s": 33.48, "e": 33.79}]}, {"start": 33.79, "end": 34.52, "text": "— שתיים עשרה.", "words": [{"t": "—", "s": 33.79, "e": 33.85}, {"t": "שתיים", "s": 33.85, "e": 34.15}, {"t": "עשרה.", "s": 34.15, "e": 34.4}]}, {"start": 35.1, "end": 36.82, "text": "וזאת התשובה הנכונה.", "words": [{"t": "וזאת", "s": 35.1, "e": 35.96}, {"t": "התשובה", "s": 35.96, "e": 36.32}, {"t": "הנכונה.", "s": 36.32, "e": 36.7}]}, {"start": 37.08, "end": 39.18, "text": "המלכודת עובדת כי במלבן", "words": [{"t": "המלכודת", "s": 37.08, "e": 37.94}, {"t": "עובדת", "s": 37.94, "e": 38.38}, {"t": "כי", "s": 38.38, "e": 38.5}, {"t": "במלבן", "s": 38.5, "e": 39.06}]}, {"start": 39.06, "end": 40.98, "text": "שתי המידות הן צלעות.", "words": [{"t": "שתי", "s": 39.06, "e": 39.64}, {"t": "המידות", "s": 39.64, "e": 40.2}, {"t": "הן", "s": 40.2, "e": 40.39}, {"t": "צלעות.", "s": 40.39, "e": 40.86}]}, {"start": 41.12, "end": 42.28, "text": "עוד אחד.", "words": [{"t": "עוד", "s": 41.12, "e": 41.96}, {"t": "אחד.", "s": 41.96, "e": 42.16}]}, {"start": 42.34, "end": 44.78, "text": "בסיס עשר, גובה שלוש,", "words": [{"t": "בסיס", "s": 42.34, "e": 43.08}, {"t": "עשר,", "s": 43.08, "e": 43.34}, {"t": "גובה", "s": 43.66, "e": 44.34}, {"t": "שלוש,", "s": 44.34, "e": 44.66}]}, {"start": 45.12, "end": 46.66, "text": "ושוב, לא צלע.", "words": [{"t": "ושוב,", "s": 45.12, "e": 45.74}, {"t": "לא", "s": 45.8, "e": 46.14}, {"t": "צלע.", "s": 46.14, "e": 46.54}]}, {"start": 46.7, "end": 49.28, "text": "מורידים אנך, ועשר כפול", "words": [{"t": "מורידים", "s": 46.7, "e": 47.5}, {"t": "אנך,", "s": 47.5, "e": 48.04}, {"t": "ועשר", "s": 48.04, "e": 48.76}, {"t": "כפול", "s": 48.76, "e": 49.16}]}, {"start": 49.16, "end": 50.14, "text": "שלוש חלקי שתיים", "words": [{"t": "שלוש", "s": 49.16, "e": 49.42}, {"t": "חלקי", "s": 49.42, "e": 49.88}, {"t": "שתיים", "s": 49.88, "e": 50.02}]}, {"start": 50.02, "end": 51, "text": "זה חמש עשרה.", "words": [{"t": "זה", "s": 50.02, "e": 50.62}, {"t": "חמש", "s": 50.62, "e": 50.73}, {"t": "עשרה.", "s": 50.73, "e": 50.88}]}, {"start": 51.28, "end": 53.96, "text": "אבל במשולש ישר זווית,", "words": [{"t": "אבל", "s": 51.28, "e": 52.06}, {"t": "במשולש", "s": 52.06, "e": 52.84}, {"t": "ישר", "s": 52.84, "e": 53.38}, {"t": "זוו