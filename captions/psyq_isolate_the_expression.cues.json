ds": [{"t": "מחפשים", "s": 32.02, "e": 32.86}, {"t": "פעולה,", "s": 32.86, "e": 33.4}, {"t": "לא", "s": 33.42, "e": 33.82}, {"t": "נעלמים.", "s": 33.82, "e": 34.365}]}], "captions_default": "on", "text_load": {"mean_visible_words": 7.1, "threshold": 20.0}}
