{"slug": "psyq_isolate_the_expression", "duration": 34.77, "cues": [{"start": 0.0, "end": 1.68, "text": "שלוש איקס ועוד", "words": [{"t": "שלוש", "s": 0.0, "e": 0.48}, {"t": "איקס", "s": 0.48, "e": 0.96}, {"t": "ועוד", "s": 0.96, "e": 1.68}]}, {"start": 1.68, "end": 4.175, "text": "שתים עשרה איגרק שווים שלושים.", "words": [{"t": "שתים", "s": 1.68, "e": 1.924}, {"t": "עשרה", "s": 1.924, "e": 2.167}, {"t": "איגרק", "s": 2.167, "e": 2.46}, {"t": "שווים", "s": 2.46, "e": 3.42}, {"t": "שלושים.", "s": 3.42, "e": 4.175}]}, {"start": 4.32, "end": 6.461, "text": "מהו איקס ועוד ארבע איגרק?", "words": [{"t": "מהו", "s": 4.32, "e": 5.08}, {"t": "איקס", "s": 5.08, "e": 5.34}, {"t": "ועוד", "s": 5.34, "e": 5.84}, {"t": "ארבע", "s": 5.84, "e": 5.995}, {"t": "איגרק?", "s": 5.995, "e": 6.461}]}, {"start": 6.98, "end": 7.74, "text": "הרפלקס:", "words": [{"t": "הרפלקס:", "s": 6.98, "e": 7.74}]}, {"start": 7.76, "end": 9.013, "text": "לחפש את הנעלמים.", "words": [{"t": "לחפש", "s": 7.76, "e": 8.28}, {"t": "את", "s": 8.28, "e": 8.4}, {"t": "הנעלמים.", "s": 8.4, "e": 9.013}]}, {"start": 9.22, "end": 11.28, "text": "משוואה אחת בשני נעלמים", "words": [{"t": "משוואה", "s": 9.22, "e": 9.98}, {"t": "אחת", "s": 9.98, "e": 10.42}, {"t": "בשני", "s": 10.42, "e": 10.82}, {"t": "נעלמים", "s": 10.82, "e": 11.28}]}, {"start": 11.28, "end": 12.5, "text": "לא קובעת אותם.", "words": [{"t": "לא", "s": 11.28, "e": 11.76}, {"t": "קובעת", "s": 11.76, "e": 12.2}, {"t": "אותם.", "s": 12.2, "e": 12.5}]}, {"start": 12.54, "end": 14.963, "text": "והשאלה ביקשה ביטוי, לא נעלם.", "words": [{"t": "והשאלה", "s": 12.54, "e": 13.34}, {"t": "ביקשה", "s": 13.34, "e": 13.66}, {"t": "ביטוי,", "s": 13.66, "e": 14.12}, {"t": "לא", "s": 14.22, "e": 14.52}, {"t": "נעלם.", "s": 14.52, "e": 14.963}]}, {"start": 15.06, "end": 16.4, "text": "אז איזו פעולה", "words": [{"t": "אז", "s": 15.06, "e": 15.64}, {"t": "איזו", "s": 15.64, "e": 15.98}, {"t": "פעולה", "s": 15.98, "e": 16.4}]}, {"start": 16.4, "end": 17.864, "text": "אחת מגיע