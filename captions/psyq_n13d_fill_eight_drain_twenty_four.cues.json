{"slug": "psyq_n13d_fill_eight_drain_twenty_four", "duration": 33.12, "cues": [{"start": 0.0, "end": 1.74, "text": "מתי תתמלא הבריכה,", "words": [{"t": "מתי", "s": 0.0, "e": 0.62}, {"t": "תתמלא", "s": 0.62, "e": 1.14}, {"t": "הבריכה,", "s": 1.14, "e": 1.74}]}, {"start": 1.74, "end": 3.14, "text": "כשיש גם ניקוז?", "words": [{"t": "כשיש", "s": 1.74, "e": 2.28}, {"t": "גם", "s": 2.28, "e": 2.62}, {"t": "ניקוז?", "s": 2.62, "e": 3.14}]}, {"start": 3.34, "end": 5.88, "text": "ברז ממלא אותה בשמונה שעות.", "words": [{"t": "ברז", "s": 3.34, "e": 4.14}, {"t": "ממלא", "s": 4.14, "e": 4.52}, {"t": "אותה", "s": 4.52, "e": 4.82}, {"t": "בשמונה", "s": 4.82, "e": 5.42}, {"t": "שעות.", "s": 5.42, "e": 5.88}]}, {"start": 5.92, "end": 7.66, "text": "ניקוז מרוקן אותה", "words": [{"t": "ניקוז", "s": 5.92, "e": 6.58}, {"t": "מרוקן", "s": 6.58, "e": 7.28}, {"t": "אותה", "s": 7.28, "e": 7.66}]}, {"start": 7.66, "end": 9.26, "text": "בעשרים וארבע שעות.", "words": [{"t": "בעשרים", "s": 7.66, "e": 8.0}, {"t": "וארבע", "s": 8.0, "e": 8.34}, {"t": "שעות.", "s": 8.34, "e": 9.26}]}, {"start": 9.3, "end": 10.54, "text": "פותחים שניהם יחד.", "words": [{"t": "פותחים", "s": 9.3, "e": 9.86}, {"t": "שניהם", "s": 9.86, "e": 10.24}, {"t": "יחד.", "s": 10.24, "e": 10.54}]}, {"start": 10.78, "end": 11.66, "text": "המלכודת:", "words": [{"t": "המלכודת:", "s": 10.78, "e": 11.66}]}, {"start": 11.76, "end": 14.34, "text": "לחבר קצבים, ולקבל שש שעות.", "words": [{"t": "לחבר", "s": 11.76, "e": 12.4}, {"t": "קצבים,", "s": 12.4, "e": 12.9}, {"t": "ולקבל", "s": 12.9, "e": 13.62}, {"t": "שש", "s": 13.62, "e": 13.92}, {"t": "שעות.", "s": 13.92, "e": 14.34}]}, {"start": 14.4, "end": 16.16, "text": "אבל הניקוז מוציא", "words": [{"t": "אבל", "s": 14.4, "e": 14.9}, {"t": "הניקוז", "s": 14.9, "e": 15.44}, {"t": "מוציא", "s": 15.44, "e": 16.16}]}, {"start": 16.16, "end": 17.28, "text": "מים, לא מוסיף.", "words": [{"t": "מים,", "s": 16.16, "e": 16.5}, {"t": "לא", "s": 16.58, "e": 16.84}, {"t": "מוסיף.", "s": 16.84, "e": 17.28}]}, {"start": 17.62, "end": 18.32, "text": "מחסרים:", "words": [{"t": "מחסרים:", "s": 17.62, "e": 18.32}]}, {"start": 18.44, "end": 20.38, "text": "אחד חלקי שמונה פחות", "words": [{"t": "אחד", "s": 18.44, "e": 18.88}, {"t": "חלקי", "s": 18.88, "e": 19.32}, {"t": "שמונה", "s": 19.32, "e": 19.48}, {"t": "פחות", "s": 19.48, "e": 20.38}]}, {"start": 20.38, "end": 21.52, "text": "אחד חלקי 24.", "words": [{"t": "אחד", "s": 20.38, "e": 20.66}, {"t": "חלקי", "s": 20.66, "e": 21.2}, {"t": "24.", "s": 21.2, "e": 21.52}]}, {"start": 21.98, "end": 22.86, "text": "הקצב:", "words": [{"t": "הקצב:", "s": 21.98, "e": 22.86}]}, {"start": 22.9, "end": 24.12, "text": "שתיים חלקי 24.", "words": [{"t": "שתיים", "s": 22.9, "e": 23.3}, {"t": "חלקי", "s": 23.3, "e": 23.86}, {"t": "24.", "s": 23.86, "e": 24.12}]}, {"start": 24.42, "end": 27.04, "text": "כלומר אחד חלקי 12 בשעה.", "words": [{"t": "כלומר", "s": 24.42, "e": 25.14}, {"t": "אחד", "s": 25.18, "e": 25.5}, {"t": "חלקי", "s": 25.5, "e": 26.06}, {"t": "12", "s": 26.06, "e": 26.22}, {"t": "בשעה.", "s": 26.22, "e": 27.04}]}, {"start": 27.2, "end": 29.82, "text": "הזמן הוא אחד חלקי ההפרש.", "words": [{"t": "הזמן", "s": 27.2, "e": 28.08}, {"t": "הוא", "s": 28.08, "e": 28.28}, {"t": "אחד", "s": 28.28, "e": 28.68}, {"t": "חלקי", "s": 28.68, "e": 29.36}, {"t": "ההפרש.", "s": 29.36, "e": 29.82}]}, {"start": 30.0, "end": 32.72, "text": "12 שעות, ארוך משמונה שעות.", "words": [{"t": "12", "s": 30.0, "e": 30.7}, {"t": "שעות,", "s": 30.7, "e": 31.4}, {"t": "ארוך", "s": 31.42, "e": 32.02}, {"t": "משמונה", "s": 32.02, "e": 32.38}, {"t": "שעות.", "s": 32.38, "e": 32.72}]}]}
