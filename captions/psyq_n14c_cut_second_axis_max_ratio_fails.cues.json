.7}, {"t": "קצוץ.", "s": 18.7, "e": 19.12}]}, {"start": 19.32, "end": 22.2, "text": "הטענה ששתיהן שוות היא מלכודת.", "words": [{"t": "הטענה", "s": 19.32, "e": 20.02}, {"t": "ששתיהן", "s": 20.02, "e": 20.56}, {"t": "שוות", "s": 20.56, "e": 20.92}, {"t": "היא", "s": 20.92, "e": 21.32}, {"t": "מלכודת.", "s": 21.32, "e": 22.2}]}, {"start": 22.42, "end": 23.88, "text": "שיוך הפוך של הצירים", "words": [{"t": "שיוך", "s": 22.42, "e": 22.92}, {"t": "הפוך", "s": 22.92, "e": 23.34}, {"t": "של", "s": 23.34, "e": 23.48}, {"t": "הצירים", "s": 23.48, "e": 23.88}]}, {"start": 23.88, "end": 24.84, "text": "גם הוא שגוי.", "words": [{"t": "גם", "s": 23.88, "e": 24.18}, {"t": "הוא", "s": 24.18, "e": 24.44}, {"t": "שגוי.", "s": 24.44, "e": 24.84}]}, {"start": 24.94, "end": 26.0, "text": "לכן אי אפשר", "words": [{"t": "לכן", "s": 24.94, "e": 25.52}, {"t": "אי", "s": 25.52, "e": 25.78}, {"t": "אפשר", "s": 25.78, "e": 26.0}]}, {"start": 26.0, "end": 27.74, "text": "לגזור יחס מהמקסימומים.", "words": [{"t": "לגזור", "s": 26.0, "e": 26.4}, {"t": "יחס", "s": 26.4, "e": 26.82}, {"t": "מהמקסימומים.", "s": 26.82, "e": 27.74}]}, {"start": 27.74, "end": 30.06, "text": "בציור העמודות שוות, אבל", "words": [{"t": "בציור", "s": 27.74, "e": 28.7}, {"t": "העמודות", "s": 28.7, "e": 29.22}, {"t": "שוות,", "s": 29.22, "e": 29.66}, {"t": "אבל", "s": 29.66, "e": 30.06}]}, {"start": 30.06, "end": 31.98, "text": "בערכים לא בהכרח.", "words": [{"t": "בערכים", "s": 30.06, "e": 30.84}, {"t": "לא", "s": 30.84, "e": 31.28}, {"t": "בהכרח.", "s": 31.28, "e": 31.98}]}, {"start": 32.02, "end": 33.68, "text": "זה נשבר כאן.", "words": [{"t": "זה", "s": 32.02, "e": 32.42}, {"t": "נשבר", "s": 32.42, "e": 33.14}, {"t": "כאן.", "s": 33.14, "e": 33.68}]}, {"start": 33.74, "end": 35.94, "text": "קודם קוראים את הצירים.", "words": [{"t": "קודם", "s": 33.74, "e": 34.6}, {"t": "קוראים", "s": 34.6, "e": 35.28}, {"t": "את", "s": 35.28, "e": 35.38}, {"t": "הצירים.", "s": 35.38, "e": 35.94}]}], "captions_default": "on", "text_load": {"