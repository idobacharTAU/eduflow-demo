{"slug": "psyq_order_matters_then_divide", "duration": 40.26, "cues": [{"start": 0, "end": 2.26, "text": "בכמה דרכים בוחרים ועד", "words": [{"t": "בכמה", "s": 0, "e": 0.66}, {"t": "דרכים", "s": 0.66, "e": 1.16}, {"t": "בוחרים", "s": 1.16, "e": 1.66}, {"t": "ועד", "s": 1.66, "e": 2.14}]}, {"start": 2.14, "end": 3.94, "text": "של שניים מתוך שישה?", "words": [{"t": "של", "s": 2.14, "e": 2.3}, {"t": "שניים", "s": 2.3, "e": 2.84}, {"t": "מתוך", "s": 2.84, "e": 3.4}, {"t": "שישה?", "s": 3.4, "e": 3.82}]}, {"start": 3.84, "end": 5.08, "text": "בלי תפקידים.", "words": [{"t": "בלי", "s": 3.84, "e": 4.46}, {"t": "תפקידים.", "s": 4.46, "e": 4.96}]}, {"start": 5.12, "end": 7.74, "text": "קודם שואלים, הסדר קובע?", "words": [{"t": "קודם", "s": 5.12, "e": 5.94}, {"t": "שואלים,", "s": 5.94, "e": 6.4}, {"t": "הסדר", "s": 6.48, "e": 7.26}, {"t": "קובע?", "s": 7.26, "e": 7.62}]}, {"start": 8.14, "end": 10.74, "text": "ההכרעה מהניסוח, לא מהתחושה.", "words": [{"t": "ההכרעה", "s": 8.14, "e": 8.98}, {"t": "מהניסוח,", "s": 8.98, "e": 9.56}, {"t": "לא", "s": 9.76, "e": 10.02}, {"t": "מהתחושה.", "s": 10.02, "e": 10.62}]}, {"start": 11.04, "end": 12.9, "text": "ועד בלי תפקידים, אז", "words": [{"t": "ועד", "s": 11.04, "e": 11.64}, {"t": "בלי", "s": 11.64, "e": 11.86}, {"t": "תפקידים,", "s": 11.86, "e": 12.36}, {"t": "אז", "s": 12.4, "e": 12.78}]}, {"start": 12.78, "end": 14.14, "text": "הסדר לא קובע.", "words": [{"t": "הסדר", "s": 12.78, "e": 13.3}, {"t": "לא", "s": 13.3, "e": 13.66}, {"t": "קובע.", "s": 13.66, "e": 14.02}]}, {"start": 14.46, "end": 16.08, "text": "דנה ויובל הם אותו", "words": [{"t": "דנה", "s": 14.46, "e": 14.88}, {"t": "ויובל", "s": 14.88, "e": 15.42}, {"t": "הם", "s": 15.42, "e": 15.76}, {"t": "אותו", "s": 15.76, "e": 15.96}]}, {"start": 15.96, "end": 17.86, "text": "ועד כמו יובל ודנה.", "words": [{"t": "ועד", "s": 15.96, "e": 16.4}, {"t": "כמו", "s": 16.4, "e": 16.64}, {"t": "יובל", "s": 16.64, "e": 17.16}, {"t": "ודנה.", "s": 17.16, "e": 17.74}]}, {"start": 18.4, "end": 2