{"slug": "psyq_percent_order_cannot_rescue", "duration": 42.9, "cues": [{"start": 0, "end": 1.76, "text": "היפוך הסדר לא", "words": [{"t": "היפוך", "s": 0, "e": 0.64}, {"t": "הסדר", "s": 0.64, "e": 1.18}, {"t": "לא", "s": 1.18, "e": 1.64}]}, {"start": 1.64, "end": 2.9, "text": "מציל את המחיר.", "words": [{"t": "מציל", "s": 1.64, "e": 2.16}, {"t": "את", "s": 2.16, "e": 2.3}, {"t": "המחיר.", "s": 2.3, "e": 2.78}]}, {"start": 3.24, "end": 5.08, "text": "מחיר ירד בעשרים אחוז,", "words": [{"t": "מחיר", "s": 3.24, "e": 3.7}, {"t": "ירד", "s": 3.7, "e": 4.14}, {"t": "בעשרים", "s": 4.14, "e": 4.7}, {"t": "אחוז,", "s": 4.7, "e": 4.96}]}, {"start": 4.96, "end": 7.42, "text": "ואז עלה בעשרים אחוז.", "words": [{"t": "ואז", "s": 4.96, "e": 5.84}, {"t": "עלה", "s": 5.84, "e": 6.44}, {"t": "בעשרים אחוז.", "s": 6.44, "e": 7.3}]}, {"start": 7.3, "end": 10.88, "text": "ביחס למקורי, גבוה, זהה,", "words": [{"t": "ביחס", "s": 7.3, "e": 8.28}, {"t": "למקורי,", "s": 8.28, "e": 8.88}, {"t": "גבוה,", "s": 8.9, "e": 9.8}, {"t": "זהה,", "s": 9.92, "e": 10.76}]}, {"start": 10.88, "end": 13.38, "text": "נמוך או תלוי במחיר.", "words": [{"t": "נמוך", "s": 10.88, "e": 11.7}, {"t": "או", "s": 11.7, "e": 12.2}, {"t": "תלוי", "s": 12.2, "e": 12.8}, {"t": "במחיר.", "s": 12.8, "e": 13.26}]}, {"start": 13.86, "end": 15.7, "text": "הירידה היא כפל", "words": [{"t": "הירידה", "s": 13.86, "e": 14.78}, {"t": "היא", "s": 14.78, "e": 15.06}, {"t": "כפל", "s": 15.06, "e": 15.58}]}, {"start": 15.58, "end": 16.8, "text": "באפס נקודה שמונה.", "words": [{"t": "באפס", "s": 15.58, "e": 16.04}, {"t": "נקודה שמונה.", "s": 16.04, "e": 16.68}]}, {"start": 17.08, "end": 18.94, "text": "העלייה היא כפל", "words": [{"t": "העלייה", "s": 17.08, "e": 18}, {"t": "היא", "s": 18, "e": 18.38}, {"t": "כפל", "s": 18.38, "e": 18.82}]}, {"start": 18.82, "end": 20.02, "text": "באחת נקודה שתיים.", "words": [{"t": "באחת", "s": 18.82, "e": 19.22}, {"t": "נקודה שתיים.", "s": 19.22, "e": 19.9}]}, {"start": 20.48, "end": 23.18, "text": "ובכפל הסדר לא משנה.", "words": [{"t": "ובכפל", "s": 20.48, "e": 21.4}, {"t": "הסדר", "s": 21.4, "e": 22.16}, {"t": "לא", "s": 22.16, "e": 22.6}, {"t": "משנה.", "s": 22.6, "e": 23.06}]}, {"start": 23.48, "end": 25.36, "text": "יוצא אפס נקודה תשעים ושש,", "words": [{"t": "יוצא", "s": 23.48, "e": 23.94}, {"t": "אפס", "s": 23.94, "e": 24.4}, {"t": "נקודה תשעים ושש,", "s": 24.4, "e": 25.24}]}, {"start": 25.56, "end": 27.06, "text": "פחות מאחד.", "words": [{"t": "פחות", "s": 25.56, "e": 26.46}, {"t": "מאחד.", "s": 26.46, "e": 26.94}]}, {"start": 27.16, "end": 28.8, "text": "כמו עלייה ואז ירידה.", "words": [{"t": "כמו", "s": 27.16, "e": 27.62}, {"t": "עלייה", "s": 27.62, "e": 28.02}, {"t": "ואז", "s": 28.02, "e": 28.3}, {"t": "ירידה.", "s": 28.3, "e": 28.68}]}, {"start": 28.68, "end": 31.26, "text": "והמכפלה נכונה לכל", "words": [{"t": "והמכפלה", "s": 28.68, "e": 29.98}, {"t": "נכונה", "s": 29.98, "e": 30.5}, {"t": "לכל", "s": 30.5, "e": 31.14}]}, {"start": 31.14, "end": 32.22, "text": "מחיר התחלתי.", "words": [{"t": "מחיר", "s": 31.14, "e": 31.62}, {"t": "התחלתי.", "s": 31.62, "e": 32.1}]}, {"start": 32.6, "end": 34.04, "text": "לכן המחיר הסופי", "words": [{"t": "לכן", "s": 32.6, "e": 33.08}, {"t": "המחיר", "s": 33.08, "e": 33.44}, {"t": "הסופי", "s": 33.44, "e": 33.92}]}, {"start": 33.92, "end": 35, "text": "נמוך יותר.", "words": [{"t": "נמוך", "s": 33.92, "e": 34.64}, {"t": "יותר.", "s": 34.64, "e": 34.88}]}, {"start": 35.18, "end": 37.18, "text": "אותו אחוז, למטה", "words": [{"t": "אותו", "s": 35.18, "e": 35.8}, {"t": "אחוז,", "s": 35.8, "e": 36.26}, {"t": "למטה", "s": 36.34, "e": 37.06}]}, {"start": 37.06, "end": 39.12, "text": "ולמעלה, בכל סדר,", "words": [{"t": "ולמעלה,", "s": 37.06, "e": 37.52}, {"t": "בכל", "s": 37.54, "e": 38.52}, {"t": "סדר,", "s": 38.52, "e": 39}]}, {"start": 39.02, "end": 41.42, "text": "מסיימים מתחת למקור.", "words": [{"t": "מסיימים", "s": 39.02, "e": 40.04}, {"t": "מתחת", "s": 40.04, "e": 40.88}, {"t": "למקור.", "s": 40.88, "e": 41.3}]}]}
