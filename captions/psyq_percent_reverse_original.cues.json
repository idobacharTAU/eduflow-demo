{"slug": "psyq_percent_reverse_original", "duration": 39.96, "cues": [{"start": 0, "end": 3.04, "text": "מוצר התייקר, עשרים וחמישה אחוז.", "words": [{"t": "מוצר", "s": 0, "e": 0.74}, {"t": "התייקר,", "s": 0.74, "e": 1.36}, {"t": "עשרים וחמישה אחוז.", "s": 1.38, "e": 2.92}]}, {"start": 2.92, "end": 5.06, "text": "המחיר עכשיו מאתיים וחמישים.", "words": [{"t": "המחיר", "s": 2.92, "e": 3.96}, {"t": "עכשיו", "s": 3.96, "e": 4.42}, {"t": "מאתיים וחמישים.", "s": 4.42, "e": 4.94}]}, {"start": 5.66, "end": 7.04, "text": "מה היה קודם?", "words": [{"t": "מה", "s": 5.66, "e": 6.3}, {"t": "היה", "s": 6.3, "e": 6.44}, {"t": "קודם?", "s": 6.44, "e": 6.92}]}, {"start": 7.5, "end": 8.9, "text": "ארבע אפשרויות על הדף.", "words": [{"t": "ארבע", "s": 7.5, "e": 7.82}, {"t": "אפשרויות", "s": 7.82, "e": 8.36}, {"t": "על", "s": 8.36, "e": 8.52}, {"t": "הדף.", "s": 8.52, "e": 8.78}]}, {"start": 9.12, "end": 10.88, "text": "המסיח הראשון מפתה,", "words": [{"t": "המסיח", "s": 9.12, "e": 9.78}, {"t": "הראשון", "s": 9.78, "e": 10.3}, {"t": "מפתה,", "s": 10.3, "e": 10.76}]}, {"start": 10.84, "end": 12.92, "text": "מאה שמונים ושבע וחצי.", "words": [{"t": "מאה שמונים ושבע", "s": 10.84, "e": 12.02}, {"t": "וחצי.", "s": 12.02, "e": 12.8}]}, {"start": 13.04, "end": 14.1, "text": "הוא מוריד את", "words": [{"t": "הוא", "s": 13.04, "e": 13.5}, {"t": "מוריד", "s": 13.5, "e": 13.86}, {"t": "את", "s": 13.86, "e": 13.98}]}, {"start": 13.98, "end": 15.58, "text": "האחוז מהמחיר החדש.", "words": [{"t": "האחוז", "s": 13.98, "e": 14.38}, {"t": "מהמחיר", "s": 14.38, "e": 14.92}, {"t": "החדש.", "s": 14.92, "e": 15.46}]}, {"start": 15.54, "end": 16.8, "text": "זה בסיס אחר,", "words": [{"t": "זה", "s": 15.54, "e": 15.96}, {"t": "בסיס", "s": 15.96, "e": 16.28}, {"t": "אחר,", "s": 16.28, "e": 16.68}]}, {"start": 16.68, "end": 17.56, "text": "אז הוא נופל.", "words": [{"t": "אז", "s": 16.68, "e": 17.02}, {"t": "הוא", "s": 17.02, "e": 17.14}, {"t": "נופל.", "s": 17.14, "e": 17.44}]}, {"start": 17.88, "end": 19.72, "text": "התייקרות היא כפל", "words": [{"t": "התייקרות", "s": 17.88, "e": 18.8}, {"t": "היא", "s": 18.8, "e": 18.98}, {"t": "כפל", "s": 18.98, "e": 19.6}]}, {"start": 19.6, "end": 21.92, "text": "במקדם, אחת נקודה שתיים חמש.", "words": [{"t": "במקדם,", "s": 19.6, "e": 20.2}, {"t": "אחת", "s": 20.26, "e": 20.76}, {"t": "נקודה שתיים חמש.", "s": 20.76, "e": 21.8}]}, {"start": 22.74, "end": 24.1, "text": "לחזור אחורה זה", "words": [{"t": "לחזור", "s": 22.74, "e": 23.2}, {"t": "אחורה", "s": 23.2, "e": 23.64}, {"t": "זה", "s": 23.64, "e": 23.98}]}, {"start": 23.98, "end": 25.62, "text": "לחלק, לא להוריד.", "words": [{"t": "לחלק,", "s": 23.98, "e": 24.66}, {"t": "לא", "s": 24.7, "e": 25.04}, {"t": "להוריד.", "s": 25.04, "e": 25.5}]}, {"start": 25.78, "end": 28.52, "text": "מאתיים וחמישים חלקי המקדם.", "words": [{"t": "מאתיים וחמישים", "s": 25.78, "e": 26.7}, {"t": "חלקי", "s": 26.7, "e": 27.86}, {"t": "המקדם.", "s": 27.86, "e": 28.4}]}, {"start": 28.4, "end": 29.94, "text": "התשובה, מאתיים.", "words": [{"t": "התשובה,", "s": 28.4, "e": 29.34}, {"t": "מאתיים.", "s": 29.36, "e": 29.82}]}, {"start": 30.66, "end": 32.28, "text": "אחד חלקי המקדם", "words": [{"t": "אחד", "s": 30.66, "e": 31.12}, {"t": "חלקי", "s": 31.12, "e": 31.66}, {"t": "המקדם", "s": 31.66, "e": 32.16}]}, {"start": 32.16, "end": 33.72, "text": "הוא אפס נקודה שמונה.", "words": [{"t": "הוא", "s": 32.16, "e": 32.48}, {"t": "אפס", "s": 32.48, "e": 32.92}, {"t": "נקודה שמונה.", "s": 32.92, "e": 33.6}]}, {"start": 33.84, "end": 35.52, "text": "ולא המקדם המשלים.", "words": [{"t": "ולא", "s": 33.84, "e": 34.54}, {"t": "המקדם", "s": 34.54, "e": 35.04}, {"t": "המשלים.", "s": 35.04, "e": 35.4}]}, {"start": 36.02, "end": 37.34, "text": "היפוך אחוז הוא", "words": [{"t": "היפוך", "s": 36.02, "e": 36.48}, {"t": "אחוז", "s": 36.48, "e": 36.92}, {"t": "הוא", "s": 36.92, "e": 37.22}]}, {"start": 37.22, "end": 38.48, "text": "חילוק במקדם.", "words": [{"t": "חילוק", "s": 37.22, "e": 37.82}, {"t": "במקדם.", "s": 37.82, "e": 38.36}]}]}
