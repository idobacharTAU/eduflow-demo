{"slug": "psyq_pythagoras_root_at_the_end", "duration": 42.96, "cues": [{"start": 0, "end": 1.74, "text": "משולש ישר זווית.", "words": [{"t": "משולש", "s": 0, "e": 0.78}, {"t": "ישר", "s": 0.78, "e": 1.2}, {"t": "זווית.", "s": 1.2, "e": 1.62}]}, {"start": 1.74, "end": 4.14, "text": "הניצבים שלוש וארבע.", "words": [{"t": "הניצבים", "s": 1.74, "e": 2.58}, {"t": "שלוש", "s": 2.58, "e": 3.32}, {"t": "וארבע.", "s": 3.32, "e": 4.02}]}, {"start": 4.1, "end": 5.54, "text": "כמה היתר?", "words": [{"t": "כמה", "s": 4.1, "e": 4.92}, {"t": "היתר?", "s": 4.92, "e": 5.42}]}, {"start": 5.46, "end": 6.74, "text": "חמש שניות.", "words": [{"t": "חמש", "s": 5.46, "e": 6.28}, {"t": "שניות.", "s": 6.28, "e": 6.62}]}, {"start": 10.62, "end": 11.84, "text": "אם ענית שבע,", "words": [{"t": "אם", "s": 10.62, "e": 11.04}, {"t": "ענית", "s": 11.04, "e": 11.3}, {"t": "שבע,", "s": 11.3, "e": 11.72}]}, {"start": 11.86, "end": 13.28, "text": "חיברת את הניצבים.", "words": [{"t": "חיברת", "s": 11.86, "e": 12.52}, {"t": "את", "s": 12.52, "e": 12.66}, {"t": "הניצבים.", "s": 12.66, "e": 13.16}]}, {"start": 13.34, "end": 15.1, "text": "אם ענית עשרים וחמש,", "words": [{"t": "אם", "s": 13.34, "e": 13.92}, {"t": "ענית", "s": 13.92, "e": 14.2}, {"t": "עשרים", "s": 14.2, "e": 14.56}, {"t": "וחמש,", "s": 14.56, "e": 14.98}]}, {"start": 15.14, "end": 16.5, "text": "שכחת את השורש.", "words": [{"t": "שכחת", "s": 15.14, "e": 15.8}, {"t": "את", "s": 15.8, "e": 15.9}, {"t": "השורש.", "s": 15.9, "e": 16.38}]}, {"start": 16.84, "end": 19.54, "text": "פיתגורס אומר, ריבוע היתר", "words": [{"t": "פיתגורס", "s": 16.84, "e": 17.68}, {"t": "אומר,", "s": 17.68, "e": 17.9}, {"t": "ריבוע", "s": 18.14, "e": 18.8}, {"t": "היתר", "s": 18.8, "e": 19.42}]}, {"start": 19.42, "end": 21.48, "text": "שווה לסכום ריבועי הניצבים.", "words": [{"t": "שווה", "s": 19.42, "e": 19.88}, {"t": "לסכום", "s": 19.88, "e": 20.38}, {"t": "ריבועי", "s": 20.38, "e": 20.86}, {"t": "הניצבים.", "s": 20.86, "e": 21.36}]}, {"start": 21.72, "end": 23.64, "t