{"slug": "psyq_pythagorean_triples_sanity", "duration": 33.78, "cues": [{"start": 0, "end": 1.06, "text": "את היתר הזה", "words": [{"t": "את", "s": 0, "e": 0.3}, {"t": "היתר", "s": 0.3, "e": 0.8}, {"t": "הזה", "s": 0.8, "e": 0.94}]}, {"start": 0.94, "end": 2.54, "text": "לא צריך לחשב.", "words": [{"t": "לא", "s": 0.94, "e": 1.48}, {"t": "צריך", "s": 1.48, "e": 1.92}, {"t": "לחשב.", "s": 1.92, "e": 2.42}]}, {"start": 2.54, "end": 5.06, "text": "במשולש ישר זווית, הניצבים", "words": [{"t": "במשולש", "s": 2.54, "e": 3.4}, {"t": "ישר", "s": 3.4, "e": 3.86}, {"t": "זווית,", "s": 3.86, "e": 4.26}, {"t": "הניצבים", "s": 4.28, "e": 4.94}]}, {"start": 4.94, "end": 6.54, "text": "הם שלוש וארבע.", "words": [{"t": "הם", "s": 4.94, "e": 5.1}, {"t": "שלוש", "s": 5.1, "e": 5.72}, {"t": "וארבע.", "s": 5.72, "e": 6.42}]}, {"start": 6.54, "end": 8.06, "text": "מהו אורך היתר?", "words": [{"t": "מהו", "s": 6.54, "e": 7.18}, {"t": "אורך", "s": 7.18, "e": 7.46}, {"t": "היתר?", "s": 7.46, "e": 7.94}]}, {"start": 8.02, "end": 10.24, "text": "היתר גדול מכל ניצב", "words": [{"t": "היתר", "s": 8.02, "e": 8.88}, {"t": "גדול", "s": 8.88, "e": 9.48}, {"t": "מכל", "s": 9.48, "e": 9.78}, {"t": "ניצב", "s": 9.78, "e": 10.12}]}, {"start": 10.12, "end": 12.38, "text": "וקטן מסכומם, כלומר,", "words": [{"t": "וקטן", "s": 10.12, "e": 11}, {"t": "מסכומם,", "s": 11, "e": 11.56}, {"t": "כלומר,", "s": 11.64, "e": 12.26}]}, {"start": 12.32, "end": 13.96, "text": "בין ארבע לשבע.", "words": [{"t": "בין", "s": 12.32, "e": 12.76}, {"t": "ארבע", "s": 12.76, "e": 13.16}, {"t": "לשבע.", "s": 13.16, "e": 13.84}]}, {"start": 14.47, "end": 15.68, "text": "שבע הוא הסכום", "words": [{"t": "שבע", "s": 14.47, "e": 14.9}, {"t": "הוא", "s": 14.9, "e": 15.22}, {"t": "הסכום", "s": 15.22, "e": 15.56}]}, {"start": 15.56, "end": 17.2, "text": "עצמו, ולכן נפסל.", "words": [{"t": "עצמו,", "s": 15.56, "e": 15.96}, {"t": "ולכן", "s": 16.02, "e": 16.62}, {"t": "נפסל.", "s": 16.62, "e": 17.08}]}, {"start": 17.38, "end": 19.08, "text": "עשרים וחמש ושתים", "words": [{"t": "עשרים", "s": 17.38, "e": 18.08}, {"t": "וחמש", "s": 18.08, "e": 18.52}, {"t": "ושתים", "s": 18.52, "e": 18.96}]}, {"start": 18.96, "end": 20.64, "text": "עשרה גדולים מדי.", "words": [{"t": "עשרה", "s": 18.96, "e": 19.32}, {"t": "גדולים", "s": 19.32, "e": 20.16}, {"t": "מדי.", "s": 20.16, "e": 20.52}]}, {"start": 20.56, "end": 22.54, "text": "נשאר רק חמש,", "words": [{"t": "נשאר", "s": 20.56, "e": 21.42}, {"t": "רק", "s": 21.42, "e": 21.7}, {"t": "חמש,", "s": 21.7, "e": 22.42}]}, {"start": 22.48, "end": 23.8, "text": "בלי שום חישוב.", "words": [{"t": "בלי", "s": 22.48, "e": 22.9}, {"t": "שום", "s": 22.9, "e": 23.22}, {"t": "חישוב.", "s": 23.22, "e": 23.68}]}, {"start": 23.74, "end": 25.34, "text": "וזו שלישייה מוכרת.", "words": [{"t": "וזו", "s": 23.74, "e": 24.4}, {"t": "שלישייה", "s": 24.4, "e": 24.76}, {"t": "מוכרת.", "s": 24.76, "e": 25.22}]}, {"start": 25.4, "end": 27.58, "text": "שלוש, ארבע, חמש.", "words": [{"t": "שלוש,", "s": 25.4, "e": 26.22}, {"t": "ארבע,", "s": 26.24, "e": 26.82}, {"t": "חמש.", "s": 26.88, "e": 27.46}]}, {"start": 27.46, "end": 30.48, "text": "קודם חוסמים ומזהים שלישייה,", "words": [{"t": "קודם", "s": 27.46, "e": 28.44}, {"t": "חוסמים", "s": 28.44, "e": 28.98}, {"t": "ומזהים", "s": 28.98, "e": 29.84}, {"t": "שלישייה,", "s": 29.84, "e": 30.36}]}, {"start": 30.44, "end": 32.3, "text": "ורק אז מחשבים.", "words": [{"t": "ורק", "s": 30.44, "e": 31.2}, {"t": "אז", "s": 31.2, "e": 31.38}, {"t": "מחשבים.", "s": 31.38, "e": 32.18}]}]}
