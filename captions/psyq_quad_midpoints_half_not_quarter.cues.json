{"slug": "psyq_quad_midpoints_half_not_quarter", "duration": 39.8, "cues": [{"start": 0.0, "end": 2.132, "text": "מרובע, ארבעה אמצעים:", "words": [{"t": "מרובע,", "s": 0.0, "e": 0.818}, {"t": "ארבעה", "s": 0.856, "e": 1.58}, {"t": "אמצעים:", "s": 1.58, "e": 2.132}]}, {"start": 2.151, "end": 3.635, "text": "רבע או חצי?", "words": [{"t": "רבע", "s": 2.151, "e": 2.836}, {"t": "או", "s": 2.836, "e": 3.179}, {"t": "חצי?", "s": 3.179, "e": 3.635}]}, {"start": 4.206, "end": 5.653, "text": "שטח המרובע מאה ועשרים.", "words": [{"t": "שטח", "s": 4.206, "e": 4.625}, {"t": "המרובע", "s": 4.625, "e": 4.968}, {"t": "מאה", "s": 4.968, "e": 5.31}, {"t": "ועשרים.", "s": 5.31, "e": 5.653}]}, {"start": 6.262, "end": 7.975, "text": "מחברים את אמצעי ארבע", "words": [{"t": "מחברים", "s": 6.262, "e": 7.061}, {"t": "את", "s": 7.061, "e": 7.233}, {"t": "אמצעי", "s": 7.233, "e": 7.67}, {"t": "ארבע", "s": 7.67, "e": 7.975}]}, {"start": 7.975, "end": 9.536, "text": "צלעותיו, לפי הסדר.", "words": [{"t": "צלעותיו,", "s": 7.975, "e": 8.565}, {"t": "לפי", "s": 8.698, "e": 9.098}, {"t": "הסדר.", "s": 9.098, "e": 9.536}]}, {"start": 9.764, "end": 10.601, "text": "המלכודת:", "words": [{"t": "המלכודת:", "s": 9.764, "e": 10.601}]}, {"start": 10.697, "end": 12.923, "text": "כלל הרבע מהמשולש, שלושים.", "words": [{"t": "כלל", "s": 10.697, "e": 11.306}, {"t": "הרבע", "s": 11.306, "e": 11.743}, {"t": "מהמשולש,", "s": 11.743, "e": 12.429}, {"t": "שלושים.", "s": 12.524, "e": 12.923}]}, {"start": 13.247, "end": 15.093, "text": "אבל כאן אין משולש אחד.", "words": [{"t": "אבל", "s": 13.247, "e": 13.856}, {"t": "כאן", "s": 13.856, "e": 14.237}, {"t": "אין", "s": 14.237, "e": 14.56}, {"t": "משולש", "s": 14.56, "e": 14.922}, {"t": "אחד.", "s": 14.922, "e": 15.093}]}, {"start": 15.55, "end": 17.453, "text": "מעבירים אלכסון, והמרובע", "words": [{"t": "מעבירים", "s": 15.55, "e": 16.254}, {"t": "אלכסון,", "s": 16.254, "e": 16.673}, {"t": "והמרובע", "s": 16.673, "e": 17.453}]}, {"start": 17.453, "end": 18.71, "text": "נחצ