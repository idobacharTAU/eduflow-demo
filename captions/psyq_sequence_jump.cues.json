{"slug": "psyq_sequence_jump", "duration": 31.66, "cues": [{"start": 0.0, "end": 2.92, "text": "סדרה שעולה בקפיצות שוות בדיוק.", "words": [{"t": "סדרה", "s": 0.0, "e": 0.74}, {"t": "שעולה", "s": 0.74, "e": 1.26}, {"t": "בקפיצות", "s": 1.26, "e": 1.98}, {"t": "שוות", "s": 1.98, "e": 2.38}, {"t": "בדיוק.", "s": 2.38, "e": 2.92}]}, {"start": 2.96, "end": 4.94, "text": "שואלים על איבר רחוק מאוד.", "words": [{"t": "שואלים", "s": 2.96, "e": 3.62}, {"t": "על", "s": 3.62, "e": 3.72}, {"t": "איבר", "s": 3.72, "e": 4.06}, {"t": "רחוק", "s": 4.06, "e": 4.68}, {"t": "מאוד.", "s": 4.68, "e": 4.94}]}, {"start": 5.22, "end": 6.9, "text": "יש שלוש שניות.", "words": [{"t": "יש", "s": 5.22, "e": 5.72}, {"t": "שלוש", "s": 5.72, "e": 6.5}, {"t": "שניות.", "s": 6.5, "e": 6.9}]}, {"start": 7.22, "end": 9.44, "text": "לא סופרים איבר אחרי איבר.", "words": [{"t": "לא", "s": 7.22, "e": 7.68}, {"t": "סופרים", "s": 7.68, "e": 8.18}, {"t": "איבר", "s": 8.18, "e": 8.7}, {"t": "אחרי", "s": 8.7, "e": 9.06}, {"t": "איבר.", "s": 9.06, "e": 9.44}]}, {"start": 9.52, "end": 12.22, "text": "סופרים רק את הקפיצות שביניהם.", "words": [{"t": "סופרים", "s": 9.52, "e": 10.32}, {"t": "רק", "s": 10.32, "e": 10.7}, {"t": "את", "s": 10.7, "e": 10.94}, {"t": "הקפיצות", "s": 10.94, "e": 11.6}, {"t": "שביניהם.", "s": 11.6, "e": 12.22}]}, {"start": 12.32, "end": 14.82, "text": "מהאיבר הראשון עד זה שביקשו,", "words": [{"t": "מהאיבר", "s": 12.32, "e": 13.2}, {"t": "הראשון", "s": 13.2, "e": 13.74}, {"t": "עד", "s": 13.74, "e": 14.1}, {"t": "זה", "s": 14.1, "e": 14.24}, {"t": "שביקשו,", "s": 14.24, "e": 14.82}]}, {"start": 14.84, "end": 17.22, "text": "יש תמיד קפיצה אחת פחות.", "words": [{"t": "יש", "s": 14.84, "e": 15.32}, {"t": "תמיד", "s": 15.32, "e": 15.88}, {"t": "קפיצה", "s": 15.88, "e": 16.48}, {"t": "אחת", "s": 16.48, "e": 16.82}, {"t": "פחות.", "s": 16.82, "e": 17.22}]}, {"start": 17.38, "end": 18.74, "text": "מכפילים את מספר", "words": [{"t": "מכפילים", "s": 17.38, "e": 18.26}, {"t": "את", "s": 18.26, "e": 18.38}, {"t": "מספר", "s": 18.38, "e": 18.74}]}, {"start": 18.74, "end": 20.42, "text": "הקפיצות בגודל הקפיצה.", "words": [{"t": "הקפיצות", "s": 18.74, "e": 19.24}, {"t": "בגודל", "s": 19.24, "e": 19.9}, {"t": "הקפיצה.", "s": 19.9, "e": 20.42}]}, {"start": 20.46, "end": 22.74, "text": "מוסיפים את התוצאה לאיבר הראשון.", "words": [{"t": "מוסיפים", "s": 20.46, "e": 21.22}, {"t": "את", "s": 21.22, "e": 21.36}, {"t": "התוצאה", "s": 21.36, "e": 21.8}, {"t": "לאיבר", "s": 21.8, "e": 22.26}, {"t": "הראשון.", "s": 22.26, "e": 22.74}]}, {"start": 22.78, "end": 24.78, "text": "וזהו, בלי לספור כלום.", "words": [{"t": "וזהו,", "s": 22.78, "e": 23.58}, {"t": "בלי", "s": 23.6, "e": 24.08}, {"t": "לספור", "s": 24.08, "e": 24.46}, {"t": "כלום.", "s": 24.46, "e": 24.78}]}, {"start": 25.34, "end": 27.16, "text": "הטעות הנפוצה היא לספור", "words": [{"t": "הטעות", "s": 25.34, "e": 25.8}, {"t": "הנפוצה", "s": 25.8, "e": 26.4}, {"t": "היא", "s": 26.4, "e": 26.66}, {"t": "לספור", "s": 26.66, "e": 27.16}]}, {"start": 27.16, "end": 28.62, "text": "איברים במקום קפיצות.", "words": [{"t": "איברים", "s": 27.16, "e": 27.72}, {"t": "במקום", "s": 27.72, "e": 28.18}, {"t": "קפיצות.", "s": 28.18, "e": 28.62}]}, {"start": 28.62, "end": 31.26, "text": "תמיד אחת פחות ממה שנדמה.", "words": [{"t": "תמיד", "s": 28.62, "e": 29.62}, {"t": "אחת", "s": 29.62, "e": 30.12}, {"t": "פחות", "s": 30.12, "e": 30.54}, {"t": "ממה", "s": 30.54, "e": 30.86}, {"t": "שנדמה.", "s": 30.86, "e": 31.26}]}]}
