{"slug": "psyq_start_from_middle_option", "duration": 38.36, "cues": [{"start": 0, "end": 2.02, "text": "ארבעה מסיחים, ורק", "words": [{"t": "ארבעה", "s": 0, "e": 0.7}, {"t": "מסיחים,", "s": 0.7, "e": 1.3}, {"t": "ורק", "s": 1.3, "e": 1.9}]}, {"start": 1.9, "end": 3.02, "text": "שתי הצבות.", "words": [{"t": "שתי", "s": 1.9, "e": 2.24}, {"t": "הצבות.", "s": 2.24, "e": 2.9}]}, {"start": 3, "end": 4.88, "text": "שלוש איקס ועוד ארבע,", "words": [{"t": "שלוש", "s": 3, "e": 3.84}, {"t": "איקס", "s": 3.84, "e": 4.12}, {"t": "ועוד", "s": 4.12, "e": 4.46}, {"t": "ארבע,", "s": 4.46, "e": 4.76}]}, {"start": 4.9, "end": 6.44, "text": "חלקי איקס פחות", "words": [{"t": "חלקי", "s": 4.9, "e": 5.6}, {"t": "איקס", "s": 5.6, "e": 5.92}, {"t": "פחות", "s": 5.92, "e": 6.32}]}, {"start": 6.32, "end": 7.72, "text": "שתיים, שווה חמש.", "words": [{"t": "שתיים,", "s": 6.32, "e": 6.8}, {"t": "שווה", "s": 6.8, "e": 7.26}, {"t": "חמש.", "s": 7.26, "e": 7.6}]}, {"start": 8.08, "end": 9.04, "text": "המסיחים:", "words": [{"t": "המסיחים:", "s": 8.08, "e": 8.92}]}, {"start": 8.96, "end": 11.4, "text": "שתיים, ארבע, שבע,", "words": [{"t": "שתיים,", "s": 8.96, "e": 9.8}, {"t": "ארבע,", "s": 9.82, "e": 10.46}, {"t": "שבע,", "s": 10.6, "e": 11.28}]}, {"start": 11.42, "end": 12.42, "text": "אחת עשרה.", "words": [{"t": "אחת", "s": 11.42, "e": 11.96}, {"t": "עשרה.", "s": 11.96, "e": 12.3}]}, {"start": 12.46, "end": 14.14, "text": "בסדר עולה, אז", "words": [{"t": "בסדר", "s": 12.46, "e": 13.26}, {"t": "עולה,", "s": 13.26, "e": 13.6}, {"t": "אז", "s": 13.62, "e": 14.02}]}, {"start": 14.02, "end": 15.24, "text": "מתחילים מהאמצע.", "words": [{"t": "מתחילים", "s": 14.02, "e": 14.52}, {"t": "מהאמצע.", "s": 14.52, "e": 15.12}]}, {"start": 15.28, "end": 17.44, "text": "מציבים ארבע ומקבלים", "words": [{"t": "מציבים", "s": 15.28, "e": 16.06}, {"t": "ארבע", "s": 16.06, "e": 16.54}, {"t": "ומקבלים", "s": 16.54, "e": 17.32}]}, {"start": 17.32, "end": 19.2, "text": "שמונה, גדול מחמש.", "words": [{"t": "שמונה,", "s": 17.32, "e": 17.92}, {"t": "גדול", "s": 18, "e": 18.74}, {"t": "מחמש.", "s": 18.74, "e": 19.08}]}, {"start": 19.62, "end": 21.4, "text": "מעל שתיים הביטוי", "words": [{"t": "מעל", "s": 19.62, "e": 20.3}, {"t": "שתיים", "s": 20.3, "e": 20.78}, {"t": "הביטוי", "s": 20.78, "e": 21.28}]}, {"start": 21.28, "end": 22.92, "text": "יורד, לכן צריך", "words": [{"t": "יורד,", "s": 21.28, "e": 21.66}, {"t": "לכן", "s": 21.76, "e": 22.42}, {"t": "צריך", "s": 22.42, "e": 22.8}]}, {"start": 22.8, "end": 24.16, "text": "איקס גדול מארבע.", "words": [{"t": "איקס", "s": 22.8, "e": 23.12}, {"t": "גדול", "s": 23.12, "e": 23.62}, {"t": "מארבע.", "s": 23.62, "e": 24.04}]}, {"start": 24.32, "end": 26.24, "text": "ושתיים, מאפס את", "words": [{"t": "ושתיים,", "s": 24.32, "e": 25.16}, {"t": "מאפס", "s": 25.16, "e": 26.02}, {"t": "את", "s": 26.02, "e": 26.12}]}, {"start": 26.12, "end": 27.82, "text": "המכנה, ולכן פסול.", "words": [{"t": "המכנה,", "s": 26.12, "e": 26.56}, {"t": "ולכן", "s": 26.62, "e": 27.28}, {"t": "פסול.", "s": 27.28, "e": 27.7}]}, {"start": 27.7, "end": 30.66, "text": "מציבים שבע, עשרים וחמש", "words": [{"t": "מציבים", "s": 27.7, "e": 28.8}, {"t": "שבע,", "s": 28.8, "e": 29.2}, {"t": "עשרים", "s": 29.28, "e": 30.1}, {"t": "וחמש", "s": 30.1, "e": 30.54}]}, {"start": 30.54, "end": 33.1, "text": "חלקי חמש, בדיוק חמש.", "words": [{"t": "חלקי", "s": 30.54, "e": 31.16}, {"t": "חמש,", "s": 31.16, "e": 31.56}, {"t": "בדיוק", "s": 31.62, "e": 32.64}, {"t": "חמש.", "s": 32.64, "e": 32.98}]}, {"start": 33.66, "end": 35.8, "text": "אמצע קודם רק כשהביטוי", "words": [{"t": "אמצע", "s": 33.66, "e": 34.08}, {"t": "קודם", "s": 34.08, "e": 34.58}, {"t": "רק", "s": 34.58, "e": 35}, {"t": "כשהביטוי", "s": 35, "e": 35.68}]}, {"start": 35.68, "end": 36.88, "text": "נע בכיוון אחד.", "words": [{"t": "נע", "s": 35.68, "e": 36}, {"t": "בכיוון", "s": 36, "e": 36.58}, {"t": "אחד.", "s": 36.58, "e": 36.76}]}]}
