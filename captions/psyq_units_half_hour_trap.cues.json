, "e": 17.9}]}, {"start": 18.02, "end": 19.34, "text": "אבל הוא צעד", "words": [{"t": "אבל", "s": 18.02, "e": 18.58}, {"t": "הוא", "s": 18.58, "e": 18.8}, {"t": "צעד", "s": 18.8, "e": 19.22}]}, {"start": 19.22, "end": 20.4, "text": "רק חצי שעה.", "words": [{"t": "רק", "s": 19.22, "e": 19.34}, {"t": "חצי", "s": 19.34, "e": 19.9}, {"t": "שעה.", "s": 19.9, "e": 20.28}]}, {"start": 20.32, "end": 22.06, "text": "חצי שעה זה בעצם", "words": [{"t": "חצי", "s": 20.32, "e": 21.1}, {"t": "שעה", "s": 21.1, "e": 21.42}, {"t": "זה", "s": 21.42, "e": 21.54}, {"t": "בעצם", "s": 21.54, "e": 21.94}]}, {"start": 21.94, "end": 23.84, "text": "אפס נקודה חמש שעות.", "words": [{"t": "אפס", "s": 21.94, "e": 22.46}, {"t": "נקודה", "s": 22.46, "e": 22.76}, {"t": "חמש", "s": 22.76, "e": 23.2}, {"t": "שעות.", "s": 23.2, "e": 23.72}]}, {"start": 23.98, "end": 26.08, "text": "דרך שווה מהירות", "words": [{"t": "דרך", "s": 23.98, "e": 24.82}, {"t": "שווה", "s": 24.82, "e": 25.36}, {"t": "מהירות", "s": 25.36, "e": 25.96}]}, {"start": 25.96, "end": 26.96, "text": "כפול זמן.", "words": [{"t": "כפול", "s": 25.96, "e": 26.46}, {"t": "זמן.", "s": 26.46, "e": 26.84}]}, {"start": 26.84, "end": 29.72, "text": "עכשיו מכפילים, שש כפול", "words": [{"t": "עכשיו", "s": 26.84, "e": 27.64}, {"t": "מכפילים,", "s": 27.64, "e": 28.16}, {"t": "שש", "s": 28.2, "e": 28.98}, {"t": "כפול", "s": 28.98, "e": 29.6}]}, {"start": 29.6, "end": 30.94, "text": "אפס נקודה חמש.", "words": [{"t": "אפס", "s": 29.6, "e": 30.02}, {"t": "נקודה", "s": 30.02, "e": 30.28}, {"t": "חמש.", "s": 30.28, "e": 30.82}]}, {"start": 30.86, "end": 31.86, "text": "שלוש.", "words": [{"t": "שלוש.", "s": 30.86, "e": 31.74}]}, {"start": 31.78, "end": 34.6, "text": "התשובה הנכונה שלושה קילומטרים.", "words": [{"t": "התשובה", "s": 31.78, "e": 32.58}, {"t": "הנכונה", "s": 32.58, "e": 33.04}, {"t": "שלושה", "s": 33.04, "e": 33.9}, {"t": "קילומטרים.", "s": 33.9, "e": 34.48}]}, {"start": 34.94, "end": 36.32, "text": "לפני שאתה מכפיל,", "words": [{"t": "לפני", "