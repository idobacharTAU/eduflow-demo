{"slug": "psyq_wp8_helper_joins_after_head_start", "duration": 36.46, "cues": [{"start": 0.0, "end": 1.56, "text": "שלוש שעות לבד,", "words": [{"t": "שלוש", "s": 0.0, "e": 0.66}, {"t": "שעות", "s": 0.66, "e": 1.04}, {"t": "לבד,", "s": 1.04, "e": 1.56}]}, {"start": 1.58, "end": 3.16, "text": "ואז מצטרף עוזר?", "words": [{"t": "ואז", "s": 1.58, "e": 2.26}, {"t": "מצטרף", "s": 2.26, "e": 2.84}, {"t": "עוזר?", "s": 2.84, "e": 3.16}]}, {"start": 3.38, "end": 5.54, "text": "צבע צובע חדר לבדו", "words": [{"t": "צבע", "s": 3.38, "e": 4.22}, {"t": "צובע", "s": 4.22, "e": 4.72}, {"t": "חדר", "s": 4.72, "e": 5.1}, {"t": "לבדו", "s": 5.1, "e": 5.54}]}, {"start": 5.54, "end": 7.36, "text": "בשש שעות, בקצב קבוע.", "words": [{"t": "בשש", "s": 5.54, "e": 6.08}, {"t": "שעות,", "s": 6.08, "e": 6.58}, {"t": "בקצב", "s": 6.6, "e": 7.02}, {"t": "קבוע.", "s": 7.02, "e": 7.36}]}, {"start": 7.48, "end": 8.82, "text": "העוזר צובע אותו", "words": [{"t": "העוזר", "s": 7.48, "e": 8.3}, {"t": "צובע", "s": 8.3, "e": 8.66}, {"t": "אותו", "s": 8.66, "e": 8.82}]}, {"start": 8.82, "end": 10.16, "text": "לבדו בשתים עשרה.", "words": [{"t": "לבדו", "s": 8.82, "e": 9.22}, {"t": "בשתים", "s": 9.22, "e": 9.8}, {"t": "עשרה.", "s": 9.8, "e": 10.16}]}, {"start": 10.46, "end": 12.14, "text": "הצבע עובד לבדו שלוש", "words": [{"t": "הצבע", "s": 10.46, "e": 11.04}, {"t": "עובד", "s": 11.04, "e": 11.36}, {"t": "לבדו", "s": 11.36, "e": 11.74}, {"t": "שלוש", "s": 11.74, "e": 12.14}]}, {"start": 12.14, "end": 14.12, "text": "שעות ומסיים חצי חדר.", "words": [{"t": "שעות", "s": 12.14, "e": 12.58}, {"t": "ומסיים", "s": 12.58, "e": 13.2}, {"t": "חצי", "s": 13.2, "e": 13.8}, {"t": "חדר.", "s": 13.8, "e": 14.12}]}, {"start": 14.28, "end": 15.68, "text": "אחר כך שניהם", "words": [{"t": "אחר", "s": 14.28, "e": 14.9}, {"t": "כך", "s": 14.9, "e": 15.2}, {"t": "שניהם", "s": 15.2, "e": 15.68}]}, {"start": 15.68, "end": 17.34, "text": "יחד, והקצבים מתחברים.", "words": [{"t": "יחד,", "s": 15.68, "e": 16.14}, {"t": "והקצבים", "s":