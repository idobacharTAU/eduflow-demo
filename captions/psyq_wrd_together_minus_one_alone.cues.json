{"slug": "psyq_wrd_together_minus_one_alone", "duration": 39.8, "cues": [{"start": 0.0, "end": 1.903, "text": "יחד ארבע שעות.", "words": [{"t": "יחד", "s": 0.0, "e": 0.796}, {"t": "ארבע", "s": 0.815, "e": 1.437}, {"t": "שעות.", "s": 1.437, "e": 1.903}]}, {"start": 1.961, "end": 3.242, "text": "והשני לבדו?", "words": [{"t": "והשני", "s": 1.961, "e": 2.854}, {"t": "לבדו?", "s": 2.854, "e": 3.242}]}, {"start": 3.436, "end": 5.805, "text": "שני גננים מכסחים מדשאה,", "words": [{"t": "שני", "s": 3.436, "e": 4.329}, {"t": "גננים", "s": 4.329, "e": 4.718}, {"t": "מכסחים", "s": 4.718, "e": 5.3}, {"t": "מדשאה,", "s": 5.3, "e": 5.805}]}, {"start": 5.805, "end": 7.067, "text": "כל אחד בקצב קבוע.", "words": [{"t": "כל", "s": 5.805, "e": 6.115}, {"t": "אחד", "s": 6.115, "e": 6.329}, {"t": "בקצב", "s": 6.329, "e": 6.795}, {"t": "קבוע.", "s": 6.795, "e": 7.067}]}, {"start": 7.28, "end": 9.901, "text": "יחד הם מסיימים בארבע שעות.", "words": [{"t": "יחד", "s": 7.28, "e": 8.173}, {"t": "הם", "s": 8.173, "e": 8.426}, {"t": "מסיימים", "s": 8.426, "e": 8.95}, {"t": "בארבע", "s": 8.95, "e": 9.454}, {"t": "שעות.", "s": 9.454, "e": 9.901}]}, {"start": 9.959, "end": 12.541, "text": "הראשון לבדו מסיים בשש שעות.", "words": [{"t": "הראשון", "s": 9.959, "e": 10.813}, {"t": "לבדו", "s": 10.813, "e": 11.143}, {"t": "מסיים", "s": 11.143, "e": 11.726}, {"t": "בשש", "s": 11.726, "e": 12.153}, {"t": "שעות.", "s": 12.153, "e": 12.541}]}, {"start": 12.58, "end": 13.337, "text": "הפיתוי:", "words": [{"t": "הפיתוי:", "s": 12.58, "e": 13.337}]}, {"start": 13.473, "end": 15.512, "text": "שש פחות ארבע, שעתיים.", "words": [{"t": "שש", "s": 13.473, "e": 14.094}, {"t": "פחות", "s": 14.094, "e": 14.347}, {"t": "ארבע,", "s": 14.347, "e": 14.677}, {"t": "שעתיים.", "s": 14.774, "e": 15.512}]}, {"start": 15.57, "end": 17.55, "text": "אבל לבדו השני", "words": [{"t": "אבל", "s": 15.57, "e": 16.346}, {"t": "לבדו", "s": 16.346, "e": 16.987}, {"t": "השני", "s": 16.987, "e": 17.55}]}, {"start": 17.55, "end": 18.831, "text": "איטי מהצוות כולו.", "words": [{"t": "איטי", "s": 17.55, "e": 17.987}, {"t": "מהצוות", "s": 17.987, "e": 18.424}, {"t": "כולו.", "s": 18.424, "e": 18.831}]}, {"start": 19.123, "end": 21.724, "text": "שעתיים קצר מדי, ונפסל מיד.", "words": [{"t": "שעתיים", "s": 19.123, "e": 19.86}, {"t": "קצר", "s": 19.86, "e": 20.443}, {"t": "מדי,", "s": 20.443, "e": 20.773}, {"t": "ונפסל", "s": 20.792, "e": 21.491}, {"t": "מיד.", "s": 21.491, "e": 21.724}]}, {"start": 22.423, "end": 23.918, "text": "זמנים לא מחסרים.", "words": [{"t": "זמנים", "s": 22.423, "e": 22.869}, {"t": "לא", "s": 22.869, "e": 23.355}, {"t": "מחסרים.", "s": 23.355, "e": 23.918}]}, {"start": 24.034, "end": 26.092, "text": "מחסרים חלקים לשעה.", "words": [{"t": "מחסרים", "s": 24.034, "e": 24.869}, {"t": "חלקים", "s": 24.869, "e": 25.587}, {"t": "לשעה.", "s": 25.587, "e": 26.092}]}, {"start": 26.17, "end": 27.626, "text": "נחלק את המדשאה", "words": [{"t": "נחלק", "s": 26.17, "e": 27.004}, {"t": "את", "s": 27.004, "e": 27.14}, {"t": "המדשאה", "s": 27.14, "e": 27.626}]}, {"start": 27.626, "end": 28.829, "text": "לשתים עשרה משבצות.", "words": [{"t": "לשתים", "s": 27.626, "e": 28.13}, {"t": "עשרה", "s": 28.13, "e": 28.383}, {"t": "משבצות.", "s": 28.383, "e": 28.829}]}, {"start": 29.121, "end": 29.819, "text": "יחד:", "words": [{"t": "יחד:", "s": 29.121, "e": 29.819}]}, {"start": 29.839, "end": 31.217, "text": "שלוש משבצות בשעה.", "words": [{"t": "שלוש", "s": 29.839, "e": 30.441}, {"t": "משבצות", "s": 30.441, "e": 30.81}, {"t": "בשעה.", "s": 30.81, "e": 31.217}]}, {"start": 31.683, "end": 32.46, "text": "הראשון לבדו:", "words": [{"t": "הראשון", "s": 31.683, "e": 32.149}, {"t": "לבדו:", "s": 32.149, "e": 32.46}]}, {"start": 32.537, "end": 33.469, "text": "שתי משבצות.", "words": [{"t": "שתי", "s": 32.537, "e": 33.003}, {"t": "משבצות.", "s": 33.003, "e": 33.469}]}, {"start": 33.663, "end": 36.711, "text": "לשני נשארת משבצת אחת בשעה.", "words": [{"t": "לשני", "s": 33.663, "e": 34.595}, {"t": "נשארת", "s": 34.595, "e": 35.139}, {"t": "משבצת", "s": 35.139, "e": 35.799}, {"t": "אחת", "s": 35.799, "e": 36.284}, {"t": "בשעה.", "s": 36.284, "e": 36.711}]}, {"start": 37.1, "end": 38.051, "text": "לכן לבדו:", "words": [{"t": "לכן", "s": 37.1, "e": 37.566}, {"t": "לבדו:", "s": 37.566, "e": 38.051}]}, {"start": 38.09, "end": 39.41, "text": "שתים עשרה שעות.", "words": [{"t": "שתים", "s": 38.09, "e": 38.769}, {"t": "עשרה", "s": 38.769, "e": 39.08}, {"t": "שעות.", "s": 39.08, "e": 39.41}]}], "captions_default": "off", "text_load": {"mean_visible_words": 20.6, "threshold": 20.0}}
