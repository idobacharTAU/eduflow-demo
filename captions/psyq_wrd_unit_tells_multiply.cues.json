{"slug": "psyq_wrd_unit_tells_multiply", "duration": 39.36, "cues": [{"start": 0.0, "end": 2.78, "text": "כמה רחוק מגיעים בארבע שעות?", "words": [{"t": "כמה", "s": 0.0, "e": 0.56}, {"t": "רחוק", "s": 0.56, "e": 1.02}, {"t": "מגיעים", "s": 1.02, "e": 1.6}, {"t": "בארבע", "s": 1.6, "e": 2.24}, {"t": "שעות?", "s": 2.24, "e": 2.78}]}, {"start": 2.82, "end": 4.14, "text": "רוכבת נוסעת", "words": [{"t": "רוכבת", "s": 2.82, "e": 3.66}, {"t": "נוסעת", "s": 3.66, "e": 4.14}]}, {"start": 4.14, "end": 6.06, "text": "חמישה עשר קילומטרים לשעה.", "words": [{"t": "חמישה", "s": 4.14, "e": 4.66}, {"t": "עשר", "s": 4.66, "e": 4.92}, {"t": "קילומטרים", "s": 4.92, "e": 5.62}, {"t": "לשעה.", "s": 5.62, "e": 6.06}]}, {"start": 6.08, "end": 6.98, "text": "היא רוכבת", "words": [{"t": "היא", "s": 6.08, "e": 6.56}, {"t": "רוכבת", "s": 6.56, "e": 6.98}]}, {"start": 6.98, "end": 8.82, "text": "ארבע שעות, בקצב קבוע.", "words": [{"t": "ארבע", "s": 6.98, "e": 7.44}, {"t": "שעות,", "s": 7.44, "e": 7.94}, {"t": "בקצב", "s": 7.94, "e": 8.52}, {"t": "קבוע.", "s": 8.52, "e": 8.82}]}, {"start": 9.42, "end": 9.9, "text": "הפיתוי:", "words": [{"t": "הפיתוי:", "s": 9.42, "e": 9.9}]}, {"start": 10.02, "end": 12.34, "text": "לחבר, ולקבל תשע עשרה.", "words": [{"t": "לחבר,", "s": 10.02, "e": 10.68}, {"t": "ולקבל", "s": 10.68, "e": 11.58}, {"t": "תשע", "s": 11.58, "e": 11.96}, {"t": "עשרה.", "s": 11.96, "e": 12.34}]}, {"start": 12.42, "end": 13.48, "text": "תשע עשרה מה?", "words": [{"t": "תשע", "s": 12.42, "e": 13.04}, {"t": "עשרה", "s": 13.04, "e": 13.38}, {"t": "מה?", "s": 13.38, "e": 13.48}]}, {"start": 13.62, "end": 14.72, "text": "אין לזה יחידה.", "words": [{"t": "אין", "s": 13.62, "e": 14.12}, {"t": "לזה", "s": 14.12, "e": 14.32}, {"t": "יחידה.", "s": 14.32, "e": 14.72}]}, {"start": 14.84, "end": 16.42, "text": "אבל מהירות ועוד", "words": [{"t": "אבל", "s": 14.84, "e": 15.46}, {"t": "מהירות", "s": 15.46, "e": 16.08}, {"t": "ועוד", "s": 16.08, "e": 16.42}]}, {"start": 16.42, "end": 17.94, "text": "זמן אינם מתחברים.", "words": [{"t": "זמן", "s": 16.42, "e": 16.8}, {"t": "אינם", "s": 16.8, "e": 17.5}, {"t": "מתחברים.", "s": 17.5, "e": 17.94}]}, {"start": 18.28, "end": 20.14, "text": "הקשיבו לשם של היחידה.", "words": [{"t": "הקשיבו", "s": 18.28, "e": 19.06}, {"t": "לשם", "s": 19.06, "e": 19.54}, {"t": "של", "s": 19.54, "e": 19.66}, {"t": "היחידה.", "s": 19.66, "e": 20.14}]}, {"start": 20.34, "end": 22.98, "text": "קילומטרים לשעה, כפול שעות.", "words": [{"t": "קילומטרים", "s": 20.34, "e": 21.24}, {"t": "לשעה,", "s": 21.24, "e": 21.8}, {"t": "כפול", "s": 21.8, "e": 22.46}, {"t": "שעות.", "s": 22.46, "e": 22.98}]}, {"start": 23.02, "end": 26.06, "text": "השעות מצטמצמות, ונשארים קילומטרים.", "words": [{"t": "השעות", "s": 23.02, "e": 23.86}, {"t": "מצטמצמות,", "s": 23.86, "e": 24.6}, {"t": "ונשארים", "s": 24.6, "e": 25.5}, {"t": "קילומטרים.", "s": 25.5, "e": 26.06}]}, {"start": 26.1, "end": 27.56, "text": "לכן כופלים:", "words": [{"t": "לכן", "s": 26.1, "e": 27.0}, {"t": "כופלים:", "s": 27.0, "e": 27.56}]}, {"start": 27.7, "end": 29.78, "text": "חמש עשרה כפול ארבע.", "words": [{"t": "חמש", "s": 27.7, "e": 28.38}, {"t": "עשרה", "s": 28.38, "e": 28.82}, {"t": "כפול", "s": 28.82, "e": 29.4}, {"t": "ארבע.", "s": 29.4, "e": 29.78}]}, {"start": 30.0, "end": 30.74, "text": "התשובה:", "words": [{"t": "התשובה:", "s": 30.0, "e": 30.74}]}, {"start": 30.74, "end": 32.12, "text": "שישים קילומטרים.", "words": [{"t": "שישים", "s": 30.74, "e": 31.54}, {"t": "קילומטרים.", "s": 31.54, "e": 32.12}]}, {"start": 32.18, "end": 32.98, "text": "בדיקה:", "words": [{"t": "בדיקה:", "s": 32.18, "e": 32.98}]}, {"start": 33.1, "end": 35.74, "text": "שישים חלקי ארבע, חמש עשרה.", "words": [{"t": "שישים", "s": 33.1, "e": 33.98}, {"t": "חלקי", "s": 33.98, "e": 34.4}, {"t": "ארבע,", "s": 34.4, "e": 34.74}, {"t": "חמש", "s": 34.74, "e": 35.4}, {"t": "עשרה.", "s": 35.4, "e": 35.74}]}, {"start": 35.8, "end": 37.08, "text": "היחידות תואמות?", "words": [{"t": "היחידות", "s": 35.8, "e": 36.64}, {"t": "תואמות?", "s": 36.64, "e": 37.08}]}, {"start": 37.16, "end": 38.96, "text": "כפל אחד, וזהו.", "words": [{"t": "כפל", "s": 37.16, "e": 37.96}, {"t": "אחד,", "s": 37.96, "e": 38.14}, {"t": "וזהו.", "s": 38.14, "e": 38.96}]}], "captions_default": "on", "text_load": {"mean_visible_words": 14.0, "threshold": 20.0}}
