{"slug": "psyq_zero_one_dont_decide", "duration": 35.8, "cues": [{"start": 0.0, "end": 1.78, "text": "הצבת אפס, ושלוש", "words": [{"t": "הצבת", "s": 0.0, "e": 0.6}, {"t": "אפס,", "s": 0.6, "e": 1.19}, {"t": "ושלוש", "s": 1.19, "e": 1.78}]}, {"start": 1.78, "end": 3.28, "text": "אפשרויות יצאו נכונות?", "words": [{"t": "אפשרויות", "s": 1.78, "e": 2.48}, {"t": "יצאו", "s": 2.48, "e": 2.78}, {"t": "נכונות?", "s": 2.78, "e": 3.28}]}, {"start": 3.4, "end": 4.4, "text": "זה לא מקרה.", "words": [{"t": "זה", "s": 3.4, "e": 3.82}, {"t": "לא", "s": 3.82, "e": 4.0}, {"t": "מקרה.", "s": 4.0, "e": 4.4}]}, {"start": 4.56, "end": 7.22, "text": "אפס ואחד הם ערכים חריגים.", "words": [{"t": "אפס", "s": 4.56, "e": 5.11}, {"t": "ואחד", "s": 5.11, "e": 5.66}, {"t": "הם", "s": 5.66, "e": 6.08}, {"t": "ערכים", "s": 6.08, "e": 6.62}, {"t": "חריגים.", "s": 6.62, "e": 7.22}]}, {"start": 7.36, "end": 9.34, "text": "אחד בכל חזקה נשאר אחד.", "words": [{"t": "אחד", "s": 7.36, "e": 7.9}, {"t": "בכל", "s": 7.9, "e": 8.44}, {"t": "חזקה", "s": 8.44, "e": 8.76}, {"t": "נשאר", "s": 8.76, "e": 9.14}, {"t": "אחד.", "s": 9.14, "e": 9.34}]}, {"start": 9.54, "end": 11.94, "text": "ואפס מאפס כל מכפלה.", "words": [{"t": "ואפס", "s": 9.54, "e": 10.42}, {"t": "מאפס", "s": 10.42, "e": 11.24}, {"t": "כל", "s": 11.24, "e": 11.44}, {"t": "מכפלה.", "s": 11.44, "e": 11.94}]}, {"start": 12.02, "end": 13.22, "text": "לכן הם עלולים", "words": [{"t": "לכן", "s": 12.02, "e": 12.76}, {"t": "הם", "s": 12.76, "e": 12.88}, {"t": "עלולים", "s": 12.88, "e": 13.22}]}, {"start": 13.22, "end": 14.52, "text": "לאמת כמה אפשרויות.", "words": [{"t": "לאמת", "s": 13.22, "e": 13.6}, {"t": "כמה", "s": 13.6, "e": 13.98}, {"t": "אפשרויות.", "s": 13.98, "e": 14.52}]}, {"start": 14.7, "end": 16.0, "text": "וגם מספר רגיל", "words": [{"t": "וגם", "s": 14.7, "e": 15.4}, {"t": "מספר", "s": 15.4, "e": 15.72}, {"t": "רגיל", "s": 15.72, "e": 16.0}]}, {"start": 16.0, "end": 16.92, "text": "אחד לא מספיק.", "words": [{"t": "אחד", "s": 16.0, "e": 16.18}, {"t": "לא", "s": 16.18, "e": 16.46}, {"t": "מספיק.", "s": 16.46, "e": 16.92}]}, {"start": 17.06, "end": 18.84, "text": "אפשרות יכולה לשרוד הצבה", "words": [{"t": "אפשרות", "s": 17.06, "e": 17.72}, {"t": "יכולה", "s": 17.72, "e": 18.06}, {"t": "לשרוד", "s": 18.06, "e": 18.46}, {"t": "הצבה", "s": 18.46, "e": 18.84}]}, {"start": 18.84, "end": 20.34, "text": "אחת וליפול בשנייה.", "words": [{"t": "אחת", "s": 18.84, "e": 19.3}, {"t": "וליפול", "s": 19.3, "e": 19.88}, {"t": "בשנייה.", "s": 19.88, "e": 20.34}]}, {"start": 20.8, "end": 22.44, "text": "שתי אפשרויות יצאו נכונות?", "words": [{"t": "שתי", "s": 20.8, "e": 21.2}, {"t": "אפשרויות", "s": 21.2, "e": 21.64}, {"t": "יצאו", "s": 21.64, "e": 21.9}, {"t": "נכונות?", "s": 21.9, "e": 22.44}]}, {"start": 22.46, "end": 24.32, "text": "הבדיקה לא הכריעה.", "words": [{"t": "הבדיקה", "s": 22.46, "e": 23.26}, {"t": "לא", "s": 23.26, "e": 23.66}, {"t": "הכריעה.", "s": 23.66, "e": 24.32}]}, {"start": 24.36, "end": 26.86, "text": "הצב מספר שני מטיפוס אחר.", "words": [{"t": "הצב", "s": 24.36, "e": 24.92}, {"t": "מספר", "s": 24.92, "e": 25.32}, {"t": "שני", "s": 25.32, "e": 25.72}, {"t": "מטיפוס", "s": 25.72, "e": 26.42}, {"t": "אחר.", "s": 26.42, "e": 26.86}]}, {"start": 26.92, "end": 29.06, "text": "קודם שתיים, ואז חצי.", "words": [{"t": "קודם", "s": 26.92, "e": 27.58}, {"t": "שתיים,", "s": 27.58, "e": 27.8}, {"t": "ואז", "s": 27.8, "e": 28.64}, {"t": "חצי.", "s": 28.64, "e": 29.06}]}, {"start": 29.06, "end": 30.22, "text": "סתם ביטוי?", "words": [{"t": "סתם", "s": 29.06, "e": 29.88}, {"t": "ביטוי?", "s": 29.88, "e": 30.22}]}, {"start": 30.3, "end": 32.04, "text": "לא אפס ולא אחד.", "words": [{"t": "לא", "s": 30.3, "e": 30.78}, {"t": "אפס", "s": 30.78, "e": 31.38}, {"t": "ולא", "s": 31.38, "e": 31.78}, {"t": "אחד.", "s": 31.78, "e": 32.04}]}, {"start": 32.24, "end": 33.74, "text": "ובדוק לפחות שני", "words": [{"t": "ובדוק", "s": 32.24, "e": 32.94}, {"t": "לפחות", "s": 32.94, "e": 33.38}, {"t": "שני", "s": 33.38, "e": 33.74}]}, {"s