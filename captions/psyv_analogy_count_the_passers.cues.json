{"slug": "psyv_analogy_count_the_passers", "duration": 42.3, "cues": [{"start": 0, "end": 2.06, "text": "מצנח, נפילה.", "words": [{"t": "מצנח,", "s": 0, "e": 1.02}, {"t": "נפילה.", "s": 1.04, "e": 1.94}]}, {"start": 2.06, "end": 3.58, "text": "ניסחת יחס:", "words": [{"t": "ניסחת", "s": 2.06, "e": 2.98}, {"t": "יחס:", "s": 2.98, "e": 3.46}]}, {"start": 3.58, "end": 5.9, "text": "מצנח קשור לנפילה.", "words": [{"t": "מצנח", "s": 3.58, "e": 4.46}, {"t": "קשור", "s": 4.46, "e": 5.22}, {"t": "לנפילה.", "s": 5.22, "e": 5.78}]}, {"start": 5.92, "end": 8.08, "text": "המשפט הזה נכון לגמרי.", "words": [{"t": "המשפט", "s": 5.92, "e": 6.8}, {"t": "הזה", "s": 6.8, "e": 6.98}, {"t": "נכון", "s": 6.98, "e": 7.46}, {"t": "לגמרי.", "s": 7.46, "e": 7.96}]}, {"start": 8.06, "end": 9.98, "text": "ועכשיו תספור.", "words": [{"t": "ועכשיו", "s": 8.06, "e": 8.92}, {"t": "תספור.", "s": 8.92, "e": 9.86}]}, {"start": 9.9, "end": 12.12, "text": "כמה מהתשובות עוברות אותו?", "words": [{"t": "כמה", "s": 9.9, "e": 10.68}, {"t": "מהתשובות", "s": 10.68, "e": 11.34}, {"t": "עוברות", "s": 11.34, "e": 11.82}, {"t": "אותו?", "s": 11.82, "e": 12}]}, {"start": 12.34, "end": 13.34, "text": "כולן.", "words": [{"t": "כולן.", "s": 12.34, "e": 13.22}]}, {"start": 13.4, "end": 14.92, "text": "ארבע מתוך ארבע.", "words": [{"t": "ארבע", "s": 13.4, "e": 14.04}, {"t": "מתוך", "s": 14.04, "e": 14.46}, {"t": "ארבע.", "s": 14.46, "e": 14.8}]}, {"start": 15.34, "end": 17.1, "text": "משפט שכולן עוברות לא", "words": [{"t": "משפט", "s": 15.34, "e": 15.78}, {"t": "שכולן", "s": 15.78, "e": 16.3}, {"t": "עוברות", "s": 16.3, "e": 16.7}, {"t": "לא", "s": 16.7, "e": 16.98}]}, {"start": 16.98, "end": 18.22, "text": "פסל אף אחת.", "words": [{"t": "פסל", "s": 16.98, "e": 17.44}, {"t": "אף", "s": 17.44, "e": 17.72}, {"t": "אחת.", "s": 17.72, "e": 18.1}]}, {"start": 18.14, "end": 20.3, "text": "אז מצמצמים את המשפט.", "words": [{"t": "אז", "s": 18.14, "e": 18.7}, {"t": "מצמצמים", "s": 18.7, "e": 19.56}, {"t": "את", "s": 19.56, "e": 19.74}, {"t": "המשפט.", "s": 19.74, "e": 20.18}]}, {"start": 20.6, "end": 23.52, "text": "מצנח הוא אמצעי, ונפילה", "words": [{"t": "מצנח", "s": 20.6, "e": 21.48}, {"t": "הוא", "s": 21.48, "e": 21.66}, {"t": "אמצעי,", "s": 21.66, "e": 22.32}, {"t": "ונפילה", "s": 22.38, "e": 23.4}]}, {"start": 23.4, "end": 25.22, "text": "היא התהליך שהוא מרסן.", "words": [{"t": "היא", "s": 23.4, "e": 23.72}, {"t": "התהליך", "s": 23.72, "e": 24.36}, {"t": "שהוא", "s": 24.36, "e": 24.52}, {"t": "מרסן.", "s": 24.52, "e": 25.1}]}, {"start": 25.38, "end": 26.54, "text": "תספור שוב.", "words": [{"t": "תספור", "s": 25.38, "e": 26.06}, {"t": "שוב.", "s": 26.06, "e": 26.42}]}, {"start": 26.42, "end": 29.16, "text": "עכשיו עוברת רק אחת.", "words": [{"t": "עכשיו", "s": 26.42, "e": 27.42}, {"t": "עוברת", "s": 27.42, "e": 27.98}, {"t": "רק", "s": 27.98, "e": 28.3}, {"t": "אחת.", "s": 28.3, "e": 29.04}]}, {"start": 29.22, "end": 31.1, "text": "סכר, הצפה.", "words": [{"t": "סכר,", "s": 29.22, "e": 30.14}, {"t": "הצפה.", "s": 30.14, "e": 30.98}]}, {"start": 31.64, "end": 33.7, "text": "אחת עוברת, המשפט נעול.", "words": [{"t": "אחת", "s": 31.64, "e": 32.1}, {"t": "עוברת,", "s": 32.1, "e": 32.48}, {"t": "המשפט", "s": 32.58, "e": 33.26}, {"t": "נעול.", "s": 33.26, "e": 33.58}]}, {"start": 33.72, "end": 35.84, "text": "שתיים עוברות, המשפט", "words": [{"t": "שתיים", "s": 33.72, "e": 34.58}, {"t": "עוברות,", "s": 34.58, "e": 34.9}, {"t": "המשפט", "s": 35.02, "e": 35.72}]}, {"start": 35.72, "end": 36.68, "text": "עדיין רופף.", "words": [{"t": "עדיין", "s": 35.72, "e": 36.22}, {"t": "רופף.", "s": 36.22, "e": 36.56}]}, {"start": 37.06, "end": 38.26, "text": "אל תבחר מה", "words": [{"t": "אל", "s": 37.06, "e": 37.52}, {"t": "תבחר", "s": 37.52, "e": 38.02}, {"t": "מה", "s": 38.02, "e": 38.14}]}, {"start": 38.14, "end": 39.38, "text": "מרגיש נכון יותר.", "words": [{"t": "מרגיש", "s": 38.14, "e": 38.62}, {"t": "נכון", "s": 38.62, "e": 39.08}, {"t": "יותר.", "s": 39.08, "e": 39.26}]}, {"start": 39.5, "end": 40.82, "text": "פשוט תספור.", "words": [{"t": "פשוט", "s": 39.5, "e": 40.18}, {"t": "תספור.", "s": 40.18, "e": 40.7}]}]}
