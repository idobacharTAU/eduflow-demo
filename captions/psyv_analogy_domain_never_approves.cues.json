{"slug": "psyv_analogy_domain_never_approves", "duration": 39.8, "cues": [{"start": 0.0, "end": 1.65, "text": "קרבת נושא מפתה.", "words": [{"t": "קרבת", "s": 0.0, "e": 0.588}, {"t": "נושא", "s": 0.588, "e": 1.043}, {"t": "מפתה.", "s": 1.043, "e": 1.65}]}, {"start": 1.745, "end": 2.675, "text": "אבל היא אף", "words": [{"t": "אבל", "s": 1.745, "e": 2.295}, {"t": "היא", "s": 2.295, "e": 2.447}, {"t": "אף", "s": 2.447, "e": 2.675}]}, {"start": 2.675, "end": 3.566, "text": "פעם לא מאשרת.", "words": [{"t": "פעם", "s": 2.675, "e": 2.959}, {"t": "לא", "s": 2.959, "e": 3.092}, {"t": "מאשרת.", "s": 3.092, "e": 3.566}]}, {"start": 3.775, "end": 5.482, "text": "מצנח, נפילה.", "words": [{"t": "מצנח,", "s": 3.775, "e": 4.686}, {"t": "נפילה.", "s": 4.742, "e": 5.482}]}, {"start": 6.108, "end": 6.564, "text": "מסיח:", "words": [{"t": "מסיח:", "s": 6.108, "e": 6.564}]}, {"start": 6.772, "end": 8.385, "text": "קסדה, אופנוע.", "words": [{"t": "קסדה,", "s": 6.772, "e": 7.645}, {"t": "אופנוע.", "s": 7.664, "e": 8.385}]}, {"start": 8.555, "end": 11.401, "text": "קסדה ומצנח, שניהם ציוד מגן.", "words": [{"t": "קסדה", "s": 8.555, "e": 9.466}, {"t": "ומצנח,", "s": 9.466, "e": 10.111}, {"t": "שניהם", "s": 10.13, "e": 10.794}, {"t": "ציוד", "s": 10.794, "e": 11.078}, {"t": "מגן.", "s": 11.078, "e": 11.401}]}, {"start": 11.534, "end": 13.469, "text": "ובכל זאת הזוג נפסל.", "words": [{"t": "ובכל", "s": 11.534, "e": 12.293}, {"t": "זאת", "s": 12.293, "e": 12.615}, {"t": "הזוג", "s": 12.615, "e": 12.975}, {"t": "נפסל.", "s": 12.975, "e": 13.469}]}, {"start": 14.0, "end": 15.84, "text": "בשאלה הזו היחס דורש", "words": [{"t": "בשאלה", "s": 14.0, "e": 14.455}, {"t": "הזו", "s": 14.455, "e": 14.797}, {"t": "היחס", "s": 14.834, "e": 15.517}, {"t": "דורש", "s": 15.517, "e": 15.84}]}, {"start": 15.84, "end": 18.515, "text": "תהליך, ואופנוע אינו תהליך.", "words": [{"t": "תהליך,", "s": 15.84, "e": 16.428}, {"t": "ואופנוע", "s": 16.542, "e": 17.32}, {"t": "אינו", "s": 17.32, "e": 17.965}, {"t": "תהליך.", "s