{"slug": "psyv_analogy_relation_lock", "duration": 45.0, "cues": [{"start": 0, "end": 1.82, "text": "מצנח נפילה.", "words": [{"t": "מצנח", "s": 0, "e": 0.86}, {"t": "נפילה.", "s": 0.86, "e": 1.7}]}, {"start": 2.26, "end": 3.56, "text": "מסיח אחד ירגיש", "words": [{"t": "מסיח", "s": 2.26, "e": 2.74}, {"t": "אחד", "s": 2.74, "e": 3.02}, {"t": "ירגיש", "s": 3.02, "e": 3.44}]}, {"start": 3.44, "end": 4.28, "text": "לך נכון.", "words": [{"t": "לך", "s": 3.44, "e": 3.62}, {"t": "נכון.", "s": 3.62, "e": 4.16}]}, {"start": 4.36, "end": 6.62, "text": "קסדה, אופנוע, אותו", "words": [{"t": "קסדה,", "s": 4.36, "e": 5.2}, {"t": "אופנוע,", "s": 5.4, "e": 5.94}, {"t": "אותו", "s": 6.12, "e": 6.5}]}, {"start": 6.5, "end": 7.6, "text": "עולם בטיחות.", "words": [{"t": "עולם", "s": 6.5, "e": 6.92}, {"t": "בטיחות.", "s": 6.92, "e": 7.48}]}, {"start": 8, "end": 10.08, "text": "וזו בדיוק המלכודת.", "words": [{"t": "וזו", "s": 8, "e": 8.48}, {"t": "בדיוק", "s": 8.48, "e": 9.14}, {"t": "המלכודת.", "s": 9.14, "e": 9.96}]}, {"start": 10.38, "end": 11.46, "text": "הטכניקה?", "words": [{"t": "הטכניקה?", "s": 10.38, "e": 11.34}]}, {"start": 11.36, "end": 13.52, "text": "לפני שמסתכלים בתשובות,", "words": [{"t": "לפני", "s": 11.36, "e": 12.24}, {"t": "שמסתכלים", "s": 12.24, "e": 12.82}, {"t": "בתשובות,", "s": 12.82, "e": 13.4}]}, {"start": 13.4, "end": 15.14, "text": "מנסחים את היחס.", "words": [{"t": "מנסחים", "s": 13.4, "e": 14.2}, {"t": "את", "s": 14.2, "e": 14.4}, {"t": "היחס.", "s": 14.4, "e": 15.02}]}, {"start": 15.58, "end": 17.64, "text": "מצנח הוא האמצעי", "words": [{"t": "מצנח", "s": 15.58, "e": 16.54}, {"t": "הוא", "s": 16.54, "e": 16.88}, {"t": "האמצעי", "s": 16.88, "e": 17.52}]}, {"start": 17.52, "end": 19.48, "text": "שמרסן תהליך טבעי.", "words": [{"t": "שמרסן", "s": 17.52, "e": 18.34}, {"t": "תהליך", "s": 18.34, "e": 18.88}, {"t": "טבעי.", "s": 18.88, "e": 19.36}]}, {"start": 19.46, "end": 20.4, "text": "נפילה.", "words": [{"t": "נפילה.", "s": 19.46, "e": 20.28}]}, {"start": 20.64,