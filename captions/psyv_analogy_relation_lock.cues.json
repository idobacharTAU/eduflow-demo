{"slug": "psyv_analogy_relation_lock", "duration": 37.54, "cues": [{"start": 0.0, "end": 1.72, "text": "מצנח, נפילה.", "words": [{"t": "מצנח,", "s": 0.0, "e": 0.92}, {"t": "נפילה.", "s": 0.92, "e": 1.72}]}, {"start": 1.76, "end": 3.98, "text": "מסיח אחד ירגיש נכון.", "words": [{"t": "מסיח", "s": 1.76, "e": 2.6}, {"t": "אחד", "s": 2.6, "e": 2.88}, {"t": "ירגיש", "s": 2.88, "e": 3.52}, {"t": "נכון.", "s": 3.52, "e": 3.98}]}, {"start": 4.06, "end": 6.84, "text": "קסדה, אופנוע אותו עולם-בטיחות.", "words": [{"t": "קסדה,", "s": 4.06, "e": 4.92}, {"t": "אופנוע", "s": 4.94, "e": 5.48}, {"t": "אותו", "s": 5.66, "e": 6.04}, {"t": "עולם-בטיחות.", "s": 6.04, "e": 6.84}]}, {"start": 6.94, "end": 8.98, "text": "וזו בדיוק המלכודת.", "words": [{"t": "וזו", "s": 6.94, "e": 7.72}, {"t": "בדיוק", "s": 7.72, "e": 8.44}, {"t": "המלכודת.", "s": 8.44, "e": 8.98}]}, {"start": 9.22, "end": 10.06, "text": "הטכניקה:", "words": [{"t": "הטכניקה:", "s": 9.22, "e": 10.06}]}, {"start": 10.08, "end": 11.92, "text": "לפני שמסתכלים בתשובות,", "words": [{"t": "לפני", "s": 10.08, "e": 10.76}, {"t": "שמסתכלים", "s": 10.76, "e": 11.4}, {"t": "בתשובות,", "s": 11.4, "e": 11.92}]}, {"start": 11.94, "end": 13.24, "text": "מנסחים את היחס.", "words": [{"t": "מנסחים", "s": 11.94, "e": 12.62}, {"t": "את", "s": 12.62, "e": 12.78}, {"t": "היחס.", "s": 12.78, "e": 13.24}]}, {"start": 13.48, "end": 15.9, "text": "מצנח הוא האמצעי שמרסן", "words": [{"t": "מצנח", "s": 13.48, "e": 14.36}, {"t": "הוא", "s": 14.36, "e": 14.6}, {"t": "האמצעי", "s": 14.6, "e": 15.24}, {"t": "שמרסן", "s": 15.24, "e": 15.9}]}, {"start": 15.9, "end": 17.62, "text": "תהליך טבעי, נפילה.", "words": [{"t": "תהליך", "s": 15.9, "e": 16.4}, {"t": "טבעי,", "s": 16.4, "e": 16.84}, {"t": "נפילה.", "s": 16.92, "e": 17.62}]}, {"start": 17.7, "end": 19.28, "text": "זה המשפט הנעול.", "words": [{"t": "זה", "s": 17.7, "e": 18.28}, {"t": "המשפט", "s": 18.28, "e": 18.86}, {"t": "הנעול.", "s": 18.86, "e": 19.28}]}, {"start": 19.44, "end": 21.26, "text": "עכשיו ב