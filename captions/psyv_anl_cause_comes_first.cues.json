{"slug": "psyv_anl_cause_comes_first", "duration": 39.9, "cues": [{"start": 0.0, "end": 1.44, "text": "מי עומדת ראשונה:", "words": [{"t": "מי", "s": 0.0, "e": 0.54}, {"t": "עומדת", "s": 0.54, "e": 0.94}, {"t": "ראשונה:", "s": 0.94, "e": 1.44}]}, {"start": 1.48, "end": 3.24, "text": "סיבה או תוצאה?", "words": [{"t": "סיבה", "s": 1.48, "e": 2.28}, {"t": "או", "s": 2.28, "e": 2.62}, {"t": "תוצאה?", "s": 2.62, "e": 3.24}]}, {"start": 3.4, "end": 5.32, "text": "עקיצה, נפיחות.", "words": [{"t": "עקיצה,", "s": 3.4, "e": 4.38}, {"t": "נפיחות.", "s": 4.38, "e": 5.32}]}, {"start": 5.54, "end": 6.52, "text": "הנעילה:", "words": [{"t": "הנעילה:", "s": 5.54, "e": 6.52}]}, {"start": 6.52, "end": 8.16, "text": "הראשונה היא הסיבה,", "words": [{"t": "הראשונה", "s": 6.52, "e": 7.54}, {"t": "היא", "s": 7.54, "e": 7.66}, {"t": "הסיבה,", "s": 7.66, "e": 8.16}]}, {"start": 8.16, "end": 10.18, "text": "והשנייה נגרמת ממנה.", "words": [{"t": "והשנייה", "s": 8.16, "e": 8.94}, {"t": "נגרמת", "s": 8.94, "e": 9.72}, {"t": "ממנה.", "s": 9.72, "e": 10.18}]}, {"start": 10.44, "end": 13.52, "text": "העקיצה קרתה קודם, והנפיחות אחריה.", "words": [{"t": "העקיצה", "s": 10.44, "e": 11.32}, {"t": "קרתה", "s": 11.32, "e": 11.7}, {"t": "קודם,", "s": 11.7, "e": 12.12}, {"t": "והנפיחות", "s": 12.12, "e": 12.92}, {"t": "אחריה.", "s": 12.92, "e": 13.52}]}, {"start": 13.64, "end": 15.0, "text": "עכשיו מסיח:", "words": [{"t": "עכשיו", "s": 13.64, "e": 14.52}, {"t": "מסיח:", "s": 14.52, "e": 15.0}]}, {"start": 15.2, "end": 17.08, "text": "תאונה, רשלנות.", "words": [{"t": "תאונה,", "s": 15.2, "e": 15.92}, {"t": "רשלנות.", "s": 16.14, "e": 17.08}]}, {"start": 17.24, "end": 19.42, "text": "גם כאן יש סיבה ותוצאה.", "words": [{"t": "גם", "s": 17.24, "e": 17.8}, {"t": "כאן", "s": 17.8, "e": 18.16}, {"t": "יש", "s": 18.16, "e": 18.3}, {"t": "סיבה", "s": 18.3, "e": 18.82}, {"t": "ותוצאה.", "s": 18.82, "e": 19.42}]}, {"start": 19.46, "end": 21.84, "text": "אבל הרשלנות קרתה קודם.", "words": [{"t": "אבל", "s": 19.46, "e": 2