{"slug": "psyv_es3_either_side_can_win", "duration": 38.66, "cues": [{"start": 0, "end": 1.58, "text": "איזו עמדה הבודקים", "words": [{"t": "איזו", "s": 0, "e": 0.64}, {"t": "עמדה", "s": 0.64, "e": 1.02}, {"t": "הבודקים", "s": 1.02, "e": 1.46}]}, {"start": 1.46, "end": 2.42, "text": "רוצים לקרוא?", "words": [{"t": "רוצים", "s": 1.46, "e": 1.94}, {"t": "לקרוא?", "s": 1.94, "e": 2.3}]}, {"start": 2.46, "end": 4.36, "text": "במטלת הכתיבה אין", "words": [{"t": "במטלת", "s": 2.46, "e": 3.32}, {"t": "הכתיבה", "s": 3.32, "e": 3.74}, {"t": "אין", "s": 3.74, "e": 4.24}]}, {"start": 4.24, "end": 5.58, "text": "תשובה אחת נכונה.", "words": [{"t": "תשובה", "s": 4.24, "e": 4.6}, {"t": "אחת", "s": 4.6, "e": 5.02}, {"t": "נכונה.", "s": 5.02, "e": 5.46}]}, {"start": 5.87, "end": 6.84, "text": "נושא לדוגמה.", "words": [{"t": "נושא", "s": 5.87, "e": 6.3}, {"t": "לדוגמה.", "s": 6.3, "e": 6.72}]}, {"start": 6.82, "end": 8.24, "text": "האם להגביל זמן", "words": [{"t": "האם", "s": 6.82, "e": 7.26}, {"t": "להגביל", "s": 7.26, "e": 7.78}, {"t": "זמן", "s": 7.78, "e": 8.12}]}, {"start": 8.12, "end": 9.4, "text": "מסך לבני נוער?", "words": [{"t": "מסך", "s": 8.12, "e": 8.44}, {"t": "לבני", "s": 8.44, "e": 8.86}, {"t": "נוער?", "s": 8.86, "e": 9.28}]}, {"start": 9.4, "end": 11, "text": "אפשר לטעון בעד,", "words": [{"t": "אפשר", "s": 9.4, "e": 10.02}, {"t": "לטעון", "s": 10.02, "e": 10.42}, {"t": "בעד,", "s": 10.42, "e": 10.88}]}, {"start": 10.9, "end": 12.2, "text": "ואפשר לטעון נגד.", "words": [{"t": "ואפשר", "s": 10.9, "e": 11.38}, {"t": "לטעון", "s": 11.38, "e": 11.72}, {"t": "נגד.", "s": 11.72, "e": 12.08}]}, {"start": 12.2, "end": 14.3, "text": "שני הכיוונים תקינים, כל", "words": [{"t": "שני", "s": 12.2, "e": 12.78}, {"t": "הכיוונים", "s": 12.78, "e": 13.24}, {"t": "תקינים,", "s": 13.24, "e": 13.8}, {"t": "כל", "s": 13.82, "e": 14.18}]}, {"start": 14.18, "end": 16.26, "text": "עוד המבנה מלא וברור.", "words": [{"t": "עוד", "s": 14.18, "e": 14.58}, {"t": "המבנה", "s": 14.58, "e": 15.04}, {"