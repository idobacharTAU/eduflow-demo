{"slug": "psyv_essay_close_adds_nothing_new", "duration": 34.59, "cues": [{"start": 0.0, "end": 2.46, "text": "פסקת הסיכום עושה דבר אחד.", "words": [{"t": "פסקת", "s": 0.0, "e": 0.6}, {"t": "הסיכום", "s": 0.6, "e": 1.16}, {"t": "עושה", "s": 1.16, "e": 1.66}, {"t": "דבר", "s": 1.66, "e": 2.02}, {"t": "אחד.", "s": 2.02, "e": 2.46}]}, {"start": 2.5, "end": 4.9, "text": "היא סוגרת, והיא לא פותחת.", "words": [{"t": "היא", "s": 2.5, "e": 2.78}, {"t": "סוגרת,", "s": 2.78, "e": 3.46}, {"t": "והיא", "s": 3.46, "e": 4.06}, {"t": "לא", "s": 4.06, "e": 4.3}, {"t": "פותחת.", "s": 4.3, "e": 4.9}]}, {"start": 5.38, "end": 7.044, "text": "בחיבור אין מסיחים,", "words": [{"t": "בחיבור", "s": 5.38, "e": 6.2}, {"t": "אין", "s": 6.2, "e": 6.56}, {"t": "מסיחים,", "s": 6.56, "e": 7.044}]}, {"start": 7.12, "end": 8.559, "text": "אבל אפשר לתרגל.", "words": [{"t": "אבל", "s": 7.12, "e": 7.54}, {"t": "אפשר", "s": 7.54, "e": 8.04}, {"t": "לתרגל.", "s": 8.04, "e": 8.559}]}, {"start": 8.98, "end": 10.78, "text": "חיבור על הגבלת זמן", "words": [{"t": "חיבור", "s": 8.98, "e": 9.8}, {"t": "על", "s": 9.8, "e": 9.96}, {"t": "הגבלת", "s": 9.96, "e": 10.46}, {"t": "זמן", "s": 10.46, "e": 10.78}]}, {"start": 10.78, "end": 12.963, "text": "מסך, ארבעה משפטי סיום.", "words": [{"t": "מסך,", "s": 10.78, "e": 11.2}, {"t": "ארבעה", "s": 11.32, "e": 12.12}, {"t": "משפטי", "s": 12.12, "e": 12.56}, {"t": "סיום.", "s": 12.56, "e": 12.963}]}, {"start": 13.38, "end": 15.34, "text": "ראוי להגביל את הגלילה", "words": [{"t": "ראוי", "s": 13.38, "e": 14.2}, {"t": "להגביל", "s": 14.2, "e": 14.78}, {"t": "את", "s": 14.78, "e": 14.86}, {"t": "הגלילה", "s": 14.86, "e": 15.34}]}, {"start": 15.38, "end": 17.201, "text": "ניסוח מחדש של הטענה.", "words": [{"t": "ניסוח", "s": 15.38, "e": 16.12}, {"t": "מחדש", "s": 16.12, "e": 16.64}, {"t": "של", "s": 16.64, "e": 16.78}, {"t": "הטענה.", "s": 16.78, "e": 17.201}]}, {"start": 17.87, "end": 20.1, "text": "פגיעה בשינה משפיעה על הריכוז", "words": [{"t": "פגיעה", "s": 17.87, "e": 18.28}, {"t": "בשינה", "s": 18.28, "e": 18.7}, {"t": "משפיעה", "s": 18.7, "e": 19.44}, {"t": "על", "s": 19.44, "e": 19.56}, {"t": "הריכוז", "s": 19.56, "e": 20.1}]}, {"start": 20.14, "end": 21.926, "text": "ניסוח מחדש של הנימוק.", "words": [{"t": "ניסוח", "s": 20.14, "e": 20.8}, {"t": "מחדש", "s": 20.8, "e": 21.34}, {"t": "של", "s": 21.34, "e": 21.44}, {"t": "הנימוק.", "s": 21.44, "e": 21.926}]}, {"start": 22.26, "end": 24.96, "text": "הגבלה ממוקדת עדיפה על איסור", "words": [{"t": "הגבלה", "s": 22.26, "e": 23.08}, {"t": "ממוקדת", "s": 23.08, "e": 23.84}, {"t": "עדיפה", "s": 23.84, "e": 24.44}, {"t": "על", "s": 24.44, "e": 24.56}, {"t": "איסור", "s": 24.56, "e": 24.96}]}, {"start": 24.96, "end": 27.02, "text": "גורף ההכרעה שכבר נגזרה.", "words": [{"t": "גורף", "s": 24.96, "e": 25.32}, {"t": "ההכרעה", "s": 25.52, "e": 26.4}, {"t": "שכבר", "s": 26.4, "e": 26.74}, {"t": "נגזרה.", "s": 26.74, "e": 27.02}]}, {"start": 27.02, "end": 29.5, "text": "ויש להטיל מס על", "words": [{"t": "ויש", "s": 27.02, "e": 28.38}, {"t": "להטיל", "s": 28.38, "e": 28.98}, {"t": "מס", "s": 28.98, "e": 29.2}, {"t": "על", "s": 29.2, "e": 29.5}]}, {"start": 29.5, "end": 31.64, "text": "חברות המדיה רעיון חדש.", "words": [{"t": "חברות", "s": 29.5, "e": 29.9}, {"t": "המדיה", "s": 29.9, "e": 30.34}, {"t": "רעיון", "s": 30.4, "e": 31.2}, {"t": "חדש.", "s": 31.2, "e": 31.64}]}, {"start": 31.68, "end": 32.82, "text": "הוא לא בוסס", "words": [{"t": "הוא", "s": 31.68, "e": 32.14}, {"t": "לא", "s": 32.14, "e": 32.36}, {"t": "בוסס", "s": 32.36, "e": 32.82}]}, {"start": 32.82, "end": 34.02, "text": "באף פסקה קודמת.", "words": [{"t": "באף", "s": 32.82, "e": 33.24}, {"t": "פסקה", "s": 33.24, "e": 33.56}, {"t": "קודמת.", "s": 33.56, "e": 34.02}]}], "captions_default": "on", "text_load": {"mean_visible_words": 19.7, "threshold": 20.0}}
