{"slug": "psyv_essay_concede_then_turn", "duration": 42.1, "cues": [{"start": 0, "end": 2, "text": "כלל אחד לפסקת", "words": [{"t": "כלל", "s": 0, "e": 0.52}, {"t": "אחד", "s": 0.52, "e": 0.82}, {"t": "לפסקת", "s": 0.82, "e": 1.88}]}, {"start": 1.88, "end": 2.92, "text": "טיעון הנגד.", "words": [{"t": "טיעון", "s": 1.88, "e": 2.3}, {"t": "הנגד.", "s": 2.3, "e": 2.8}]}, {"start": 2.82, "end": 4.82, "text": "שתי תנועות תמיד", "words": [{"t": "שתי", "s": 2.82, "e": 3.5}, {"t": "תנועות", "s": 3.5, "e": 4.04}, {"t": "תמיד", "s": 4.04, "e": 4.7}]}, {"start": 4.7, "end": 5.52, "text": "בסדר הזה.", "words": [{"t": "בסדר", "s": 4.7, "e": 5.22}, {"t": "הזה.", "s": 5.22, "e": 5.4}]}, {"start": 5.82, "end": 8.28, "text": "הודאה, ואז תפנית.", "words": [{"t": "הודאה,", "s": 5.82, "e": 6.74}, {"t": "ואז", "s": 6.74, "e": 7.62}, {"t": "תפנית.", "s": 7.62, "e": 8.16}]}, {"start": 8.34, "end": 9.38, "text": "הודאה:", "words": [{"t": "הודאה:", "s": 8.34, "e": 9.26}]}, {"start": 9.5, "end": 11.52, "text": "יש הטוענים שעבודה בזמן", "words": [{"t": "יש", "s": 9.5, "e": 10}, {"t": "הטוענים", "s": 10, "e": 10.48}, {"t": "שעבודה", "s": 10.48, "e": 11}, {"t": "בזמן", "s": 11, "e": 11.4}]}, {"start": 11.4, "end": 13.66, "text": "הלימודים גוזלת זמן לימוד.", "words": [{"t": "הלימודים", "s": 11.4, "e": 11.96}, {"t": "גוזלת", "s": 11.96, "e": 12.78}, {"t": "זמן", "s": 12.78, "e": 13.1}, {"t": "לימוד.", "s": 13.1, "e": 13.54}]}, {"start": 13.58, "end": 15.86, "text": "עצור כאן, והכף", "words": [{"t": "עצור", "s": 13.58, "e": 14.2}, {"t": "כאן,", "s": 14.2, "e": 14.66}, {"t": "והכף", "s": 14.72, "e": 15.74}]}, {"start": 15.74, "end": 17.24, "text": "נפלה לצד השני.", "words": [{"t": "נפלה", "s": 15.74, "e": 16.42}, {"t": "לצד", "s": 16.42, "e": 16.78}, {"t": "השני.", "s": 16.78, "e": 17.12}]}, {"start": 17.72, "end": 19.76, "text": "הכנסת לחיבור טענה נגד", "words": [{"t": "הכנסת", "s": 17.72, "e": 18.22}, {"t": "לחיבור", "s": 18.22, "e": 18.76}, {"t": "טענה", "s": 18.76, "e": 19.12}, {"t": "נגד", "s": 19.12, "e": 19.64}]}, {"start": 19.64, "end": 21.86, "text": "עצמך והשארת אותה עומדת.", "words": [{"t": "עצמך", "s": 19.64, "e": 19.96}, {"t": "והשארת", "s": 19.96, "e": 21.1}, {"t": "אותה", "s": 21.1, "e": 21.34}, {"t": "עומדת.", "s": 21.34, "e": 21.74}]}, {"start": 21.88, "end": 23.72, "text": "עכשיו התפנית.", "words": [{"t": "עכשיו", "s": 21.88, "e": 22.84}, {"t": "התפנית.", "s": 22.84, "e": 23.6}]}, {"start": 23.98, "end": 26.38, "text": "אך דווקא היא שמאלצת", "words": [{"t": "אך", "s": 23.98, "e": 24.48}, {"t": "דווקא", "s": 24.48, "e": 24.94}, {"t": "היא", "s": 24.94, "e": 25.2}, {"t": "שמאלצת", "s": 25.2, "e": 26.26}]}, {"start": 26.26, "end": 27.64, "text": "ניהול זמן קפדני.", "words": [{"t": "ניהול", "s": 26.26, "e": 26.6}, {"t": "זמן", "s": 26.6, "e": 26.98}, {"t": "קפדני.", "s": 26.98, "e": 27.52}]}, {"start": 28.08, "end": 29.22, "text": "הכף חוזרת.", "words": [{"t": "הכף", "s": 28.08, "e": 28.58}, {"t": "חוזרת.", "s": 28.58, "e": 29.1}]}, {"start": 29.1, "end": 31.5, "text": "מילת התפנית היא הציר.", "words": [{"t": "מילת", "s": 29.1, "e": 30.18}, {"t": "התפנית", "s": 30.18, "e": 30.7}, {"t": "היא", "s": 30.7, "e": 30.92}, {"t": "הציר.", "s": 30.92, "e": 31.38}]}, {"start": 31.58, "end": 34.28, "text": "אך, אולם, עם זאת.", "words": [{"t": "אך,", "s": 31.58, "e": 32.32}, {"t": "אולם,", "s": 32.32, "e": 32.98}, {"t": "עם", "s": 33.22, "e": 33.78}, {"t": "זאת.", "s": 33.78, "e": 34.16}]}, {"start": 34.34, "end": 36.2, "text": "אין תפנית, אין", "words": [{"t": "אין", "s": 34.34, "e": 35.06}, {"t": "תפנית,", "s": 35.06, "e": 35.48}, {"t": "אין", "s": 35.6, "e": 36.08}]}, {"start": 36.08, "end": 36.96, "text": "פסקת נגד.", "words": [{"t": "פסקת", "s": 36.08, "e": 36.44}, {"t": "נגד.", "s": 36.44, "e": 36.84}]}, {"start": 36.86, "end": 37.74, "text": "יש ויתור.", "words": [{"t": "יש", "s": 36.86, "e": 37.22}, {"t": "ויתור.", "s": 37.22, "e": 37.62}]}, {"start": 38.02, "end": 38.88, "text": "שאלה?", "words": [{"t": "שאלה?", "s": 38.02, "e": 38.76}]}, {"start": 38.82, "end": 40.62, "text": "איפה מילת התפנית שלך?", "words": [{"t": "איפה", "s": 38.82, "e": 39.56}, {"t": "מילת", "s": 39.56, "e": 39.88}, {"t": "התפנית", "s": 39.88, "e": 40.24}, {"t": "שלך?", "s": 40.24, "e": 40.5}]}]}
