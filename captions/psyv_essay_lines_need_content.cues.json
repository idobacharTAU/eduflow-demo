{"slug": "psyv_essay_lines_need_content", "duration": 39.44, "cues": [{"start": 0, "end": 1.16, "text": "נועה סיימה את", "words": [{"t": "נועה", "s": 0, "e": 0.54}, {"t": "סיימה", "s": 0.54, "e": 0.92}, {"t": "את", "s": 0.92, "e": 1.04}]}, {"start": 1.04, "end": 2.82, "text": "החיבור ונשאר זמן.", "words": [{"t": "החיבור", "s": 1.04, "e": 1.5}, {"t": "ונשאר", "s": 1.5, "e": 2.26}, {"t": "זמן.", "s": 2.26, "e": 2.7}]}, {"start": 2.76, "end": 4.16, "text": "שלוש פסקאות.", "words": [{"t": "שלוש", "s": 2.76, "e": 3.56}, {"t": "פסקאות.", "s": 3.56, "e": 4.04}]}, {"start": 4.18, "end": 6.7, "text": "טענה, נימוק, סיכום.", "words": [{"t": "טענה,", "s": 4.18, "e": 4.92}, {"t": "נימוק,", "s": 5.04, "e": 5.76}, {"t": "סיכום.", "s": 5.9, "e": 6.58}]}, {"start": 6.72, "end": 8.36, "text": "היא ספרה את השורות.", "words": [{"t": "היא", "s": 6.72, "e": 7.18}, {"t": "ספרה", "s": 7.18, "e": 7.66}, {"t": "את", "s": 7.66, "e": 7.76}, {"t": "השורות.", "s": 7.76, "e": 8.24}]}, {"start": 8.28, "end": 9.56, "text": "חמש עשרה.", "words": [{"t": "חמש", "s": 8.28, "e": 8.96}, {"t": "עשרה.", "s": 8.96, "e": 9.44}]}, {"start": 9.72, "end": 11.14, "text": "הרצפה ידועה.", "words": [{"t": "הרצפה", "s": 9.72, "e": 10.54}, {"t": "ידועה.", "s": 10.54, "e": 11.02}]}, {"start": 11.08, "end": 12.94, "text": "עשרים וחמש שורות.", "words": [{"t": "עשרים", "s": 11.08, "e": 11.84}, {"t": "וחמש", "s": 11.84, "e": 12.4}, {"t": "שורות.", "s": 12.4, "e": 12.82}]}, {"start": 12.94, "end": 14.2, "text": "אז היא חזרה על", "words": [{"t": "אז", "s": 12.94, "e": 13.48}, {"t": "היא", "s": 13.48, "e": 13.58}, {"t": "חזרה", "s": 13.58, "e": 14}, {"t": "על", "s": 14, "e": 14.08}]}, {"start": 14.08, "end": 15.54, "text": "הנימוק במילים אחרות", "words": [{"t": "הנימוק", "s": 14.08, "e": 14.48}, {"t": "במילים", "s": 14.48, "e": 14.92}, {"t": "אחרות", "s": 14.92, "e": 15.42}]}, {"start": 15.42, "end": 16.8, "text": "עד שהדף יתמלא.", "words": [{"t": "עד", "s": 15.42, "e": 15.88}, {"t": "שהדף", "s": 15.88, "e": 16.36}, {"t": "יתמלא.", "s": 16.36, "e": 16.68}]}, {"start": 17.26, "end": 18.2, "text": "זו הטעות.", "words": [{"t": "זו", "s": 17.26, "e": 17.7}, {"t": "הטעות.", "s": 17.7, "e": 18.08}]}, {"start": 18.24, "end": 20.04, "text": "מילוי שורות מוסיף", "words": [{"t": "מילוי", "s": 18.24, "e": 18.9}, {"t": "שורות", "s": 18.9, "e": 19.28}, {"t": "מוסיף", "s": 19.28, "e": 19.92}]}, {"start": 19.92, "end": 21.74, "text": "שורות ופוגע בלשון.", "words": [{"t": "שורות", "s": 19.92, "e": 20.44}, {"t": "ופוגע", "s": 20.44, "e": 21.14}, {"t": "בלשון.", "s": 21.14, "e": 21.62}]}, {"start": 21.76, "end": 23.04, "text": "מה שחסר לה", "words": [{"t": "מה", "s": 21.76, "e": 22.24}, {"t": "שחסר", "s": 22.24, "e": 22.82}, {"t": "לה", "s": 22.82, "e": 22.92}]}, {"start": 22.92, "end": 23.98, "text": "זה תוכן.", "words": [{"t": "זה", "s": 22.92, "e": 23.28}, {"t": "תוכן.", "s": 23.28, "e": 23.86}]}, {"start": 23.96, "end": 25.84, "text": "אצלה כל הגוף", "words": [{"t": "אצלה", "s": 23.96, "e": 24.68}, {"t": "כל", "s": 24.68, "e": 25.12}, {"t": "הגוף", "s": 25.12, "e": 25.72}]}, {"start": 25.72, "end": 26.54, "text": "הוא נימוק אחד.", "words": [{"t": "הוא", "s": 25.72, "e": 25.8}, {"t": "נימוק", "s": 25.8, "e": 26.2}, {"t": "אחד.", "s": 26.2, "e": 26.42}]}, {"start": 26.78, "end": 28.66, "text": "נועה הוסיפה פסקת גוף", "words": [{"t": "נועה", "s": 26.78, "e": 27.48}, {"t": "הוסיפה", "s": 27.48, "e": 27.92}, {"t": "פסקת", "s": 27.92, "e": 28.32}, {"t": "גוף", "s": 28.32, "e": 28.54}]}, {"start": 28.54, "end": 30.22, "text": "שנייה, טיעון הנגד,", "words": [{"t": "שנייה,", "s": 28.54, "e": 29}, {"t": "טיעון", "s": 29, "e": 29.66}, {"t": "הנגד,", "s": 29.66, "e": 30.1}]}, {"start": 30.1, "end": 31.66, "text": "והכפילה את הגוף.", "words": [{"t": "והכפילה", "s": 30.1, "e": 31.08}, {"t": "את", "s": 31.08, "e": 31.18}, {"t": "הגוף.", "s": 31.18, "e": 31.54}]}, {"start": 31.64, "end": 33.82, "text": "עכשיו החיבור עובר", "words": [{"t": "עכשיו", "s": 31.64, "e": 32.52}, {"t": "החיבור", "s": 32.52, "e": 33.2}, {"t": "עובר", "s": 33.2, "e": 33.7}]}, {"start": 33.7, "end": 34.4, "text": "את הרצפה.", "words": [{"t": "את", "s": 33.7, "e": 33.8}, {"t": "הרצפה.", "s": 33.8, "e": 34.28}]}, {"start": 34.5, "end": 36.32, "text": "כשחסרות שורות, שאל", "words": [{"t": "כשחסרות", "s": 34.5, "e": 35.38}, {"t": "שורות,", "s": 35.38, "e": 35.82}, {"t": "שאל", "s": 35.84, "e": 36.2}]}, {"start": 36.2, "end": 37.96, "text": "איזה תוכן חסר?", "words": [{"t": "איזה", "s": 36.2, "e": 36.94}, {"t": "תוכן", "s": 36.94, "e": 37.42}, {"t": "חסר?", "s": 37.42, "e": 37.84}]}]}
