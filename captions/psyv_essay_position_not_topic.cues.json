{"slug": "psyv_essay_position_not_topic", "duration": 37.22, "cues": [{"start": 0, "end": 2.22, "text": "במטלת הכתיבה אין מסיחים.", "words": [{"t": "במטלת", "s": 0, "e": 0.72}, {"t": "הכתיבה", "s": 0.72, "e": 1.14}, {"t": "אין", "s": 1.14, "e": 1.58}, {"t": "מסיחים.", "s": 1.58, "e": 2.1}]}, {"start": 2.14, "end": 4.16, "text": "כותבים חיבור, אבל אפשר", "words": [{"t": "כותבים", "s": 2.14, "e": 2.62}, {"t": "חיבור,", "s": 2.62, "e": 2.96}, {"t": "אבל", "s": 3.08, "e": 3.62}, {"t": "אפשר", "s": 3.62, "e": 4.04}]}, {"start": 4.04, "end": 5.8, "text": "לתרגל את המשפט הראשון.", "words": [{"t": "לתרגל", "s": 4.04, "e": 4.6}, {"t": "את", "s": 4.6, "e": 4.7}, {"t": "המשפט", "s": 4.7, "e": 5.18}, {"t": "הראשון.", "s": 5.18, "e": 5.68}]}, {"start": 5.76, "end": 8.24, "text": "ארבעה פתיחים, נושא אחד,", "words": [{"t": "ארבעה", "s": 5.76, "e": 6.48}, {"t": "פתיחים,", "s": 6.48, "e": 6.98}, {"t": "נושא", "s": 7, "e": 7.74}, {"t": "אחד,", "s": 7.74, "e": 8.12}]}, {"start": 8.38, "end": 9.92, "text": "חובת שנת התנדבות.", "words": [{"t": "חובת", "s": 8.38, "e": 8.96}, {"t": "שנת", "s": 8.96, "e": 9.32}, {"t": "התנדבות.", "s": 9.32, "e": 9.8}]}, {"start": 10.36, "end": 12.14, "text": "מאז ומתמיד התלבטה", "words": [{"t": "מאז", "s": 10.36, "e": 10.8}, {"t": "ומתמיד", "s": 10.8, "e": 11.36}, {"t": "התלבטה", "s": 11.36, "e": 12.02}]}, {"start": 12.02, "end": 13.7, "text": "החברה, הקדמה ריקה.", "words": [{"t": "החברה,", "s": 12.02, "e": 12.62}, {"t": "הקדמה", "s": 12.64, "e": 13.24}, {"t": "ריקה.", "s": 13.24, "e": 13.58}]}, {"start": 13.86, "end": 16.2, "text": "יש יתרונות וגם חסרונות,", "words": [{"t": "יש", "s": 13.86, "e": 14.32}, {"t": "יתרונות", "s": 14.32, "e": 14.9}, {"t": "וגם", "s": 14.9, "e": 15.34}, {"t": "חסרונות,", "s": 15.34, "e": 16.08}]}, {"start": 16.14, "end": 17.14, "text": "ישיבה על הגדר.", "words": [{"t": "ישיבה", "s": 16.14, "e": 16.64}, {"t": "על", "s": 16.64, "e": 16.72}, {"t": "הגדר.", "s": 16.72, "e": 17.02}]}, {"start": 17.22, "end": 19.16, "text": "אדון בשאלה ואציג", "words": [{"t": "אדון", "s": 17.22, "e": 17.9}, {"t": "בשאלה", "s": 17.9, "e": 18.44}, {"t": "ואציג", "s": 18.44, "e": 19.04}]}, {"start": 19.04, "end": 20.06, "text": "את שני הצדדים,", "words": [{"t": "את", "s": 19.04, "e": 19.16}, {"t": "שני", "s": 19.16, "e": 19.44}, {"t": "הצדדים,", "s": 19.44, "e": 19.94}]}, {"start": 20, "end": 21.12, "text": "הכרזה על נושא.", "words": [{"t": "הכרזה", "s": 20, "e": 20.54}, {"t": "על", "s": 20.54, "e": 20.72}, {"t": "נושא.", "s": 20.72, "e": 21}]}, {"start": 21.12, "end": 23.12, "text": "יש לחייב התנדבות", "words": [{"t": "יש", "s": 21.12, "e": 21.82}, {"t": "לחייב", "s": 21.82, "e": 22.54}, {"t": "התנדבות", "s": 22.54, "e": 23}]}, {"start": 23, "end": 24.48, "text": "משום שהיא מקנה", "words": [{"t": "משום", "s": 23, "e": 23.64}, {"t": "שהיא", "s": 23.64, "e": 23.92}, {"t": "מקנה", "s": 23.92, "e": 24.36}]}, {"start": 24.36, "end": 25.82, "text": "בגרות, זו עמדה.", "words": [{"t": "בגרות,", "s": 24.36, "e": 24.78}, {"t": "זו", "s": 24.96, "e": 25.44}, {"t": "עמדה.", "s": 25.44, "e": 25.7}]}, {"start": 25.9, "end": 28.38, "text": "מבחן אחד, פוסל שלושה.", "words": [{"t": "מבחן", "s": 25.9, "e": 26.78}, {"t": "אחד,", "s": 26.78, "e": 27}, {"t": "פוסל", "s": 27.22, "e": 27.76}, {"t": "שלושה.", "s": 27.76, "e": 28.26}]}, {"start": 28.26, "end": 30.34, "text": "שאל, אחרי המשפט", "words": [{"t": "שאל,", "s": 28.26, "e": 29}, {"t": "אחרי", "s": 29.1, "e": 29.74}, {"t": "המשפט", "s": 29.74, "e": 30.22}]}, {"start": 30.22, "end": 31.12, "text": "הזה אני יודע", "words": [{"t": "הזה", "s": 30.22, "e": 30.32}, {"t": "אני", "s": 30.32, "e": 30.7}, {"t": "יודע", "s": 30.7, "e": 31}]}, {"start": 31, "end": 32.26, "text": "במה הכותב תומך?", "words": [{"t": "במה", "s": 31, "e": 31.46}, {"t": "הכותב", "s": 31.46, "e": 31.84}, {"t": "תומך?", "s": 31.84, "e": 32.14}]}, {"start": 32.4, "end": 34.44, "text": "תרגול, מה העמדה", "words": [{"t": "תרגול,", "s": 32.4, "e": 33.16}, {"t": "מה", "s": 33.18, "e": 33.78}, {"t": "העמדה", "s": 33.78, "e": 34.32}]}, {"start": 34.32, "end": 35.74, "text": "שלך במשפט אחד?", "words": [{"t": "שלך", "s": 34.32, "e": 34.62}, {"t": "במשפט", "s": 34.62, "e": 35.44}, {"t": "אחד?", "s": 35.44, "e": 35.62}]}]}
