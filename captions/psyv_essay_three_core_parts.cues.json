{"slug": "psyv_essay_three_core_parts", "duration": 37.52, "cues": [{"start": 0, "end": 1.86, "text": "במודל הטיעון של טולמין", "words": [{"t": "במודל", "s": 0, "e": 0.7}, {"t": "הטיעון", "s": 0.7, "e": 1.12}, {"t": "של", "s": 1.12, "e": 1.28}, {"t": "טולמין", "s": 1.28, "e": 1.74}]}, {"start": 1.74, "end": 3.9, "text": "יש ליבה ותוספות.", "words": [{"t": "יש", "s": 1.74, "e": 2.2}, {"t": "ליבה", "s": 2.2, "e": 2.8}, {"t": "ותוספות.", "s": 2.8, "e": 3.78}]}, {"start": 3.92, "end": 6.12, "text": "הליבה היא שלושה חלקים.", "words": [{"t": "הליבה", "s": 3.92, "e": 4.72}, {"t": "היא", "s": 4.72, "e": 4.96}, {"t": "שלושה", "s": 4.96, "e": 5.52}, {"t": "חלקים.", "s": 5.52, "e": 6}]}, {"start": 6.26, "end": 7.7, "text": "טענה, מה אני", "words": [{"t": "טענה,", "s": 6.26, "e": 6.86}, {"t": "מה", "s": 7.02, "e": 7.42}, {"t": "אני", "s": 7.42, "e": 7.58}]}, {"start": 7.58, "end": 9.14, "text": "מוכיח, ראיה:", "words": [{"t": "מוכיח,", "s": 7.58, "e": 7.98}, {"t": "ראיה:", "s": 8.24, "e": 9.02}]}, {"start": 9.14, "end": 10.52, "text": "על מה אני נשען,", "words": [{"t": "על", "s": 9.14, "e": 9.58}, {"t": "מה", "s": 9.58, "e": 9.78}, {"t": "אני", "s": 9.78, "e": 9.9}, {"t": "נשען,", "s": 9.9, "e": 10.4}]}, {"start": 10.5, "end": 12.82, "text": "וחיבור, למה הראיה", "words": [{"t": "וחיבור,", "s": 10.5, "e": 11.44}, {"t": "למה", "s": 11.5, "e": 12.16}, {"t": "הראיה", "s": 12.16, "e": 12.7}]}, {"start": 12.7, "end": 14.22, "text": "הזאת תומכת בטענה.", "words": [{"t": "הזאת", "s": 12.7, "e": 12.96}, {"t": "תומכת", "s": 12.96, "e": 13.66}, {"t": "בטענה.", "s": 13.66, "e": 14.1}]}, {"start": 14.6, "end": 16.9, "text": "התוספות הן גיבוי, סייג", "words": [{"t": "התוספות", "s": 14.6, "e": 15.4}, {"t": "הן", "s": 15.4, "e": 15.58}, {"t": "גיבוי,", "s": 15.58, "e": 16.12}, {"t": "סייג", "s": 16.24, "e": 16.78}]}, {"start": 16.78, "end": 18.48, "text": "והסתייגות, והן לא", "words": [{"t": "והסתייגות,", "s": 16.78, "e": 17.58}, {"t": "והן", "s": 17.68, "e": 18.22}, {"t": "לא", "s": 18.22, "e": 18.36}]}, {"start": 18.36, "end": 19.56, "text": "נדרשות בכל טיעון.", "words": [{"t": "נדרשות", "s": 18.36, "e": 18.74}, {"t": "בכל", "s": 18.74, "e": 19.1}, {"t": "טיעון.", "s": 19.1, "e": 19.44}]}, {"start": 19.84, "end": 21.4, "text": "פסקת נימוק שלמה", "words": [{"t": "פסקת", "s": 19.84, "e": 20.48}, {"t": "נימוק", "s": 20.48, "e": 20.86}, {"t": "שלמה", "s": 20.86, "e": 21.28}]}, {"start": 21.28, "end": 22.76, "text": "עומדת על הליבה.", "words": [{"t": "עומדת", "s": 21.28, "e": 22.12}, {"t": "על", "s": 22.12, "e": 22.28}, {"t": "הליבה.", "s": 22.28, "e": 22.64}]}, {"start": 22.98, "end": 25.38, "text": "הבדיקה, שלוש שאלות על", "words": [{"t": "הבדיקה,", "s": 22.98, "e": 23.78}, {"t": "שלוש", "s": 23.84, "e": 24.44}, {"t": "שאלות", "s": 24.44, "e": 24.9}, {"t": "על", "s": 24.9, "e": 25.26}]}, {"start": 25.26, "end": 26.52, "text": "כל פסקת נימוק.", "words": [{"t": "כל", "s": 25.26, "e": 25.52}, {"t": "פסקת", "s": 25.52, "e": 26.06}, {"t": "נימוק.", "s": 26.06, "e": 26.4}]}, {"start": 26.4, "end": 28.6, "text": "שאלה בלי תשובה, חלק", "words": [{"t": "שאלה", "s": 26.4, "e": 27.24}, {"t": "בלי", "s": 27.24, "e": 27.4}, {"t": "תשובה,", "s": 27.4, "e": 27.76}, {"t": "חלק", "s": 27.8, "e": 28.48}]}, {"start": 28.48, "end": 30.9, "text": "מהליבה חסר, וסייג לא", "words": [{"t": "מהליבה", "s": 28.48, "e": 28.84}, {"t": "חסר,", "s": 28.84, "e": 29.3}, {"t": "וסייג", "s": 29.32, "e": 30.3}, {"t": "לא", "s": 30.3, "e": 30.78}]}, {"start": 30.78, "end": 32.2, "text": "ממלא את מקום החיבור.", "words": [{"t": "ממלא", "s": 30.78, "e": 31.22}, {"t": "את", "s": 31.22, "e": 31.32}, {"t": "מקום", "s": 31.32, "e": 31.64}, {"t": "החיבור.", "s": 31.64, "e": 32.08}]}, {"start": 32.42, "end": 33.98, "text": "הליבה חובה.", "words": [{"t": "הליבה", "s": 32.42, "e": 33.14}, {"t": "חובה.", "s": 33.14, "e": 33.86}]}, {"start": 34.08, "end": 36.04, "text": "התוספות לא בכל טיעון.", "words": [{"t": "התוספות", "s": 34.08, "e": 34.8}, {"t": "לא", "s": 34.8, "e": 35.22}, {"t": "בכל", "s": 35.22, "e": 35.58}, {"t": "טיעון.", "s": 35.58, "e": 35.92}]}]}
