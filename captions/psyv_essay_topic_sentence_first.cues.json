{"slug": "psyv_essay_topic_sentence_first", "duration": 33.92, "cues": [{"start": 0, "end": 2.1, "text": "הדוגמה שלך טובה, רק", "words": [{"t": "הדוגמה", "s": 0, "e": 0.7}, {"t": "שלך", "s": 0.7, "e": 0.98}, {"t": "טובה,", "s": 0.98, "e": 1.46}, {"t": "רק", "s": 1.48, "e": 1.98}]}, {"start": 1.98, "end": 3.32, "text": "במקום הלא נכון.", "words": [{"t": "במקום", "s": 1.98, "e": 2.68}, {"t": "הלא", "s": 2.68, "e": 2.86}, {"t": "נכון.", "s": 2.86, "e": 3.2}]}, {"start": 3.5, "end": 5.14, "text": "חיבור על הגבלת", "words": [{"t": "חיבור", "s": 3.5, "e": 4.26}, {"t": "על", "s": 4.26, "e": 4.5}, {"t": "הגבלת", "s": 4.5, "e": 5.02}]}, {"start": 5.02, "end": 5.8, "text": "זמן מסך.", "words": [{"t": "זמן", "s": 5.02, "e": 5.36}, {"t": "מסך.", "s": 5.36, "e": 5.68}]}, {"start": 5.92, "end": 8.02, "text": "פסקת הנימוק נפתחת כך.", "words": [{"t": "פסקת", "s": 5.92, "e": 6.68}, {"t": "הנימוק", "s": 6.68, "e": 7.04}, {"t": "נפתחת", "s": 7.04, "e": 7.64}, {"t": "כך.", "s": 7.64, "e": 7.9}]}, {"start": 8.18, "end": 9.66, "text": "תלמיד גלל עד", "words": [{"t": "תלמיד", "s": 8.18, "e": 8.94}, {"t": "גלל", "s": 8.94, "e": 9.28}, {"t": "עד", "s": 9.28, "e": 9.54}]}, {"start": 9.54, "end": 11.16, "text": "חצות והגיע עייף.", "words": [{"t": "חצות", "s": 9.54, "e": 10}, {"t": "והגיע", "s": 10, "e": 10.66}, {"t": "עייף.", "s": 10.66, "e": 11.04}]}, {"start": 11.28, "end": 13.04, "text": "יפה, אבל מה", "words": [{"t": "יפה,", "s": 11.28, "e": 12.04}, {"t": "אבל", "s": 12.06, "e": 12.58}, {"t": "מה", "s": 12.58, "e": 12.92}]}, {"start": 12.92, "end": 14.08, "text": "הדוגמה הזאת מוכיחה?", "words": [{"t": "הדוגמה", "s": 12.92, "e": 13.34}, {"t": "הזאת", "s": 13.34, "e": 13.56}, {"t": "מוכיחה?", "s": 13.56, "e": 13.96}]}, {"start": 14.34, "end": 15.9, "text": "כל פסקה נושאת", "words": [{"t": "כל", "s": 14.34, "e": 14.88}, {"t": "פסקה", "s": 14.88, "e": 15.4}, {"t": "נושאת", "s": 15.4, "e": 15.78}]}, {"start": 15.78, "end": 17.92, "text": "רעיון אחד, ונפתחת", "words": [{"t": "רעיון", "s": 15.78