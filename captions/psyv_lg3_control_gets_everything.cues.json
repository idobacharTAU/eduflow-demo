{"slug": "psyv_lg3_control_gets_everything", "duration": 37.2, "cues": [{"start": 0, "end": 1.58, "text": "יש שתי קבוצות", "words": [{"t": "יש", "s": 0, "e": 0.52}, {"t": "שתי", "s": 0.52, "e": 0.86}, {"t": "קבוצות", "s": 0.86, "e": 1.46}]}, {"start": 1.46, "end": 3.4, "text": "ותוצאה שונה ביניהן.", "words": [{"t": "ותוצאה", "s": 1.46, "e": 2.3}, {"t": "שונה", "s": 2.3, "e": 2.72}, {"t": "ביניהן.", "s": 2.72, "e": 3.28}]}, {"start": 3.32, "end": 5.06, "text": "האם הגורם הנבדק", "words": [{"t": "האם", "s": 3.32, "e": 4}, {"t": "הגורם", "s": 4, "e": 4.32}, {"t": "הנבדק", "s": 4.32, "e": 4.94}]}, {"start": 4.94, "end": 6.02, "text": "גרם להבדל?", "words": [{"t": "גרם", "s": 4.94, "e": 5.44}, {"t": "להבדל?", "s": 5.44, "e": 5.9}]}, {"start": 6.16, "end": 8.36, "text": "מתאם לבדו אינו", "words": [{"t": "מתאם", "s": 6.16, "e": 7.12}, {"t": "לבדו", "s": 7.12, "e": 7.66}, {"t": "אינו", "s": 7.66, "e": 8.24}]}, {"start": 8.24, "end": 9.22, "text": "מוכיח סיבה.", "words": [{"t": "מוכיח", "s": 8.24, "e": 8.72}, {"t": "סיבה.", "s": 8.72, "e": 9.1}]}, {"start": 9.54, "end": 11.02, "text": "בלי חלוקה אקראית", "words": [{"t": "בלי", "s": 9.54, "e": 10.02}, {"t": "חלוקה", "s": 10.02, "e": 10.38}, {"t": "אקראית", "s": 10.38, "e": 10.9}]}, {"start": 10.9, "end": 12.56, "text": "ייתכן גורם שלישי,", "words": [{"t": "ייתכן", "s": 10.9, "e": 11.66}, {"t": "גורם", "s": 11.66, "e": 11.96}, {"t": "שלישי,", "s": 11.96, "e": 12.44}]}, {"start": 12.46, "end": 14.96, "text": "וייתכן שהסיבתיות הפוכה.", "words": [{"t": "וייתכן", "s": 12.46, "e": 13.42}, {"t": "שהסיבתיות", "s": 13.42, "e": 14.16}, {"t": "הפוכה.", "s": 14.16, "e": 14.84}]}, {"start": 15.2, "end": 17.06, "text": "נתון שמצביע על הסבר", "words": [{"t": "נתון", "s": 15.2, "e": 15.88}, {"t": "שמצביע", "s": 15.88, "e": 16.38}, {"t": "על", "s": 16.38, "e": 16.54}, {"t": "הסבר", "s": 16.54, "e": 16.94}]}, {"start": 16.94, "end": 18.74, "text": "כזה מחליש את המסקנה.", "words": [{"t": "כזה", "s": 16.94, "e": 17.26}, {"t": "מחליש", "s": 17.26, "e": 18.04}, {"t": "את", "s": 18.04, "e": 18.18}, {"t": "המסקנה.", "s": 18.18, "e": 18.62}]}, {"start": 19.38, "end": 21.9, "text": "חלוקה אקראית מאזנת בממוצע", "words": [{"t": "חלוקה", "s": 19.38, "e": 19.86}, {"t": "אקראית", "s": 19.86, "e": 20.32}, {"t": "מאזנת", "s": 20.32, "e": 21.18}, {"t": "בממוצע", "s": 21.18, "e": 21.78}]}, {"start": 21.78, "end": 23.76, "text": "תכונות כמו גיל, אבל", "words": [{"t": "תכונות", "s": 21.78, "e": 22.3}, {"t": "כמו", "s": 22.3, "e": 22.58}, {"t": "גיל,", "s": 22.58, "e": 22.96}, {"t": "אבל", "s": 23.04, "e": 23.64}]}, {"start": 23.64, "end": 25.46, "text": "הקבוצות יכולות להיבדל גם", "words": [{"t": "הקבוצות", "s": 23.64, "e": 24.16}, {"t": "יכולות", "s": 24.16, "e": 24.62}, {"t": "להיבדל", "s": 24.62, "e": 25.16}, {"t": "גם", "s": 25.16, "e": 25.34}]}, {"start": 25.34, "end": 27, "text": "בעצם קבלת טיפול.", "words": [{"t": "בעצם", "s": 25.34, "e": 26.02}, {"t": "קבלת", "s": 26.02, "e": 26.46}, {"t": "טיפול.", "s": 26.46, "e": 26.88}]}, {"start": 26.88, "end": 29.58, "text": "לכן קבוצת הביקורת מקבלת", "words": [{"t": "לכן", "s": 26.88, "e": 27.86}, {"t": "קבוצת", "s": 27.86, "e": 28.3}, {"t": "הביקורת", "s": 28.3, "e": 28.82}, {"t": "מקבלת", "s": 28.82, "e": 29.46}]}, {"start": 29.46, "end": 31.8, "text": "הכול, מלבד הגורם הנבדק.", "words": [{"t": "הכול,", "s": 29.46, "e": 30.02}, {"t": "מלבד", "s": 30.02, "e": 30.8}, {"t": "הגורם", "s": 30.8, "e": 31.2}, {"t": "הנבדק.", "s": 31.2, "e": 31.68}]}, {"start": 31.96, "end": 33.88, "text": "כל הבדל נוסף ביניהן", "words": [{"t": "כל", "s": 31.96, "e": 32.44}, {"t": "הבדל", "s": 32.44, "e": 32.84}, {"t": "נוסף", "s": 32.84, "e": 33.3}, {"t": "ביניהן", "s": 33.3, "e": 33.76}]}, {"start": 33.76, "end": 35.72, "text": "הוא הסבר חלופי לתוצאה.", "words": [{"t": "הוא", "s": 33.76, "e": 34}, {"t": "הסבר", "s": 34, "e": 34.48}, {"t": "חלופי", "s": 34.48, "e": 35.1}, {"t": "לתוצאה.", "s": 35.1, "e": 35.6}]}]}
