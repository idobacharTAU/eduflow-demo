{"slug": "psyv_lg5_not_a_says_nothing", "duration": 34.08, "cues": [{"start": 0.0, "end": 2.4, "text": "כל הכינורות הם כלי מיתר.", "words": [{"t": "כל", "s": 0.0, "e": 0.32}, {"t": "הכינורות", "s": 0.32, "e": 1.04}, {"t": "הם", "s": 1.04, "e": 1.4}, {"t": "כלי", "s": 1.4, "e": 1.82}, {"t": "מיתר.", "s": 1.82, "e": 2.4}]}, {"start": 2.5, "end": 4.7, "text": "הכלי הזה אינו כינור.", "words": [{"t": "הכלי", "s": 2.5, "e": 3.3}, {"t": "הזה", "s": 3.3, "e": 3.46}, {"t": "אינו", "s": 3.46, "e": 4.24}, {"t": "כינור.", "s": 4.24, "e": 4.7}]}, {"start": 5.02, "end": 6.9, "text": "אז הוא אינו כלי מיתר?", "words": [{"t": "אז", "s": 5.02, "e": 5.42}, {"t": "הוא", "s": 5.42, "e": 5.6}, {"t": "אינו", "s": 5.6, "e": 6.2}, {"t": "כלי", "s": 6.2, "e": 6.44}, {"t": "מיתר?", "s": 6.44, "e": 6.9}]}, {"start": 7.34, "end": 8.86, "text": "זו מסקנה שלא נובעת.", "words": [{"t": "זו", "s": 7.34, "e": 7.74}, {"t": "מסקנה", "s": 7.74, "e": 8.14}, {"t": "שלא", "s": 8.14, "e": 8.4}, {"t": "נובעת.", "s": 8.4, "e": 8.86}]}, {"start": 8.94, "end": 9.78, "text": "הוא יכול להיות", "words": [{"t": "הוא", "s": 8.94, "e": 9.36}, {"t": "יכול", "s": 9.36, "e": 9.6}, {"t": "להיות", "s": 9.6, "e": 9.78}]}, {"start": 9.78, "end": 11.18, "text": "גיטרה, עם מיתרים.", "words": [{"t": "גיטרה,", "s": 9.78, "e": 10.28}, {"t": "עם", "s": 10.28, "e": 10.74}, {"t": "מיתרים.", "s": 10.74, "e": 11.18}]}, {"start": 11.32, "end": 12.38, "text": "והוא יכול להיות", "words": [{"t": "והוא", "s": 11.32, "e": 11.9}, {"t": "יכול", "s": 11.9, "e": 12.14}, {"t": "להיות", "s": 12.14, "e": 12.38}]}, {"start": 12.38, "end": 13.82, "text": "תוף, בלי מיתרים.", "words": [{"t": "תוף,", "s": 12.38, "e": 12.78}, {"t": "בלי", "s": 12.78, "e": 13.42}, {"t": "מיתרים.", "s": 13.42, "e": 13.82}]}, {"start": 14.08, "end": 16.46, "text": "הנתון מתיישב עם שניהם.", "words": [{"t": "הנתון", "s": 14.08, "e": 14.84}, {"t": "מתיישב", "s": 14.84, "e": 15.5}, {"t": "עם", "s": 15.5, "e": 15.66}, {"t": "שניהם.", "s": 15.66, "e": 16.46}]}, {"start": 16.66,