{"slug": "psyv_lg6_two_yes_no_chain", "duration": 31.66, "cues": [{"start": 0.0, "end": 1.62, "text": "יש ועוד יש:", "words": [{"t": "יש", "s": 0.0, "e": 0.64}, {"t": "ועוד", "s": 0.64, "e": 1.44}, {"t": "יש:", "s": 1.44, "e": 1.62}]}, {"start": 1.88, "end": 2.84, "text": "מה נובע?", "words": [{"t": "מה", "s": 1.88, "e": 2.44}, {"t": "נובע?", "s": 2.44, "e": 2.84}]}, {"start": 3.06, "end": 5.16, "text": "יש רופאים שהם נגנים.", "words": [{"t": "יש", "s": 3.06, "e": 3.94}, {"t": "רופאים", "s": 3.94, "e": 4.42}, {"t": "שהם", "s": 4.42, "e": 4.74}, {"t": "נגנים.", "s": 4.74, "e": 5.16}]}, {"start": 5.26, "end": 7.42, "text": "ויש נגנים שהם טבחים.", "words": [{"t": "ויש", "s": 5.26, "e": 6.04}, {"t": "נגנים", "s": 6.04, "e": 6.48}, {"t": "שהם", "s": 6.48, "e": 6.94}, {"t": "טבחים.", "s": 6.94, "e": 7.42}]}, {"start": 7.84, "end": 9.02, "text": "האם בהכרח יש", "words": [{"t": "האם", "s": 7.84, "e": 8.28}, {"t": "בהכרח", "s": 8.28, "e": 8.76}, {"t": "יש", "s": 8.76, "e": 9.02}]}, {"start": 9.02, "end": 10.26, "text": "רופא שהוא טבח?", "words": [{"t": "רופא", "s": 9.02, "e": 9.54}, {"t": "שהוא", "s": 9.54, "e": 9.74}, {"t": "טבח?", "s": 9.74, "e": 10.26}]}, {"start": 10.4, "end": 11.4, "text": "לא נובע.", "words": [{"t": "לא", "s": 10.4, "e": 11.02}, {"t": "נובע.", "s": 11.02, "e": 11.4}]}, {"start": 12.0, "end": 14.04, "text": "דנה היא רופאה, ונגנית.", "words": [{"t": "דנה", "s": 12.0, "e": 12.44}, {"t": "היא", "s": 12.44, "e": 12.66}, {"t": "רופאה,", "s": 12.66, "e": 13.26}, {"t": "ונגנית.", "s": 13.26, "e": 14.04}]}, {"start": 14.24, "end": 16.48, "text": "רון הוא נגן, וטבח.", "words": [{"t": "רון", "s": 14.24, "e": 15.06}, {"t": "הוא", "s": 15.06, "e": 15.24}, {"t": "נגן,", "s": 15.24, "e": 15.86}, {"t": "וטבח.", "s": 15.86, "e": 16.48}]}, {"start": 16.68, "end": 18.56, "text": "דנה אינה טבחית.", "words": [{"t": "דנה", "s": 16.68, "e": 17.56}, {"t": "אינה", "s": 17.56, "e": 18.02}, {"t": "טבחית.", "s": 18.02, "e": 18.56}]}, {"start": 18.7, "end": 20.32, "text": "במצב הזה אין", "words": [{"t": "במצב", "s": 18.7, "e": 19.52}, {"t": "הזה", "s": 19.52, "e": 19.7}, {"t": "אין", "s": 19.7, "e": 20.32}]}, {"start": 20.32, "end": 21.24, "text": "רופא שהוא טבח.", "words": [{"t": "רופא", "s": 20.32, "e": 20.64}, {"t": "שהוא", "s": 20.64, "e": 20.82}, {"t": "טבח.", "s": 20.82, "e": 21.24}]}, {"start": 21.74, "end": 23.58, "text": "כל משפט יש יכול", "words": [{"t": "כל", "s": 21.74, "e": 22.18}, {"t": "משפט", "s": 22.18, "e": 22.78}, {"t": "יש", "s": 22.78, "e": 23.0}, {"t": "יכול", "s": 23.0, "e": 23.58}]}, {"start": 23.58, "end": 25.12, "text": "לדבר על נגן אחר.", "words": [{"t": "לדבר", "s": 23.58, "e": 24.12}, {"t": "על", "s": 24.12, "e": 24.28}, {"t": "נגן", "s": 24.28, "e": 24.68}, {"t": "אחר.", "s": 24.68, "e": 25.12}]}, {"start": 25.16, "end": 27.24, "text": "לכן אי אפשר לשרשר אותם.", "words": [{"t": "לכן", "s": 25.16, "e": 25.82}, {"t": "אי", "s": 25.82, "e": 26.06}, {"t": "אפשר", "s": 26.06, "e": 26.34}, {"t": "לשרשר", "s": 26.34, "e": 26.88}, {"t": "אותם.", "s": 26.88, "e": 27.24}]}, {"start": 27.32, "end": 28.98, "text": "מותר רק להפוך:", "words": [{"t": "מותר", "s": 27.32, "e": 27.98}, {"t": "רק", "s": 27.98, "e": 28.4}, {"t": "להפוך:", "s": 28.4, "e": 28.98}]}, {"start": 28.98, "end": 31.26, "text": "יש נגנים שהם רופאים.", "words": [{"t": "יש", "s": 28.98, "e": 29.68}, {"t": "נגנים", "s": 29.68, "e": 30.26}, {"t": "שהם", "s": 30.26, "e": 30.86}, {"t": "רופאים.", "s": 30.86, "e": 31.26}]}], "captions_default": "off", "text_load": {"mean_visible_words": 21.6, "threshold": 20.0}}
