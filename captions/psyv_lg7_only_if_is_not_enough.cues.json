{"slug": "psyv_lg7_only_if_is_not_enough", "duration": 32.5, "cues": [{"start": 0, "end": 1.32, "text": "יש מגרש.", "words": [{"t": "יש", "s": 0, "e": 0.54}, {"t": "מגרש.", "s": 0.54, "e": 1.2}]}, {"start": 1.36, "end": 3.02, "text": "האם הקבוצה עולה?", "words": [{"t": "האם", "s": 1.36, "e": 2.12}, {"t": "הקבוצה", "s": 2.12, "e": 2.6}, {"t": "עולה?", "s": 2.6, "e": 2.9}]}, {"start": 3.32, "end": 5.42, "text": "הקבוצה תעלה לליגה רק", "words": [{"t": "הקבוצה", "s": 3.32, "e": 4.12}, {"t": "תעלה", "s": 4.12, "e": 4.52}, {"t": "לליגה", "s": 4.52, "e": 4.92}, {"t": "רק", "s": 4.92, "e": 5.3}]}, {"start": 5.3, "end": 6.72, "text": "אם יש לה מגרש.", "words": [{"t": "אם", "s": 5.3, "e": 5.6}, {"t": "יש", "s": 5.6, "e": 5.86}, {"t": "לה", "s": 5.86, "e": 6.02}, {"t": "מגרש.", "s": 6.02, "e": 6.6}]}, {"start": 6.6, "end": 8.08, "text": "ויש לה מגרש.", "words": [{"t": "ויש", "s": 6.6, "e": 7.34}, {"t": "לה", "s": 7.34, "e": 7.54}, {"t": "מגרש.", "s": 7.54, "e": 7.96}]}, {"start": 8.08, "end": 10.06, "text": "האם בהכרח תעלה?", "words": [{"t": "האם", "s": 8.08, "e": 8.86}, {"t": "בהכרח", "s": 8.86, "e": 9.52}, {"t": "תעלה?", "s": 9.52, "e": 9.94}]}, {"start": 10.04, "end": 11.3, "text": "לא נובע.", "words": [{"t": "לא", "s": 10.04, "e": 10.84}, {"t": "נובע.", "s": 10.84, "e": 11.18}]}, {"start": 11.58, "end": 12.5, "text": "תרגום.", "words": [{"t": "תרגום.", "s": 11.58, "e": 12.38}]}, {"start": 12.5, "end": 14.66, "text": "אם הקבוצה עולה, אז", "words": [{"t": "אם", "s": 12.5, "e": 13.1}, {"t": "הקבוצה", "s": 13.1, "e": 13.6}, {"t": "עולה,", "s": 13.6, "e": 13.98}, {"t": "אז", "s": 13.98, "e": 14.54}]}, {"start": 14.54, "end": 15.52, "text": "יש לה מגרש.", "words": [{"t": "יש", "s": 14.54, "e": 14.78}, {"t": "לה", "s": 14.78, "e": 14.94}, {"t": "מגרש.", "s": 14.94, "e": 15.4}]}, {"start": 15.72, "end": 17.96, "text": "המגרש הוא תנאי הכרחי,", "words": [{"t": "המגרש", "s": 15.72, "e": 16.52}, {"t": "הוא", "s": 16.52, "e": 16.64}, {"t": "תנאי", "s": 16.64, "e": 17.08}, {"t": "הכרחי,", "s": 17.08, "e": 17.84}]}, {"start": 17.84, "end": 19.36, "text": "אבל הוא לא מספיק.", "words": [{"t": "אבל", "s": 17.84, "e": 18.54}, {"t": "הוא", "s": 18.54, "e": 18.68}, {"t": "לא", "s": 18.68, "e": 18.76}, {"t": "מספיק.", "s": 18.76, "e": 19.24}]}, {"start": 19.38, "end": 20.88, "text": "ייתכן שחסר לה", "words": [{"t": "ייתכן", "s": 19.38, "e": 20.18}, {"t": "שחסר", "s": 20.18, "e": 20.7}, {"t": "לה", "s": 20.7, "e": 20.76}]}, {"start": 20.76, "end": 22.1, "text": "גם מאמן, אז", "words": [{"t": "גם", "s": 20.76, "e": 20.92}, {"t": "מאמן,", "s": 20.92, "e": 21.42}, {"t": "אז", "s": 21.44, "e": 21.98}]}, {"start": 21.98, "end": 23.02, "text": "היא נשארת למטה.", "words": [{"t": "היא", "s": 21.98, "e": 22.1}, {"t": "נשארת", "s": 22.1, "e": 22.48}, {"t": "למטה.", "s": 22.48, "e": 22.9}]}, {"start": 23.34, "end": 25.22, "text": "מהמגרש אי אפשר", "words": [{"t": "מהמגרש", "s": 23.34, "e": 24.14}, {"t": "אי", "s": 24.14, "e": 24.74}, {"t": "אפשר", "s": 24.74, "e": 25.1}]}, {"start": 25.1, "end": 26.2, "text": "לחזור אל העלייה.", "words": [{"t": "לחזור", "s": 25.1, "e": 25.56}, {"t": "אל", "s": 25.56, "e": 25.66}, {"t": "העלייה.", "s": 25.66, "e": 26.08}]}, {"start": 26.08, "end": 29.68, "text": "רק אם פירושו נדרש,", "words": [{"t": "רק", "s": 26.08, "e": 27.1}, {"t": "אם", "s": 27.1, "e": 27.4}, {"t": "פירושו", "s": 27.4, "e": 28.36}, {"t": "נדרש,", "s": 28.36, "e": 29.56}]}, {"start": 29.56, "end": 31.02, "text": "אך לא מבטיח.", "words": [{"t": "אך", "s": 29.56, "e": 30.14}, {"t": "לא", "s": 30.14, "e": 30.38}, {"t": "מבטיח.", "s": 30.38, "e": 30.9}]}]}
