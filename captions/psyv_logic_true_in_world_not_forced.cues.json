6.52}, {"t": "כריש.", "s": 16.52, "e": 16.86}]}, {"start": 17.64, "end": 18.96, "text": "כל מה שאינו", "words": [{"t": "כל", "s": 17.64, "e": 18.08}, {"t": "מה", "s": 18.08, "e": 18.24}, {"t": "שאינו", "s": 18.24, "e": 18.84}]}, {"start": 18.84, "end": 20.32, "text": "כריש אינו דג?", "words": [{"t": "כריש", "s": 18.84, "e": 19.34}, {"t": "אינו", "s": 19.34, "e": 19.78}, {"t": "דג?", "s": 19.78, "e": 20.2}]}, {"start": 20.24, "end": 21.5, "text": "זה שוב היפוך", "words": [{"t": "זה", "s": 20.24, "e": 20.78}, {"t": "שוב", "s": 20.78, "e": 21.12}, {"t": "היפוך", "s": 21.12, "e": 21.38}]}, {"start": 21.38, "end": 22.94, "text": "הכיוון, רק בתחפושת.", "words": [{"t": "הכיוון,", "s": 21.38, "e": 21.82}, {"t": "רק", "s": 21.9, "e": 22.14}, {"t": "בתחפושת.", "s": 22.14, "e": 22.82}]}, {"start": 22.92, "end": 23.74, "text": "נפסל.", "words": [{"t": "נפסל.", "s": 22.92, "e": 23.62}]}, {"start": 24.06, "end": 25.06, "text": "נשאר:", "words": [{"t": "נשאר:", "s": 24.06, "e": 24.94}]}, {"start": 24.94, "end": 26.52, "text": "כל מה שאינו", "words": [{"t": "כל", "s": 24.94, "e": 25.48}, {"t": "מה", "s": 25.48, "e": 25.76}, {"t": "שאינו", "s": 25.76, "e": 26.4}]}, {"start": 26.4, "end": 28.08, "text": "דג, אינו כריש.", "words": [{"t": "דג,", "s": 26.4, "e": 26.84}, {"t": "אינו", "s": 26.84, "e": 27.48}, {"t": "כריש.", "s": 27.48, "e": 27.96}]}, {"start": 28.04, "end": 29.94, "text": "זה הניגוד ההגיוני.", "words": [{"t": "זה", "s": 28.04, "e": 28.76}, {"t": "הניגוד", "s": 28.76, "e": 29.34}, {"t": "ההגיוני.", "s": 29.34, "e": 29.82}]}, {"start": 30, "end": 31.66, "text": "נכון במציאות זה", "words": [{"t": "נכון", "s": 30, "e": 30.72}, {"t": "במציאות", "s": 30.72, "e": 31.32}, {"t": "זה", "s": 31.32, "e": 31.54}]}, {"start": 31.54, "end": 32.78, "text": "לא בהכרח נכון.", "words": [{"t": "לא", "s": 31.54, "e": 31.82}, {"t": "בהכרח", "s": 31.82, "e": 32.3}, {"t": "נכון.", "s": 32.3, "e": 32.66}]}]}
