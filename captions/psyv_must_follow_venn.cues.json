{"slug": "psyv_must_follow_venn", "duration": 40.52, "cues": [{"start": 0, "end": 0.8, "text": "נתון.", "words": [{"t": "נתון.", "s": 0, "e": 0.68}]}, {"start": 0.74, "end": 3.06, "text": "כל החתולים הם יונקים.", "words": [{"t": "כל", "s": 0.74, "e": 1.36}, {"t": "החתולים", "s": 1.36, "e": 2.08}, {"t": "הם", "s": 2.08, "e": 2.46}, {"t": "יונקים.", "s": 2.46, "e": 2.94}]}, {"start": 3.16, "end": 4.56, "text": "ועוד נתון.", "words": [{"t": "ועוד", "s": 3.16, "e": 4.06}, {"t": "נתון.", "s": 4.06, "e": 4.44}]}, {"start": 4.52, "end": 5.84, "text": "מקס הוא חתול.", "words": [{"t": "מקס", "s": 4.52, "e": 5.3}, {"t": "הוא", "s": 5.3, "e": 5.4}, {"t": "חתול.", "s": 5.4, "e": 5.72}]}, {"start": 6.09, "end": 7.68, "text": "מה בהכרח נכון?", "words": [{"t": "מה", "s": 6.09, "e": 6.54}, {"t": "בהכרח", "s": 6.54, "e": 7.06}, {"t": "נכון?", "s": 7.06, "e": 7.56}]}, {"start": 7.74, "end": 9.1, "text": "בוא נצייר את זה.", "words": [{"t": "בוא", "s": 7.74, "e": 8.3}, {"t": "נצייר", "s": 8.3, "e": 8.8}, {"t": "את", "s": 8.8, "e": 8.88}, {"t": "זה.", "s": 8.88, "e": 8.98}]}, {"start": 9.34, "end": 11.48, "text": "עיגול גדול, היונקים.", "words": [{"t": "עיגול", "s": 9.34, "e": 9.9}, {"t": "גדול,", "s": 9.9, "e": 10.42}, {"t": "היונקים.", "s": 10.44, "e": 11.36}]}, {"start": 11.62, "end": 14.08, "text": "בתוכו עיגול, החתולים.", "words": [{"t": "בתוכו", "s": 11.62, "e": 12.52}, {"t": "עיגול,", "s": 12.52, "e": 12.96}, {"t": "החתולים.", "s": 13, "e": 13.96}]}, {"start": 14.26, "end": 17.24, "text": "ומקס, נקודה בתוך החתולים.", "words": [{"t": "ומקס,", "s": 14.26, "e": 15.16}, {"t": "נקודה", "s": 15.16, "e": 16}, {"t": "בתוך", "s": 16, "e": 16.6}, {"t": "החתולים.", "s": 16.6, "e": 17.12}]}, {"start": 17.24, "end": 19.8, "text": "אז מקס בהכרח יונק.", "words": [{"t": "אז", "s": 17.24, "e": 17.92}, {"t": "מקס", "s": 17.92, "e": 18.38}, {"t": "בהכרח", "s": 18.38, "e": 19.02}, {"t": "יונק.", "s": 19.02, "e": 19.68}]}, {"start": 19.99, "end": 21.3, "text": "זאת התשובה הנכונה.", "words": [{"t": "ז