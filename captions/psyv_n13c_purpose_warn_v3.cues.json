{"slug": "psyv_n13c_purpose_warn_v3", "duration": 36.99, "cues": [{"start": 0.0, "end": 1.82, "text": "מה מטרת הכותב בקטע?", "words": [{"t": "מה", "s": 0.0, "e": 0.6}, {"t": "מטרת", "s": 0.6, "e": 0.98}, {"t": "הכותב", "s": 0.98, "e": 1.44}, {"t": "בקטע?", "s": 1.44, "e": 1.82}]}, {"start": 2.24, "end": 4.46, "text": "הקטע עוסק בסיסמאות.", "words": [{"t": "הקטע", "s": 2.24, "e": 3.04}, {"t": "עוסק", "s": 3.04, "e": 3.58}, {"t": "בסיסמאות.", "s": 3.58, "e": 4.46}]}, {"start": 4.52, "end": 6.22, "text": "אל תענו לפי הנושא.", "words": [{"t": "אל", "s": 4.52, "e": 5.12}, {"t": "תענו", "s": 5.12, "e": 5.48}, {"t": "לפי", "s": 5.48, "e": 5.8}, {"t": "הנושא.", "s": 5.8, "e": 6.22}]}, {"start": 6.24, "end": 8.58, "text": "ענו לפי מה שהכותב עושה.", "words": [{"t": "ענו", "s": 6.24, "e": 6.84}, {"t": "לפי", "s": 6.84, "e": 7.32}, {"t": "מה", "s": 7.32, "e": 7.44}, {"t": "שהכותב", "s": 7.44, "e": 8.18}, {"t": "עושה.", "s": 8.18, "e": 8.58}]}, {"start": 8.82, "end": 10.46, "text": "הכותב מציג הֶרְגֵּל:", "words": [{"t": "הכותב", "s": 8.82, "e": 9.62}, {"t": "מציג", "s": 9.62, "e": 10.0}, {"t": "הֶרְגֵּל:", "s": 10.0, "e": 10.46}]}, {"start": 10.58, "end": 12.62, "text": "סיסמה על פתק ליד המסך.", "words": [{"t": "סיסמה", "s": 10.58, "e": 11.32}, {"t": "על", "s": 11.32, "e": 11.58}, {"t": "פתק", "s": 11.58, "e": 11.96}, {"t": "ליד", "s": 11.96, "e": 12.24}, {"t": "המסך.", "s": 12.24, "e": 12.62}]}, {"start": 13.0, "end": 15.34, "text": "הַהֶרְגֵּל נוח, ואין צורך לזכור.", "words": [{"t": "הַהֶרְגֵּל", "s": 13.0, "e": 13.74}, {"t": "נוח,", "s": 13.74, "e": 14.14}, {"t": "ואין", "s": 14.18, "e": 14.62}, {"t": "צורך", "s": 14.62, "e": 14.9}, {"t": "לזכור.", "s": 14.9, "e": 15.34}]}, {"start": 15.4, "end": 17.0, "text": "אך כל מי שנכנס", "words": [{"t": "אך", "s": 15.4, "e": 16.02}, {"t": "כל", "s": 16.02, "e": 16.32}, {"t": "מי", "s": 16.32, "e": 16.54}, {"t": "שנכנס", "s": 16.54, "e": 17.0}]}, {"start": 17.0, "end": 18.5, "text": "לחדר יכול לקרוא.", "words": [{"t": "לחדר", "s": 17.0, "e": 17.46}, {"t": "יכול", "s": 17.46, "e": 18.0}, {"t": "לקרוא.", "s": 18.0, "e": 18.5}]}, {"start": 18.72, "end": 21.7, "text": "בסוף הנוחות הופכת לסכנה.", "words": [{"t": "בסוף", "s": 18.72, "e": 19.52}, {"t": "הנוחות", "s": 19.54, "e": 20.16}, {"t": "הופכת", "s": 20.16, "e": 21.04}, {"t": "לסכנה.", "s": 21.04, "e": 21.7}]}, {"start": 22.32, "end": 23.1, "text": "אין כאן מילת", "words": [{"t": "אין", "s": 22.32, "e": 22.72}, {"t": "כאן", "s": 22.72, "e": 22.88}, {"t": "מילת", "s": 22.88, "e": 23.1}]}, {"start": 23.1, "end": 24.5, "text": "מסקנה, כמו לכן.", "words": [{"t": "מסקנה,", "s": 23.1, "e": 23.52}, {"t": "כמו", "s": 23.58, "e": 23.96}, {"t": "לכן.", "s": 23.96, "e": 24.5}]}, {"start": 24.86, "end": 26.58, "text": "אין השוואה בין שתי דרכים.", "words": [{"t": "אין", "s": 24.86, "e": 25.26}, {"t": "השוואה", "s": 25.26, "e": 25.78}, {"t": "בין", "s": 25.78, "e": 25.96}, {"t": "שתי", "s": 25.96, "e": 26.16}, {"t": "דרכים.", "s": 26.16, "e": 26.58}]}, {"start": 26.58, "end": 28.5, "text": "הכותב אינו מתאר,", "words": [{"t": "הכותב", "s": 26.58, "e": 27.58}, {"t": "אינו", "s": 27.58, "e": 27.9}, {"t": "מתאר,", "s": 27.9, "e": 28.5}]}, {"start": 28.5, "end": 30.32, "text": "ואינו אוסר סיסמאות.", "words": [{"t": "ואינו", "s": 28.5, "e": 29.2}, {"t": "אוסר", "s": 29.2, "e": 29.74}, {"t": "סיסמאות.", "s": 29.74, "e": 30.32}]}, {"start": 30.34, "end": 32.72, "text": "הוא מזהיר מפני סכנה", "words": [{"t": "הוא", "s": 30.34, "e": 30.82}, {"t": "מזהיר", "s": 30.82, "e": 31.64}, {"t": "מפני", "s": 31.64, "e": 32.04}, {"t": "סכנה", "s": 32.04, "e": 32.72}]}, {"start": 32.72, "end": 34.32, "text": "שבתוך הֶרְגֵּל נוח.", "words": [{"t": "שבתוך", "s": 32.72, "e": 33.4}, {"t": "הֶרְגֵּל", "s": 33.4, "e": 33.94}, {"t": "נוח.", "s": 33.94, "e": 34.32}]}, {"start": 34.6, "end": 36.64, "text": "הַפֹּעַל הוא התשובה.", "words": [{"t": "הַפֹּעַל", "s": 34.6, "e": 35.68}, {"t": "הוא", "s": 35.68, "e": 35.86}, {"t": "התשובה.", "s": 35.86, "e": 36.64}]}]}
