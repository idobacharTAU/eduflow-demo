{"slug": "psyv_rcx_role_not_content", "duration": 38.9, "cues": [{"start": 0.0, "end": 1.36, "text": "שאלה על פסקה,", "words": [{"t": "שאלה", "s": 0.0, "e": 0.8}, {"t": "על", "s": 0.8, "e": 0.88}, {"t": "פסקה,", "s": 0.88, "e": 1.36}]}, {"start": 1.42, "end": 2.52, "text": "לא על משפט.", "words": [{"t": "לא", "s": 1.42, "e": 1.86}, {"t": "על", "s": 1.86, "e": 2.02}, {"t": "משפט.", "s": 2.02, "e": 2.52}]}, {"start": 2.58, "end": 5.16, "text": "מה תפקידה של האמצעית בקטע?", "words": [{"t": "מה", "s": 2.58, "e": 3.12}, {"t": "תפקידה", "s": 3.12, "e": 3.78}, {"t": "של", "s": 3.78, "e": 3.98}, {"t": "האמצעית", "s": 3.98, "e": 4.62}, {"t": "בקטע?", "s": 4.62, "e": 5.16}]}, {"start": 5.7, "end": 7.2, "text": "לפני שנוגעים במסיחים,", "words": [{"t": "לפני", "s": 5.7, "e": 6.18}, {"t": "שנוגעים", "s": 6.18, "e": 6.6}, {"t": "במסיחים,", "s": 6.6, "e": 7.2}]}, {"start": 7.24, "end": 8.5, "text": "בונים מפה קצרה.", "words": [{"t": "בונים", "s": 7.24, "e": 7.72}, {"t": "מפה", "s": 7.72, "e": 8.24}, {"t": "קצרה.", "s": 8.24, "e": 8.5}]}, {"start": 8.86, "end": 10.54, "text": "הפותחת מציגה את", "words": [{"t": "הפותחת", "s": 8.86, "e": 9.82}, {"t": "מציגה", "s": 9.82, "e": 10.4}, {"t": "את", "s": 10.4, "e": 10.54}]}, {"start": 10.54, "end": 12.26, "text": "מדד ההשאלות בספרייה.", "words": [{"t": "מדד", "s": 10.54, "e": 11.04}, {"t": "ההשאלות", "s": 11.04, "e": 11.7}, {"t": "בספרייה.", "s": 11.7, "e": 12.26}]}, {"start": 12.58, "end": 14.56, "text": "האמצעית מערערת אותו,", "words": [{"t": "האמצעית", "s": 12.58, "e": 13.54}, {"t": "מערערת", "s": 13.54, "e": 14.34}, {"t": "אותו,", "s": 14.34, "e": 14.56}]}, {"start": 14.56, "end": 16.28, "text": "ומביאה מקרה נגדי.", "words": [{"t": "ומביאה", "s": 14.56, "e": 15.48}, {"t": "מקרה", "s": 15.48, "e": 15.94}, {"t": "נגדי.", "s": 15.94, "e": 16.28}]}, {"start": 16.58, "end": 18.84, "text": "והסוגרת מסיקה, והיא", "words": [{"t": "והסוגרת", "s": 16.58, "e": 17.54}, {"t": "מסיקה,", "s": 17.54, "e": 18.3}, {"t": "והיא", "s": 18.34, "e": 18.84}]}, {"start": 18.84, "end": 20.54, "text": "מסומנת במילה לכן.", "words": [{"t": "מסומנת", "s": 18.84, "e": 19.44}, {"t": "במילה", "s": 19.44, "e": 19.92}, {"t": "לכן.", "s": 19.92, "e": 20.54}]}, {"start": 20.74, "end": 23.58, "text": "וכאן נפתחת המלכודת של השאלה.", "words": [{"t": "וכאן", "s": 20.74, "e": 21.7}, {"t": "נפתחת", "s": 21.7, "e": 22.28}, {"t": "המלכודת", "s": 22.28, "e": 22.96}, {"t": "של", "s": 22.96, "e": 23.08}, {"t": "השאלה.", "s": 23.08, "e": 23.58}]}, {"start": 23.9, "end": 27.04, "text": "מסיח מונה חוגי-קריאה ושיעורי-מחשב.", "words": [{"t": "מסיח", "s": 23.9, "e": 24.56}, {"t": "מונה", "s": 24.56, "e": 25.06}, {"t": "חוגי-קריאה", "s": 25.06, "e": 26.0}, {"t": "ושיעורי-מחשב.", "s": 26.0, "e": 27.04}]}, {"start": 27.16, "end": 28.2, "text": "זה אכן כתוב", "words": [{"t": "זה", "s": 27.16, "e": 27.62}, {"t": "אכן", "s": 27.62, "e": 27.88}, {"t": "כתוב", "s": 27.88, "e": 28.2}]}, {"start": 28.2, "end": 29.38, "text": "שם, מילה במילה.", "words": [{"t": "שם,", "s": 28.2, "e": 28.42}, {"t": "מילה", "s": 28.42, "e": 28.96}, {"t": "במילה.", "s": 28.96, "e": 29.38}]}, {"start": 29.38, "end": 32.0, "text": "אבל זה תוכן, ולא תפקיד.", "words": [{"t": "אבל", "s": 29.38, "e": 30.06}, {"t": "זה", "s": 30.06, "e": 30.28}, {"t": "תוכן,", "s": 30.28, "e": 30.88}, {"t": "ולא", "s": 30.88, "e": 31.44}, {"t": "תפקיד.", "s": 31.44, "e": 32.0}]}, {"start": 32.36, "end": 35.22, "text": "שאלת-תפקיד שואלת מה הפסקה עושה.", "words": [{"t": "שאלת-תפקיד", "s": 32.36, "e": 33.34}, {"t": "שואלת", "s": 33.34, "e": 33.94}, {"t": "מה", "s": 33.94, "e": 34.14}, {"t": "הפסקה", "s": 34.14, "e": 34.68}, {"t": "עושה.", "s": 34.68, "e": 35.22}]}, {"start": 35.32, "end": 37.2, "text": "התשובה היא המקרה", "words": [{"t": "התשובה", "s": 35.32, "e": 36.32}, {"t": "היא", "s": 36.32, "e": 36.54}, {"t": "המקרה", "s": 36.54, "e": 37.2}]}, {"start": 37.2, "end": 38.5, "text": "שמערער את המדד.", "words": [{"t": "שמערער", "s": 37.2, "e": 38.04}, {"t": "את", "s": 38.04, "e": 38.12}, {"t": "המדד.", "s": 38.12, "e": 38.5}]}]}
