{"slug": "psyv_rcx_swap_test_example", "duration": 34.43, "cues": [{"start": 0.0, "end": 2.02, "text": "משפט בודד בתוך הקטע.", "words": [{"t": "משפט", "s": 0.0, "e": 0.72}, {"t": "בודד", "s": 0.72, "e": 1.16}, {"t": "בתוך", "s": 1.16, "e": 1.56}, {"t": "הקטע.", "s": 1.56, "e": 2.02}]}, {"start": 2.04, "end": 3.643, "text": "מה התפקיד שלו כאן?", "words": [{"t": "מה", "s": 2.04, "e": 2.54}, {"t": "התפקיד", "s": 2.54, "e": 3.04}, {"t": "שלו", "s": 3.04, "e": 3.3}, {"t": "כאן?", "s": 3.3, "e": 3.643}]}, {"start": 3.82, "end": 5.46, "text": "יש מבחן קצר", "words": [{"t": "יש", "s": 3.82, "e": 4.3}, {"t": "מבחן", "s": 4.3, "e": 4.84}, {"t": "קצר", "s": 4.84, "e": 5.46}]}, {"start": 5.46, "end": 7.0, "text": "שמכריע, והוא חינם.", "words": [{"t": "שמכריע,", "s": 5.46, "e": 6.02}, {"t": "והוא", "s": 6.08, "e": 6.44}, {"t": "חינם.", "s": 6.44, "e": 7.0}]}, {"start": 7.04, "end": 8.98, "text": "קוראים לו מבחן ההחלפה.", "words": [{"t": "קוראים", "s": 7.04, "e": 7.62}, {"t": "לו", "s": 7.62, "e": 7.76}, {"t": "מבחן", "s": 7.76, "e": 8.42}, {"t": "ההחלפה.", "s": 8.42, "e": 8.98}]}, {"start": 9.02, "end": 10.38, "text": "מחליפים את המשפט", "words": [{"t": "מחליפים", "s": 9.02, "e": 9.82}, {"t": "את", "s": 9.82, "e": 9.92}, {"t": "המשפט", "s": 9.92, "e": 10.38}]}, {"start": 10.38, "end": 11.886, "text": "בדוגמה אחרת לגמרי.", "words": [{"t": "בדוגמה", "s": 10.38, "e": 10.86}, {"t": "אחרת", "s": 10.86, "e": 11.4}, {"t": "לגמרי.", "s": 11.4, "e": 11.886}]}, {"start": 12.1, "end": 13.54, "text": "עמדת הכותב זזה?", "words": [{"t": "עמדת", "s": 12.1, "e": 12.64}, {"t": "הכותב", "s": 12.64, "e": 13.08}, {"t": "זזה?", "s": 13.08, "e": 13.54}]}, {"start": 13.58, "end": 14.766, "text": "אז זו טענה.", "words": [{"t": "אז", "s": 13.58, "e": 14.1}, {"t": "זו", "s": 14.1, "e": 14.36}, {"t": "טענה.", "s": 14.36, "e": 14.766}]}, {"start": 14.84, "end": 16.22, "text": "העמדה יציבה?", "words": [{"t": "העמדה", "s": 14.84, "e": 15.66}, {"t": "יציבה?", "s": 15.66, "e": 16.22}]}, {"start": 16.26, "end": 17.473, "text": "אז זו המחשה.", "words": [{"t": "אז", "s": 16.26, "e": 16.8}, {"t": "זו", "s": 16.8, "e": 17.0}, {"t": "המחשה.", "s": 17.0, "e": 17.473}]}, {"start": 17.76, "end": 19.34, "text": "בקטע מושווים כיסא", "words": [{"t": "בקטע", "s": 17.76, "e": 18.46}, {"t": "מושווים", "s": 18.46, "e": 18.92}, {"t": "כיסא", "s": 18.92, "e": 19.34}]}, {"start": 19.34, "end": 20.878, "text": "זול וכיסא עמיד.", "words": [{"t": "זול", "s": 19.34, "e": 19.74}, {"t": "וכיסא", "s": 19.74, "e": 20.46}, {"t": "עמיד.", "s": 20.46, "e": 20.878}]}, {"start": 21.0, "end": 24.18, "text": "החלפנו אותם במדפסות, והמסקנה נשמרה.", "words": [{"t": "החלפנו", "s": 21.0, "e": 21.88}, {"t": "אותם", "s": 21.88, "e": 22.06}, {"t": "במדפסות,", "s": 22.06, "e": 22.86}, {"t": "והמסקנה", "s": 22.96, "e": 23.7}, {"t": "נשמרה.", "s": 23.7, "e": 24.18}]}, {"start": 24.22, "end": 26.8, "text": "לכן זו דוגמה, ולא הטענה.", "words": [{"t": "לכן", "s": 24.22, "e": 25.0}, {"t": "זו", "s": 25.0, "e": 25.2}, {"t": "דוגמה,", "s": 25.2, "e": 25.76}, {"t": "ולא", "s": 25.78, "e": 26.32}, {"t": "הטענה.", "s": 26.32, "e": 26.8}]}, {"start": 26.8, "end": 29.808, "text": "הטענה מסומנת במילים אם כן.", "words": [{"t": "הטענה", "s": 26.8, "e": 27.8}, {"t": "מסומנת", "s": 27.8, "e": 28.36}, {"t": "במילים", "s": 28.36, "e": 28.76}, {"t": "אם", "s": 28.76, "e": 29.3}, {"t": "כן.", "s": 29.3, "e": 29.808}]}, {"start": 30.12, "end": 31.14, "text": "ומה עם הפתיחה?", "words": [{"t": "ומה", "s": 30.12, "e": 30.56}, {"t": "עם", "s": 30.56, "e": 30.68}, {"t": "הפתיחה?", "s": 30.68, "e": 31.14}]}, {"start": 31.18, "end": 32.18, "text": "היא מציגה את", "words": [{"t": "היא", "s": 31.18, "e": 31.62}, {"t": "מציגה", "s": 31.62, "e": 32.06}, {"t": "את", "s": 32.06, "e": 32.18}]}, {"start": 32.18, "end": 33.84, "text": "התפיסה שהכותב סותר.", "words": [{"t": "התפיסה", "s": 32.18, "e": 32.8}, {"t": "שהכותב", "s": 32.8, "e": 33.46}, {"t": "סותר.", "s": 33.46, "e": 33.84}]}], "captions_default": "off", "text_load": {"mean_visible_words": 2