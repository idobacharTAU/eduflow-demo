{"slug": "psyv_rdc_denied_cause_is_still_cause", "duration": 36.92, "cues": [{"start": 0.0, "end": 2.22, "text": "לשלול סיבה זה בטוח יותר?", "words": [{"t": "לשלול", "s": 0.0, "e": 0.8}, {"t": "סיבה", "s": 0.8, "e": 1.24}, {"t": "זה", "s": 1.24, "e": 1.44}, {"t": "בטוח", "s": 1.44, "e": 1.96}, {"t": "יותר?", "s": 1.96, "e": 2.22}]}, {"start": 2.74, "end": 3.56, "text": "בקטע:", "words": [{"t": "בקטע:", "s": 2.74, "e": 3.56}]}, {"start": 3.58, "end": 4.94, "text": "מכון כושר הוסיף", "words": [{"t": "מכון", "s": 3.58, "e": 4.18}, {"t": "כושר", "s": 4.18, "e": 4.54}, {"t": "הוסיף", "s": 4.54, "e": 4.94}]}, {"start": 4.94, "end": 6.5, "text": "חוגי יוגה בינואר.", "words": [{"t": "חוגי", "s": 4.94, "e": 5.36}, {"t": "יוגה", "s": 5.36, "e": 5.78}, {"t": "בינואר.", "s": 5.78, "e": 6.5}]}, {"start": 6.54, "end": 8.86, "text": "בחודשים שאחרי, נרשמו אליו", "words": [{"t": "בחודשים", "s": 6.54, "e": 7.34}, {"t": "שאחרי,", "s": 7.34, "e": 7.86}, {"t": "נרשמו", "s": 7.86, "e": 8.58}, {"t": "אליו", "s": 8.58, "e": 8.86}]}, {"start": 8.86, "end": 10.16, "text": "מתאמנים חדשים רבים.", "words": [{"t": "מתאמנים", "s": 8.86, "e": 9.34}, {"t": "חדשים", "s": 9.34, "e": 9.78}, {"t": "רבים.", "s": 9.78, "e": 10.16}]}, {"start": 10.38, "end": 12.4, "text": "באותם חודשים גם נפתח", "words": [{"t": "באותם", "s": 10.38, "e": 11.2}, {"t": "חודשים", "s": 11.2, "e": 11.6}, {"t": "גם", "s": 11.6, "e": 12.02}, {"t": "נפתח", "s": 12.02, "e": 12.4}]}, {"start": 12.4, "end": 13.7, "text": "לידו חניון חדש.", "words": [{"t": "לידו", "s": 12.4, "e": 12.76}, {"t": "חניון", "s": 12.76, "e": 13.28}, {"t": "חדש.", "s": 13.28, "e": 13.7}]}, {"start": 14.24, "end": 15.26, "text": "במה הקטע תומך?", "words": [{"t": "במה", "s": 14.24, "e": 14.66}, {"t": "הקטע", "s": 14.66, "e": 14.94}, {"t": "תומך?", "s": 14.94, "e": 15.26}]}, {"start": 15.58, "end": 16.98, "text": "מסיח זהיר:", "words": [{"t": "מסיח", "s": 15.58, "e": 16.42}, {"t": "זהיר:", "s": 16.42, "e": 16.98}]}, {"start": 17.24, "end": 19.66, "text": "היוגה