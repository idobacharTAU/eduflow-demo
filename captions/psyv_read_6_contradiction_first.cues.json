{"slug": "psyv_read_6_contradiction_first", "duration": 42.06, "cues": [{"start": 0, "end": 2.8, "text": "השאלה, במה הקטע תומך?", "words": [{"t": "השאלה,", "s": 0, "e": 0.8}, {"t": "במה", "s": 0.9, "e": 1.74}, {"t": "הקטע", "s": 1.74, "e": 2.2}, {"t": "תומך?", "s": 2.2, "e": 2.68}]}, {"start": 3.04, "end": 5.04, "text": "מאיפה מתחילים לפסול?", "words": [{"t": "מאיפה", "s": 3.04, "e": 3.96}, {"t": "מתחילים", "s": 3.96, "e": 4.4}, {"t": "לפסול?", "s": 4.4, "e": 4.92}]}, {"start": 5.22, "end": 7.06, "text": "מהסתירה הישירה.", "words": [{"t": "מהסתירה", "s": 5.22, "e": 6.14}, {"t": "הישירה.", "s": 6.14, "e": 6.94}]}, {"start": 7.52, "end": 9.8, "text": "בקטע נאמר, הגן הקהילתי", "words": [{"t": "בקטע", "s": 7.52, "e": 7.98}, {"t": "נאמר,", "s": 7.98, "e": 8.32}, {"t": "הגן", "s": 8.54, "e": 9.14}, {"t": "הקהילתי", "s": 9.14, "e": 9.68}]}, {"start": 9.68, "end": 11.68, "text": "מושקה רק במי גשם.", "words": [{"t": "מושקה", "s": 9.68, "e": 10.18}, {"t": "רק", "s": 10.18, "e": 10.64}, {"t": "במי", "s": 10.64, "e": 11.06}, {"t": "גשם.", "s": 11.06, "e": 11.56}]}, {"start": 12.08, "end": 14.34, "text": "מסיח, בקיץ משקים את", "words": [{"t": "מסיח,", "s": 12.08, "e": 12.54}, {"t": "בקיץ", "s": 12.76, "e": 13.66}, {"t": "משקים", "s": 13.66, "e": 14.1}, {"t": "את", "s": 14.1, "e": 14.22}]}, {"start": 14.22, "end": 15.4, "text": "הגן במי ברז.", "words": [{"t": "הגן", "s": 14.22, "e": 14.54}, {"t": "במי", "s": 14.54, "e": 14.88}, {"t": "ברז.", "s": 14.88, "e": 15.28}]}, {"start": 15.92, "end": 17.36, "text": "הקטע אומר במפורש,", "words": [{"t": "הקטע", "s": 15.92, "e": 16.38}, {"t": "אומר", "s": 16.38, "e": 16.56}, {"t": "במפורש,", "s": 16.56, "e": 17.24}]}, {"start": 17.42, "end": 19.14, "text": "רק מי גשם.", "words": [{"t": "רק", "s": 17.42, "e": 18.06}, {"t": "מי", "s": 18.06, "e": 18.44}, {"t": "גשם.", "s": 18.44, "e": 19.02}]}, {"start": 19.1, "end": 21, "text": "המסיח סותר משפט", "words": [{"t": "המסיח", "s": 19.1, "e": 19.94}, {"t": "סותר", "s": 19.94, "e": 20.44}, {"t": "מש