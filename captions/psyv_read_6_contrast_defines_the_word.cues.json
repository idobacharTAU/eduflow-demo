{"slug": "psyv_read_6_contrast_defines_the_word", "duration": 43.68, "cues": [{"start": 0, "end": 2.96, "text": "בקטע, העורכת הוותיקה חדה.", "words": [{"t": "בקטע,", "s": 0, "e": 0.8}, {"t": "העורכת", "s": 0.8, "e": 1.7}, {"t": "הוותיקה", "s": 1.7, "e": 2.28}, {"t": "חדה.", "s": 2.28, "e": 2.84}]}, {"start": 3, "end": 5.54, "text": "לעומתה, המתמחה מפספס", "words": [{"t": "לעומתה,", "s": 3, "e": 3.88}, {"t": "המתמחה", "s": 3.92, "e": 4.72}, {"t": "מפספס", "s": 4.72, "e": 5.42}]}, {"start": 5.42, "end": 6.36, "text": "טעויות רבות.", "words": [{"t": "טעויות", "s": 5.42, "e": 5.78}, {"t": "רבות.", "s": 5.78, "e": 6.24}]}, {"start": 6.4, "end": 8.14, "text": "מה פירוש חדה כאן?", "words": [{"t": "מה", "s": 6.4, "e": 7.06}, {"t": "פירוש", "s": 7.06, "e": 7.34}, {"t": "חדה", "s": 7.34, "e": 7.74}, {"t": "כאן?", "s": 7.74, "e": 8.02}]}, {"start": 8.32, "end": 9.96, "text": "היא יכולה לתאר סכין", "words": [{"t": "היא", "s": 8.32, "e": 8.66}, {"t": "יכולה", "s": 8.66, "e": 8.94}, {"t": "לתאר", "s": 8.94, "e": 9.36}, {"t": "סכין", "s": 9.36, "e": 9.84}]}, {"start": 9.84, "end": 11.22, "text": "או דיבור עוקצני.", "words": [{"t": "או", "s": 9.84, "e": 10.2}, {"t": "דיבור", "s": 10.2, "e": 10.8}, {"t": "עוקצני.", "s": 10.8, "e": 11.1}]}, {"start": 11.2, "end": 13.68, "text": "שניהם מובנים אמיתיים, והמילה", "words": [{"t": "שניהם", "s": 11.2, "e": 11.94}, {"t": "מובנים", "s": 11.94, "e": 12.3}, {"t": "אמיתיים,", "s": 12.3, "e": 12.76}, {"t": "והמילה", "s": 12.88, "e": 13.56}]}, {"start": 13.56, "end": 15.16, "text": "לבדה לא מכריעה.", "words": [{"t": "לבדה", "s": 13.56, "e": 14.08}, {"t": "לא", "s": 14.08, "e": 14.44}, {"t": "מכריעה.", "s": 14.44, "e": 15.04}]}, {"start": 15.34, "end": 17.3, "text": "הניגוד שמולה מראה", "words": [{"t": "הניגוד", "s": 15.34, "e": 16.16}, {"t": "שמולה", "s": 16.16, "e": 16.62}, {"t": "מראה", "s": 16.62, "e": 17.18}]}, {"start": 17.18, "end": 18.2, "text": "איפה לחפש.", "words": [{"t": "איפה", "s": 17.18, "e": 17.62}, {"t": "לחפש.", "s": 17.62, "e": 1