{"slug": "psyv_read_outside_knowledge_out", "duration": 38.54, "cues": [{"start": 0, "end": 1.16, "text": "קטע קצר.", "words": [{"t": "קטע", "s": 0, "e": 0.54}, {"t": "קצר.", "s": 0.54, "e": 1.04}]}, {"start": 1.22, "end": 3.82, "text": "חברת תעופה הוזילה כרטיסים", "words": [{"t": "חברת", "s": 1.22, "e": 2.1}, {"t": "תעופה", "s": 2.1, "e": 2.58}, {"t": "הוזילה", "s": 2.58, "e": 3.2}, {"t": "כרטיסים", "s": 3.2, "e": 3.7}]}, {"start": 3.7, "end": 6.14, "text": "בקו הפנימי, ומאז מספר", "words": [{"t": "בקו", "s": 3.7, "e": 4.02}, {"t": "הפנימי,", "s": 4.02, "e": 4.5}, {"t": "ומאז", "s": 4.5, "e": 5.28}, {"t": "מספר", "s": 5.28, "e": 6.02}]}, {"start": 6.02, "end": 7.46, "text": "הנוסעים בקו עלה.", "words": [{"t": "הנוסעים", "s": 6.02, "e": 6.52}, {"t": "בקו", "s": 6.52, "e": 6.94}, {"t": "עלה.", "s": 6.94, "e": 7.34}]}, {"start": 8.02, "end": 9.58, "text": "שאלה, מה ניתן", "words": [{"t": "שאלה,", "s": 8.02, "e": 8.46}, {"t": "מה", "s": 8.5, "e": 9.1}, {"t": "ניתן", "s": 9.1, "e": 9.46}]}, {"start": 9.46, "end": 10.7, "text": "להסיק מהקטע?", "words": [{"t": "להסיק", "s": 9.46, "e": 10.1}, {"t": "מהקטע?", "s": 10.1, "e": 10.58}]}, {"start": 10.68, "end": 12.56, "text": "יש לך חמש שניות.", "words": [{"t": "יש", "s": 10.68, "e": 11.42}, {"t": "לך", "s": 11.42, "e": 11.68}, {"t": "חמש", "s": 11.68, "e": 12.1}, {"t": "שניות.", "s": 12.1, "e": 12.44}]}, {"start": 13.08, "end": 15.42, "text": "אם בחרת שטיסות מזהמות", "words": [{"t": "אם", "s": 13.08, "e": 13.52}, {"t": "בחרת", "s": 13.52, "e": 13.96}, {"t": "שטיסות", "s": 13.96, "e": 14.66}, {"t": "מזהמות", "s": 14.66, "e": 15.3}]}, {"start": 15.3, "end": 17.54, "text": "יותר מאשר רכבות נפלת.", "words": [{"t": "יותר", "s": 15.3, "e": 15.54}, {"t": "מאשר", "s": 15.54, "e": 15.98}, {"t": "רכבות", "s": 15.98, "e": 16.4}, {"t": "נפלת.", "s": 16.54, "e": 17.42}]}, {"start": 17.58, "end": 19.56, "text": "זה אולי נכון במציאות,", "words": [{"t": "זה", "s": 17.58, "e": 18.2}, {"t": "אולי", "s": 18.2, "e": 18.46}, {"t": "נכון", "s": 18.46, "e": 18.84}, {"t": "במציאות,", "s": 18.84, "e": 19.44}]}, {"start": 19.5, "end": 20.96, "text": "אבל הקטע לא", "words": [{"t": "אבל", "s": 19.5, "e": 19.86}, {"t": "הקטע", "s": 19.86, "e": 20.44}, {"t": "לא", "s": 20.44, "e": 20.84}]}, {"start": 20.84, "end": 22.5, "text": "עוסק כלל בזיהום.", "words": [{"t": "עוסק", "s": 20.84, "e": 21.44}, {"t": "כלל", "s": 21.44, "e": 21.92}, {"t": "בזיהום.", "s": 21.92, "e": 22.38}]}, {"start": 22.58, "end": 23.98, "text": "ידע כללי דווקא", "words": [{"t": "ידע", "s": 22.58, "e": 23.22}, {"t": "כללי", "s": 23.22, "e": 23.54}, {"t": "דווקא", "s": 23.54, "e": 23.86}]}, {"start": 23.86, "end": 24.94, "text": "פוסל אותך כאן.", "words": [{"t": "פוסל", "s": 23.86, "e": 24.3}, {"t": "אותך", "s": 24.3, "e": 24.56}, {"t": "כאן.", "s": 24.56, "e": 24.82}]}, {"start": 24.82, "end": 26.78, "text": "ההסקה שהקטע כן", "words": [{"t": "ההסקה", "s": 24.82, "e": 25.92}, {"t": "שהקטע", "s": 25.92, "e": 26.42}, {"t": "כן", "s": 26.42, "e": 26.66}]}, {"start": 26.66, "end": 27.36, "text": "תומך בה?", "words": [{"t": "תומך", "s": 26.66, "e": 27.12}, {"t": "בה?", "s": 27.12, "e": 27.24}]}, {"start": 27.46, "end": 29.58, "text": "ההוזלה משכה נוסעים", "words": [{"t": "ההוזלה", "s": 27.46, "e": 28.32}, {"t": "משכה", "s": 28.32, "e": 28.96}, {"t": "נוסעים", "s": 28.96, "e": 29.46}]}, {"start": 29.46, "end": 30.5, "text": "אל הקו האווירי.", "words": [{"t": "אל", "s": 29.46, "e": 29.66}, {"t": "הקו", "s": 29.66, "e": 29.96}, {"t": "האווירי.", "s": 29.96, "e": 30.38}]}, {"start": 30.99, "end": 32.62, "text": "שאל תמיד, איפה", "words": [{"t": "שאל", "s": 30.99, "e": 31.42}, {"t": "תמיד,", "s": 31.42, "e": 31.86}, {"t": "איפה", "s": 31.86, "e": 32.5}]}, {"start": 32.5, "end": 33.78, "text": "זה כתוב בקטע?", "words": [{"t": "זה", "s": 32.5, "e": 32.64}, {"t": "כתוב", "s": 32.64, "e": 33.2}, {"t": "בקטע?", "s": 33.2, "e": 33.66}]}, {"start": 34, "end": 36.02, "text": "תרגול, מה עוד", "words": [{"t": "תרגול,", "s": 34, "e": 34.86}, {"t": "מה", "s": 34.9, "e": 35.54}, {"t": "עוד", "s": 35.54, "e": 35.9}]}, {"start": 35.9, "end": 37.06, "text": "הקטע לא אומר?", "words": [{"t": "הקטע", "s": 35.9, "e": 36.24}, {"t": "לא", "s": 36.24, "e": 36.68}, {"t": "אומר?", "s": 36.68, "e": 36.94}]}]}
