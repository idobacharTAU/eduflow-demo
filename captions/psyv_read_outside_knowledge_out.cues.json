{"slug": "psyv_read_outside_knowledge_out", "duration": 39.6, "cues": [{"start": 0, "end": 1.12, "text": "קטע קצר.", "words": [{"t": "קטע", "s": 0, "e": 0.5}, {"t": "קצר.", "s": 0.5, "e": 1}]}, {"start": 1.14, "end": 3.22, "text": "חברת תעופה הוזילה", "words": [{"t": "חברת", "s": 1.14, "e": 2.02}, {"t": "תעופה", "s": 2.02, "e": 2.5}, {"t": "הוזילה", "s": 2.5, "e": 3.1}]}, {"start": 3.1, "end": 4.7, "text": "כרטיסים בקו פנימי.", "words": [{"t": "כרטיסים", "s": 3.1, "e": 3.7}, {"t": "בקו", "s": 3.7, "e": 4.12}, {"t": "פנימי.", "s": 4.12, "e": 4.58}]}, {"start": 4.7, "end": 6.78, "text": "מאז מספר הנוסעים", "words": [{"t": "מאז", "s": 4.7, "e": 5.58}, {"t": "מספר", "s": 5.58, "e": 6.14}, {"t": "הנוסעים", "s": 6.14, "e": 6.66}]}, {"start": 6.66, "end": 7.58, "text": "בקו עלה.", "words": [{"t": "בקו", "s": 6.66, "e": 7.06}, {"t": "עלה.", "s": 7.06, "e": 7.46}]}, {"start": 7.86, "end": 9.3, "text": "לוח הטיסות בקו", "words": [{"t": "לוח", "s": 7.86, "e": 8.3}, {"t": "הטיסות", "s": 8.3, "e": 8.76}, {"t": "בקו", "s": 8.76, "e": 9.18}]}, {"start": 9.18, "end": 9.94, "text": "לא שונה.", "words": [{"t": "לא", "s": 9.18, "e": 9.48}, {"t": "שונה.", "s": 9.48, "e": 9.82}]}, {"start": 10.52, "end": 11.08, "text": "שאלה:", "words": [{"t": "שאלה:", "s": 10.52, "e": 10.96}]}, {"start": 11, "end": 12.84, "text": "מה ניתן להסיק מהקטע?", "words": [{"t": "מה", "s": 11, "e": 11.6}, {"t": "ניתן", "s": 11.6, "e": 11.88}, {"t": "להסיק", "s": 11.88, "e": 12.26}, {"t": "מהקטע?", "s": 12.26, "e": 12.72}]}, {"start": 12.8, "end": 14.62, "text": "יש לך חמש שניות.", "words": [{"t": "יש", "s": 12.8, "e": 13.38}, {"t": "לך", "s": 13.38, "e": 13.66}, {"t": "חמש", "s": 13.66, "e": 14.08}, {"t": "שניות.", "s": 14.08, "e": 14.5}]}, {"start": 15.26, "end": 17.66, "text": "אם סימנת שטיסות מזהמות", "words": [{"t": "אם", "s": 15.26, "e": 15.7}, {"t": "סימנת", "s": 15.7, "e": 16.14}, {"t": "שטיסות", "s": 16.14, "e": 16.8}, {"t": "מזהמות", "s": 16.8, "e": 17.54}]}, {"start": 17.54, "end": 19.78, "text": "יותר