{"slug": "psyv_read_outside_knowledge_out_h2", "duration": 33.48, "cues": [{"start": 0, "end": 1.86, "text": "מה ניתן להסיק מהקטע?", "words": [{"t": "מה", "s": 0, "e": 0.38}, {"t": "ניתן", "s": 0.38, "e": 0.74}, {"t": "להסיק", "s": 0.74, "e": 1.26}, {"t": "מהקטע?", "s": 1.26, "e": 1.74}]}, {"start": 1.82, "end": 3.82, "text": "חברת תעופה הוזילה", "words": [{"t": "חברת", "s": 1.82, "e": 2.64}, {"t": "תעופה", "s": 2.64, "e": 3.08}, {"t": "הוזילה", "s": 3.08, "e": 3.7}]}, {"start": 3.7, "end": 5.08, "text": "כרטיסים בקו פנימי.", "words": [{"t": "כרטיסים", "s": 3.7, "e": 4.22}, {"t": "בקו", "s": 4.22, "e": 4.54}, {"t": "פנימי.", "s": 4.54, "e": 4.96}]}, {"start": 4.98, "end": 6.96, "text": "מאז מספר הנוסעים", "words": [{"t": "מאז", "s": 4.98, "e": 5.78}, {"t": "מספר", "s": 5.78, "e": 6.36}, {"t": "הנוסעים", "s": 6.36, "e": 6.84}]}, {"start": 6.84, "end": 7.78, "text": "בקו עלה.", "words": [{"t": "בקו", "s": 6.84, "e": 7.28}, {"t": "עלה.", "s": 7.28, "e": 7.66}]}, {"start": 7.76, "end": 9.44, "text": "לוח הטיסות בקו", "words": [{"t": "לוח", "s": 7.76, "e": 8.44}, {"t": "הטיסות", "s": 8.44, "e": 8.88}, {"t": "בקו", "s": 8.88, "e": 9.32}]}, {"start": 9.32, "end": 10.06, "text": "לא שונה.", "words": [{"t": "לא", "s": 9.32, "e": 9.64}, {"t": "שונה.", "s": 9.64, "e": 9.94}]}, {"start": 10.28, "end": 12.32, "text": "סימנת שטיסות מזהמות", "words": [{"t": "סימנת", "s": 10.28, "e": 10.98}, {"t": "שטיסות", "s": 10.98, "e": 11.56}, {"t": "מזהמות", "s": 11.56, "e": 12.2}]}, {"start": 12.2, "end": 13.5, "text": "יותר מנסיעה ברכבת?", "words": [{"t": "יותר", "s": 12.2, "e": 12.38}, {"t": "מנסיעה", "s": 12.38, "e": 12.94}, {"t": "ברכבת?", "s": 12.94, "e": 13.38}]}, {"start": 13.52, "end": 14.32, "text": "נפלת.", "words": [{"t": "נפלת.", "s": 13.52, "e": 14.2}]}, {"start": 14.32, "end": 15.56, "text": "זה אולי נכון", "words": [{"t": "זה", "s": 14.32, "e": 14.94}, {"t": "אולי", "s": 14.94, "e": 15.14}, {"t": "נכון", "s": 15.14, "e": 15.44}]}, {"start": 15.44, "end": 17.18, "text": "במציאו