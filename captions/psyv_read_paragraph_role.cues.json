": 35.518, "text": "עמדה שהכותב בא לסתור.", "words": [{"t": "עמדה", "s": 33.254, "e": 34.108}, {"t": "שהכותב", "s": 34.108, "e": 34.783}, {"t": "בא", "s": 34.783, "e": 34.942}, {"t": "לסתור.", "s": 34.942, "e": 35.518}]}, {"start": 36.035, "end": 36.909, "text": "עכשיו בודקים:", "words": [{"t": "עכשיו", "s": 36.035, "e": 36.492}, {"t": "בודקים:", "s": 36.492, "e": 36.909}]}, {"start": 36.949, "end": 39.412, "text": "מה מסמנת המילה לכן?", "words": [{"t": "מה", "s": 36.949, "e": 37.505}, {"t": "מסמנת", "s": 37.505, "e": 38.161}, {"t": "המילה", "s": 38.161, "e": 38.677}, {"t": "לכן?", "s": 38.677, "e": 39.412}]}]}
