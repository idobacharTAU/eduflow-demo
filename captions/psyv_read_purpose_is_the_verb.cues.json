{"slug": "psyv_read_purpose_is_the_verb", "duration": 40.5, "cues": [{"start": 0, "end": 1.6, "text": "מה מטרת הכותב?", "words": [{"t": "מה", "s": 0, "e": 0.48}, {"t": "מטרת", "s": 0.48, "e": 0.96}, {"t": "הכותב?", "s": 0.96, "e": 1.48}]}, {"start": 1.95, "end": 3.4, "text": "לא עונים מהנושא,", "words": [{"t": "לא", "s": 1.95, "e": 2.38}, {"t": "עונים", "s": 2.38, "e": 2.66}, {"t": "מהנושא,", "s": 2.66, "e": 3.28}]}, {"start": 3.3, "end": 5.06, "text": "עונים מהפעולה.", "words": [{"t": "עונים", "s": 3.3, "e": 3.88}, {"t": "מהפעולה.", "s": 3.88, "e": 4.94}]}, {"start": 5.28, "end": 8, "text": "לטעון, להשוות, לתאר", "words": [{"t": "לטעון,", "s": 5.28, "e": 6.14}, {"t": "להשוות,", "s": 6.18, "e": 6.82}, {"t": "לתאר", "s": 7.12, "e": 7.88}]}, {"start": 7.88, "end": 8.96, "text": "או להזהיר.", "words": [{"t": "או", "s": 7.88, "e": 8.02}, {"t": "להזהיר.", "s": 8.02, "e": 8.84}]}, {"start": 9.39, "end": 10.82, "text": "קטע על ריהוט משרדי.", "words": [{"t": "קטע", "s": 9.39, "e": 9.82}, {"t": "על", "s": 9.82, "e": 9.92}, {"t": "ריהוט", "s": 9.92, "e": 10.2}, {"t": "משרדי.", "s": 10.2, "e": 10.7}]}, {"start": 10.8, "end": 12.34, "text": "הנושא הוא ריהוט.", "words": [{"t": "הנושא", "s": 10.8, "e": 11.52}, {"t": "הוא", "s": 11.52, "e": 11.76}, {"t": "ריהוט.", "s": 11.76, "e": 12.22}]}, {"start": 12.28, "end": 14, "text": "אבל מה הקטע עושה?", "words": [{"t": "אבל", "s": 12.28, "e": 12.84}, {"t": "מה", "s": 12.84, "e": 13.2}, {"t": "הקטע", "s": 13.2, "e": 13.52}, {"t": "עושה?", "s": 13.52, "e": 13.88}]}, {"start": 14.25, "end": 15.74, "text": "הוא פותח בתפיסה.", "words": [{"t": "הוא", "s": 14.25, "e": 14.68}, {"t": "פותח", "s": 14.68, "e": 15.1}, {"t": "בתפיסה.", "s": 15.1, "e": 15.62}]}, {"start": 15.86, "end": 17.46, "text": "ריהוט זול נראה", "words": [{"t": "ריהוט", "s": 15.86, "e": 16.48}, {"t": "זול", "s": 16.48, "e": 16.84}, {"t": "נראה", "s": 16.84, "e": 17.34}]}, {"start": 17.34, "end": 18.28, "text": "כמו חיסכון.", "words": [{"t": "כמו", "s": 17.34, "e": 17.6}, {"t": "חיסכון.", "s": 17.6, "e": 18.16}]}, {"start": 18.61, "end": 20.04, "text": "אחר כך הוא משווה", "words": [{"t": "אחר", "s": 18.61, "e": 19.04}, {"t": "כך", "s": 19.04, "e": 19.26}, {"t": "הוא", "s": 19.26, "e": 19.46}, {"t": "משווה", "s": 19.46, "e": 19.92}]}, {"start": 19.92, "end": 21.78, "text": "כיסא זול לכיסא איכותי.", "words": [{"t": "כיסא", "s": 19.92, "e": 20.3}, {"t": "זול", "s": 20.3, "e": 20.74}, {"t": "לכיסא", "s": 20.74, "e": 21.2}, {"t": "איכותי.", "s": 21.2, "e": 21.66}]}, {"start": 21.9, "end": 23.64, "text": "ההשוואה היא רק המחשה.", "words": [{"t": "ההשוואה", "s": 21.9, "e": 22.76}, {"t": "היא", "s": 22.76, "e": 22.94}, {"t": "רק", "s": 22.94, "e": 23.16}, {"t": "המחשה.", "s": 23.16, "e": 23.52}]}, {"start": 23.86, "end": 25.84, "text": "המשפט האחרון פותח", "words": [{"t": "המשפט", "s": 23.86, "e": 24.72}, {"t": "האחרון", "s": 24.72, "e": 25.26}, {"t": "פותח", "s": 25.26, "e": 25.72}]}, {"start": 25.72, "end": 27, "text": "במילים אם כן.", "words": [{"t": "במילים", "s": 25.72, "e": 26.26}, {"t": "אם", "s": 26.26, "e": 26.54}, {"t": "כן.", "s": 26.54, "e": 26.88}]}, {"start": 27.26, "end": 29.46, "text": "וכאן הכותב מסיק.", "words": [{"t": "וכאן", "s": 27.26, "e": 28.12}, {"t": "הכותב", "s": 28.12, "e": 28.84}, {"t": "מסיק.", "s": 28.84, "e": 29.34}]}, {"start": 29.34, "end": 31.9, "text": "העלות נמדדת לאורך", "words": [{"t": "העלות", "s": 29.34, "e": 30.44}, {"t": "נמדדת", "s": 30.44, "e": 31.06}, {"t": "לאורך", "s": 31.06, "e": 31.78}]}, {"start": 31.78, "end": 32.76, "text": "שנות השימוש.", "words": [{"t": "שנות", "s": 31.78, "e": 32.08}, {"t": "השימוש.", "s": 32.08, "e": 32.64}]}, {"start": 32.68, "end": 33.72, "text": "זאת טענה.", "words": [{"t": "זאת", "s": 32.68, "e": 33.28}, {"t": "טענה.", "s": 33.28, "e": 33.6}]}, {"start": 33.72, "end": 35.94, "text": "אז המטרה היא לטעון.", "words": [{"t": "אז", "s": 33.72, "e": 34.24}, {"t": "המטרה", "s": 34.24, "e": 34.72}, {"t": "היא", "s": 34.72, "e": 34.88}, {"t": "לטעון.", "s": 34.88, "e": 35.82}]}, {"start": 35.82, "end": 37.46, "text": "לא להשוות כיסאות", "words": [{"t": "לא", "s": 35.82, "e": 36.3}, {"t": "להשוות", "s": 36.3, "e": 36.8}, {"t": "כיסאות", "s": 36.8, "e": 37.34}]}, {"start": 37.34, "end": 39.02, "text": "ולא לתאר ריהוט.", "words": [{"t": "ולא", "s": 37.34, "e": 38.04}, {"t": "לתאר", "s": 38.04, "e": 38.68}, {"t": "ריהוט.", "s": 38.68, "e": 38.9}]}]}
