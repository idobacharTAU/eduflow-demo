{"slug": "psyv_sc3_nobody_locks_the_edge", "duration": 37.66, "cues": [{"start": 0, "end": 3.04, "text": "התמיכה בהצעה הייתה וכאן", "words": [{"t": "התמיכה", "s": 0, "e": 0.7}, {"t": "בהצעה", "s": 0.7, "e": 1.28}, {"t": "הייתה", "s": 1.28, "e": 1.88}, {"t": "וכאן", "s": 1.88, "e": 2.92}]}, {"start": 2.92, "end": 4.72, "text": "החלל, שכן איש", "words": [{"t": "החלל,", "s": 2.92, "e": 3.26}, {"t": "שכן", "s": 3.4, "e": 4.22}, {"t": "איש", "s": 4.22, "e": 4.6}]}, {"start": 4.6, "end": 5.62, "text": "לא הצביע נגדה", "words": [{"t": "לא", "s": 4.6, "e": 4.7}, {"t": "הצביע", "s": 4.7, "e": 5.08}, {"t": "נגדה", "s": 5.08, "e": 5.5}]}, {"start": 5.5, "end": 7, "text": "ואיש לא נמנע.", "words": [{"t": "ואיש", "s": 5.5, "e": 6.4}, {"t": "לא", "s": 6.4, "e": 6.54}, {"t": "נמנע.", "s": 6.54, "e": 6.88}]}, {"start": 7.26, "end": 9.16, "text": "איש לא, פעמיים.", "words": [{"t": "איש", "s": 7.26, "e": 7.68}, {"t": "לא,", "s": 7.68, "e": 8.1}, {"t": "פעמיים.", "s": 8.24, "e": 9.04}]}, {"start": 9.22, "end": 10.98, "text": "כלומר, כל הנוכחים", "words": [{"t": "כלומר,", "s": 9.22, "e": 9.94}, {"t": "כל", "s": 10, "e": 10.26}, {"t": "הנוכחים", "s": 10.26, "e": 10.86}]}, {"start": 10.86, "end": 12.14, "text": "הצביעו בעד.", "words": [{"t": "הצביעו", "s": 10.86, "e": 11.44}, {"t": "בעד.", "s": 11.44, "e": 12.02}]}, {"start": 12.6, "end": 14.5, "text": "מילת היקף כוללת קובעת", "words": [{"t": "מילת", "s": 12.6, "e": 13.02}, {"t": "היקף", "s": 13.02, "e": 13.38}, {"t": "כוללת", "s": 13.38, "e": 13.92}, {"t": "קובעת", "s": 13.92, "e": 14.38}]}, {"start": 14.38, "end": 16.08, "text": "סימן, וגם עוצמה.", "words": [{"t": "סימן,", "s": 14.38, "e": 14.84}, {"t": "וגם", "s": 14.94, "e": 15.52}, {"t": "עוצמה.", "s": 15.52, "e": 15.96}]}, {"start": 16.08, "end": 17.58, "text": "היא נועלת את", "words": [{"t": "היא", "s": 16.08, "e": 16.64}, {"t": "נועלת", "s": 16.64, "e": 17.34}, {"t": "את", "s": 17.34, "e": 17.46}]}, {"start": 17.46, "end": 18.22, "text": "קצה הסולם.", "words": [{"t": "קצה", "s": 