{"slug": "psyv_sc3_semicolon_quiet_flip", "duration": 38, "cues": [{"start": 0, "end": 2.94, "text": "המחקר נערך בקפדנות יתרה,", "words": [{"t": "המחקר", "s": 0, "e": 0.8}, {"t": "נערך", "s": 0.8, "e": 1.18}, {"t": "בקפדנות", "s": 1.18, "e": 2.24}, {"t": "יתרה,", "s": 2.24, "e": 2.82}]}, {"start": 2.92, "end": 5.18, "text": "ואחרי נקודה פסיק כל", "words": [{"t": "ואחרי", "s": 2.92, "e": 3.72}, {"t": "נקודה", "s": 3.72, "e": 4.02}, {"t": "פסיק", "s": 4.02, "e": 4.46}, {"t": "כל", "s": 4.46, "e": 5.06}]}, {"start": 5.06, "end": 6.92, "text": "מדידה בו הייתה...", "words": [{"t": "מדידה", "s": 5.06, "e": 5.82}, {"t": "בו", "s": 5.82, "e": 6}, {"t": "הייתה...", "s": 6, "e": 6.8}]}, {"start": 6.8, "end": 8.22, "text": "וכאן החלל.", "words": [{"t": "וכאן", "s": 6.8, "e": 7.72}, {"t": "החלל.", "s": 7.72, "e": 8.1}]}, {"start": 8.28, "end": 9.76, "text": "אין כאן מילת קישור.", "words": [{"t": "אין", "s": 8.28, "e": 8.88}, {"t": "כאן", "s": 8.88, "e": 9.04}, {"t": "מילת", "s": 9.04, "e": 9.28}, {"t": "קישור.", "s": 9.28, "e": 9.64}]}, {"start": 9.82, "end": 12.04, "text": "כאן נקודה פסיק מסמנת", "words": [{"t": "כאן", "s": 9.82, "e": 10.48}, {"t": "נקודה", "s": 10.48, "e": 10.88}, {"t": "פסיק", "s": 10.88, "e": 11.3}, {"t": "מסמנת", "s": 11.3, "e": 11.92}]}, {"start": 11.92, "end": 13.56, "text": "הרחבה, לא תפנית.", "words": [{"t": "הרחבה,", "s": 11.92, "e": 12.56}, {"t": "לא", "s": 12.68, "e": 13.04}, {"t": "תפנית.", "s": 13.04, "e": 13.44}]}, {"start": 13.8, "end": 14.72, "text": "רשלנית?", "words": [{"t": "רשלנית?", "s": 13.8, "e": 14.6}]}, {"start": 14.72, "end": 16.32, "text": "רק אם שותלים שם", "words": [{"t": "רק", "s": 14.72, "e": 15.44}, {"t": "אם", "s": 15.44, "e": 15.62}, {"t": "שותלים", "s": 15.62, "e": 15.96}, {"t": "שם", "s": 15.96, "e": 16.2}]}, {"start": 16.2, "end": 18.54, "text": "אבל, וכל מדידה רשלנית", "words": [{"t": "אבל,", "s": 16.2, "e": 16.46}, {"t": "וכל", "s": 16.66, "e": 17.4}, {"t": "מדידה", "s": 17.4, "e": 17.88}, {"t": "רשלנית", "s": 17.88, "e":