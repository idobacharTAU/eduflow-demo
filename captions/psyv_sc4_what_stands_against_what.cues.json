{"slug": "psyv_sc4_what_stands_against_what", "duration": 36.24, "cues": [{"start": 0.0, "end": 2.0, "text": "נקודה פסיק מסמנת", "words": [{"t": "נקודה", "s": 0.0, "e": 0.62}, {"t": "פסיק", "s": 0.62, "e": 1.1}, {"t": "מסמנת", "s": 1.1, "e": 2.0}]}, {"start": 2.0, "end": 3.4, "text": "בדרך כלל הרחבה.", "words": [{"t": "בדרך", "s": 2.0, "e": 2.38}, {"t": "כלל", "s": 2.38, "e": 2.78}, {"t": "הרחבה.", "s": 2.78, "e": 3.4}]}, {"start": 3.54, "end": 5.26, "text": "אבל לפעמים יש", "words": [{"t": "אבל", "s": 3.54, "e": 4.16}, {"t": "לפעמים", "s": 4.16, "e": 4.8}, {"t": "יש", "s": 4.8, "e": 5.26}]}, {"start": 5.26, "end": 6.62, "text": "אחריה דווקא ניגוד.", "words": [{"t": "אחריה", "s": 5.26, "e": 5.68}, {"t": "דווקא", "s": 5.68, "e": 6.02}, {"t": "ניגוד.", "s": 6.02, "e": 6.62}]}, {"start": 7.16, "end": 8.6, "text": "ומה נושא את הניגוד הזה?", "words": [{"t": "ומה", "s": 7.16, "e": 7.62}, {"t": "נושא", "s": 7.62, "e": 7.96}, {"t": "את", "s": 7.96, "e": 8.06}, {"t": "הניגוד", "s": 8.06, "e": 8.46}, {"t": "הזה?", "s": 8.46, "e": 8.6}]}, {"start": 8.8, "end": 11.08, "text": "לא הפיסוק, אלא התוכן.", "words": [{"t": "לא", "s": 8.8, "e": 9.34}, {"t": "הפיסוק,", "s": 9.34, "e": 9.92}, {"t": "אלא", "s": 9.98, "e": 10.48}, {"t": "התוכן.", "s": 10.48, "e": 11.08}]}, {"start": 11.48, "end": 14.06, "text": "הוא עשיר; אחיו עני.", "words": [{"t": "הוא", "s": 11.48, "e": 11.94}, {"t": "עשיר;", "s": 11.94, "e": 12.66}, {"t": "אחיו", "s": 12.72, "e": 13.58}, {"t": "עני.", "s": 13.58, "e": 14.06}]}, {"start": 14.3, "end": 16.5, "text": "שני נושאים, זה מול זה.", "words": [{"t": "שני", "s": 14.3, "e": 15.18}, {"t": "נושאים,", "s": 15.18, "e": 15.72}, {"t": "זה", "s": 15.72, "e": 16.08}, {"t": "מול", "s": 16.08, "e": 16.34}, {"t": "זה.", "s": 16.34, "e": 16.5}]}, {"start": 17.08, "end": 20.46, "text": "המלון מפואר; החדרים בו קטנים.", "words": [{"t": "המלון", "s": 17.08, "e": 18.0}, {"t": "מפואר;", "s": 18.0, "e": 18.76}, {"t": "החדרים", "s": 18.9, "e": 19.82}, {"t": "בו", "s": 19.82, "e": 20.0