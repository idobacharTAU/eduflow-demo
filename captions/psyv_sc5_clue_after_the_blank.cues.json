{"slug": "psyv_sc5_clue_after_the_blank", "duration": 39.52, "cues": [{"start": 0, "end": 2.08, "text": "הוא נחשב, וכאן", "words": [{"t": "הוא", "s": 0, "e": 0.3}, {"t": "נחשב,", "s": 0.3, "e": 1.16}, {"t": "וכאן", "s": 1.18, "e": 1.96}]}, {"start": 1.96, "end": 3.8, "text": "החלל, בין חבריו.", "words": [{"t": "החלל,", "s": 1.96, "e": 2.36}, {"t": "בין", "s": 2.54, "e": 3.12}, {"t": "חבריו.", "s": 3.12, "e": 3.68}]}, {"start": 4.14, "end": 5.3, "text": "עצרתם כאן?", "words": [{"t": "עצרתם", "s": 4.14, "e": 4.94}, {"t": "כאן?", "s": 4.94, "e": 5.18}]}, {"start": 5.26, "end": 6.8, "text": "אפשר לשבץ כמעט", "words": [{"t": "אפשר", "s": 5.26, "e": 5.9}, {"t": "לשבץ", "s": 5.9, "e": 6.3}, {"t": "כמעט", "s": 6.3, "e": 6.68}]}, {"start": 6.68, "end": 7.64, "text": "כל תכונה.", "words": [{"t": "כל", "s": 6.68, "e": 7.06}, {"t": "תכונה.", "s": 7.06, "e": 7.52}]}, {"start": 7.84, "end": 11.02, "text": "מצחיק, נדיב, דייקן, כל", "words": [{"t": "מצחיק,", "s": 7.84, "e": 8.64}, {"t": "נדיב,", "s": 8.72, "e": 9.42}, {"t": "דייקן,", "s": 9.56, "e": 10.24}, {"t": "כל", "s": 10.5, "e": 10.9}]}, {"start": 10.9, "end": 11.84, "text": "אחת נשמעת טוב.", "words": [{"t": "אחת", "s": 10.9, "e": 11.2}, {"t": "נשמעת", "s": 11.2, "e": 11.56}, {"t": "טוב.", "s": 11.56, "e": 11.72}]}, {"start": 11.96, "end": 13.56, "text": "אבל החלל לבדו", "words": [{"t": "אבל", "s": 11.96, "e": 12.6}, {"t": "החלל", "s": 12.6, "e": 12.98}, {"t": "לבדו", "s": 12.98, "e": 13.44}]}, {"start": 13.44, "end": 14.34, "text": "לא מכריע.", "words": [{"t": "לא", "s": 13.44, "e": 13.82}, {"t": "מכריע.", "s": 13.82, "e": 14.22}]}, {"start": 14.48, "end": 16.7, "text": "עכשיו קוראים עד הסוף.", "words": [{"t": "עכשיו", "s": 14.48, "e": 15.28}, {"t": "קוראים", "s": 15.28, "e": 15.82}, {"t": "עד", "s": 15.82, "e": 16.22}, {"t": "הסוף.", "s": 16.22, "e": 16.58}]}, {"start": 16.8, "end": 18.86, "text": "משום שמעולם לא", "words": [{"t": "משום", "s": 16.8, "e": 17.6}, {"t": "שמעולם", "s": 17.6, "e": 18.4}, {"t": "לא", "s": 18.4, "e": 18.74}]}, {"start": 18.74, "end": 19.76, "text": "איחר לפגישה.", "words": [{"t": "איחר", "s": 18.74, "e": 19.1}, {"t": "לפגישה.", "s": 19.1, "e": 19.64}]}, {"start": 20.1, "end": 22.16, "text": "מילת הקישור פותחת סיבה.", "words": [{"t": "מילת", "s": 20.1, "e": 20.58}, {"t": "הקישור", "s": 20.58, "e": 21.02}, {"t": "פותחת", "s": 21.02, "e": 21.62}, {"t": "סיבה.", "s": 21.62, "e": 22.04}]}, {"start": 22.26, "end": 24.16, "text": "מה שאחריה מסביר", "words": [{"t": "מה", "s": 22.26, "e": 22.66}, {"t": "שאחריה", "s": 22.66, "e": 23.2}, {"t": "מסביר", "s": 23.2, "e": 24.04}]}, {"start": 24.04, "end": 25.02, "text": "את מה שלפניה.", "words": [{"t": "את", "s": 24.04, "e": 24.22}, {"t": "מה", "s": 24.22, "e": 24.4}, {"t": "שלפניה.", "s": 24.4, "e": 24.9}]}, {"start": 25.46, "end": 26.74, "text": "ומי שמעולם לא", "words": [{"t": "ומי", "s": 25.46, "e": 25.86}, {"t": "שמעולם", "s": 25.86, "e": 26.42}, {"t": "לא", "s": 26.42, "e": 26.62}]}, {"start": 26.62, "end": 28.08, "text": "איחר, דייקן.", "words": [{"t": "איחר,", "s": 26.62, "e": 27.04}, {"t": "דייקן.", "s": 27.08, "e": 27.96}]}, {"start": 28.28, "end": 29.72, "text": "מצחיק ונדיב?", "words": [{"t": "מצחיק", "s": 28.28, "e": 29.08}, {"t": "ונדיב?", "s": 29.08, "e": 29.6}]}, {"start": 30, "end": 31.38, "text": "הסיבה לא מסבירה אותם.", "words": [{"t": "הסיבה", "s": 30, "e": 30.42}, {"t": "לא", "s": 30.42, "e": 30.52}, {"t": "מסבירה", "s": 30.52, "e": 30.9}, {"t": "אותם.", "s": 30.9, "e": 31.26}]}, {"start": 31.84, "end": 33.3, "text": "כאן הרמז יושב", "words": [{"t": "כאן", "s": 31.84, "e": 32.26}, {"t": "הרמז", "s": 32.26, "e": 32.76}, {"t": "יושב", "s": 32.76, "e": 33.18}]}, {"start": 33.18, "end": 34.24, "text": "אחרי החלל.", "words": [{"t": "אחרי", "s": 33.18, "e": 33.7}, {"t": "החלל.", "s": 33.7, "e": 34.12}]}, {"start": 34.56, "end": 36.7, "text": "מי שעוצר בחלל עונה", "words": [{"t": "מי", "s": 34.56, "e": 34.98}, {"t": "שעוצר", "s": 34.98, "e": 35.4}, {"t": "בחלל", "s": 35.4, "e": 35.8}, {"t": "עונה", "s": 35.8,