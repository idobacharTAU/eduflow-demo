 34}]}, {"start": 34.34, "end": 36.2, "text": "המשפט קובע את המשלב,", "words": [{"t": "המשפט", "s": 34.34, "e": 35.1}, {"t": "קובע", "s": 35.1, "e": 35.42}, {"t": "את", "s": 35.42, "e": 35.56}, {"t": "המשלב,", "s": 35.56, "e": 36.08}]}, {"start": 36.12, "end": 37.28, "text": "לא רמת המילה.", "words": [{"t": "לא", "s": 36.12, "e": 36.52}, {"t": "רמת", "s": 36.52, "e": 36.88}, {"t": "המילה.", "s": 36.88, "e": 37.16}]}]}
