{"slug": "psyv_sc_6_that_is_same_idea", "duration": 39.18, "cues": [{"start": 0, "end": 2.46, "text": "הנהגת נסעה בזהירות רבה.", "words": [{"t": "הנהגת", "s": 0, "e": 0.86}, {"t": "נסעה", "s": 0.86, "e": 1.42}, {"t": "בזהירות", "s": 1.42, "e": 1.98}, {"t": "רבה.", "s": 1.98, "e": 2.34}]}, {"start": 2.64, "end": 5.16, "text": "כלומר, וכאן חלל.", "words": [{"t": "כלומר,", "s": 2.64, "e": 3.48}, {"t": "וכאן", "s": 3.66, "e": 4.66}, {"t": "חלל.", "s": 4.66, "e": 5.04}]}, {"start": 5.54, "end": 7.54, "text": "מה נכנס אחרי כלומר?", "words": [{"t": "מה", "s": 5.54, "e": 5.96}, {"t": "נכנס", "s": 5.96, "e": 6.38}, {"t": "אחרי", "s": 6.38, "e": 6.92}, {"t": "כלומר?", "s": 6.92, "e": 7.42}]}, {"start": 8.02, "end": 9.42, "text": "כלומר לא מביאה", "words": [{"t": "כלומר", "s": 8.02, "e": 8.44}, {"t": "לא", "s": 8.44, "e": 8.86}, {"t": "מביאה", "s": 8.86, "e": 9.3}]}, {"start": 9.3, "end": 10.3, "text": "רעיון חדש.", "words": [{"t": "רעיון", "s": 9.3, "e": 9.72}, {"t": "חדש.", "s": 9.72, "e": 10.18}]}, {"start": 10.34, "end": 11.8, "text": "היא אומרת את אותו", "words": [{"t": "היא", "s": 10.34, "e": 10.8}, {"t": "אומרת", "s": 10.8, "e": 11.24}, {"t": "את", "s": 11.24, "e": 11.36}, {"t": "אותו", "s": 11.36, "e": 11.68}]}, {"start": 11.68, "end": 13.82, "text": "דבר במילים אחרות, או", "words": [{"t": "דבר", "s": 11.68, "e": 12.14}, {"t": "במילים", "s": 12.14, "e": 12.78}, {"t": "אחרות,", "s": 12.78, "e": 13.32}, {"t": "או", "s": 13.32, "e": 13.7}]}, {"start": 13.7, "end": 15.42, "text": "מביאה מקרה פרטי שלו.", "words": [{"t": "מביאה", "s": 13.7, "e": 14.2}, {"t": "מקרה", "s": 14.2, "e": 14.56}, {"t": "פרטי", "s": 14.56, "e": 15.02}, {"t": "שלו.", "s": 15.02, "e": 15.3}]}, {"start": 15.74, "end": 16.66, "text": "מסיח.", "words": [{"t": "מסיח.", "s": 15.74, "e": 16.54}]}, {"start": 16.86, "end": 18.56, "text": "היא הגיעה בשלום.", "words": [{"t": "היא", "s": 16.86, "e": 17.28}, {"t": "הגיעה", "s": 17.28, "e": 17.88}, {"t": "בשלום.", "s": 17.88, "e": 18.44}]}, {"start": 18.92, "end": 20.38, "text": "נשמע טוב, אבל", "words": [{"t": "נשמע", "s": 18.92, "e": 19.34}, {"t": "טוב,", "s": 19.34, "e": 19.54}, {"t": "אבל", "s": 19.74, "e": 20.26}]}, {"start": 20.26, "end": 21.2, "text": "זו תוצאה.", "words": [{"t": "זו", "s": 20.26, "e": 20.54}, {"t": "תוצאה.", "s": 20.54, "e": 21.08}]}, {"start": 21.3, "end": 23.38, "text": "תוצאה היא רעיון חדש.", "words": [{"t": "תוצאה", "s": 21.3, "e": 22.14}, {"t": "היא", "s": 22.14, "e": 22.26}, {"t": "רעיון", "s": 22.26, "e": 22.68}, {"t": "חדש.", "s": 22.68, "e": 23.26}]}, {"start": 23.28, "end": 25.34, "text": "היא מתאימה אחרי ולכן,", "words": [{"t": "היא", "s": 23.28, "e": 23.56}, {"t": "מתאימה", "s": 23.56, "e": 23.96}, {"t": "אחרי", "s": 23.96, "e": 24.34}, {"t": "ולכן,", "s": 24.34, "e": 25.22}]}, {"start": 25.24, "end": 26.56, "text": "לא אחרי כלומר.", "words": [{"t": "לא", "s": 25.24, "e": 25.7}, {"t": "אחרי", "s": 25.7, "e": 26.06}, {"t": "כלומר.", "s": 26.06, "e": 26.44}]}, {"start": 27.02, "end": 27.72, "text": "ומה כן?", "words": [{"t": "ומה", "s": 27.02, "e": 27.44}, {"t": "כן?", "s": 27.44, "e": 27.6}]}, {"start": 27.6, "end": 29.6, "text": "היא הורידה מהירות", "words": [{"t": "היא", "s": 27.6, "e": 28.42}, {"t": "הורידה", "s": 28.42, "e": 28.94}, {"t": "מהירות", "s": 28.94, "e": 29.48}]}, {"start": 29.48, "end": 30.82, "text": "לפני כל צומת.", "words": [{"t": "לפני", "s": 29.48, "e": 29.9}, {"t": "כל", "s": 29.9, "e": 30.16}, {"t": "צומת.", "s": 30.16, "e": 30.7}]}, {"start": 31.14, "end": 32.68, "text": "זו הזהירות עצמה,", "words": [{"t": "זו", "s": 31.14, "e": 31.62}, {"t": "הזהירות", "s": 31.62, "e": 32.1}, {"t": "עצמה,", "s": 32.1, "e": 32.56}]}, {"start": 32.6, "end": 33.8, "text": "במקרה פרטי.", "words": [{"t": "במקרה", "s": 32.6, "e": 33.24}, {"t": "פרטי.", "s": 33.24, "e": 33.68}]}, {"start": 34.3, "end": 36.8, "text": "אחרי כלומר, החלל חוזר", "words": [{"t": "אחרי", "s": 34.3, "e": 34.78}, {"t": "כלומר,", "s": 34.78, "e": 35.26}, {"t": "החלל", "s": 35.38, "e": 36.02}, {"t": "חוזר", "s": 36.