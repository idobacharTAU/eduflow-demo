{"slug": "psyv_sc_connotation_judgment", "duration": 37.64, "cues": [{"start": 0, "end": 2.3, "text": "עקשן ומתמיד מתארים", "words": [{"t": "עקשן", "s": 0, "e": 0.68}, {"t": "ומתמיד", "s": 0.68, "e": 1.38}, {"t": "מתארים", "s": 1.38, "e": 2.18}]}, {"start": 2.18, "end": 3.62, "text": "אותו אדם, אבל", "words": [{"t": "אותו", "s": 2.18, "e": 2.5}, {"t": "אדם,", "s": 2.5, "e": 3.06}, {"t": "אבל", "s": 3.08, "e": 3.5}]}, {"start": 3.5, "end": 4.74, "text": "לא אותו שיפוט.", "words": [{"t": "לא", "s": 3.5, "e": 3.94}, {"t": "אותו", "s": 3.94, "e": 4.22}, {"t": "שיפוט.", "s": 4.22, "e": 4.62}]}, {"start": 4.94, "end": 6.54, "text": "שניהם לא מוותרים.", "words": [{"t": "שניהם", "s": 4.94, "e": 5.78}, {"t": "לא", "s": 5.78, "e": 5.96}, {"t": "מוותרים.", "s": 5.96, "e": 6.42}]}, {"start": 6.72, "end": 8.52, "text": "מתמיד זו מחמאה,", "words": [{"t": "מתמיד", "s": 6.72, "e": 7.56}, {"t": "זו", "s": 7.56, "e": 7.86}, {"t": "מחמאה,", "s": 7.86, "e": 8.4}]}, {"start": 8.42, "end": 10.06, "text": "עקשן זו ביקורת.", "words": [{"t": "עקשן", "s": 8.42, "e": 9.1}, {"t": "זו", "s": 9.1, "e": 9.52}, {"t": "ביקורת.", "s": 9.52, "e": 9.94}]}, {"start": 10.1, "end": 11.72, "text": "זו משמעות לוואי:", "words": [{"t": "זו", "s": 10.1, "e": 10.74}, {"t": "משמעות", "s": 10.74, "e": 11.28}, {"t": "לוואי:", "s": 11.28, "e": 11.6}]}, {"start": 11.76, "end": 14.16, "text": "הגדרה דומה, שיפוט שונה.", "words": [{"t": "הגדרה", "s": 11.76, "e": 12.48}, {"t": "דומה,", "s": 12.48, "e": 12.96}, {"t": "שיפוט", "s": 12.98, "e": 13.68}, {"t": "שונה.", "s": 13.68, "e": 14.04}]}, {"start": 14.16, "end": 16.06, "text": "וכך גם קמצן", "words": [{"t": "וכך", "s": 14.16, "e": 14.98}, {"t": "גם", "s": 14.98, "e": 15.14}, {"t": "קמצן", "s": 15.14, "e": 15.94}]}, {"start": 15.94, "end": 18.04, "text": "וחסכן, פתי ותמים.", "words": [{"t": "וחסכן,", "s": 15.94, "e": 16.76}, {"t": "פתי", "s": 17.1, "e": 17.54}, {"t": "ותמים.", "s": 17.54, "e": 17.92}]}, {"start": 18.58, "end": 20.4, "text": "איך בוחרים בשאלת השלמה?", 