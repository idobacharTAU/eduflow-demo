{"slug": "psyv_sc_escalation_family", "duration": 39.8, "cues": [{"start": 0.0, "end": 1.858, "text": "לא זו בלבד שהחוקרים", "words": [{"t": "לא", "s": 0.0, "e": 0.368}, {"t": "זו", "s": 0.368, "e": 0.755}, {"t": "בלבד", "s": 0.755, "e": 1.297}, {"t": "שהחוקרים", "s": 1.297, "e": 1.858}]}, {"start": 1.858, "end": 3.543, "text": "לא הפריכו את ההשערה.", "words": [{"t": "לא", "s": 1.858, "e": 2.149}, {"t": "הפריכו", "s": 2.149, "e": 2.943}, {"t": "את", "s": 2.943, "e": 3.059}, {"t": "ההשערה.", "s": 3.059, "e": 3.543}]}, {"start": 3.659, "end": 5.363, "text": "אלא שממצאיהם אף,", "words": [{"t": "אלא", "s": 3.659, "e": 4.259}, {"t": "שממצאיהם", "s": 4.259, "e": 5.014}, {"t": "אף,", "s": 5.014, "e": 5.363}]}, {"start": 5.44, "end": 7.55, "text": "וכאן החלל, אותה.", "words": [{"t": "וכאן", "s": 5.44, "e": 6.176}, {"t": "החלל,", "s": 6.176, "e": 6.582}, {"t": "אותה.", "s": 6.698, "e": 7.55}]}, {"start": 8.015, "end": 8.75, "text": "חמש שניות.", "words": [{"t": "חמש", "s": 8.015, "e": 8.441}, {"t": "שניות.", "s": 8.441, "e": 8.75}]}, {"start": 9.505, "end": 10.744, "text": "בחרת החלישו?", "words": [{"t": "בחרת", "s": 9.505, "e": 9.931}, {"t": "החלישו?", "s": 9.931, "e": 10.744}]}, {"start": 11.228, "end": 13.861, "text": "זיהית ציר נכון, והפכת סימן.", "words": [{"t": "זיהית", "s": 11.228, "e": 11.654}, {"t": "ציר", "s": 11.654, "e": 12.1}, {"t": "נכון,", "s": 12.1, "e": 12.506}, {"t": "והפכת", "s": 12.506, "e": 13.435}, {"t": "סימן.", "s": 13.435, "e": 13.861}]}, {"start": 14.074, "end": 15.894, "text": "המבנה הזה הוא הגברה.", "words": [{"t": "המבנה", "s": 14.074, "e": 14.868}, {"t": "הזה", "s": 14.868, "e": 15.042}, {"t": "הוא", "s": 15.042, "e": 15.216}, {"t": "הגברה.", "s": 15.216, "e": 15.894}]}, {"start": 15.952, "end": 18.585, "text": "החלק השני מסלים באותו כיוון.", "words": [{"t": "החלק", "s": 15.952, "e": 16.552}, {"t": "השני", "s": 16.552, "e": 16.901}, {"t": "מסלים", "s": 16.901, "e": 17.501}, {"t": "באותו", "s": 17.501, "e": 18.198}, {"t": "כיוון.", "s": 18.198, "e": 18.585}]}, {"start": 18.682, "end": 21.779, "text": "לא הפריכו פירושו שההשערה שרדה.", "words": [{"t": "לא", "s": 18.682, "e": 19.475}, {"t": "הפריכו", "s": 19.475, "e": 20.076}, {"t": "פירושו", "s": 20.076, "e": 20.637}, {"t": "שההשערה", "s": 20.637, "e": 21.256}, {"t": "שרדה.", "s": 21.256, "e": 21.779}]}, {"start": 21.915, "end": 23.154, "text": "שרידה היא כיוון", "words": [{"t": "שרידה", "s": 21.915, "e": 22.747}, {"t": "היא", "s": 22.747, "e": 22.863}, {"t": "כיוון", "s": 22.863, "e": 23.154}]}, {"start": 23.154, "end": 24.683, "text": "חיובי, אך חלש.", "words": [{"t": "חיובי,", "s": 23.154, "e": 23.676}, {"t": "אך", "s": 23.715, "e": 24.141}, {"t": "חלש.", "s": 24.141, "e": 24.683}]}, {"start": 25.09, "end": 27.684, "text": "להחליש זה צעד לכיוון ההפרכה.", "words": [{"t": "להחליש", "s": 25.09, "e": 25.941}, {"t": "זה", "s": 25.941, "e": 26.116}, {"t": "צעד", "s": 26.116, "e": 26.522}, {"t": "לכיוון", "s": 26.522, "e": 26.948}, {"t": "ההפרכה.", "s": 26.948, "e": 27.684}]}, {"start": 27.993, "end": 31.013, "text": "הזכירו ניטרלי, ולא מדרגה נוספת.", "words": [{"t": "הזכירו", "s": 27.993, "e": 28.884}, {"t": "ניטרלי,", "s": 28.884, "e": 29.678}, {"t": "ולא", "s": 29.678, "e": 30.181}, {"t": "מדרגה", "s": 30.181, "e": 30.51}, {"t": "נוספת.", "s": 30.51, "e": 31.013}]}, {"start": 31.226, "end": 32.891, "text": "ייתרו עובר לציר", "words": [{"t": "ייתרו", "s": 31.226, "e": 31.981}, {"t": "עובר", "s": 31.981, "e": 32.582}, {"t": "לציר", "s": 32.582, "e": 32.891}]}, {"start": 32.891, "end": 34.479, "text": "הנחיצות, לא הנכונות.", "words": [{"t": "הנחיצות,", "s": 32.891, "e": 33.53}, {"t": "לא", "s": 33.627, "e": 33.917}, {"t": "הנכונות.", "s": 33.917, "e": 34.479}]}, {"start": 34.576, "end": 36.357, "text": "נשארה חיזקו.", "words": [{"t": "נשארה", "s": 34.576, "e": 35.582}, {"t": "חיזקו.", "s": 35.582, "e": 36.357}]}, {"start": 36.782, "end": 39.435, "text": "שאלו כיוון, ואחריו עוצמה.", "words": [{"t": "שאלו", "s": 36.782, "e": 37.286}, {"t": "כיוון,", "s": 37.286, "e": 37.731}, {"t": "ואחריו", "s": 37.731, "e": 38.602}, {"t": "עוצמה.", "s": 38.602, "e": 39.435}]}]}
