{"slug": "psyv_sc_pairs_not_words", "duration": 39.8, "cues": [{"start": 0.0, "end": 3.405, "text": "הדוח היה, וכאן חלל, בפרטים.", "words": [{"t": "הדוח", "s": 0.0, "e": 0.755}, {"t": "היה,", "s": 0.755, "e": 1.316}, {"t": "וכאן", "s": 1.354, "e": 2.128}, {"t": "חלל,", "s": 2.128, "e": 2.515}, {"t": "בפרטים.", "s": 2.612, "e": 3.405}]}, {"start": 3.56, "end": 5.185, "text": "כמעט כל טענה", "words": [{"t": "כמעט", "s": 3.56, "e": 4.45}, {"t": "כל", "s": 4.45, "e": 4.702}, {"t": "טענה", "s": 4.702, "e": 5.185}]}, {"start": 5.185, "end": 6.288, "text": "בו נתמכה בטבלה.", "words": [{"t": "בו", "s": 5.185, "e": 5.359}, {"t": "נתמכה", "s": 5.359, "e": 5.843}, {"t": "בטבלה.", "s": 5.843, "e": 6.288}]}, {"start": 6.559, "end": 8.997, "text": "ואולם מסקנתו נותרה,", "words": [{"t": "ואולם", "s": 6.559, "e": 7.449}, {"t": "מסקנתו", "s": 7.449, "e": 8.494}, {"t": "נותרה,", "s": 8.494, "e": 8.997}]}, {"start": 9.055, "end": 10.351, "text": "וכאן חלל נוסף.", "words": [{"t": "וכאן", "s": 9.055, "e": 9.732}, {"t": "חלל", "s": 9.732, "e": 9.984}, {"t": "נוסף.", "s": 9.984, "e": 10.351}]}, {"start": 10.99, "end": 12.886, "text": "ואולם היא מילת ניגוד.", "words": [{"t": "ואולם", "s": 10.99, "e": 11.88}, {"t": "היא", "s": 11.88, "e": 12.131}, {"t": "מילת", "s": 12.131, "e": 12.518}, {"t": "ניגוד.", "s": 12.518, "e": 12.886}]}, {"start": 13.021, "end": 14.221, "text": "אבל ניגוד למה?", "words": [{"t": "אבל", "s": 13.021, "e": 13.602}, {"t": "ניגוד", "s": 13.602, "e": 13.95}, {"t": "למה?", "s": 13.95, "e": 14.221}]}, {"start": 14.472, "end": 16.543, "text": "אחרי דל, המילה", "words": [{"t": "אחרי", "s": 14.472, "e": 15.362}, {"t": "דל,", "s": 15.362, "e": 15.846}, {"t": "המילה", "s": 15.904, "e": 16.543}]}, {"start": 16.543, "end": 17.974, "text": "חדה יוצרת ניגוד.", "words": [{"t": "חדה", "s": 16.543, "e": 17.007}, {"t": "יוצרת", "s": 17.007, "e": 17.587}, {"t": "ניגוד.", "s": 17.587, "e": 17.974}]}, {"start": 18.09, "end": 21.012, "text": "אחרי עשיר, מעורפלת יוצרת אותו.", "words": [{"t": "אחרי", "s": 18.09, "e": 18.864}, {"t": "עשיר,", "s": 18.864, "e": 19.464}, {"t": "מעורפלת", "s": 19.503, "e": 20.354}, {"t": "יוצרת", "s": 20.354, "e": 20.838}, {"t": "אותו.", "s": 20.838, "e": 21.012}]}, {"start": 21.012, "end": 23.121, "text": "כאן אי אפשר לשפוט", "words": [{"t": "כאן", "s": 21.012, "e": 22.134}, {"t": "אי", "s": 22.134, "e": 22.444}, {"t": "אפשר", "s": 22.444, "e": 22.715}, {"t": "לשפוט", "s": 22.715, "e": 23.121}]}, {"start": 23.121, "end": 24.34, "text": "את החלל הסוגר לבדו.", "words": [{"t": "את", "s": 23.121, "e": 23.198}, {"t": "החלל", "s": 23.198, "e": 23.527}, {"t": "הסוגר", "s": 23.527, "e": 23.933}, {"t": "לבדו.", "s": 23.933, "e": 24.34}]}, {"start": 24.417, "end": 25.868, "text": "מה שנבדק הוא", "words": [{"t": "מה", "s": 24.417, "e": 24.998}, {"t": "שנבדק", "s": 24.998, "e": 25.636}, {"t": "הוא", "s": 25.636, "e": 25.868}]}, {"start": 25.868, "end": 27.01, "text": "הקשר בין האיברים.", "words": [{"t": "הקשר", "s": 25.868, "e": 26.429}, {"t": "בין", "s": 26.429, "e": 26.681}, {"t": "האיברים.", "s": 26.681, "e": 27.01}]}, {"start": 27.223, "end": 29.718, "text": "לכן בודקים זוגות, לא מילים.", "words": [{"t": "לכן", "s": 27.223, "e": 28.016}, {"t": "בודקים", "s": 28.016, "e": 28.422}, {"t": "זוגות,", "s": 28.422, "e": 28.945}, {"t": "לא", "s": 29.022, "e": 29.332}, {"t": "מילים.", "s": 29.332, "e": 29.718}]}, {"start": 30.144, "end": 31.518, "text": "הטבלאות קובעות:", "words": [{"t": "הטבלאות", "s": 30.144, "e": 30.937}, {"t": "קובעות:", "s": 30.937, "e": 31.518}]}, {"start": 31.537, "end": 32.988, "text": "הדוח עשיר.", "words": [{"t": "הדוח", "s": 31.537, "e": 32.35}, {"t": "עשיר.", "s": 32.35, "e": 32.988}]}, {"start": 33.24, "end": 36.2, "text": "והזוג עשיר ומעורפלת הוא התשובה.", "words": [{"t": "והזוג", "s": 33.24, "e": 34.033}, {"t": "עשיר", "s": 34.033, "e": 34.633}, {"t": "ומעורפלת", "s": 34.633, "e": 35.368}, {"t": "הוא", "s": 35.368, "e": 35.755}, {"t": "התשובה.", "s": 35.755, "e": 36.2}]}, {"start": 36.452, "end": 38.619, "t