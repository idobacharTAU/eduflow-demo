{"slug": "psyv_snc_not_all_drops_the_edge", "duration": 37.62, "cues": [{"start": 0.0, "end": 2.4, "text": "איש לא, או לא כולם?", "words": [{"t": "איש", "s": 0.0, "e": 0.56}, {"t": "לא,", "s": 0.56, "e": 0.76}, {"t": "או", "s": 0.76, "e": 1.52}, {"t": "לא", "s": 1.52, "e": 2.0}, {"t": "כולם?", "s": 2.0, "e": 2.4}]}, {"start": 2.78, "end": 5.74, "text": "ההחלטה התקבלה, וכאן החלל.", "words": [{"t": "ההחלטה", "s": 2.78, "e": 3.66}, {"t": "התקבלה,", "s": 3.66, "e": 4.22}, {"t": "וכאן", "s": 4.28, "e": 5.16}, {"t": "החלל.", "s": 5.16, "e": 5.74}]}, {"start": 5.92, "end": 7.46, "text": "שכן לא כל חברי", "words": [{"t": "שכן", "s": 5.92, "e": 6.58}, {"t": "לא", "s": 6.58, "e": 6.72}, {"t": "כל", "s": 6.72, "e": 6.98}, {"t": "חברי", "s": 6.98, "e": 7.46}]}, {"start": 7.46, "end": 8.52, "text": "הוועד תמכו בה.", "words": [{"t": "הוועד", "s": 7.46, "e": 7.92}, {"t": "תמכו", "s": 7.92, "e": 8.36}, {"t": "בה.", "s": 8.36, "e": 8.52}]}, {"start": 8.8, "end": 11.14, "text": "המילה כל קופצת לעין,", "words": [{"t": "המילה", "s": 8.8, "e": 9.42}, {"t": "כל", "s": 9.42, "e": 9.66}, {"t": "קופצת", "s": 9.66, "e": 10.76}, {"t": "לעין,", "s": 10.76, "e": 11.14}]}, {"start": 11.22, "end": 12.86, "text": "ואיתה פה אחד.", "words": [{"t": "ואיתה", "s": 11.22, "e": 11.9}, {"t": "פה", "s": 11.9, "e": 12.5}, {"t": "אחד.", "s": 12.5, "e": 12.86}]}, {"start": 13.22, "end": 14.32, "text": "זו המלכודת:", "words": [{"t": "זו", "s": 13.22, "e": 13.8}, {"t": "המלכודת:", "s": 13.8, "e": 14.32}]}, {"start": 14.44, "end": 15.64, "text": "רפלקס הקצה.", "words": [{"t": "רפלקס", "s": 14.44, "e": 15.24}, {"t": "הקצה.", "s": 15.24, "e": 15.64}]}, {"start": 15.74, "end": 17.68, "text": "אבל סדר המילים קובע.", "words": [{"t": "אבל", "s": 15.74, "e": 16.3}, {"t": "סדר", "s": 16.3, "e": 16.7}, {"t": "המילים", "s": 16.7, "e": 17.24}, {"t": "קובע.", "s": 17.24, "e": 17.68}]}, {"start": 17.8, "end": 19.54, "text": "איש לא התנגד", "words": [{"t": "איש", "s": 17.8, "e": 18.64}, {"t": "לא", "s": 18.64, "e": 18.9}, {"t": "התנגד", "s": 18.9, "e": 19.54}]}, {"start": 19.54, "end": 20.86, "text": "נועל את הקצה.", "words": [{"t": "נועל", "s": 19.54, "e": 20.32}, {"t": "את", "s": 20.32, "e": 20.46}, {"t": "הקצה.", "s": 20.46, "e": 20.86}]}, {"start": 20.96, "end": 23.18, "text": "לא כולם תמכו רק", "words": [{"t": "לא", "s": 20.96, "e": 21.66}, {"t": "כולם", "s": 21.66, "e": 22.18}, {"t": "תמכו", "s": 22.18, "e": 22.64}, {"t": "רק", "s": 22.74, "e": 23.18}]}, {"start": 23.18, "end": 24.08, "text": "שולל את הכלל.", "words": [{"t": "שולל", "s": 23.18, "e": 23.66}, {"t": "את", "s": 23.66, "e": 23.76}, {"t": "הכלל.", "s": 23.76, "e": 24.08}]}, {"start": 24.26, "end": 27.28, "text": "ופה אחד סותר אותו ישירות.", "words": [{"t": "ופה", "s": 24.26, "e": 25.14}, {"t": "אחד", "s": 25.14, "e": 25.48}, {"t": "סותר", "s": 25.48, "e": 26.28}, {"t": "אותו", "s": 26.28, "e": 26.52}, {"t": "ישירות.", "s": 26.52, "e": 27.28}]}, {"start": 27.28, "end": 30.62, "text": "באיחור ובהפתעה יוצאות מהציר.", "words": [{"t": "באיחור", "s": 27.28, "e": 28.56}, {"t": "ובהפתעה", "s": 28.56, "e": 29.3}, {"t": "יוצאות", "s": 29.3, "e": 30.14}, {"t": "מהציר.", "s": 30.14, "e": 30.62}]}, {"start": 30.68, "end": 31.66, "text": "נשאר:", "words": [{"t": "נשאר:", "s": 30.68, "e": 31.66}]}, {"start": 31.66, "end": 33.1, "text": "ברוב קולות.", "words": [{"t": "ברוב", "s": 31.66, "e": 32.66}, {"t": "קולות.", "s": 32.66, "e": 33.1}]}, {"start": 33.36, "end": 35.08, "text": "כשהשלילה באה לפני", "words": [{"t": "כשהשלילה", "s": 33.36, "e": 34.36}, {"t": "באה", "s": 34.36, "e": 34.58}, {"t": "לפני", "s": 34.58, "e": 35.08}]}, {"start": 35.08, "end": 37.22, "text": "כל, הקצה נופל.", "words": [{"t": "כל,", "s": 35.08, "e": 35.48}, {"t": "הקצה", "s": 35.5, "e": 36.5}, {"t": "נופל.", "s": 36.5, "e": 37.22}]}], "captions_default": "off", "text_load": {"mean_visible_words": 23.5, "threshold": 20.0}}
