{"slug": "psyv_strengthen_street_without_bumps", "duration": 33.68, "cues": [{"start": 0.0, "end": 1.54, "text": "איזה נתון מחזק", "words": [{"t": "איזה", "s": 0.0, "e": 0.54}, {"t": "נתון", "s": 0.54, "e": 0.9}, {"t": "מחזק", "s": 0.9, "e": 1.54}]}, {"start": 1.54, "end": 2.54, "text": "את פסי ההאטה?", "words": [{"t": "את", "s": 1.54, "e": 1.7}, {"t": "פסי", "s": 1.7, "e": 2.08}, {"t": "ההאטה?", "s": 2.08, "e": 2.54}]}, {"start": 2.76, "end": 5.12, "text": "ברחוב הגפן הותקנו פסי האטה.", "words": [{"t": "ברחוב", "s": 2.76, "e": 3.52}, {"t": "הגפן", "s": 3.52, "e": 4.0}, {"t": "הותקנו", "s": 4.0, "e": 4.38}, {"t": "פסי", "s": 4.38, "e": 4.74}, {"t": "האטה.", "s": 4.74, "e": 5.12}]}, {"start": 5.2, "end": 7.46, "text": "מאז ירדו התאונות ברחוב.", "words": [{"t": "מאז", "s": 5.2, "e": 5.94}, {"t": "ירדו", "s": 5.94, "e": 6.48}, {"t": "התאונות", "s": 6.48, "e": 6.94}, {"t": "ברחוב.", "s": 6.94, "e": 7.46}]}, {"start": 7.64, "end": 8.4, "text": "המסקנה:", "words": [{"t": "המסקנה:", "s": 7.64, "e": 8.4}]}, {"start": 8.52, "end": 10.54, "text": "הפסים הורידו את התאונות.", "words": [{"t": "הפסים", "s": 8.52, "e": 9.28}, {"t": "הורידו", "s": 9.28, "e": 9.84}, {"t": "את", "s": 9.84, "e": 9.96}, {"t": "התאונות.", "s": 9.96, "e": 10.54}]}, {"start": 11.02, "end": 11.92, "text": "נתון מפתה:", "words": [{"t": "נתון", "s": 11.02, "e": 11.4}, {"t": "מפתה:", "s": 11.4, "e": 11.92}]}, {"start": 12.12, "end": 13.7, "text": "באותו חורף ירד", "words": [{"t": "באותו", "s": 12.12, "e": 12.88}, {"t": "חורף", "s": 12.88, "e": 13.38}, {"t": "ירד", "s": 13.38, "e": 13.7}]}, {"start": 13.7, "end": 15.36, "text": "שלג, והנסיעה הואטה.", "words": [{"t": "שלג,", "s": 13.7, "e": 14.22}, {"t": "והנסיעה", "s": 14.22, "e": 14.94}, {"t": "הואטה.", "s": 14.94, "e": 15.36}]}, {"start": 15.94, "end": 17.16, "text": "נשמע קשור, אבל", "words": [{"t": "נשמע", "s": 15.94, "e": 16.32}, {"t": "קשור,", "s": 16.32, "e": 16.82}, {"t": "אבל", "s": 16.86, "e": 17.16}]}, {"start": 17.16, "end": 18.08, "text": "זה הסבר