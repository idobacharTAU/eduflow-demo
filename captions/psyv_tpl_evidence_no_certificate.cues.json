{"slug": "psyv_tpl_evidence_no_certificate", "duration": 33.56, "cues": [{"start": 0.0, "end": 1.74, "text": "מה בהכרח נכון?", "words": [{"t": "מה", "s": 0.0, "e": 0.46}, {"t": "בהכרח", "s": 0.46, "e": 1.24}, {"t": "נכון?", "s": 1.24, "e": 1.74}]}, {"start": 2.32, "end": 4.28, "text": "רון לא קיבל תעודה.", "words": [{"t": "רון", "s": 2.32, "e": 2.72}, {"t": "לא", "s": 2.72, "e": 3.28}, {"t": "קיבל", "s": 3.28, "e": 3.88}, {"t": "תעודה.", "s": 3.88, "e": 4.28}]}, {"start": 4.84, "end": 6.08, "text": "כל מי שעבר את", "words": [{"t": "כל", "s": 4.84, "e": 5.24}, {"t": "מי", "s": 5.24, "e": 5.56}, {"t": "שעבר", "s": 5.56, "e": 5.92}, {"t": "את", "s": 5.92, "e": 6.08}]}, {"start": 6.08, "end": 7.64, "text": "המבחן קיבל תעודה.", "words": [{"t": "המבחן", "s": 6.08, "e": 6.56}, {"t": "קיבל", "s": 6.56, "e": 7.26}, {"t": "תעודה.", "s": 7.26, "e": 7.64}]}, {"start": 7.92, "end": 9.18, "text": "הקפיצה המהירה:", "words": [{"t": "הקפיצה", "s": 7.92, "e": 8.72}, {"t": "המהירה:", "s": 8.72, "e": 9.18}]}, {"start": 9.24, "end": 11.42, "text": "רון נכשל בכל המבחנים.", "words": [{"t": "רון", "s": 9.24, "e": 9.9}, {"t": "נכשל", "s": 9.9, "e": 10.46}, {"t": "בכל", "s": 10.46, "e": 10.94}, {"t": "המבחנים.", "s": 10.94, "e": 11.42}]}, {"start": 11.66, "end": 13.06, "text": "ואם רון עבר?", "words": [{"t": "ואם", "s": 11.66, "e": 12.46}, {"t": "רון", "s": 12.46, "e": 12.72}, {"t": "עבר?", "s": 12.72, "e": 13.06}]}, {"start": 13.12, "end": 14.36, "text": "סותר את הנתון.", "words": [{"t": "סותר", "s": 13.12, "e": 13.9}, {"t": "את", "s": 13.9, "e": 14.08}, {"t": "הנתון.", "s": 14.08, "e": 14.36}]}, {"start": 14.76, "end": 16.2, "text": "עוברים בלי תעודה?", "words": [{"t": "עוברים", "s": 14.76, "e": 15.42}, {"t": "בלי", "s": 15.42, "e": 15.9}, {"t": "תעודה?", "s": 15.9, "e": 16.2}]}, {"start": 16.34, "end": 17.38, "text": "גם סותר.", "words": [{"t": "גם", "s": 16.34, "e": 17.02}, {"t": "סותר.", "s": 17.02, "e": 17.38}]}, {"start": 17.86, "end": 19.02, "text": "ומבחן אחר?", "words": [{"t": "ומבחן", "s": 17.86, "e": 18.66}, {"t": "אחר?", "s": 18.66, "e": 19.02}]}, {"start": 19.04, "end": 20.86, "text": "הנתון לא אומר עליו דבר.", "words": [{"t": "הנתון", "s": 19.04, "e": 19.94}, {"t": "לא", "s": 19.94, "e": 20.12}, {"t": "אומר", "s": 20.12, "e": 20.38}, {"t": "עליו", "s": 20.38, "e": 20.62}, {"t": "דבר.", "s": 20.62, "e": 20.86}]}, {"start": 21.0, "end": 23.48, "text": "אז ההכללה על כל המבחנים?", "words": [{"t": "אז", "s": 21.0, "e": 21.72}, {"t": "ההכללה", "s": 21.72, "e": 22.3}, {"t": "על", "s": 22.3, "e": 22.5}, {"t": "כל", "s": 22.5, "e": 22.84}, {"t": "המבחנים?", "s": 22.84, "e": 23.48}]}, {"start": 23.76, "end": 25.24, "text": "לא מאולצת.", "words": [{"t": "לא", "s": 23.76, "e": 24.16}, {"t": "מאולצת.", "s": 24.24, "e": 25.24}]}, {"start": 25.28, "end": 25.94, "text": "נפסלת.", "words": [{"t": "נפסלת.", "s": 25.28, "e": 25.94}]}, {"start": 26.3, "end": 27.1, "text": "התשובה:", "words": [{"t": "התשובה:", "s": 26.3, "e": 27.1}]}, {"start": 27.16, "end": 29.66, "text": "רון לא עבר את המבחן.", "words": [{"t": "רון", "s": 27.16, "e": 27.96}, {"t": "לא", "s": 27.96, "e": 28.5}, {"t": "עבר", "s": 28.5, "e": 28.98}, {"t": "את", "s": 28.98, "e": 29.14}, {"t": "המבחן.", "s": 29.14, "e": 29.66}]}, {"start": 30.0, "end": 31.36, "text": "לכן מי שלא קיבל", "words": [{"t": "לכן", "s": 30.0, "e": 30.44}, {"t": "מי", "s": 30.44, "e": 30.76}, {"t": "שלא", "s": 30.76, "e": 31.04}, {"t": "קיבל", "s": 31.04, "e": 31.36}]}, {"start": 31.36, "end": 33.16, "text": "תעודה, בהכרח לא עבר.", "words": [{"t": "תעודה,", "s": 31.36, "e": 31.7}, {"t": "בהכרח", "s": 31.7, "e": 32.78}, {"t": "לא", "s": 32.78, "e": 32.9}, {"t": "עבר.", "s": 32.9, "e": 33.16}]}], "captions_default": "off", "text_load": {"mean_visible_words": 20.3, "threshold": 20.0}}
