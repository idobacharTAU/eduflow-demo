{"slug": "psyv_weaken_the_link", "duration": 39.94, "cues": [{"start": 0, "end": 2.62, "text": "בעיר נסללו מסלולי אופניים.", "words": [{"t": "בעיר", "s": 0, "e": 0.66}, {"t": "נסללו", "s": 0.66, "e": 1.24}, {"t": "מסלולי", "s": 1.24, "e": 1.84}, {"t": "אופניים.", "s": 1.84, "e": 2.5}]}, {"start": 2.52, "end": 4.48, "text": "מאז עלה מספר", "words": [{"t": "מאז", "s": 2.52, "e": 3.28}, {"t": "עלה", "s": 3.28, "e": 3.9}, {"t": "מספר", "s": 3.9, "e": 4.36}]}, {"start": 4.36, "end": 5.64, "text": "תאונות האופניים.", "words": [{"t": "תאונות", "s": 4.36, "e": 4.92}, {"t": "האופניים.", "s": 4.92, "e": 5.52}]}, {"start": 6.05, "end": 9.06, "text": "המסקנה בשאלה, המסלולים מסוכנים.", "words": [{"t": "המסקנה", "s": 6.05, "e": 6.54}, {"t": "בשאלה,", "s": 6.54, "e": 7.1}, {"t": "המסלולים", "s": 7.18, "e": 8.14}, {"t": "מסוכנים.", "s": 8.14, "e": 8.94}]}, {"start": 9.65, "end": 11.28, "text": "איזו עובדה מחלישה", "words": [{"t": "איזו", "s": 9.65, "e": 10.14}, {"t": "עובדה", "s": 10.14, "e": 10.44}, {"t": "מחלישה", "s": 10.44, "e": 11.16}]}, {"start": 11.16, "end": 11.8, "text": "את המסקנה?", "words": [{"t": "את", "s": 11.16, "e": 11.26}, {"t": "המסקנה?", "s": 11.26, "e": 11.68}]}, {"start": 11.86, "end": 13.68, "text": "יש לך שלוש שניות.", "words": [{"t": "יש", "s": 11.86, "e": 12.54}, {"t": "לך", "s": 12.54, "e": 12.76}, {"t": "שלוש", "s": 12.76, "e": 13.22}, {"t": "שניות.", "s": 13.22, "e": 13.56}]}, {"start": 16.66, "end": 18.56, "text": "הרוכבים חובשים קסדה.", "words": [{"t": "הרוכבים", "s": 16.66, "e": 17.64}, {"t": "חובשים", "s": 17.64, "e": 18}, {"t": "קסדה.", "s": 18, "e": 18.44}]}, {"start": 18.48, "end": 20.16, "text": "נכון, אבל לא", "words": [{"t": "נכון,", "s": 18.48, "e": 19.3}, {"t": "אבל", "s": 19.3, "e": 19.78}, {"t": "לא", "s": 19.78, "e": 20.04}]}, {"start": 20.04, "end": 20.94, "text": "נוגע במסקנה.", "words": [{"t": "נוגע", "s": 20.04, "e": 20.32}, {"t": "במסקנה.", "s": 20.32, "e": 20.82}]}, {"start": 20.82, "end": 22.96, "text": "גם תאונות הרכב עלו.", "words": [{"t": "גם", "s": 20.82, "e": 21.66}, {"t": "תאונות", "s": 21.66, "e": 22.18}, {"t": "הרכב", "s": 22.18, "e": 22.64}, {"t": "עלו.", "s": 22.64, "e": 22.84}]}, {"start": 22.86, "end": 24.5, "text": "זה כבר נושא אחר.", "words": [{"t": "זה", "s": 22.86, "e": 23.4}, {"t": "כבר", "s": 23.4, "e": 23.72}, {"t": "נושא", "s": 23.72, "e": 24}, {"t": "אחר.", "s": 24, "e": 24.38}]}, {"start": 24.88, "end": 26.82, "text": "המסלולים נסללו בקיץ.", "words": [{"t": "המסלולים", "s": 24.88, "e": 25.64}, {"t": "נסללו", "s": 25.64, "e": 26.14}, {"t": "בקיץ.", "s": 26.14, "e": 26.7}]}, {"start": 26.78, "end": 28.48, "text": "עובדה בלי שום כיוון.", "words": [{"t": "עובדה", "s": 26.78, "e": 27.52}, {"t": "בלי", "s": 27.52, "e": 27.76}, {"t": "שום", "s": 27.76, "e": 28}, {"t": "כיוון.", "s": 28, "e": 28.36}]}, {"start": 28.74, "end": 30.94, "text": "מספר הרוכבים הוכפל.", "words": [{"t": "מספר", "s": 28.74, "e": 29.5}, {"t": "הרוכבים", "s": 29.5, "e": 30.12}, {"t": "הוכפל.", "s": 30.12, "e": 30.82}]}, {"start": 30.94, "end": 33.32, "text": "יותר רוכבים, יותר תאונות.", "words": [{"t": "יותר", "s": 30.94, "e": 31.54}, {"t": "רוכבים,", "s": 31.54, "e": 32.18}, {"t": "יותר", "s": 32.2, "e": 32.58}, {"t": "תאונות.", "s": 32.58, "e": 33.2}]}, {"start": 33.44, "end": 35.38, "text": "השיעור עצמו אולי ירד.", "words": [{"t": "השיעור", "s": 33.44, "e": 34.2}, {"t": "עצמו", "s": 34.2, "e": 34.66}, {"t": "אולי", "s": 34.66, "e": 35.04}, {"t": "ירד.", "s": 35.04, "e": 35.26}]}, {"start": 35.82, "end": 37.46, "text": "להחליש טיעון זה", "words": [{"t": "להחליש", "s": 35.82, "e": 36.58}, {"t": "טיעון", "s": 36.58, "e": 37}, {"t": "זה", "s": 37, "e": 37.34}]}, {"start": 37.34, "end": 38.46, "text": "לתקוף את הקשר.", "words": [{"t": "לתקוף", "s": 37.34, "e": 37.88}, {"t": "את", "s": 37.88, "e": 38}, {"t": "הקשר.", "s": 38, "e": 38.34}]}]}
